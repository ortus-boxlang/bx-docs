/**
 * `coldbox` CLI verb - documents a ColdBox application into a project's
 * own content tree, from its conventions on disk.
 *
 * The ColdBox-side counterpart of the Gradle/Maven plugins'
 * `bxSitesControllerScanDoc`, with one deliberate difference in method:
 * the Spring generator reflects over compiled classes, while this one
 * never boots or loads anything. `ColdBoxAppScanner` finds the
 * conventions, `ColdBoxRouterParser` reads the routers,
 * `ColdBoxConfigParser` reads each module's own declarations, and
 * `ColdBoxDocGenerator` turns all of it into pages. Nothing is built or
 * served here - the pages are ordinary content, picked up by the next
 * `build`/`serve` like any other.
 *
 * Class-level detail (a handler's actions, their arguments and doc
 * comments) comes from DocBox, through the same `DocBoxRunner` the
 * `docbox` verb uses - there is no second metadata reader in bx-sites.
 * That makes bx-docbox an optional enhancement rather than a
 * prerequisite: without it the pages still list handlers, routes and
 * modules, and say plainly what's missing and how to get it.
 *
 * Because it's static, a route or handler that only exists once the app
 * is running can't appear. That's the trade named in each of those
 * classes' own docblocks, and the reason this verb works on a CI runner
 * with no datasources, no environment, and no app to boot.
 */
class {

	/**
	 * @options { projectRoot (required, absolute path), appRoot, pagePathPrefix, tags (comma list), include (comma list) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxSites.MissingProjectRoot", message = "`coldbox` requires a project root" )
		}
		var root = projectRoot.reReplace( "[\/]+$", "" )

		var config = new "models.config.ConfigLoader@bxsites"().load( root )
		var settings = config.coldbox ?: {}
		var contentDir = new "models.config.SourceDirResolver@bxsites"().resolve( root )
		var appRoot = resolveAppRoot( root, settings, arguments.options )

		var scanner = new "models.build.ColdBoxAppScanner@bxsites"()
		var app = scanner.scan( appRoot )

		if ( !app.isColdBoxApp ) {
			throw(
				type    = "BxSites.NotAColdBoxApp",
				message = "No ColdBox application found at [#appRoot#] - expected a handlers/ folder, a config/ColdBox file, a config/Router file, or modules_app/. Point at the right root with [coldbox.appRoot] in bxsites.yaml, or --appRoot=<path>"
			)
		}

		var include = includeFor( settings, arguments.options )
		var configParser = new "models.build.ColdBoxConfigParser@bxsites"()

		// Each module's own declarations are needed twice - to mount its
		// routes at the entry point it declares, and to describe it on its
		// own page - so read them once and carry them on the module.
		for ( var module in app.modules ) {
			module[ "metadata" ] = configParser.moduleMetadata( module.configFile )
		}

		var routes = collectRoutes( app )
		var pagePathPrefix = pagePathPrefixFor( settings, arguments.options )
		var metadata = classDocs( app, include )

		var generated = new "models.build.ColdBoxDocGenerator@bxsites"().generate(
			app            = app,
			routes         = routes,
			contentDir     = contentDir,
			pagePathPrefix = pagePathPrefix,
			tags           = tagsFor( settings, arguments.options ),
			include        = include,
			classDocs      = metadata.docs,
			metadataAdvice = metadata.advice,
			mappings       = include.findNoCase( "models" ) || include.findNoCase( "modules" ) ? collectMappings( app ) : [],
			interceptors   = include.findNoCase( "interceptors" ) ? configParser.interceptorDeclarations( app.configFile ) : [],
			tasks          = include.findNoCase( "scheduler" ) ? collectTasks( app ) : []
		)

		return {
			exitCode : 0,
			message  : report( app, routes, generated, contentDir, pagePathPrefix, metadata.warnings )
		}
	}

	/**
	 * DocBox metadata for every handler and model the requested page sets
	 * need, keyed the way `ColdBoxDocGenerator` looks it up.
	 *
	 * Each root is documented under its own mapping, so two modules'
	 * identically-named handlers - or a handler and a model sharing a
	 * name - stay distinct. The JSON goes to a temp directory that leaves
	 * with the run: the pages are the deliverable, not the metadata
	 * behind them.
	 *
	 * Never throws: a metadata problem degrades the handler, model and
	 * interceptor pages, it doesn't fail the run, and every other page set
	 * is unaffected either way.
	 *
	 * The two ways it can come back empty are deliberately not the same
	 * thing. bx-docbox not being installed is the ordinary case, and the
	 * generator's own default advice ("install it") is right. A DocBox run
	 * that fails with the module installed is not: telling that reader to
	 * install what they already have sends them the wrong way, so the
	 * failure travels back as `advice` (what the pages say) and as a
	 * `warnings` entry (what the verb prints), carrying the real error.
	 *
	 * @app A `ColdBoxAppScanner.scan()` result
	 * @include The page sets being generated
	 *
	 * @return `{ docs, advice, warnings }` - `advice` is "" to keep the generator's default
	 */
	private struct function classDocs( required struct app, required array include ) {
		// Captured first: an arrow closure has its own `arguments` scope,
		// so `arguments.include` inside the filter would not be this one.
		var requested = arguments.include
		var kinds = [ "handler", "model", "interceptor" ].filter( ( kind ) => requested.findNoCase( kind & "s" ) > 0 )

		if ( !kinds.len() ) {
			return noClassDocs()
		}

		var runner = new "models.build.DocBoxRunner@bxsites"()

		if ( !runner.isAvailable() ) {
			return noClassDocs()
		}

		var sources = []
		var rootsByMapping = {}

		for ( var kind in kinds ) {
			var folder = kind & "s"
			var appRoot = arguments.app.appRoot & "/" & folder

			if ( directoryExists( appRoot ) ) {
				sources.append( { "dir" : appRoot, "mapping" : folder } )
				rootsByMapping[ folder ] = { "kind" : kind, "module" : "" }
			}

			for ( var module in arguments.app.modules ) {
				var moduleRoot = module.root & "/" & folder

				if ( !directoryExists( moduleRoot ) ) {
					continue
				}

				var mapping = "cbmodules." & module.name.reReplace( "[^a-zA-Z0-9_]", "_", "all" ) & "." & folder
				sources.append( { "dir" : moduleRoot, "mapping" : mapping } )
				rootsByMapping[ mapping ] = { "kind" : kind, "module" : module.name }
			}
		}

		if ( !sources.len() ) {
			return noClassDocs()
		}

		var jsonDir = createTempDirectory( prefix = "bxsites-coldbox-" )

		try {
			runner.run( sources = sources, outputDir = jsonDir, projectTitle = "ColdBox Application" )

			return { "docs" : indexClassDocs( jsonDir, rootsByMapping ), "advice" : "", "warnings" : [] }
		} catch ( any e ) {
			// Installed, but it failed - say that, and say why, rather than
			// letting the pages advise an install that has already happened.
			var failure = "The bx-docbox module is installed, but reading this application's classes failed: #e.message#"

			return { "docs" : {}, "advice" : failure, "warnings" : [ failure ] }
		} finally {
			if ( directoryExists( jsonDir ) ) {
				directoryDelete( jsonDir, true )
			}
		}
	}

	/**
	 * No class metadata, for a reason the generator's own default advice
	 * already covers - bx-docbox isn't installed, or there is nothing of
	 * that kind to document.
	 */
	private struct function noClassDocs() {
		return { "docs" : {}, "advice" : "", "warnings" : [] }
	}

	/**
	 * Turns a DocBox JSON tree into the lookup the generator wants, using
	 * each class' own recorded package to work out which root - and so
	 * which kind and module - it came from.
	 *
	 * @jsonDir The directory DocBox wrote to
	 * @rootsByMapping Mapping name -> `{ kind, module }`
	 */
	private struct function indexClassDocs( required string jsonDir, required struct rootsByMapping ) {
		var overviewFile = arguments.jsonDir & "/overview-summary.json"

		if ( !fileExists( overviewFile ) ) {
			return {}
		}

		var generator = new "models.build.ColdBoxDocGenerator@bxsites"()
		var overview = jsonDeserialize( fileRead( overviewFile ) )
		var docs = {}

		for ( var classEntry in ( overview.classes ?: [] ) ) {
			var classFile = arguments.jsonDir & "/" & classEntry.path

			if ( !fileExists( classFile ) ) {
				continue
			}

			var doc = jsonDeserialize( fileRead( classFile ) )
			var package = doc.package ?: ""

			for ( var mapping in arguments.rootsByMapping ) {
				if ( package != mapping && !package.startsWith( mapping & "." ) ) {
					continue
				}

				var root = arguments.rootsByMapping[ mapping ]
				var relative = package.mid( mapping.len() + 2, package.len() )
				var name = len( relative ) ? relative & "." & doc.name : doc.name

				docs[ generator.classKey( root.kind, root.module, name ) ] = doc
				break
			}
		}

		return docs
	}

	/**
	 * Every WireBox mapping the app declares: its own binder first, then
	 * each module's.
	 *
	 * @app A `ColdBoxAppScanner.scan()` result
	 */
	private array function collectMappings( required struct app ) {
		var parser = new "models.build.ColdBoxWireBoxParser@bxsites"()
		var scanner = new "models.build.ColdBoxAppScanner@bxsites"()
		var mappings = parser.parse( arguments.app.wireBoxFile )

		for ( var module in arguments.app.modules ) {
			var moduleBinder = scanner.firstExisting( module.root & "/config/WireBox" )

			if ( len( moduleBinder ) ) {
				mappings.append( parser.parse( moduleBinder, module.name ), true )
			}
		}

		return mappings
	}

	/**
	 * Every route the app declares: its own router first, then each
	 * module's, prefixed by that module's declared entry point so a
	 * module route's pattern reads as the URL it actually answers on.
	 *
	 * @app A `ColdBoxAppScanner.scan()` result
	 */
	private array function collectRoutes( required struct app ) {
		var parser = new "models.build.ColdBoxRouterParser@bxsites"()
		var routes = parser.parse( arguments.app.routerFile )

		for ( var module in arguments.app.modules ) {
			if ( !len( module.routerFile ) ) {
				continue
			}

			routes.append(
				parser.parse(
					routerFile = module.routerFile,
					module     = module.name,
					prefix     = ( module.metadata ?: {} ).entryPoint ?: module.name
				),
				true
			)
		}

		return routes
	}

	/**
	 * Every scheduled task the app registers: its own scheduler first,
	 * then each module's.
	 *
	 * @app A `ColdBoxAppScanner.scan()` result
	 */
	private array function collectTasks( required struct app ) {
		var parser = new "models.build.ColdBoxSchedulerParser@bxsites"()
		var scanner = new "models.build.ColdBoxAppScanner@bxsites"()
		var tasks = parser.parse( arguments.app.schedulerFile )

		for ( var module in arguments.app.modules ) {
			var moduleScheduler = scanner.firstExisting( module.root & "/config/Scheduler" )

			if ( len( moduleScheduler ) ) {
				tasks.append( parser.parse( moduleScheduler, module.name ), true )
			}
		}

		return tasks
	}

	/**
	 * Where the ColdBox app itself lives: `--appRoot`, else
	 * `coldbox.appRoot`, else the project root - which is the common case,
	 * a docs site living inside the app it documents.
	 *
	 * @projectRoot Absolute path to the project root
	 * @settings The config's `coldbox` block
	 * @options The parsed CLI options
	 */
	private string function resolveAppRoot( required string projectRoot, required struct settings, required struct options ) {
		var configured = trim( arguments.options.appRoot ?: arguments.settings.appRoot ?: "" )

		if ( !len( configured ) || configured == "." ) {
			return arguments.projectRoot
		}

		if ( configured.startsWith( "/" ) || reFind( "^[A-Za-z]:[\/]", configured ) ) {
			return configured.reReplace( "[\/]+$", "" )
		}

		return ( arguments.projectRoot & "/" & configured.reReplace( "^\./", "" ) ).reReplace( "[\/]+$", "" )
	}

	/**
	 * Where pages land, relative to the content directory.
	 *
	 * @settings The config's `coldbox` block
	 * @options The parsed CLI options
	 */
	private string function pagePathPrefixFor( required struct settings, required struct options ) {
		var prefix = trim( arguments.options.pagePathPrefix ?: arguments.settings.pagePathPrefix ?: "" )

		return len( prefix ) ? prefix : "api/coldbox"
	}

	/**
	 * The frontmatter tags every generated page carries.
	 *
	 * @settings The config's `coldbox` block
	 * @options The parsed CLI options
	 */
	private array function tagsFor( required struct settings, required struct options ) {
		var flag = trim( arguments.options.tags ?: "" )

		if ( len( flag ) ) {
			return commaList( flag )
		}

		return isArray( arguments.settings.tags ?: "" ) ? arguments.settings.tags : [ "api", "coldbox" ]
	}

	/**
	 * Which page sets to generate.
	 *
	 * @settings The config's `coldbox` block
	 * @options The parsed CLI options
	 */
	private array function includeFor( required struct settings, required struct options ) {
		var flag = trim( arguments.options.include ?: "" )

		if ( len( flag ) ) {
			return commaList( flag )
		}

		return isArray( arguments.settings.include ?: "" ) && arguments.settings.include.len()
			? arguments.settings.include
			: [ "routes", "handlers", "models", "modules", "interceptors", "scheduler" ]
	}

	/**
	 * A comma-delimited flag value as a trimmed, non-empty array.
	 *
	 * @value The raw flag value
	 */
	private array function commaList( required string value ) {
		return arguments.value.listToArray( "," ).map( ( entry ) => trim( entry ) ).filter( ( entry ) => len( entry ) )
	}

	/**
	 * The verb's own stdout report.
	 *
	 * @app The scanned application
	 * @routes Every parsed route
	 * @generated ColdBoxDocGenerator's result struct
	 * @contentDir The project's content directory
	 * @pagePathPrefix Where pages were written, relative to `contentDir`
	 * @metadataWarnings Anything that went wrong reading class metadata
	 */
	private string function report(
		required struct app,
		required array routes,
		required struct generated,
		required string contentDir,
		required string pagePathPrefix,
		array metadataWarnings = []
	) {
		var handlerCount = arguments.app.handlers.len()
			+ arguments.app.modules.reduce( ( total, module ) => total + module.handlers.len(), 0 )
		var lines = [
			"Documented #arguments.routes.len()# route(s), #handlerCount# handler(s), #arguments.app.models.len()# model(s) and #arguments.app.modules.len()# module(s) into #arguments.generated.pageFiles.len()# page(s) under #arguments.contentDir#/#arguments.pagePathPrefix#"
		]

		// A metadata failure reaches the generator as its `metadataAdvice`,
		// so each affected page set already reports it in its own warning.
		// Only print it on its own when nothing else picked it up - an app
		// with no handlers and no models, say.
		var reported = arguments.generated.warnings

		for ( var warning in arguments.metadataWarnings ) {
			if ( !reported.some( ( existing ) => existing.findNoCase( warning ) > 0 ) ) {
				lines.append( "  - " & warning )
			}
		}

		for ( var warning in reported ) {
			lines.append( "  - " & warning )
		}

		return lines.toList( char( 10 ) )
	}

}
