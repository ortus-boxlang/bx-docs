/**
 * Reads, defaults, and validates a project's site configuration (module spec
 * section 4). `bxsites.yaml` (or `.yml`) is the preferred/default format;
 * `bxsites.toml` and `bxsites.json` are also fully supported, resolved in
 * that order when more than one is present. Pure struct in, struct out - no
 * CLI/argv concerns, so it is unit-testable directly against a temp project
 * directory.
 */
class {

	/**
	 * The config file names this module recognizes, in resolution
	 * preference order - the first one found on disk wins. `bxsites.yaml`/
	 * `.yml` are parsed via bx-yaml's `yamlDeserialize()`/`yamlDeserializeFile()`
	 * BIFs, `bxsites.json` via the built-in `jsonDeserialize()`.
	 */
	variables.configFileNames = [ "bxsites.yaml", "bxsites.yml", "bxsites.toml", "bxsites.json" ]

	/**
	 * The config file name in play for the current/last `load()` call - only
	 * used to phrase validation error messages against whichever file the
	 * project actually has. Defaults to the preferred name so a direct,
	 * standalone `validate()` call (bypassing `load()` - not used by this
	 * module itself, but a valid call shape) still produces a sensible message.
	 */
	variables.configFileName = "bxsites.yaml"

	/**
	 * Parses `bxsites.yaml`/`.yml` - real bx-yaml BIFs by default, swappable
	 * via setYamlRenderer() (YamlRenderer.bx's own docblock explains why).
	 */
	variables.yamlRenderer = new "models.build.YamlRenderer@bxsites"()
	variables.tomlRenderer = new "models.build.TomlRenderer@bxsites"()

	/**
	 * Swaps in a fake/test YAML renderer - see YamlRenderer.bx's docblock.
	 *
	 * @renderer Any object exposing `fromYaml( content )`
	 */
	void function setYamlRenderer( required any renderer ) {
		variables.yamlRenderer = arguments.renderer
	}

	void function setTomlRenderer( required any renderer ) {
		variables.tomlRenderer = arguments.renderer
	}

	/**
	 * Default site configuration, deep-merged with the user's site config.
	 * Markdown passthrough options are otherwise left to bx-markdown's own
	 * defaults - the one exception is `enableAdmonition`, which bx-sites
	 * itself defaults to `true` (admonition callout blocks have always been
	 * an out-of-the-box bx-sites feature; a project can still turn them off
	 * via `{"markdown":{"enableAdmonition":false}}`).
	 */
	variables.defaults = {
		"description"  : "",
		"baseURL"      : "/",
		"theme"        : { "name" : "bootstrap", "options" : {}, "logo" : "", "favicon" : "" },
		"search"       : true,
		"mcp"          : false,
		"searchProvider" : {
			"provider" : "local",
			"algolia"  : { "appId" : "", "apiKey" : "", "indexName" : "", "insights" : false },
			"pagefind" : { "bin" : "pagefind", "options" : [] }
		},
		"nav"          : [],
		"markdown"     : { "enableAdmonition" : true },
		"repo"         : { "url" : "", "editUri" : "" },
		"social"       : [],
		"footer"       : false,
		"lastUpdated"  : false,
		"mermaid"      : false,
		"math"         : false,
		"openapi"      : false,
		"pageActions"  : false,
		"robots"       : true,
		"analytics"    : { "provider" : "", "id" : "" },
		"ogImage"      : "",
		"generateOgImages" : false,
		"extraCss"     : [],
		"extraJs"      : [],
		"assets"       : {
			"fingerprint" : true,
			"bundle"      : true,
			"images"      : { "enabled" : true, "widths" : [ 400, 800, 1200, 1600 ], "formats" : [ "original", "webp" ] }
		},
		"plugins"      : [],
		"redirects"    : [],
		"variables"    : {},
		"i18n"         : { "defaultLocale" : { "code" : "en", "label" : "English" }, "locales" : [] },
		"blog"         : { "postsPerPage" : 10, "feed" : true, "feedLimit" : 25 },
		"versions"     : { "default" : "" },
		"cloud"        : { "siteId" : "", "apiUrl" : "" },
		"docbox"       : {
			"projectTitle"   : "",
			"mappings"       : {},
			"excludes"       : "",
			"pagePathPrefix" : "api/docbox",
			"tags"           : [ "api", "docbox" ]
		},
		"coldbox"      : {
			"appRoot"        : "",
			"pagePathPrefix" : "api/coldbox",
			"tags"           : [ "api", "coldbox" ],
			"include"        : [ "routes", "handlers" ]
		}
	}

	/**
	 * The theme names shipped by this module in v1 (module spec section 6).
	 */
	variables.builtInThemes = [ "bootstrap", "material", "tailwind", "docsy", "slate", "docusaurus", "justthedocs", "vuepress", "gitbook", "notion" ]

	/**
	 * Reads and validates a project's site config - `<projectRoot>/bxsites.yaml`
	 * (or `.yml`/`.json`, whichever is actually present - see `configFileNames`),
	 * merging it over the module's own defaults.
	 *
	 * @projectRoot Absolute path to the project root
	 *
	 * @return The normalized site configuration struct
	 */
	struct function load( required string projectRoot ) {
		var configPath = configPathFor( arguments.projectRoot )
		variables.configFileName = configPath.listLast( "/" )

		if ( !fileExists( configPath ) ) {
			throw(
				type    = "BxSites.ConfigNotFound",
				message = "No bxsites.yaml, bxsites.toml, or bxsites.json found at [#arguments.projectRoot#] - run `new` to scaffold a project first"
			)
		}

		var isYaml = variables.configFileName.endsWith( ".yaml" ) || variables.configFileName.endsWith( ".yml" )
		var isToml = variables.configFileName.endsWith( ".toml" )

		var parsed = ""
		try {
			parsed = isYaml
				? variables.yamlRenderer.fromYaml( fileRead( configPath ) )
				: ( isToml ? variables.tomlRenderer.fromToml( fileRead( configPath ) ) : jsonDeserialize( fileRead( configPath ) ) )
		} catch ( any e ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# at [#configPath#] is not valid #isYaml ? 'YAML' : ( isToml ? 'TOML' : 'JSON' )#: #e.message#"
			)
		}

		if ( !isStruct( parsed ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# at [#configPath#] must contain a #isYaml ? 'YAML' : ( isToml ? 'TOML' : 'JSON' )# object"
			)
		}

		return validate( mergeNestedAssetsImagesDefaults( mergeDefaults( parsed ), parsed ) )
	}

	/**
	 * `mergeDefaults()` only merges one level deep (see its own docblock) -
	 * fine everywhere else, since every other nested struct's own default
	 * is empty (`theme.options`, `searchProvider.algolia`, ...) and so has
	 * nothing to lose by being replaced wholesale. `assets.images` is the
	 * one exception - a real, populated default two levels down
	 * (`enabled`/`widths`/`formats`) - so a project writing just
	 * `{"assets":{"images":{"widths":[...]}}}` would otherwise silently
	 * lose `enabled`/`formats`'s own defaults entirely, rather than only
	 * overriding `widths`. This patches exactly that one struct back in,
	 * one level further than mergeDefaults() itself goes.
	 *
	 * @merged mergeDefaults()'s own output
	 * @rawConfig The original parsed bxsites.json, before any defaulting
	 */
	private struct function mergeNestedAssetsImagesDefaults( required struct merged, required struct rawConfig ) {
		var rawAssets = arguments.rawConfig.assets ?: {}
		var rawImages = isStruct( rawAssets ) ? ( rawAssets.images ?: {} ) : {}

		if ( isStruct( rawImages ) ) {
			var defaultImages = variables.defaults.assets.images
			for ( var key in defaultImages ) {
				if ( !rawImages.keyExists( key ) ) {
					arguments.merged.assets.images[ key ] = defaultImages[ key ]
				}
			}
		}

		return arguments.merged
	}

	/**
	 * The absolute path to a project's site config file - the first of
	 * `configFileNames` found on disk under `projectRoot`, or the preferred
	 * `bxsites.yaml` path when none exist yet (a project with no config at all).
	 *
	 * @projectRoot Absolute path to the project root
	 */
	string function configPathFor( required string projectRoot ) {
		var dir = arguments.projectRoot.reReplace( "[\/]+$", "" )

		for ( var fileName in variables.configFileNames ) {
			var candidate = dir & "/" & fileName
			if ( fileExists( candidate ) ) {
				return candidate
			}
		}

		return dir & "/" & variables.configFileNames[ 1 ]
	}

	/**
	 * Deep-merges a parsed site config struct over the module defaults - a
	 * user-supplied key wins outright, a user-supplied struct key is merged
	 * one level deep (so `{"theme":{"name":"material"}}` still keeps the
	 * default empty `options`), everything else falls back to the default.
	 *
	 * @config The parsed site config struct
	 *
	 * @return The config struct with defaults applied
	 */
	struct function mergeDefaults( required struct config ) {
		var merged = duplicate( variables.defaults )

		for ( var key in arguments.config ) {
			if ( isStruct( merged[ key ] ?: "" ) && isStruct( arguments.config[ key ] ) ) {
				for ( var subKey in arguments.config[ key ] ) {
					merged[ key ][ subKey ] = arguments.config[ key ][ subKey ]
				}
			} else {
				merged[ key ] = arguments.config[ key ]
			}
		}

		return merged
	}

	/**
	 * Validates a merged site configuration struct.
	 *
	 * @config The merged config struct to validate
	 *
	 * @return The same config struct, unchanged, if valid
	 */
	struct function validate( required struct config ) {
		if ( !len( trim( arguments.config.name ?: "" ) ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# is missing a required [name] property"
			)
		}

		var theme = arguments.config.theme ?: ""
		if ( !isStruct( theme ) || !len( trim( theme.name ?: "" ) ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [theme] must be an object with a [name] property"
			)
		}

		var colorMode = theme.options.colorMode ?: "auto"
		if ( !listFindNoCase( "light,dark,auto", colorMode ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [theme.options.colorMode], when present, must be one of: light, dark, auto"
			)
		}

		for ( var accentOption in [ "accentColor", "accentColorDark" ] ) {
			if ( theme.options.keyExists( accentOption ) && !reFind( "^##[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$", trim( theme.options[ accentOption ] ) ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [theme.options.#accentOption#], when present, must be a hex color like ##2563eb"
				)
			}
		}

		if ( !isSimpleValue( theme.logo ?: "" ) || !isSimpleValue( theme.favicon ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [theme.logo]/[theme.favicon], when present, must be strings"
			)
		}

		for ( var boolOption in [ "navCollapsible", "navExpandAll", "breadcrumbs" ] ) {
			if ( theme.options.keyExists( boolOption ) && !isBoolean( theme.options[ boolOption ] ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [theme.options.#boolOption#], when present, must be a boolean"
				)
			}
		}

		var tocPosition = theme.options.tocPosition ?: "top"
		if ( !listFindNoCase( "top,sticky", tocPosition ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [theme.options.tocPosition], when present, must be one of: top, sticky"
			)
		}

		var pageMetaPosition = theme.options.pageMetaPosition ?: "bottom"
		if ( !listFindNoCase( "top,bottom", pageMetaPosition ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [theme.options.pageMetaPosition], when present, must be one of: top, bottom"
			)
		}

		var pageActionsPosition = theme.options.pageActionsPosition ?: "top"
		if ( !listFindNoCase( "top,bottom", pageActionsPosition ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [theme.options.pageActionsPosition], when present, must be one of: top, bottom"
			)
		}

		if ( !isBoolean( arguments.config.search ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [search] must be a boolean"
			)
		}

		validateSearchProvider( arguments.config.searchProvider ?: "" )

		if ( !isBoolean( arguments.config.mcp ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [mcp] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.mermaid ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [mermaid] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.math ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [math] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.openapi ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [openapi] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.pageActions ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [pageActions] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.robots ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [robots] must be a boolean"
			)
		}

		if ( !isArray( arguments.config.nav ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [nav], when present, must be an array"
			)
		}

		if ( !isStruct( arguments.config.markdown ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [markdown], when present, must be an object"
			)
		}

		var repo = arguments.config.repo ?: ""
		if ( !isStruct( repo ) || !isSimpleValue( repo.url ?: "" ) || !isSimpleValue( repo.editUri ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [repo], when present, must be an object with string [url]/[editUri]"
			)
		}

		if ( !isArray( arguments.config.social ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [social], when present, must be an array"
			)
		}
		for ( var link in arguments.config.social ) {
			if ( !isStruct( link ) || !len( trim( link.url ?: "" ) ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [social] entries must be objects with a non-empty [url]"
				)
			}
		}

		if ( !isBoolean( arguments.config.footer ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [footer] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.lastUpdated ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [lastUpdated] must be a boolean"
			)
		}

		var analytics = arguments.config.analytics ?: ""
		if ( !isStruct( analytics ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [analytics], when present, must be an object"
			)
		}
		var analyticsProvider = trim( analytics.provider ?: "" )
		if ( len( analyticsProvider ) && analyticsProvider != "google" ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [analytics.provider], when present, must be: google"
			)
		}
		if ( analyticsProvider == "google" && !len( trim( analytics.id ?: "" ) ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [analytics.id] is required when [analytics.provider] is set"
			)
		}
		if ( len( analyticsProvider ) && !reFind( "^[A-Za-z0-9\-]+$", trim( analytics.id ?: "" ) ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [analytics.id] must contain only letters, numbers and hyphens"
			)
		}

		if ( !isSimpleValue( arguments.config.ogImage ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [ogImage], when present, must be a string"
			)
		}

		if ( !isBoolean( arguments.config.generateOgImages ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [generateOgImages], when present, must be a boolean"
			)
		}

		for ( var assetsKey in [ "extraCss", "extraJs" ] ) {
			var assetUrls = arguments.config[ assetsKey ] ?: ""
			if ( !isArray( assetUrls ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [#assetsKey#], when present, must be an array"
				)
			}
			for ( var assetUrl in assetUrls ) {
				if ( !isSimpleValue( assetUrl ) || !len( trim( assetUrl ) ) ) {
					throw(
						type    = "BxSites.InvalidConfig",
						message = "#variables.configFileName# [#assetsKey#] entries must be non-empty strings"
					)
				}
			}
		}

		validateAssets( arguments.config.assets ?: "" )

		if ( !isArray( arguments.config.plugins ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [plugins], when present, must be an array"
			)
		}
		for ( var pluginName in arguments.config.plugins ) {
			if ( !isSimpleValue( pluginName ) || !len( trim( pluginName ) ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [plugins] entries must be non-empty strings (BoxLang module names)"
				)
			}
		}

		validateI18n( arguments.config.i18n ?: "" )
		validateBlog( arguments.config.blog ?: "" )
		validateRedirects( arguments.config.redirects ?: "" )
		validateVariables( arguments.config.variables ?: "" )
		validateVersions( arguments.config.versions ?: "" )
		validateCloud( arguments.config.cloud ?: "" )
		validateDocBox( arguments.config.docbox ?: "" )
		validateColdBox( arguments.config.coldbox ?: "" )

		return arguments.config
	}

	/**
	 * Validates the site config's `coldbox` block - where the ColdBox app
	 * being documented lives, and which page sets the `coldbox` verb
	 * generates from it. Whether `appRoot` actually holds a ColdBox app is
	 * the verb's own check, since it has the better error to give.
	 *
	 * Typed `any` rather than `struct` for the same reason as
	 * `validateDocBox()`.
	 *
	 * @coldbox The merged `coldbox` config block
	 *
	 * @throws BxSites.InvalidConfig
	 */
	private void function validateColdBox( required any coldbox ) {
		if ( !isStruct( arguments.coldbox ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [coldbox], when present, must be an object"
			)
		}

		for ( var stringKey in [ "appRoot", "pagePathPrefix" ] ) {
			if ( !isSimpleValue( arguments.coldbox[ stringKey ] ?: "" ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [coldbox.#stringKey#], when present, must be a string"
				)
			}
		}

		for ( var arrayKey in [ "tags", "include" ] ) {
			if ( !isArray( arguments.coldbox[ arrayKey ] ?: [] ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [coldbox.#arrayKey#], when present, must be an array of strings"
				)
			}
		}
	}

	/**
	 * Validates the site config's `docbox` block - the source mappings and
	 * page placement the `docbox` verb generates BoxLang/CFML API
	 * reference pages from. Only shape is checked here; whether a mapped
	 * directory actually exists is the verb's own concern, since a config
	 * can legitimately describe a source tree that a given checkout
	 * doesn't have.
	 *
	 * Typed `any` rather than `struct` so a config that sets it to a
	 * non-object gets this readable error instead of an argument-type one.
	 *
	 * @docbox The merged `docbox` config block
	 *
	 * @throws BxSites.InvalidConfig
	 */
	private void function validateDocBox( required any docbox ) {
		if ( !isStruct( arguments.docbox ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [docbox], when present, must be an object"
			)
		}

		if ( !isStruct( arguments.docbox.mappings ?: {} ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [docbox.mappings], when present, must be an object of mapping name -> source directory"
			)
		}

		for ( var stringKey in [ "projectTitle", "excludes", "pagePathPrefix" ] ) {
			if ( !isSimpleValue( arguments.docbox[ stringKey ] ?: "" ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [docbox.#stringKey#], when present, must be a string"
				)
			}
		}

		if ( !isArray( arguments.docbox.tags ?: [] ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [docbox.tags], when present, must be an array of strings"
			)
		}
	}

	/**
	 * Validates the site config's `variables` block (module spec section 4,
	 * "Reusable variables") - an arbitrary, optionally-nested struct of
	 * project-defined values, resolved in markdown content via
	 * `{{ dotted.path }}` (VariablesProcessor.bx). No shape is enforced
	 * beyond "it's an object" - any value type (string/number/boolean/array/
	 * nested object) is valid, since VariablesProcessor only ever needs
	 * `toString()` on whatever it finds at the end of a dotted path.
	 *
	 * @vars The merged config's own `variables` value - `any`, not
	 * `struct`, for the same reason validateI18n() takes `any` (see its own
	 * docblock). Named `vars`, not `variables` - a parameter named
	 * `variables` would shadow this class's own `variables` scope for the
	 * rest of the method body (see AGENTS.md's "parameter name shadows"
	 * gotcha), breaking every `variables.configFileName` reference below.
	 */
	private void function validateVariables( required any vars ) {
		if ( !isStruct( arguments.vars ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [variables], when present, must be an object"
			)
		}
	}

	/**
	 * Validates the site config's `versions` block - `versions.default`
	 * (empty, the default, by far the common case) names which
	 * `docs/versions/<name>/` folder should build at the site root instead
	 * of the plain `docs/` tree (BuildPipeline.bx's own `build()` resolves
	 * the actual folder-exists check against `VersionsDiscoverer.bx`'s
	 * output, since that's a filesystem concern this config-only validator
	 * has no `docsDir` to check against). Only the shape is validated here.
	 *
	 * @versions The merged config's own `versions` value - `any`, not
	 * `struct`, for the same reason validateI18n() takes `any` (see its
	 * own docblock)
	 */
	private void function validateVersions( required any versions ) {
		if ( !isStruct( arguments.versions ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [versions], when present, must be an object"
			)
		}

		if ( !isSimpleValue( arguments.versions.default ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [versions.default], when present, must be a string"
			)
		}
	}

	/**
	 * Validates the site config's `cloud` block - the `publish` verb's own
	 * destination (module spec's bxSites Cloud publish-API contract):
	 * `siteId` (the target site's UUID in bxSites Cloud) and `apiUrl` (that
	 * instance's base URL, e.g. `https://cloud.bxsites.app` or a self-hosted
	 * URL). Deliberately no token/secret field here at all, not even an
	 * `EnvVar`-suffixed indirection like every `deployments/*` target uses -
	 * `publish`'s own auth token is a fixed, hardcoded env var name
	 * (`BXSITES_CLOUD_TOKEN`) plus an optional `--token` CLI flag (see
	 * `models/cli/Publish.bx`), never anything named in `bxsites.yaml`
	 * itself, so there's no field here whose value could ever be mistaken
	 * for a place to paste a real token. Both fields are optional here -
	 * empty is the "not configured yet" default - `publish` itself is what
	 * requires them to be non-empty when it actually runs.
	 *
	 * @cloud The merged config's own `cloud` value - `any`, not `struct`, for
	 * the same reason validateI18n() takes `any` (see its own docblock)
	 */
	private void function validateCloud( required any cloud ) {
		if ( !isStruct( arguments.cloud ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [cloud], when present, must be an object"
			)
		}

		if ( !isSimpleValue( arguments.cloud.siteId ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [cloud.siteId], when present, must be a string"
			)
		}

		if ( !isSimpleValue( arguments.cloud.apiUrl ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [cloud.apiUrl], when present, must be a string"
			)
		}
	}

	/**
	 * Validates the site config's own `redirects` array - explicit
	 * `{ "from", "to" }` old-URL -> new-URL mappings, only ever applied to
	 * the main site tree by RedirectGenerator.bx (see its own docblock for
	 * why). A page's own frontmatter `redirect_from` is the per-page,
	 * per-tree alternative and needs no config-side validation of its own -
	 * DocsLoader.bx already only ever produces an array there.
	 *
	 * @redirects The merged config's own `redirects` value - `any`, not
	 * `array`, for the same reason validateI18n() takes `any` (see its own docblock)
	 */
	private void function validateRedirects( required any redirects ) {
		if ( !isArray( arguments.redirects ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [redirects], when present, must be an array"
			)
		}
		for ( var redirect in arguments.redirects ) {
			if ( !isStruct( redirect ) || !len( trim( redirect.from ?: "" ) ) || !len( trim( redirect.to ?: "" ) ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [redirects] entries must be objects with non-empty [from]/[to] strings"
				)
			}
		}
	}

	/**
	 * Validates the site config's `blog` block - the `docs/blog/posts/`
	 * by-convention feature's own display/pagination options. No `docs/blog/`
	 * folder needs to exist for this to validate cleanly; it's only ever
	 * consulted once BlogDiscoverer.bx finds at least one post.
	 *
	 * @blog The merged config's own `blog` value - `any`, not `struct`, for
	 * the same reason validateI18n() takes `any` (see its own docblock)
	 */
	private void function validateBlog( required any blog ) {
		if ( !isStruct( arguments.blog ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [blog], when present, must be an object"
			)
		}

		var postsPerPage = arguments.blog.postsPerPage ?: 10
		if ( !isNumeric( postsPerPage ) || val( postsPerPage ) < 1 || val( postsPerPage ) != int( val( postsPerPage ) ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [blog.postsPerPage], when present, must be a positive whole number"
			)
		}

		if ( arguments.blog.keyExists( "feed" ) && !isBoolean( arguments.blog.feed ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [blog.feed], when present, must be a boolean"
			)
		}

		var feedLimit = arguments.blog.feedLimit ?: 25
		if ( !isNumeric( feedLimit ) || val( feedLimit ) < 0 || val( feedLimit ) != int( val( feedLimit ) ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [blog.feedLimit], when present, must be a whole number of 0 or more"
			)
		}
	}

	/**
	 * Validates the site config's `searchProvider` block - which search UI
	 * `search: true` wires up (module spec section 7). `local` (the
	 * default, bx-sites' own static MiniSearch search) needs no further settings.
	 * `algolia` (Algolia DocSearch) requires its own `algolia.{appId,apiKey,
	 * indexName}` - everything DocSearch's client itself requires to run.
	 * `pagefind` only validates its own `pagefind.{bin,options}` shape, if
	 * present - both are optional (`SearchProviderRegistry`/ConfigLoader's
	 * own defaults already cover the common case of `pagefind` being on
	 * `PATH` with no extra flags). Any other `provider` name isn't validated
	 * further here - it's a project's own custom/plugin-supplied provider,
	 * wired up by a `theme/` override rather than bx-sites core (see
	 * SearchProviderRegistry.bx).
	 *
	 * @searchProvider The merged config's own `searchProvider` value - `any`,
	 * not `struct`, for the same reason validateI18n() takes `any` (see its
	 * own docblock)
	 */
	private void function validateSearchProvider( required any searchProvider ) {
		if ( !isStruct( arguments.searchProvider ) || !len( trim( arguments.searchProvider.provider ?: "" ) ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [searchProvider] must be an object with a non-empty [provider]"
			)
		}

		var provider = lCase( trim( arguments.searchProvider.provider ) )

		if ( provider == "algolia" ) {
			var algolia = arguments.searchProvider.algolia ?: ""
			if (
				!isStruct( algolia )
				|| !len( trim( algolia.appId ?: "" ) )
				|| !len( trim( algolia.apiKey ?: "" ) )
				|| !len( trim( algolia.indexName ?: "" ) )
			) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [searchProvider.algolia] must be an object with non-empty [appId], [apiKey] and [indexName] when [searchProvider.provider] is ""algolia"""
				)
			}

			if ( algolia.keyExists( "insights" ) && !isBoolean( algolia.insights ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [searchProvider.algolia.insights], when present, must be a boolean"
				)
			}
			return
		}

		if ( provider == "pagefind" ) {
			var pagefind = arguments.searchProvider.pagefind ?: ""
			if ( !isStruct( pagefind ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [searchProvider.pagefind], when present, must be an object"
				)
			}

			if ( pagefind.keyExists( "bin" ) && !len( trim( pagefind.bin ?: "" ) ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [searchProvider.pagefind.bin], when present, must be a non-empty string"
				)
			}

			if ( pagefind.keyExists( "options" ) ) {
				if ( !isArray( pagefind.options ) ) {
					throw(
						type    = "BxSites.InvalidConfig",
						message = "#variables.configFileName# [searchProvider.pagefind.options], when present, must be an array"
					)
				}
				for ( var option in pagefind.options ) {
					if ( !isSimpleValue( option ) || !len( trim( option ) ) ) {
						throw(
							type    = "BxSites.InvalidConfig",
							message = "#variables.configFileName# [searchProvider.pagefind.options] entries must be non-empty strings"
						)
					}
				}
			}
		}
	}

	/**
	 * Validates the site config's `assets` block - fingerprinting/bundling
	 * on/off, and the `images` sub-block driving the responsive-image
	 * pipeline (ImageVariantGenerator.bx).
	 *
	 * @assets The merged config's own `assets` value - `any`, not `struct`, for the same reason validateI18n() takes `any` (see its own docblock)
	 */
	private void function validateAssets( required any assets ) {
		if ( !isStruct( arguments.assets ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [assets], when present, must be an object"
			)
		}

		if ( !isBoolean( arguments.assets.fingerprint ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [assets.fingerprint] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.assets.bundle ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [assets.bundle] must be a boolean"
			)
		}

		var images = arguments.assets.images ?: ""
		if ( !isStruct( images ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [assets.images] must be an object"
			)
		}

		if ( !isBoolean( images.enabled ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [assets.images.enabled] must be a boolean"
			)
		}

		if ( !isArray( images.widths ?: "" ) || !images.widths.len() ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [assets.images.widths] must be a non-empty array of positive whole-pixel numbers"
			)
		}
		for ( var width in images.widths ) {
			if ( !isNumeric( width ) || width <= 0 || width != int( width ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [assets.images.widths] entries must all be positive whole numbers - a fractional pixel width like 400.5 would produce an invalid ""400.5w"" srcset descriptor"
				)
			}
		}

		if ( !isArray( images.formats ?: "" ) || !images.formats.len() ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [assets.images.formats] must be a non-empty array"
			)
		}
		for ( var format in images.formats ) {
			if ( !isSimpleValue( format ) || !listFindNoCase( "original,webp", format ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [assets.images.formats] entries must each be one of: original, webp"
				)
			}
		}
	}

	/**
	 * Validates the site config's `i18n` block (module spec section 4) - the
	 * `docs/i18n/<code>/` locale-folder convention's own display/routing
	 * metadata. An empty `locales` array (the default) means the project
	 * isn't multilingual at all - no `docs/i18n/` folder is required to
	 * exist, and none of this is otherwise consulted.
	 *
	 * @i18n The merged config's own `i18n` value - `any`, not `struct`, so a
	 * user-supplied non-struct value (mergeDefaults() only overwrites the
	 * default wholesale when it isn't a struct - see its own docblock)
	 * fails with a clean BxSites.InvalidConfig below, rather than a raw
	 * BoxLang type-mismatch error from the function signature itself.
	 */
	private void function validateI18n( required any i18n ) {
		if ( !isStruct( arguments.i18n ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [i18n], when present, must be an object"
			)
		}

		validateLocale( arguments.i18n.defaultLocale ?: "", "i18n.defaultLocale" )

		if ( !isArray( arguments.i18n.locales ?: "" ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [i18n.locales], when present, must be an array"
			)
		}

		var seenCodes = [ lCase( arguments.i18n.defaultLocale.code ) ]
		for ( var locale in arguments.i18n.locales ) {
			validateLocale( locale, "i18n.locales" )
			var code = lCase( trim( locale.code ) )
			if ( seenCodes.contains( code ) ) {
				throw(
					type    = "BxSites.InvalidConfig",
					message = "#variables.configFileName# [i18n.locales] has a duplicate locale code [#locale.code#] (also used by [i18n.defaultLocale] or an earlier entry)"
				)
			}
			seenCodes.append( code )
		}
	}

	/**
	 * Validates a single locale entry - `i18n.defaultLocale`, or one entry
	 * of `i18n.locales`. `code` doubles as a `docs/i18n/<code>/` folder name
	 * and a URL path segment, so it's restricted to letters/digits/hyphens
	 * (BCP-47-shaped, e.g. `es`, `pt-BR`, `zh-Hans` - no `/`/`.` a path
	 * could ever escape with).
	 *
	 * @locale The locale struct to validate
	 * @path Where it lives in the site config, for the error message
	 */
	private void function validateLocale( required any locale, required string path ) {
		if ( !isStruct( arguments.locale ) || !len( trim( arguments.locale.code ?: "" ) ) || !len( trim( arguments.locale.label ?: "" ) ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [#arguments.path#] must be an object with a non-empty [code] and [label]"
			)
		}

		if ( !reFind( "^[A-Za-z][A-Za-z0-9\-]*$", trim( arguments.locale.code ) ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [#arguments.path#.code] [#arguments.locale.code#] must contain only letters, digits and hyphens"
			)
		}

		var dir = arguments.locale.dir ?: "ltr"
		if ( !listFindNoCase( "ltr,rtl", dir ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [#arguments.path#.dir], when present, must be one of: ltr, rtl"
			)
		}

		if ( arguments.locale.keyExists( "strings" ) && !isStruct( arguments.locale.strings ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [#arguments.path#.strings], when present, must be an object"
			)
		}

		if ( arguments.locale.keyExists( "flag" ) && !isSimpleValue( arguments.locale.flag ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "#variables.configFileName# [#arguments.path#.flag], when present, must be a string"
			)
		}
	}

	/**
	 * The theme names this module ships built-in support for (module spec section 6).
	 */
	array function getBuiltInThemes() {
		return variables.builtInThemes
	}

}
