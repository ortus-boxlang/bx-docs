/**
 * A generic `::: name attr="value" ...` ... `:::` container-block syntax -
 * the shared foundation for every GitBook-style block Flexmark has no
 * native concept of: expandable, cards/card, columns/column,
 * stepper/step, updates/update, file, embed, page-link, link-preview,
 * buttons/button, prompt, contact-form, for, if/elseif/else, and pagebreak (see each block's own `render*()` docblock below). Nests arbitrarily deep (a
 * `::: cards` block's own content is itself re-scanned for `::: card`
 * children, recursively) using the same two-phase pre/post-processing
 * shape as TabsProcessor.bx - `extract()` runs before `Markdown()`,
 * pulling every top-level directive out into a placeholder `<div>` (a
 * bare `<div ...></div>` on its own line is recognized by CommonMark as
 * an HTML block and passed through untouched); `restore()` runs after,
 * rendering each one's own markup (recursing into nested directives and
 * markdown alike) and swapping it back in for its placeholder.
 *
 * Syntax: `::: name` optionally followed by a leading `"Title"` and/or
 * `key="value"` attributes, e.g. `::: card title="Themes" href="themes.md"`.
 * A bare `:::` on its own line closes the innermost still-open block.
 *
 * `::: for item, index in data.products`, `::: if data.showBanner`
 * (optionally chained with sibling `::: elseif <path>`/a trailing bare
 * `::: else`), are a narrower family, deliberately grammared like `{{ }}`
 * itself (a bare dotted path, no comparison operators) rather than the
 * generic `key="value"` shape every other directive above uses - see
 * `renderFor()`/`collectIfChain()`/`renderIfChain()` below,
 * `protectLoopDirectives()`/`restoreLoopDirectives()` for how their own
 * bodies survive the page's single top-level `{{ }}` pass unresolved, and
 * `setLoopContext()` for the per-page wiring BuildPipeline.convertMarkdown()
 * does to make any of this work at all. Unlike every directive above, a
 * `::: if`/`::: elseif`/`::: else` chain needs only ONE trailing `:::`
 * for the whole chain, not one per branch - `extract()`'s own
 * `closeFrame()` treats `::: elseif`/`::: else` as an implicit close of
 * whatever `::: if`/`::: elseif` branch is still open, the same as a
 * real bare `:::` would (an explicit one still works too, if written).
 */
class {

	variables.openPattern = createObject( "java", "java.util.regex.Pattern" ).compile( "^:::\s*([a-zA-Z][\w-]*)\s*(.*)$" )
	variables.attrPattern = createObject( "java", "java.util.regex.Pattern" ).compile( '(\w+)="([^"]*)"' )
	variables.titlePattern = createObject( "java", "java.util.regex.Pattern" ).compile( '^"([^"]*)"\s*(.*)$' )
	variables.fileHrefPattern = createObject( "java", "java.util.regex.Pattern" ).compile( '(<a class="bxsites-file" href=")([^"]*)(")' )
	// `[^"]*` (not a literal `"bxsites-openapi"`) after the class name so
	// this still matches an `operation="..."` block's own extra
	// `bxsites-openapi--operation` class (renderOpenApi()'s own docblock).
	variables.openApiSrcPattern = createObject( "java", "java.util.regex.Pattern" ).compile( '(<div class="bxsites-openapi[^"]*" data-openapi-src=")([^"]*)("[^>]*>)' )
	variables.openApiOperationPattern = createObject( "java", "java.util.regex.Pattern" ).compile( "^(\S+)\s+(/\S*)$" )
	variables.forSpecPattern = createObject( "java", "java.util.regex.Pattern" ).compile( "^(\w+)\s*,\s*(\w+)\s+in\s+(.+)$" )
	// `::: contact-form`'s own `fields="name:type,..."` DSL - matched
	// against each comma-separated segment *after* parseContactFields()
	// strips a leading field's own trailing `*` (its own required marker),
	// so this pattern itself never needs an optional group (renderContactForm()'s
	// own docblock explains why that's deliberately avoided).
	variables.contactFieldPattern = createObject( "java", "java.util.regex.Pattern" ).compile( "^([\w-]+):(\w+)$" )
	// Matches a trailing bare `:::` at the end of a `::: name attrs...`
	// line's own attrs text (with at least one preceding whitespace char,
	// or nothing before it at all) - extract()'s own self-closing
	// single-line form, e.g. `::: file src="a.pdf" :::`.
	variables.selfClosePattern = createObject( "java", "java.util.regex.Pattern" ).compile( "(?:^|\s):::$" )
	variables.iconResolver = new "models.build.IconResolver@bxsites"()

	/**
	 * `::: for`'s own `itemName`/`indexName` binding - layered on top of
	 * `variables.loopPageVars` for `{{ }}` resolution inside the loop body -
	 * would otherwise silently shadow one of the two reserved keys
	 * `pageVars` always itself already carries (`page`/`data` -
	 * BuildPipeline.convertMarkdown()'s own docblock) rather than throwing a
	 * clear error the way a `functions.bxs` name collision already does
	 * (FunctionsLoader.bx's own `reservedNames`). A narrower,
	 * `{{ }}`-scoped concern than that list (which guards a magic
	 * function's own bare-BoxLang-scope names instead), so kept as its own
	 * short list here rather than sharing FunctionsLoader.bx's.
	 */
	variables.reservedLoopNames = [ "page", "data" ]

	/**
	 * `::: for`/`::: if`/`::: elseif`/`::: else`'s own per-page context -
	 * the `VariablesProcessor` instance plus the same
	 * `pageVars`/`functions`/`functionContext` `BuildPipeline.convertMarkdown()`
	 * already builds for the page's own top-level `{{ }}` pass - needed so
	 * `renderFor()`/`renderIfChain()` below can resolve `{{ }}` inside a
	 * loop/conditional body themselves, once per iteration (`renderFor()`)
	 * or once for whichever branch wins (`renderIfChain()`), rather than
	 * relying on that single top-level pass (which runs *before* these
	 * directives' own placeholders are even unprotected - see
	 * `protectLoopDirectives()`). Set once per page by `setLoopContext()`
	 * (called right before BuildPipeline.convertMarkdown()'s own real
	 * `extract()` call); this class is a long-lived singleton reused
	 * across every page/rebuild (the same shape FunctionsLoader.bx's own
	 * docblock already discusses), but `extract()`+`restore()` always run
	 * back-to-back for one page before the next page's own `setLoopContext()`
	 * call overwrites these, so no cross-page leakage - and `renderFor()`
	 * itself saves/restores `variables.loopPageVars` around each of its own
	 * recursive per-iteration renders, so a nested `::: for`'s own inner
	 * scope never leaks into a sibling block rendered afterward on the same
	 * page either.
	 */
	variables.loopVariablesProcessor = ""
	variables.loopPageVars = {}
	variables.loopFunctions = {}
	variables.loopFunctionContext = {}

	/**
	 * Wires this page's own `{{ }}` resolution context into `renderFor()`/
	 * `renderIfChain()` - see `variables.loopVariablesProcessor`'s own
	 * docblock for why this is a setter rather than a constructor/`extract()`
	 * param.
	 *
	 * @variablesProcessor A VariablesProcessor.bx instance (its own `resolve()`/`lookupValue()`)
	 * @pageVars Same shape BuildPipeline.convertMarkdown()'s own `pageVars` local is - the page's own `variables` (config-wide) plus `page`/`data`
	 * @functions FunctionsLoader.load()'s own output, forwarded to `resolve()` unchanged
	 * @functionContext The "supporting variables" struct `resolve()` binds into a magic function's own body, forwarded unchanged
	 */
	void function setLoopContext( required any variablesProcessor, required struct pageVars, required struct functions, required struct functionContext ) {
		variables.loopVariablesProcessor = arguments.variablesProcessor
		variables.loopPageVars = arguments.pageVars
		variables.loopFunctions = arguments.functions
		variables.loopFunctionContext = arguments.functionContext
	}

	/**
	 * `::: step`'s own `color` attribute (renderStepper() below) - the
	 * semantic marker palettes each built-in theme defines as
	 * `--bxsites-step-<color>-bg`/`-text` CSS custom properties (see
	 * docs/guides/themes.md). Unset/unrecognized falls back to the default
	 * unstyled marker, same as an unset/unrecognized `icon` falls back to
	 * no icon - a typo never breaks the build, it just doesn't color the step.
	 */
	variables.stepColors = "success,warning,danger"

	/**
	 * Pulls every top-level `::: name ... :::` directive block out of the
	 * raw markdown and replaces it with a lone placeholder `<div>` on its
	 * own line. A directive nested inside another (e.g. `::: card` inside
	 * `::: cards`) is left as literal `:::`-fenced text within its
	 * parent's own captured content, to be found again by that parent's
	 * own render function via a fresh `extract()` call - see `restore()`.
	 *
	 * A `::: elseif`/`::: else` immediately following an already-open
	 * `::: if`/`::: elseif` implicitly closes that *previous* branch first
	 * (closeFrame() below), the same way a real bare `:::` would - so a
	 * whole `::: if` / `::: elseif` / `::: else` chain only ever needs ONE
	 * trailing `:::`, not one per branch:
	 *
	 *   ::: if a
	 *   A
	 *   ::: elseif b
	 *   B
	 *   ::: else
	 *   C
	 *   :::
	 *
	 * The old, fully-explicit form (a `:::` before every `::: elseif`/
	 * `::: else` too) still works exactly as it always has - this only
	 * ever fires when the previous branch is still open, so an explicit
	 * close just means there's nothing left for it to implicitly do.
	 * Either way, every branch still becomes its own `blocks` entry, same
	 * `{ token, type, attrsRaw, content }` shape as any other directive -
	 * `collectIfChain()`/`renderIfChain()` (which group and evaluate them)
	 * never need to know which form a project actually wrote.
	 *
	 * @markdown The raw markdown body text
	 *
	 * @return { markdown: string with top-level directives replaced by placeholders, blocks: array of { token, type, attrsRaw, content } }
	 */
	struct function extract( required string markdown ) {
		var normalized = arguments.markdown.reReplace( char( 13 ) & char( 10 ), char( 10 ), "all" )
		var lines = listToArray( normalized, char( 10 ), true )
		var outputLines = []
		var blocks = []
		var stack = []
		var tracker = new "models.build.FenceTracker@bxsites"()

		for ( var line in lines ) {
			var trimmedLine = trim( line )

			// A `:::` line shown inside a fenced code example (e.g. this very
			// guide, demonstrating the syntax) is literal fence content, not
			// a real directive marker - see FenceTracker.bx.
			if ( tracker.consume( line ) ) {
				if ( stack.len() ) {
					stack[ stack.len() ].lines.append( line )
				} else {
					outputLines.append( line )
				}
				continue
			}

			if ( trimmedLine == ":::" ) {
				if ( !stack.len() ) {
					outputLines.append( line )
					continue
				}
				closeFrame( stack, blocks, outputLines )
				continue
			}

			var matcher = variables.openPattern.matcher( trimmedLine )
			if ( matcher.matches() ) {
				var newType = matcher.group( 1 )
				var newAttrsRaw = trim( matcher.group( 2 ) )
				if (
					stack.len()
					&& listFindNoCase( "elseif,else", trim( newType ) )
					&& listFindNoCase( "if,elseif", trim( stack[ stack.len() ].type ) )
				) {
					closeFrame( stack, blocks, outputLines )
				}

				// A trailing bare `:::` on the SAME line self-closes a
				// directive with no body of its own on the spot - most of
				// this file's own directives (file, embed, page-link,
				// link-preview, button, openapi, audience-switcher,
				// pagebreak) never use `content` at all, so writing
				// `::: file src="..." :::` on one line, with no separate
				// closing line, works exactly the same as the two-line
				// form (still fully supported, e.g. when a body IS
				// needed - expandable, cards, stepper, ...).
				var selfCloseMatcher = variables.selfClosePattern.matcher( newAttrsRaw )
				var selfClosing = selfCloseMatcher.find()
				if ( selfClosing ) {
					newAttrsRaw = selfCloseMatcher.start() == 0
						? ""
						: trim( newAttrsRaw.left( selfCloseMatcher.start() ) )
				}

				stack.append( { type : newType, attrsRaw : newAttrsRaw, lines : [] } )
				if ( selfClosing ) {
					closeFrame( stack, blocks, outputLines )
				}
				continue
			}

			if ( stack.len() ) {
				stack[ stack.len() ].lines.append( line )
			} else {
				outputLines.append( line )
			}
		}

		// Any directive left unclosed at EOF is flushed as if closed here,
		// rather than silently dropping its content - a typo'd or missing
		// closing `:::` shouldn't eat the rest of the page.
		while ( stack.len() ) {
			var frame = stack[ stack.len() ]
			stack.deleteAt( stack.len() )
			var content = frame.lines.toList( char( 10 ) )
			if ( !stack.len() ) {
				var token = "bxsitesdirective" & replace( createUUID(), "-", "", "all" )
				blocks.append( { token : token, type : frame.type, attrsRaw : frame.attrsRaw, content : content } )
				outputLines.append( "" )
				outputLines.append( '<div class="bxsites-raw-block" data-bxsites-token="' & token & '"></div>' )
				outputLines.append( "" )
			} else {
				var parent = stack[ stack.len() ]
				parent.lines.append( "::: " & frame.type & " " & frame.attrsRaw )
				parent.lines.append( content )
			}
		}

		return { markdown : outputLines.toList( char( 10 ) ), blocks : blocks }
	}

	/**
	 * Finalizes the innermost currently-open stack frame - extract()'s own
	 * shared closing logic, called both for a real bare `:::` line and for
	 * an implicit `::: elseif`/`::: else` continuation (extract()'s own
	 * docblock explains why the latter needs this too). A top-level frame
	 * becomes its own `blocks` entry, placeholder spliced into
	 * `outputLines`; a nested one is folded back into its own parent
	 * frame's `lines` as literal `::: type attrs` ... `:::` source text,
	 * to be found again by a fresh `extract()` call later (this class's
	 * own docblock).
	 *
	 * @stack extract()'s own open-frame stack (mutated - the top frame is popped)
	 * @blocks extract()'s own top-level blocks array (mutated when the popped frame was itself top-level)
	 * @outputLines extract()'s own output lines array (mutated the same way)
	 */
	private void function closeFrame( required array stack, required array blocks, required array outputLines ) {
		var frame = arguments.stack[ arguments.stack.len() ]
		arguments.stack.deleteAt( arguments.stack.len() )
		var content = frame.lines.toList( char( 10 ) )

		if ( !arguments.stack.len() ) {
			var token = "bxsitesdirective" & replace( createUUID(), "-", "", "all" )
			arguments.blocks.append( { token : token, type : frame.type, attrsRaw : frame.attrsRaw, content : content } )
			arguments.outputLines.append( "" )
			arguments.outputLines.append( '<div class="bxsites-raw-block" data-bxsites-token="' & token & '"></div>' )
			arguments.outputLines.append( "" )
		} else {
			var parent = arguments.stack[ arguments.stack.len() ]
			parent.lines.append( "::: " & frame.type & " " & frame.attrsRaw )
			parent.lines.append( content )
			parent.lines.append( ":::" )
		}
	}

	/**
	 * Renders every top-level block from `extract()` and swaps each one's
	 * placeholder for its final markup.
	 *
	 * @html Already-rendered HTML (from Markdown() on extract()'s output)
	 * @blocks extract()'s own `blocks` array
	 * @renderer Any object exposing `toHtml( markdown, options = {} )`, used to render markdown found inside a block (and, recursively, inside its own nested directives)
	 * @markdownOptions Passthrough options forwarded to the renderer, same as the surrounding page
	 *
	 * @return html with every directive placeholder swapped for its rendered markup
	 */
	string function restore( required string html, required array blocks, required any renderer, struct markdownOptions = {} ) {
		var result = arguments.html
		var i = 1
		while ( i <= arguments.blocks.len() ) {
			var block = arguments.blocks[ i ]

			// `::: if`/`::: elseif`/`::: else` are a linked chain, not
			// independent blocks - collectIfChain() below groups an `if`
			// with whatever `elseif`/`else` siblings immediately follow it
			// in this same array, so only the one branch that actually wins
			// (or none) ever renders; every other placeholder in the chain
			// resolves to "". An `elseif`/`else` reached here on its own
			// (never true for a well-formed chain, since this loop always
			// consumes them as part of their leading `if`) is an orphan -
			// renderBlock()'s own switch reports it as invalid.
			if ( lCase( trim( block.type ) ) == "if" ) {
				var chain = collectIfChain( arguments.blocks, i )
				var outcome = renderIfChain( chain.blocks, arguments.renderer, arguments.markdownOptions )
				for ( var chainBlock in chain.blocks ) {
					var chainPlaceholder = '<div class="bxsites-raw-block" data-bxsites-token="' & chainBlock.token & '"></div>'
					result = result.replace( chainPlaceholder, chainBlock.token == outcome.winnerToken ? outcome.html : "", "one" )
				}
				i = chain.nextIndex
				continue
			}

			var placeholder = '<div class="bxsites-raw-block" data-bxsites-token="' & block.token & '"></div>'
			result = result.replace( placeholder, renderBlock( block, arguments.renderer, arguments.markdownOptions ), "one" )
			i++
		}
		return result
	}

	/**
	 * Groups `blocks[startIndex]` (a `::: if` block) with whatever
	 * `::: elseif` blocks immediately follow it in the same sibling array,
	 * plus one trailing `::: else` if present - the run stops at the first
	 * block that's neither (or at end of array), so a chain is always
	 * contiguous: no other directive can sit between an `if` and its own
	 * `elseif`/`else` without breaking the chain there.
	 *
	 * @blocks The sibling blocks array `restore()` is walking (top-level, or one block's own nested children)
	 * @startIndex 1-based index of the `::: if` block starting this chain
	 *
	 * @return { blocks: this chain's own blocks in source order, nextIndex: the index restore()'s own scan should resume from }
	 */
	private struct function collectIfChain( required array blocks, required numeric startIndex ) {
		var chain = [ arguments.blocks[ arguments.startIndex ] ]
		var i = arguments.startIndex + 1

		while ( i <= arguments.blocks.len() && lCase( trim( arguments.blocks[ i ].type ) ) == "elseif" ) {
			chain.append( arguments.blocks[ i ] )
			i++
		}
		if ( i <= arguments.blocks.len() && lCase( trim( arguments.blocks[ i ].type ) ) == "else" ) {
			chain.append( arguments.blocks[ i ] )
			i++
		}

		return { blocks : chain, nextIndex : i }
	}

	/**
	 * Renders one `::: if`/`::: elseif`/`::: else` chain with real
	 * `if`/`elseif`/`else` semantics: each condition (`if`, then every
	 * `elseif`, in source order) is resolved and checked for truthiness,
	 * stopping at the first match - a later branch's own condition is
	 * never even looked up, so a typo'd `elseif` path only ever fails the
	 * build when its own branch is actually reached, the same
	 * short-circuiting a real `if`/`elseif` chain has. A trailing
	 * `::: else`, if present, always wins when nothing above it matched.
	 * No branch matches and there's no `::: else` -> renders nothing, the
	 * same as a standalone `::: if`'s own falsy case.
	 *
	 * @chain collectIfChain()'s own `blocks` - one `::: if`, zero or more `::: elseif`, an optional trailing `::: else`
	 *
	 * @return { html: this chain's own rendered output, winnerToken: the token of the chain block that won, or "" when none did }
	 */
	private struct function renderIfChain( required array chain, required any renderer, required struct markdownOptions ) {
		for ( var block in arguments.chain ) {
			var type = lCase( trim( block.type ) )

			if ( type == "else" ) {
				if ( len( trim( block.attrsRaw ) ) ) {
					return { html : '<div class="bxsites-directive-invalid">::: else - takes no condition (did you mean ::: elseif?)</div>', winnerToken : block.token }
				}
				return { html : renderWithVars( block.content, variables.loopPageVars, arguments.renderer, arguments.markdownOptions ), winnerToken : block.token }
			}

			var path = trim( block.attrsRaw )
			if ( !len( path ) ) {
				return { html : '<div class="bxsites-directive-invalid">::: ' & type & ' - missing a dotted.path condition</div>', winnerToken : block.token }
			}
			if ( !isObject( variables.loopVariablesProcessor ) ) {
				return { html : '<div class="bxsites-directive-invalid">::: ' & type & ' - no data context available to resolve "' & encodeForHTML( path ) & '"</div>', winnerToken : block.token }
			}

			var lookup = variables.loopVariablesProcessor.lookupValue( path, variables.loopPageVars )
			if ( !lookup.found ) {
				throw(
					type    : "BxSites.UnknownVariable",
					message : "::: #type# #path# - no [#path#] entry found"
				)
			}

			if ( isTruthy( lookup.value ) ) {
				return { html : renderWithVars( block.content, variables.loopPageVars, arguments.renderer, arguments.markdownOptions ), winnerToken : block.token }
			}
		}

		return { html : "", winnerToken : "" }
	}

	/**
	 * A pre-pass BuildPipeline.convertMarkdown() runs *before* the page's
	 * own single top-level `{{ }}` pass (VariablesProcessor.resolve()) -
	 * shields every `::: for`/`::: if` block's own raw content, at any
	 * nesting depth, from that pass, the same way FenceTracker.bx shields a
	 * fenced code block's own `{{ }}`-looking text from it. A
	 * `::: for item, idx in data.products` body's own `{{ item.name }}`
	 * doesn't refer to a page-wide variable at all - `item`/`idx` don't
	 * exist until `renderFor()` below binds them, once per iteration, so
	 * the token would otherwise fail the top pass's own "recognized shape,
	 * unresolved" check (VariablesProcessor.resolveExpression()'s own
	 * `BxSites.UnknownVariable` throw) long before `renderFor()` ever gets
	 * a chance to bind it.
	 *
	 * Every *other* directive type is deliberately left alone -
	 * reconstructed back to its own literal `::: type ...` source right
	 * where its placeholder was (recursing into its own content first, so a
	 * `::: for` nested inside e.g. `::: cards` is still found and
	 * protected) - preserving today's existing behavior of `{{ }}`
	 * resolving normally inside every non-loop block's own body, exactly as
	 * if this pre-pass had never run for them at all.
	 *
	 * @markdown Raw markdown text (a whole page, or - recursively - one block's own nested content)
	 *
	 * @return { markdown: string with only for/if blocks still placeholder-protected, placeholders: struct keyed by token -> that block's own reconstructed `::: type ...` source, restored after the top `{{ }}` pass by restoreLoopDirectives() }
	 */
	struct function protectLoopDirectives( required string markdown ) {
		var extracted = this.extract( arguments.markdown )
		var rebuilt = extracted.markdown
		var placeholders = {}

		for ( var block in extracted.blocks ) {
			var placeholder = '<div class="bxsites-raw-block" data-bxsites-token="' & block.token & '"></div>'
			var innerProtected = protectLoopDirectives( block.content )
			structAppend( placeholders, innerProtected.placeholders, true )
			var source = directiveSource( block.type, block.attrsRaw, innerProtected.markdown )

			if ( isLoopDirectiveType( block.type ) ) {
				// Placeholder itself stays untouched in `rebuilt` here -
				// still protected from the top `{{ }}` pass, restored later
				// by restoreLoopDirectives().
				placeholders[ block.token ] = source
			} else {
				rebuilt = rebuilt.replace( placeholder, source, "one" )
			}
		}

		return { markdown : rebuilt, placeholders : placeholders }
	}

	/**
	 * Swaps every `::: for`/`::: if` placeholder `protectLoopDirectives()`
	 * left in place back to that block's own real `::: type ...` source
	 * text - called right after the page's own top-level `{{ }}` pass, so
	 * the standard `extract()` call BuildPipeline.convertMarkdown() already
	 * makes right after that pass discovers these blocks completely fresh,
	 * same as any other directive. Loops to a fixed point (rather than one
	 * flat pass) since an outer loop block's own reconstructed source can
	 * itself still contain an inner loop block's own placeholder (nested
	 * `::: for`/`::: if`) - a single pass in the "wrong" struct-iteration
	 * order would restore the inner one before the outer placeholder
	 * carrying it even exists in `result` yet.
	 *
	 * @markdown The top-level `{{ }}`-resolved markdown, still carrying loop placeholders
	 * @placeholders protectLoopDirectives()'s own `placeholders` output
	 */
	string function restoreLoopDirectives( required string markdown, required struct placeholders ) {
		var result = arguments.markdown
		var changed = true
		while ( changed ) {
			changed = false
			for ( var token in arguments.placeholders ) {
				var placeholder = '<div class="bxsites-raw-block" data-bxsites-token="' & token & '"></div>'
				if ( result.find( placeholder ) ) {
					result = result.replace( placeholder, arguments.placeholders[ token ], "one" )
					changed = true
				}
			}
		}
		return result
	}

	/**
	 * @return true for the data-driven directive types protectLoopDirectives() shields from the page's own top-level `{{ }}` pass - `for`, and the `if`/`elseif`/`else` chain family
	 */
	private boolean function isLoopDirectiveType( required string type ) {
		return listFindNoCase( "for,if,elseif,else", trim( arguments.type ) ) > 0
	}

	/**
	 * Reconstructs one block's own literal `::: type attrsRaw` ... `:::`
	 * source text - the inverse of extract()'s own parsing, used by
	 * protectLoopDirectives() to put a non-loop block back exactly as
	 * authored (so the top `{{ }}` pass sees it untouched) and to build a
	 * loop block's own protected replacement text.
	 */
	private string function directiveSource( required string type, required string attrsRaw, required string content ) {
		var header = "::: " & trim( arguments.type ) & ( len( trim( arguments.attrsRaw ) ) ? " " & arguments.attrsRaw : "" )
		return header & char( 10 ) & arguments.content & char( 10 ) & ":::"
	}

	/**
	 * Runs `markdown` through the full extract -> Markdown() -> restore()
	 * cycle - the same shape `BuildPipeline.convertMarkdown()` applies to
	 * a whole page, applied here to a single block's own inner content, so
	 * a block nested inside another (or ordinary markdown inside a leaf
	 * block, e.g. an expandable's body) gets identical treatment to the
	 * page itself: nested directives, code fences, admonitions, all of it.
	 *
	 * @markdown Raw markdown text (a block's own `content`)
	 * @renderer Any object exposing `toHtml( markdown, options = {} )`
	 * @markdownOptions Passthrough options forwarded to the renderer
	 */
	private string function renderNested( required string markdown, required any renderer, required struct markdownOptions ) {
		var extracted = this.extract( arguments.markdown )
		var html = arguments.renderer.toHtml( extracted.markdown, arguments.markdownOptions )
		return this.restore( html, extracted.blocks, arguments.renderer, arguments.markdownOptions )
	}

	/**
	 * Dispatches one block to its type's own renderer. An unrecognized
	 * `type` falls back to rendering its content as plain markdown inside
	 * a neutral wrapper, rather than silently dropping it - a typo'd
	 * directive name should still show its content.
	 *
	 * @block One entry from extract()'s own `blocks` array (or a nested child, same shape)
	 */
	private string function renderBlock( required struct block, required any renderer, required struct markdownOptions ) {
		var attrs = parseAttrs( block.attrsRaw )
		switch ( lCase( trim( block.type ) ) ) {
			case "expandable":
				return renderExpandable( block, attrs, renderer, markdownOptions )
			case "cards":
				return renderCards( block, renderer, markdownOptions )
			case "columns":
				return renderColumns( block, renderer, markdownOptions )
			case "stepper":
				return renderStepper( block, renderer, markdownOptions )
			case "updates":
				return renderUpdates( block, renderer, markdownOptions )
			case "file":
				return renderFile( attrs )
			case "button":
				return renderButton( attrs )
			case "buttons":
				return renderButtons( block, renderer, markdownOptions )
			case "openapi":
				return renderOpenApi( attrs )
			case "embed":
				return renderEmbed( attrs )
			case "page-link":
				return renderPageLinkStub( attrs )
			case "link-preview":
				return renderLinkPreview( attrs )
			case "contact-form":
				return renderContactForm( attrs )
			case "prompt":
				return renderPrompt( block, attrs, renderer, markdownOptions )
			case "conditional":
				return renderConditional( block, attrs, renderer, markdownOptions )
			case "audience-switcher":
				return renderAudienceSwitcher( attrs )
			case "pagebreak":
				return renderPagebreak()
			case "for":
				return renderFor( block, renderer, markdownOptions )
			case "course":
				return renderCourseIndexStub( attrs )
			case "if":
				// restore()'s own scan always consumes a well-formed `if`
				// as part of a chain (collectIfChain()) before renderBlock()
				// is ever called for it - reached here only if renderBlock()
				// is invoked directly on a lone block, so treat it as its
				// own one-block chain instead of duplicating that logic.
				return renderIfChain( [ block ], renderer, markdownOptions ).html
			case "elseif":
				return '<div class="bxsites-directive-invalid">::: elseif - must directly follow a ::: if (with only ::: elseif in between)</div>'
			case "else":
				return '<div class="bxsites-directive-invalid">::: else - must directly follow a ::: if or ::: elseif</div>'
			default:
				return '<div class="bxsites-directive-unknown">' & renderNested( block.content, renderer, markdownOptions ) & '</div>'
		}
	}

	/**
	 * Parses a directive's `attrsRaw` (everything after its type name) -
	 * an optional leading `"Title"` shorthand becomes `attrs.title`,
	 * followed by any number of `key="value"` pairs.
	 *
	 * @attrsRaw The raw attribute text, e.g. `"Themes" href="themes.md"`
	 */
	private struct function parseAttrs( required string attrsRaw ) {
		var rest = arguments.attrsRaw
		var attrs = {}

		var titleMatcher = variables.titlePattern.matcher( trim( rest ) )
		if ( titleMatcher.matches() ) {
			attrs.title = titleMatcher.group( 1 )
			rest = titleMatcher.group( 2 )
		}

		var matcher = variables.attrPattern.matcher( rest )
		while ( matcher.find() ) {
			attrs[ matcher.group( 1 ) ] = matcher.group( 2 )
		}

		return attrs
	}

	/**
	 * A minimal, attribute-value-safe escape for an `href`/`src` value that
	 * must stay literally path-parseable downstream - `encodeForHTML()`
	 * also entity-escapes "safe" characters like `/` (its exact range is
	 * locale/JVM-dependent), which would silently break
	 * MarkdownLinkResolver.bx's later `.md`-relative-link resolution (it
	 * re-parses this same href text as a literal file path) and
	 * PageLinkResolver.bx's later href-to-page lookup. Only `&`/`"`/`<` -
	 * the characters that actually matter inside a double-quoted HTML
	 * attribute - are escaped.
	 */
	private string function attrEscape( required string value ) {
		return arguments.value.replace( "&", "&amp;", "all" ).replace( '"', "&quot;", "all" ).replace( "<", "&lt;", "all" )
	}

	/**
	 * `::: expandable "Title"` - a plain collapsible `<details>` section,
	 * with none of an admonition's callout type/color/icon. Add `open`
	 * (bare, e.g. `::: expandable "Title" open="true"`) to start expanded.
	 */
	private string function renderExpandable( required struct block, required struct attrs, required any renderer, required struct markdownOptions ) {
		var title = trim( arguments.attrs.title ?: "" )
		var openAttr = ( arguments.attrs.open ?: "" ) == "true" ? " open" : ""
		return '<details class="bxsites-expandable"' & openAttr & '><summary>' & encodeForHTML( title )
			& '</summary><div class="bxsites-expandable__body">' & renderNested( arguments.block.content, arguments.renderer, arguments.markdownOptions )
			& '</div></details>'
	}

	/**
	 * `::: conditional key="plan" value="pro"` ... `:::` - shows this block
	 * only to a reader whose own stored preference for `key` matches
	 * `value`, e.g. a tutorial showing "pro"-only instructions inline
	 * without sending the reader to a separate page. Unlike GitBook's own
	 * adaptive content (server-evaluated visitor claims/cookies - this
	 * module has no server, no visitor identity at all), the "preference"
	 * here is purely reader-chosen and stored in their own browser
	 * (`localStorage`, via `conditional-content-init.js`'s own
	 * `window.bxSitesSetPreference( key, value )`) - a project wires that up
	 * however it likes (its own theme override, a `::: audience-switcher`
	 * block, a link with `?plan=pro` - `conditional-content-init.js` also
	 * reads the URL's own query string once on load and stores whatever it
	 * finds there). Every variant renders in the HTML regardless - hidden
	 * client-side, not omitted - so a reader with JS disabled (or a search
	 * crawler) still sees every variant rather than none.
	 *
	 * @required key The preference name this block is keyed on, e.g. "plan"
	 * @required value The one value of `key` this block should show for, e.g. "pro"
	 */
	private string function renderConditional( required struct block, required struct attrs, required any renderer, required struct markdownOptions ) {
		var key = trim( arguments.attrs.key ?: "" )
		var value = trim( arguments.attrs.value ?: "" )
		if ( !len( key ) || !len( value ) ) {
			return '<div class="bxsites-conditional bxsites-conditional--invalid">::: conditional - requires both key="..." and value="..."</div>'
		}
		return '<div class="bxsites-conditional" data-bxsites-key="' & attrEscape( key ) & '" data-bxsites-value="' & attrEscape( value ) & '">'
			& renderNested( arguments.block.content, arguments.renderer, arguments.markdownOptions )
			& '</div>'
	}

	/**
	 * `::: for item, index in data.products` ... `:::` - a real, native
	 * BoxLang `for( a, b in collection )` over whatever `data.products`
	 * resolves to (docs/guides/data-files.md's "Consuming data" section) -
	 * the *same* two-variable syntax BoxLang itself uses for both an array
	 * (item + 1-based index) and a struct (key + value), so this one
	 * directive/one `renderFor()` handles both with no array-vs-struct
	 * special-casing here either - BoxLang's own runtime already dispatches
	 * on the resolved value's real type. Deliberately dotted-path only, no
	 * comparison/filter expressions - the same narrow grammar `{{ }}`
	 * itself already uses.
	 *
	 * The loop body's own `{{ }}` tokens (e.g. `{{ item.name }}`) are
	 * resolved fresh on every iteration (renderWithVars() below), layered
	 * on top of the page's own `variables.loopPageVars` - never by the
	 * page's own single top-level `{{ }}` pass, which never even sees them
	 * unresolved in the first place (protectLoopDirectives()'s own
	 * docblock) specifically so a loop variable's own reference doesn't
	 * fail there as an unknown variable before this method ever runs.
	 */
	private string function renderFor( required struct block, required any renderer, required struct markdownOptions ) {
		var spec = parseForSpec( arguments.block.attrsRaw )
		if ( isNull( spec ) ) {
			return '<div class="bxsites-directive-invalid">::: for - expected "item, index in dotted.path", got "' & encodeForHTML( arguments.block.attrsRaw ) & '"</div>'
		}

		var guardError = loopNameGuardError( [ spec.itemName, spec.indexName ] )
		if ( len( guardError ) ) {
			return '<div class="bxsites-directive-invalid">::: for - ' & encodeForHTML( guardError ) & '</div>'
		}

		if ( !isObject( variables.loopVariablesProcessor ) ) {
			return '<div class="bxsites-directive-invalid">::: for - no data context available to resolve "' & encodeForHTML( spec.path ) & '"</div>'
		}

		var lookup = variables.loopVariablesProcessor.lookupValue( spec.path, variables.loopPageVars )
		if ( !lookup.found ) {
			throw(
				type    : "BxSites.UnknownVariable",
				message : "::: for #arguments.block.attrsRaw# - no [#spec.path#] entry found"
			)
		}
		if ( !isArray( lookup.value ) && !isStruct( lookup.value ) ) {
			throw(
				type    : "BxSites.InvalidForTarget",
				message : "::: for #arguments.block.attrsRaw# - [#spec.path#] is neither an array nor a struct"
			)
		}

		var html = ""
		for ( loopItem, loopIndex in lookup.value ) {
			var iterVars = duplicate( variables.loopPageVars )
			iterVars[ spec.itemName ] = loopItem
			iterVars[ spec.indexName ] = loopIndex
			html &= renderWithVars( arguments.block.content, iterVars, arguments.renderer, arguments.markdownOptions )
		}
		return html
	}

	/**
	 * @spec `::: for`'s own raw attrsRaw text, e.g. "item, idx in data.products"
	 *
	 * @return { itemName, indexName, path } or null when it doesn't match "a, b in dotted.path"
	 */
	private any function parseForSpec( required string spec ) {
		var matcher = variables.forSpecPattern.matcher( trim( arguments.spec ) )
		if ( !matcher.matches() ) {
			return
		}
		return { itemName : matcher.group( 1 ), indexName : matcher.group( 2 ), path : trim( matcher.group( 3 ) ) }
	}

	/**
	 * @return "" when every name in `names` is safe to bind, otherwise a message naming the first reserved collision (variables.reservedLoopNames)
	 */
	private string function loopNameGuardError( required array names ) {
		for ( var name in arguments.names ) {
			if ( listFindNoCase( arrayToList( variables.reservedLoopNames ), name ) ) {
				return 'loop variable name "' & name & '" is reserved - pick a different name'
			}
		}
		return ""
	}

	/**
	 * @return false for an empty array/struct/string or `0`, true otherwise - a project author's own intuitive notion of "is this data present/on", not BoxLang's own stricter boolean coercion
	 */
	private boolean function isTruthy( required any value ) {
		if ( isArray( arguments.value ) ) {
			return arguments.value.len() > 0
		}
		if ( isStruct( arguments.value ) ) {
			return !arguments.value.isEmpty()
		}
		if ( isBoolean( arguments.value ) ) {
			return arguments.value
		}
		if ( isNumeric( arguments.value ) ) {
			return arguments.value != 0
		}
		return len( trim( "" & arguments.value ) ) > 0
	}

	/**
	 * Resolves `{{ }}` in `content` against `vars` - `renderFor()`'s own
	 * per-iteration `iterVars`, or `renderIfChain()`'s unmodified
	 * `variables.loopPageVars` - then runs the result through the same
	 * extract -> Markdown() -> restore() cycle `renderNested()` already
	 * uses for every other block type, so a `::: for`/`::: if` body can
	 * itself contain ordinary markdown, other nested directives, and even
	 * another `::: for`/`::: if` alike (this class's own docblock, "Nests
	 * arbitrarily deep").
	 *
	 * `content` is run through `protectLoopDirectives()`/`restoreLoopDirectives()`
	 * around the `{{ }}` resolve() call below, the exact same way
	 * BuildPipeline.convertMarkdown() already shields the *page's* own
	 * top-level pass - without it, a `::: for`/`::: if` nested *inside*
	 * this branch's own body would have its own `{{ }}` tokens (referencing
	 * a loop variable that doesn't exist yet at this outer level either)
	 * swept up and resolved against `vars` right here, before that inner
	 * directive's own `renderFor()`/`renderIfChain()` call ever gets a
	 * chance to bind them.
	 *
	 * `variables.loopPageVars` is saved and restored around this call
	 * (rather than just overwritten) so a nested `::: for`'s own inner
	 * scope - discovered by the recursive `this.extract()` call inside
	 * `renderNested()` below - never leaks into a sibling block rendered
	 * afterward on the same page (variables.loopVariablesProcessor's own
	 * docblock).
	 */
	private string function renderWithVars( required string content, required struct vars, required any renderer, required struct markdownOptions ) {
		var loopProtected = protectLoopDirectives( arguments.content )
		var resolvedMarkdown = variables.loopVariablesProcessor.resolve(
			loopProtected.markdown, arguments.vars, variables.loopFunctions, "", variables.loopFunctionContext
		)
		resolvedMarkdown = restoreLoopDirectives( resolvedMarkdown, loopProtected.placeholders )

		var savedPageVars = variables.loopPageVars
		variables.loopPageVars = arguments.vars
		var html = renderNested( resolvedMarkdown, arguments.renderer, arguments.markdownOptions )
		variables.loopPageVars = savedPageVars

		return html
	}

	/**
	 * `::: audience-switcher key="plan" options="free:Free,pro:Pro"` - an
	 * optional, ready-made reader control for `::: conditional`'s own `key`:
	 * one button per `value:Label` pair in `options`, calling
	 * `window.bxSitesSetPreference( key, value )` on click
	 * (`conditional-content-init.js`) so every `::: conditional key="plan"`
	 * block on the page updates immediately, and the choice is remembered
	 * on every later page too. Entirely optional - a project can just as
	 * well drive `bxSitesSetPreference()` from its own theme override
	 * instead.
	 *
	 * @required key The preference name to switch, matching `::: conditional`'s own `key`
	 * @required options Comma-separated `value:Label` pairs, e.g. "free:Free,pro:Pro"
	 */
	private string function renderAudienceSwitcher( required struct attrs ) {
		var key = trim( arguments.attrs.key ?: "" )
		var optionsRaw = trim( arguments.attrs.options ?: "" )
		if ( !len( key ) || !len( optionsRaw ) ) {
			return '<div class="bxsites-audience-switcher bxsites-audience-switcher--invalid">::: audience-switcher - requires both key="..." and options="value:Label,..."</div>'
		}

		var buttons = ""
		for ( var pair in listToArray( optionsRaw, "," ) ) {
			var value = trim( listFirst( pair, ":" ) )
			var label = listLen( pair, ":" ) > 1 ? trim( listRest( pair, ":" ) ) : value
			if ( !len( value ) ) {
				continue
			}
			buttons &= '<button type="button" class="bxsites-audience-switcher__option" data-bxsites-value="' & attrEscape( value ) & '">' & encodeForHTML( label ) & '</button>'
		}

		return '<div class="bxsites-audience-switcher" data-bxsites-key="' & attrEscape( key ) & '">' & buttons & '</div>'
	}

	/**
	 * `::: cards` containing `::: card title="..." icon="..." href="..." image="..."`
	 * children - a responsive grid of link cards. A card with no `href`
	 * renders as a plain (non-clickable) card. `icon` is resolved the same
	 * way frontmatter/nav `icon` values are (IconResolver.bx) - a plain
	 * emoji, or a named icon (`icon="phosphor-duotone:rocket-launch"`).
	 */
	private string function renderCards( required struct block, required any renderer, required struct markdownOptions ) {
		var children = this.extract( arguments.block.content ).blocks
		var html = '<div class="bxsites-cards">'

		for ( var child in children ) {
			var attrs = parseAttrs( child.attrsRaw )
			var href = trim( attrs.href ?: "" )
			var tag = len( href ) ? "a" : "div"
			var hrefAttr = len( href ) ? ' href="' & attrEscape( href ) & '"' : ""

			html &= "<" & tag & ' class="bxsites-card"' & hrefAttr & ">"
			if ( len( trim( attrs.image ?: "" ) ) ) {
				html &= '<img class="bxsites-card__image" src="' & attrEscape( attrs.image ) & '" alt="">'
			} else if ( len( trim( attrs.icon ?: "" ) ) ) {
				html &= '<div class="bxsites-card__icon">' & variables.iconResolver.resolve( attrs.icon ) & '</div>'
			}
			if ( len( trim( attrs.title ?: "" ) ) ) {
				html &= '<div class="bxsites-card__title">' & encodeForHTML( attrs.title ) & '</div>'
			}
			if ( len( trim( child.content ) ) ) {
				var bodyHtml = renderNested( child.content, arguments.renderer, arguments.markdownOptions )
				if ( tag == "a" ) {
					// The whole card is already one big <a> - markdown auto-linking
					// a bare URL/email in the body (e.g. "consulting@ortussolutions.com")
					// would otherwise nest a second <a> inside it, which is invalid
					// HTML. Browsers "fix" that by force-closing the outer <a> the
					// moment they hit the inner one, splitting the card in half and
					// leaving the rest of its content stranded outside the box. Unwrap
					// any inner anchors instead - their text still reads fine, and the
					// whole card already links to the same place a click would.
					bodyHtml = reReplaceNoCase( bodyHtml, "</?a\b[^>]*>", "", "all" )
				}
				html &= '<div class="bxsites-card__body">' & bodyHtml & '</div>'
			}
			html &= "</" & tag & ">"
		}

		return html & "</div>"
	}

	/**
	 * `::: columns` containing `::: column width="50%"` children - a
	 * side-by-side layout. `width` is optional; columns with no explicit
	 * width share the row equally.
	 */
	private string function renderColumns( required struct block, required any renderer, required struct markdownOptions ) {
		var children = this.extract( arguments.block.content ).blocks
		var html = '<div class="bxsites-columns">'

		for ( var child in children ) {
			var attrs = parseAttrs( child.attrsRaw )
			var width = trim( attrs.width ?: "" )
			// Only a plain CSS length/percentage is honored (e.g. "50%", "20rem") -
			// anything else is silently ignored rather than trusted verbatim into
			// a style="" attribute.
			var styleAttr = width.reFind( "^\d+(\.\d+)?(%|px|rem|em)$" )
				? ' style="--bxsites-column-width:' & width & '"'
				: ""
			html &= '<div class="bxsites-column"' & styleAttr & '>' & renderNested( child.content, arguments.renderer, arguments.markdownOptions ) & '</div>'
		}

		return html & "</div>"
	}

	/**
	 * `::: stepper` containing `::: step "Title"` children - a numbered,
	 * connected sequence of steps. A step's own optional `color` attribute
	 * (`success`/`warning`/`danger` - variables.stepColors) flags it with
	 * one of the semantic marker palettes each built-in theme defines,
	 * e.g. `::: step "Delete the old install" color="danger"`.
	 */
	private string function renderStepper( required struct block, required any renderer, required struct markdownOptions ) {
		var children = this.extract( arguments.block.content ).blocks
		var html = '<div class="bxsites-stepper">'
		var idx = 0

		for ( var child in children ) {
			idx++
			var attrs = parseAttrs( child.attrsRaw )
			var title = trim( attrs.title ?: "" )
			var color = lCase( trim( attrs.color ?: "" ) )
			var markerClass = "bxsites-step__marker" & ( listFindNoCase( variables.stepColors, color ) ? " bxsites-step__marker--" & color : "" )

			html &= '<div class="bxsites-step">'
				& '<div class="' & markerClass & '">' & idx & '</div>'
				& '<div class="bxsites-step__content">'
			if ( len( title ) ) {
				html &= '<div class="bxsites-step__title">' & encodeForHTML( title ) & '</div>'
			}
			html &= renderNested( child.content, arguments.renderer, arguments.markdownOptions )
				& '</div></div>'
		}

		return html & "</div>"
	}

	/**
	 * `::: updates` containing `::: update date="YYYY-MM-DD" tags="a,b"`
	 * children - a changelog list of dated, optionally-tagged entries.
	 * `tags` is a comma-separated list, each rendered as its own badge.
	 * See `UpdatesFeedGenerator.bx` for the accompanying `feed.xml` this
	 * block's presence on a page triggers.
	 */
	private string function renderUpdates( required struct block, required any renderer, required struct markdownOptions ) {
		var children = this.extract( arguments.block.content ).blocks
		var html = '<div class="bxsites-updates">'

		for ( var child in children ) {
			var attrs = parseAttrs( child.attrsRaw )
			var date = trim( attrs.date ?: "" )
			var tags = listToArray( trim( attrs.tags ?: "" ), "," ).map( tag => trim( tag ) ).filter( tag => len( tag ) )

			html &= '<div class="bxsites-update">'
			if ( len( date ) || tags.len() ) {
				html &= '<div class="bxsites-update__meta">'
				if ( len( date ) ) {
					html &= '<time class="bxsites-update__date" datetime="' & encodeForHTML( date ) & '">' & encodeForHTML( date ) & '</time>'
				}
				for ( var tag in tags ) {
					html &= '<span class="bxsites-update__tag">' & encodeForHTML( tag ) & '</span>'
				}
				html &= '</div>'
			}
			html &= '<div class="bxsites-update__body">' & renderNested( child.content, arguments.renderer, arguments.markdownOptions ) & '</div>'
				& '</div>'
		}

		return html & "</div>"
	}

	/**
	 * `::: file src="assets/spec.pdf" title="Spec Document"` - a download
	 * card for a PDF, video, or any other project asset. `src` is resolved
	 * relative to `docs/assets/` the same way `theme.logo`/frontmatter
	 * `ogImage` already are - left as-authored here and prefixed with
	 * `basePath` afterwards by `resolveFileHrefs()` below, not here (this
	 * processor has no `basePath` in scope during `restore()`; only
	 * BuildPipeline.bx's `convertMarkdown()`, which calls `resolveFileHrefs()`
	 * right after `restore()`, does).
	 */
	private string function renderFile( required struct attrs ) {
		var src = trim( arguments.attrs.src ?: "" )
		if ( !len( src ) ) {
			return '<div class="bxsites-file bxsites-file--invalid">::: file - missing required src="..."</div>'
		}
		var title = len( trim( arguments.attrs.title ?: "" ) ) ? trim( arguments.attrs.title ) : listLast( src, "/" )
		return '<a class="bxsites-file" href="' & attrEscape( src ) & '" download>'
			& '<span class="bxsites-file__icon" aria-hidden="true">📎</span>'
			& '<span class="bxsites-file__title">' & encodeForHTML( title ) & '</span>'
			& '</a>'
	}

	/**
	 * `::: pagebreak` - forces a page break wherever it's placed, for a
	 * project that later prints or exports the built site to PDF (e.g. a
	 * browser's own "Print to PDF"). No attributes - a bare
	 * `::: pagebreak` ... `:::` pair with nothing in between. Renders as a
	 * plain `<hr>` so it's visible as a subtle divider on screen too, in
	 * case a reader forgets it's there while editing; each theme's own CSS
	 * (`.bxsites-pagebreak`) turns that into an actual forced break only
	 * inside `@media print` - it does nothing to normal on-screen browsing.
	 */
	private string function renderPagebreak() {
		return '<hr class="bxsites-pagebreak" data-bxsites-pagebreak>'
	}

	/**
	 * `::: button "Get Started" href="../getting-started.md" style="primary" size="large" icon="phosphor-duotone:rocket-launch" target="_blank" disabled="true"` -
	 * a single GitBook-style call-to-action button. Only the leading
	 * `"Label"` shorthand and `href` are commonly needed; every other
	 * attribute is optional:
	 *
	 * - `style` - `"primary"` or `"secondary"` (default); any other/missing
	 *   value falls back to `"secondary"` rather than erroring, the same
	 *   forgiving-typo behavior admonitions/steps already have.
	 * - `size` - `"small"`, `"medium"` (default) or `"large"`.
	 * - `icon` - resolved the same way a card's own `icon` is (IconResolver.bx).
	 * - `target="_blank"` - opens the link in a new tab (`rel="noopener noreferrer"`
	 *   added automatically); omitted, it opens in the same tab like any
	 *   other markdown link.
	 * - `disabled="true"` - renders an inert `<span>` instead of an `<a>`
	 *   (no `href` needed), for a GitBook-style "coming soon" button.
	 *
	 * Usually used standalone, but nests inside `::: buttons` (below) to
	 * lay several out in a row.
	 */
	private string function renderButton( required struct attrs ) {
		var label = trim( arguments.attrs.title ?: "" )
		if ( !len( label ) ) {
			return '<div class="bxsites-button bxsites-button--invalid">::: button - requires a "Label" title</div>'
		}

		var style = lCase( trim( arguments.attrs.style ?: "" ) )
		if ( !listFindNoCase( "primary,secondary", style ) ) {
			style = "secondary"
		}
		var size = lCase( trim( arguments.attrs.size ?: "" ) )
		if ( !listFindNoCase( "small,medium,large", size ) ) {
			size = "medium"
		}
		var disabled = ( arguments.attrs.disabled ?: "" ) == "true"
		var href = trim( arguments.attrs.href ?: "" )
		var classes = "bxsites-button bxsites-button--" & style & " bxsites-button--" & size & ( disabled ? " bxsites-button--disabled" : "" )

		var inner = ""
		if ( len( trim( arguments.attrs.icon ?: "" ) ) ) {
			inner &= '<span class="bxsites-button__icon">' & variables.iconResolver.resolve( arguments.attrs.icon ) & '</span>'
		}
		inner &= '<span class="bxsites-button__label">' & encodeForHTML( label ) & '</span>'

		if ( disabled || !len( href ) ) {
			return '<span class="' & classes & '" aria-disabled="true">' & inner & '</span>'
		}

		var targetAttr = lCase( trim( arguments.attrs.target ?: "" ) ) == "_blank" ? ' target="_blank" rel="noopener noreferrer"' : ""
		return '<a class="' & classes & '" href="' & attrEscape( href ) & '"' & targetAttr & '>' & inner & '</a>'
	}

	/**
	 * `::: buttons` containing `::: button ...` children (see `renderButton()`
	 * above for their own attributes) - lays several buttons out in a row,
	 * wrapping on narrow viewports. Purely optional: a lone `::: button`
	 * outside a `::: buttons` wrapper renders fine on its own.
	 */
	private string function renderButtons( required struct block, required any renderer, required struct markdownOptions ) {
		var children = this.extract( arguments.block.content ).blocks
		var html = '<div class="bxsites-buttons">'
		for ( var child in children ) {
			html &= renderButton( parseAttrs( child.attrsRaw ) )
		}
		return html & "</div>"
	}

	/**
	 * `::: openapi src="assets/openapi/spec.yaml" title="My API"` - an
	 * interactive Swagger UI widget rendering an OpenAPI/Swagger spec
	 * (JSON or YAML - Swagger UI parses either client-side, no server-side
	 * parsing happens anywhere in this module). `src` is resolved the same
	 * `docs/assets/`-relative way `::: file`'s own `src` is - left
	 * as-authored here and prefixed with `basePath` afterwards by
	 * `resolveOpenApiSrcs()` below, same reasoning as `renderFile()`'s own
	 * docblock. Requires `bxsites.json`'s `openapi: true` - unset, the
	 * required Swagger UI JS/CSS is never copied into `site/` at all
	 * (BuildPipeline.bx's `copyAssets()`), the same opt-in-only shape
	 * `mermaid`/`math` already use, so this placeholder renders but stays
	 * inert (no widget mounts) on a project that hasn't turned it on.
	 *
	 * An optional `operation="METHOD /path"` (e.g. `"POST /users"`) drops
	 * just that one endpoint inline into a regular page - a tutorial can
	 * show a single relevant operation without sending the reader to the
	 * full reference. Still the same one spec, same client-side-only
	 * Swagger UI render as the full-spec block above; `openapi-init.js`
	 * mounts the identical widget, then hides every other operation and
	 * auto-expands the matching one by reading Swagger UI's own rendered
	 * DOM (`.opblock-summary-path`'s `data-path` + the `opblock-<method>`
	 * class) - no OpenAPI parsing on our side, same as the full block.
	 */
	private string function renderOpenApi( required struct attrs ) {
		var src = trim( arguments.attrs.src ?: "" )
		if ( !len( src ) ) {
			return '<div class="bxsites-openapi bxsites-openapi--invalid">::: openapi - missing required src="..."</div>'
		}

		var operation = trim( arguments.attrs.operation ?: "" )
		var operationAttr = ""
		if ( len( operation ) ) {
			var parsed = parseOpenApiOperation( operation )
			if ( isNull( parsed ) ) {
				return '<div class="bxsites-openapi bxsites-openapi--invalid">::: openapi - operation="' & encodeForHTML( operation ) & '" must look like "METHOD /path", e.g. "POST /users"</div>'
			}
			operationAttr = ' data-openapi-operation="' & attrEscape( parsed.method & " " & parsed.path ) & '"'
		}

		var title = trim( arguments.attrs.title ?: "" )
		var html = ""
		if ( len( title ) ) {
			html &= '<div class="bxsites-openapi__title">' & encodeForHTML( title ) & '</div>'
		}
		return '<div class="bxsites-openapi' & ( len( operation ) ? " bxsites-openapi--operation" : "" ) & '" data-openapi-src="' & attrEscape( src ) & '"' & operationAttr & '>' & html & '</div>'
	}

	/**
	 * @operation The raw `operation="..."` attribute value
	 *
	 * @return { method (lowercased, e.g. "post"), path (as-authored, e.g. "/users") } or null when it doesn't look like "METHOD /path"
	 */
	private any function parseOpenApiOperation( required string operation ) {
		var matcher = variables.openApiOperationPattern.matcher( trim( arguments.operation ) )
		if ( !matcher.matches() ) {
			return
		}
		var method = lCase( matcher.group( 1 ) )
		if ( !listFindNoCase( "get,post,put,delete,patch,options,head", method ) ) {
			return
		}
		return { method : method, path : matcher.group( 2 ) }
	}

	/**
	 * `::: embed url="https://..." title="Caption"` - a responsive iframe
	 * embed for a recognized provider (YouTube, Vimeo, CodePen, Spotify,
	 * Loom, Figma); an unrecognized URL falls back to a plain link card
	 * instead of guessing at an iframe that won't work.
	 */
	private string function renderEmbed( required struct attrs ) {
		var url = trim( arguments.attrs.url ?: "" )
		if ( !len( url ) ) {
			return '<div class="bxsites-embed bxsites-embed--invalid">::: embed - missing required url="..."</div>'
		}
		var title = trim( arguments.attrs.title ?: "" )
		var embedUrl = resolveEmbedUrl( url )

		if ( !len( embedUrl ) ) {
			return '<a class="bxsites-embed-fallback" href="' & attrEscape( url ) & '" target="_blank" rel="noopener noreferrer">'
				& ( len( title ) ? encodeForHTML( title ) : encodeForHTML( url ) ) & ' ↗</a>'
		}

		var html = '<div class="bxsites-embed"><iframe src="' & attrEscape( embedUrl ) & '" loading="lazy" allowfullscreen'
			& ' referrerpolicy="strict-origin-when-cross-origin"></iframe></div>'
		if ( len( title ) ) {
			html &= '<div class="bxsites-embed__caption">' & encodeForHTML( title ) & '</div>'
		}
		return html
	}

	/**
	 * Recognizes a handful of common providers' page URLs and converts
	 * each to its own dedicated iframe-embeddable URL - returns `""` for
	 * anything else, rather than emitting an iframe pointed at a page that
	 * will just refuse to render inside one (most sites send
	 * `X-Frame-Options`/CSP `frame-ancestors` precisely to prevent that).
	 *
	 * @url The page URL as authored in `::: embed url="..."`
	 */
	private string function resolveEmbedUrl( required string url ) {
		var youtube = arguments.url.reFind( "(?:youtube\.com/watch\?v=|youtu\.be/)([\w-]+)" )
			? arguments.url.reReplaceNoCase( ".*(?:youtube\.com/watch\?v=|youtu\.be/)([\w-]+).*", "\1", "one" )
			: ""
		if ( len( youtube ) ) {
			return "https://www.youtube.com/embed/" & youtube
		}

		var vimeo = arguments.url.reFindNoCase( "vimeo\.com/(\d+)" )
			? arguments.url.reReplaceNoCase( ".*vimeo\.com/(\d+).*", "\1", "one" )
			: ""
		if ( len( vimeo ) ) {
			return "https://player.vimeo.com/video/" & vimeo
		}

		if ( arguments.url.reFindNoCase( "codepen\.io/[^/]+/pen/[\w-]+" ) ) {
			return arguments.url.reReplaceNoCase( "codepen\.io/([^/]+)/pen/([\w-]+)", "codepen.io/\1/embed/\2?default-tab=result", "one" )
		}

		if ( arguments.url.reFindNoCase( "open\.spotify\.com/(track|album|playlist|episode|show)/[\w]+" ) ) {
			return arguments.url.reReplaceNoCase( "open\.spotify\.com/", "open.spotify.com/embed/", "one" )
		}

		if ( arguments.url.reFindNoCase( "loom\.com/share/[\w]+" ) ) {
			return arguments.url.reReplaceNoCase( "loom\.com/share/", "loom.com/embed/", "one" )
		}

		if ( arguments.url.reFindNoCase( "figma\.com/(file|design)/" ) ) {
			return "https://www.figma.com/embed?embed_host=bxsites&url=" & urlEncodedFormat( arguments.url )
		}

		return ""
	}

	/**
	 * `::: link-preview url="https://..." title="..." description="..." image="..."` -
	 * a rich preview card for an *external* URL. Unlike `::: page-link`
	 * (which enriches itself from another page's own frontmatter, found
	 * only once every page in the tree has loaded - see
	 * PageLinkResolver.bx), everything here comes straight from the
	 * directive's own attributes and renders in one pass - there's no
	 * build-time fetch of the target URL's own metadata (no outbound HTTP
	 * request during a build, ever, the same reasoning LinkChecker.bx's
	 * own docblock gives for staying internal-links-only): `title` falls
	 * back to the bare `url` when omitted; `description` and `image` are
	 * both optional.
	 */
	private string function renderLinkPreview( required struct attrs ) {
		var url = trim( arguments.attrs.url ?: "" )
		if ( !len( url ) ) {
			return '<div class="bxsites-link-preview bxsites-link-preview--invalid">::: link-preview - missing required url="..."</div>'
		}
		var title = len( trim( arguments.attrs.title ?: "" ) ) ? trim( arguments.attrs.title ) : url
		var description = trim( arguments.attrs.description ?: "" )
		var image = trim( arguments.attrs.image ?: "" )
		var domain = linkPreviewDomain( url )

		var html = '<a class="bxsites-link-preview" href="' & attrEscape( url ) & '" target="_blank" rel="noopener noreferrer">'
		if ( len( image ) ) {
			html &= '<div class="bxsites-link-preview__image"><img src="' & attrEscape( image ) & '" alt=""></div>'
		}
		html &= '<div class="bxsites-link-preview__text">'
			& '<div class="bxsites-link-preview__title">' & encodeForHTML( title ) & '</div>'
		if ( len( description ) ) {
			html &= '<div class="bxsites-link-preview__description">' & encodeForHTML( description ) & '</div>'
		}
		if ( len( domain ) ) {
			html &= '<div class="bxsites-link-preview__domain">' & encodeForHTML( domain ) & '</div>'
		}
		html &= '</div></a>'
		return html
	}

	/**
	 * Derives a clean "example.com"-style caption from a full URL for a
	 * link-preview card, stripping a leading "www." the same way most
	 * real link-preview widgets do since it's redundant to show - "" for
	 * anything that isn't a recognizable `http(s)://host/...` URL (a bare
	 * domain with no scheme, say), rather than showing the whole raw
	 * value as if it were just a host.
	 *
	 * @url The link-preview's own `url` attribute
	 */
	private string function linkPreviewDomain( required string url ) {
		var host = arguments.url.reReplaceNoCase( "^https?://([^/]+).*", "\1", "one" )
		if ( host == arguments.url ) {
			return ""
		}
		return host.reReplaceNoCase( "^www\.", "", "one" )
	}

	/**
	 * `::: prompt description="..." icon="..." expanded="hidden|preview|full"`
	 * - a styled container for a reusable AI prompt, bx-sites' own
	 * equivalent of GitBook's Prompt block
	 * (https://gitbook.com/docs/create-content/blocks/prompt): the block's
	 * body *is* the prompt text (rendered as markdown, so headings/lists/
	 * code inside it still get their own formatting), `description` is an
	 * optional one-line summary shown under the heading, and `icon`
	 * defaults to a sparkle glyph when omitted (resolved the same way
	 * `::: card`'s own `icon` is - IconResolver.bx). `expanded` picks the
	 * block's initial disclosure state (normalizePromptState() below) -
	 * `prompt-init.js` wires up both that toggle and the "Copy" button,
	 * which copies `data-bxsites-prompt-text` - the block's own raw
	 * markdown source, not its rendered HTML, so a reader always copies
	 * exactly the prompt text as authored, formatting markup included.
	 * GitBook's own `openInAIProviders` menu (launching the prompt
	 * straight into an external AI tool) has no equivalent here - this
	 * module never talks to a third-party AI provider.
	 */
	private string function renderPrompt( required struct block, required struct attrs, required any renderer, required struct markdownOptions ) {
		var description = trim( arguments.attrs.description ?: "" )
		var iconRef = len( trim( arguments.attrs.icon ?: "" ) ) ? trim( arguments.attrs.icon ) : "phosphor-duotone:sparkle"
		var iconHtml = variables.iconResolver.resolve( iconRef )
		var state = normalizePromptState( arguments.attrs.expanded ?: "" )
		var promptText = trim( arguments.block.content )

		var html = '<div class="bxsites-prompt bxsites-prompt--' & state & '" data-bxsites-prompt-text="' & encodeForHTML( promptText ) & '">'
			& '<div class="bxsites-prompt__header">'
		if ( len( iconHtml ) ) {
			html &= '<div class="bxsites-prompt__icon">' & iconHtml & '</div>'
		}
		html &= '<div class="bxsites-prompt__heading">'
			& '<span class="bxsites-prompt__label">Prompt</span>'
		if ( len( description ) ) {
			html &= '<span class="bxsites-prompt__description">' & encodeForHTML( description ) & '</span>'
		}
		html &= '</div>'
			& '<button type="button" class="bxsites-prompt__copy" aria-label="Copy prompt to clipboard">'
			& '<span class="bxsites-prompt__copy-label">Copy</span>'
			& '</button>'
			& '</div>'
			& '<div class="bxsites-prompt__body-wrap">'
			& '<div class="bxsites-prompt__body">' & renderNested( arguments.block.content, arguments.renderer, arguments.markdownOptions ) & '</div>'
			& '</div>'

		if ( state != "full" ) {
			// Kept as a sibling of `.bxsites-prompt__body-wrap`, not nested inside
			// it - a "hidden" block hides that whole wrapper via CSS, and a toggle
			// button nested inside it would vanish right along with it, leaving no
			// way to ever reveal the prompt again.
			var labelCollapsed = state == "hidden" ? "Show prompt" : "Show more"
			var labelExpanded = state == "hidden" ? "Hide prompt" : "Show less"
			html &= '<button type="button" class="bxsites-prompt__toggle" aria-expanded="false"'
				& ' data-label-collapsed="' & encodeForHTML( labelCollapsed ) & '" data-label-expanded="' & encodeForHTML( labelExpanded ) & '">'
				& encodeForHTML( labelCollapsed ) & '</button>'
		}

		html &= '</div>'
		return html
	}

	/**
	 * @raw `::: prompt`'s own `expanded` attribute, exactly as authored
	 *
	 * @return "hidden" (fully collapsed until toggled open), "preview" (a clamped, fade-out preview), or "full" (shown in full) - blank/unrecognized falls back to "full", the same default GitBook's own Prompt block uses ("Fully visible")
	 */
	private string function normalizePromptState( required string raw ) {
		var value = lCase( trim( arguments.raw ) )
		if ( value == "hidden" || value == "collapsed" ) {
			return "hidden"
		}
		if ( value == "preview" || value == "partial" ) {
			return "preview"
		}
		return "full"
	}

	/**
	 * Extracts `::: update` entries from one already-extracted `::: updates`
	 * block (see `extract()`'s own `blocks` array) - used by BuildPipeline
	 * to build that page's own `feed.xml` (UpdatesFeedGenerator.bx),
	 * independent of `restore()`'s own HTML rendering of the same block.
	 *
	 * @updatesBlock One `extract()` block whose `type` is `"updates"`
	 * @renderer Any object exposing `toHtml( markdown, options = {} )`
	 * @markdownOptions Passthrough options forwarded to the renderer
	 *
	 * @return Array of { date, tags: array, contentHtml }, in source order
	 */
	array function extractUpdateEntries( required struct updatesBlock, required any renderer, required struct markdownOptions ) {
		var children = this.extract( arguments.updatesBlock.content ).blocks
		var entries = []

		for ( var child in children ) {
			var attrs = parseAttrs( child.attrsRaw )
			var tags = listToArray( trim( attrs.tags ?: "" ), "," ).map( tag => trim( tag ) ).filter( tag => len( tag ) )
			entries.append( {
				date        : trim( attrs.date ?: "" ),
				tags        : tags,
				contentHtml : renderNested( child.content, arguments.renderer, arguments.markdownOptions )
			} )
		}

		return entries
	}

	/**
	 * Prefixes every `.bxsites-file` download link's own `href` with
	 * `basePath` - the "root-anchored `docs/assets/`" resolution
	 * `renderFile()`'s own docblock promises, done here instead of inside
	 * `restore()` since only the caller (BuildPipeline.bx's `convertMarkdown()`)
	 * has `basePath` in scope. An href that's already an absolute URL (has
	 * its own scheme) or already root-relative (starts with `/`) is left
	 * untouched - the same scope ResponsiveImageProcessor.bx's own
	 * asset-path resolution has.
	 *
	 * @html Already-rendered page HTML (this class's own `restore()` output)
	 * @basePath Root-relative base path ending with `/`
	 */
	string function resolveFileHrefs( required string html, required string basePath ) {
		var matcher = variables.fileHrefPattern.matcher( arguments.html )
		var buffer = createObject( "java", "java.lang.StringBuilder" ).init()

		while ( matcher.find() ) {
			var href = matcher.group( 2 )
			var resolved = isLocalAssetPath( href ) ? arguments.basePath & href : href
			matcher.appendReplacement( buffer, createObject( "java", "java.util.regex.Matcher" ).quoteReplacement( matcher.group( 1 ) & resolved & matcher.group( 3 ) ) )
		}
		matcher.appendTail( buffer )

		return buffer.toString()
	}

	/**
	 * Prefixes every `::: openapi` block's own `data-openapi-src` with
	 * `basePath` - same reasoning and same "only BuildPipeline.bx has
	 * `basePath` in scope" split as `resolveFileHrefs()` above.
	 *
	 * @html Already-rendered page HTML (this class's own `restore()` output)
	 * @basePath Root-relative base path ending with `/`
	 */
	string function resolveOpenApiSrcs( required string html, required string basePath ) {
		var matcher = variables.openApiSrcPattern.matcher( arguments.html )
		var buffer = createObject( "java", "java.lang.StringBuilder" ).init()

		while ( matcher.find() ) {
			var src = matcher.group( 2 )
			var resolved = isLocalAssetPath( src ) ? arguments.basePath & src : src
			matcher.appendReplacement( buffer, createObject( "java", "java.util.regex.Matcher" ).quoteReplacement( matcher.group( 1 ) & resolved & matcher.group( 3 ) ) )
		}
		matcher.appendTail( buffer )

		return buffer.toString()
	}

	/**
	 * @return false for an external URL (has its own scheme), a root-relative (`/...`) path, or an empty href - only a bare file-relative path is a rewrite candidate
	 */
	private boolean function isLocalAssetPath( required string href ) {
		var h = trim( arguments.href )
		if ( !len( h ) || left( h, 1 ) == "/" ) {
			return false
		}
		return !h.reFindNoCase( "^[a-z][a-z0-9+.\-]*:" )
	}

	/**
	 * `::: page-link href="guides/themes.md"` - a rich preview card
	 * linking to another page. This processor only ever sees one page's
	 * own markdown in isolation, so it can't know that page's title/icon/
	 * summary here - it emits a stub the theme can style immediately (the
	 * link itself works even with no further processing) and stamps
	 * `data-bxsites-page-link` on it; PageLinkResolver.bx (run once, after
	 * every page in the tree is loaded - the same shape as
	 * `assignPrevNext()`/`assignBreadcrumbs()` in BuildPipeline.bx) finds
	 * these stubs across all rendered pages and fills each in with its
	 * real target's title/icon/summary.
	 *
	 * @attrs `href` is resolved the same file-relative way as an ordinary
	 * markdown link (MarkdownLinkResolver.bx runs after this, so a
	 * relative `.md` path here still gets rewritten to its built URL).
	 */
	private string function renderPageLinkStub( required struct attrs ) {
		var href = trim( arguments.attrs.href ?: "" )
		if ( !len( href ) ) {
			return '<div class="bxsites-page-link bxsites-page-link--invalid">::: page-link - missing required href="..."</div>'
		}
		return '<a class="bxsites-page-link" href="' & attrEscape( href ) & '" data-bxsites-page-link>'
			& '<span class="bxsites-page-link__title">' & encodeForHTML( href ) & '</span>'
			& '</a>'
	}

	/**
	 * `::: course id="getting-started" :::` - a placeholder only.
	 * `DirectiveBlockProcessor.bx` never has access to the whole tree's
	 * pages (only this one page's own attrs), so it can't yet know the
	 * target course's lessons/titles - `CourseBuilder.resolveIndexBlocks()`
	 * runs as a post-pass, once every page in the tree has been through
	 * `convertMarkdown()`, and swaps this stub for the real, fully
	 * rendered numbered index - the identical two-phase shape
	 * `renderPageLinkStub()`/`PageLinkResolver.bx` already use, for the
	 * same reason.
	 *
	 * @attrs Must include `id`
	 */
	private string function renderCourseIndexStub( required struct attrs ) {
		var id = trim( arguments.attrs.id ?: "" )
		if ( !len( id ) ) {
			return '<div class="bxsites-course-index bxsites-course-index--invalid">::: course - missing required id="..."</div>'
		}
		return '<div class="bxsites-course-index" data-bxsites-course-index data-bxsites-course-id="' & attrEscape( id ) & '"></div>'
	}

	/**
	 * `::: contact-form id="demo-request" to="sales@acme.com" fields="name:text,email*:email,message:textarea" submitLabel="Send" :::` -
	 * a real, working-once-deployed contact/lead-gen form. Premium: this
	 * module has no backend, no visitor identity, and no server-side
	 * evaluation of any kind at build time (see "Conditional content"
	 * above for the same reality applied to a different block) - whether
	 * this project's own plan is even entitled to a *working* form at all
	 * is entirely a bxSites Cloud concern, decided at submit time, not
	 * build time. This block always renders the full, real-looking form
	 * markup regardless - `contact-form-init.js` (copied unconditionally,
	 * same as `conditional-content-init.js`) wires up its submit handler
	 * at runtime, `POST`ing JSON to `/api/forms/submit` and rendering
	 * whatever that endpoint's own response implies: success, a
	 * validation error, a 429 rate-limit, or - on a free/unentitled plan -
	 * a 403 "Upgrade to enable this form" fallback. None of that is this
	 * build's concern beyond emitting markup real enough to drive it.
	 *
	 * - `id` - this form's own slug, matching a form configuration that
	 *   lives entirely server-side (bxSites Cloud) - never validated here,
	 *   just passed through as `data-form-id`. Defaults to `"contact"`.
	 * - `to` - informational only (real delivery routing is configured by
	 *   the account admin server-side); still parsed and stamped as
	 *   `data-form-to` as a hint, with no effect on behavior here.
	 * - `fields` - required; parseContactFields()'s own small DSL, e.g.
	 *   `"name:text,email*:email,message:textarea"`.
	 * - `submitLabel` - the submit button's own label; defaults to `"Send"`.
	 *
	 * Every field gets its own labeled `<input>`/`<textarea>` (`required`
	 * when marked so in `fields`), and a hidden honeypot input
	 * (`name="_hp"`) rides along regardless of `fields` - positioned
	 * off-screen with an inline style rather than `hidden`/`display:none`,
	 * since a spam bot's own automated form-fill is more likely to still
	 * find and fill an off-screen-but-visible-to-the-DOM field than one
	 * already invisible in the accessibility tree. `contact-form-init.js`
	 * forwards it untouched on submit; the server decides what a filled
	 * one means.
	 */
	private string function renderContactForm( required struct attrs ) {
		var fieldsRaw = trim( arguments.attrs.fields ?: "" )
		if ( !len( fieldsRaw ) ) {
			return '<div class="bxsites-contact-form bxsites-contact-form--invalid">::: contact-form - missing required fields="name:type,..."</div>'
		}

		var fields = parseContactFields( fieldsRaw )
		if ( !fields.len() ) {
			return '<div class="bxsites-contact-form bxsites-contact-form--invalid">::: contact-form - fields="' & encodeForHTML( fieldsRaw ) & '" has no valid name:type entries</div>'
		}

		var formId = len( trim( arguments.attrs.id ?: "" ) ) ? trim( arguments.attrs.id ) : "contact"
		var to = trim( arguments.attrs.to ?: "" )
		var submitLabel = len( trim( arguments.attrs.submitLabel ?: "" ) ) ? trim( arguments.attrs.submitLabel ) : "Send"
		// A plain, DOM-id-safe slug derived from the (otherwise
		// free-text) `id` attribute - only used to build each field's own
		// `id`/`for` pair below, never rendered as `data-form-id` itself
		// (that keeps the author's own `id` exactly as written).
		var domId = "bxsites-contact-form-" & reReplace( formId, "[^a-zA-Z0-9_-]", "-", "all" )

		var html = '<form class="bxsites-contact-form" data-bx-form data-form-id="' & attrEscape( formId ) & '"'
		if ( len( to ) ) {
			html &= ' data-form-to="' & attrEscape( to ) & '"'
		}
		html &= ' action="/api/forms/submit" method="POST">'

		for ( var field in fields ) {
			var fieldId = domId & "-" & field.name
			var requiredAttr = field.required ? " required" : ""

			html &= '<div class="bxsites-contact-form__field">'
				& '<label class="bxsites-contact-form__label" for="' & attrEscape( fieldId ) & '">' & encodeForHTML( field.label )
			if ( field.required ) {
				html &= ' <span class="bxsites-contact-form__required" aria-hidden="true">*</span>'
			}
			html &= '</label>'

			html &= field.type == "textarea"
				? '<textarea class="bxsites-contact-form__input bxsites-contact-form__textarea" id="' & attrEscape( fieldId ) & '" name="' & attrEscape( field.name ) & '"' & requiredAttr & '></textarea>'
				: '<input class="bxsites-contact-form__input" type="' & field.type & '" id="' & attrEscape( fieldId ) & '" name="' & attrEscape( field.name ) & '"' & requiredAttr & '>'
			html &= '</div>'
		}

		html &= '<input class="bxsites-contact-form__honeypot" type="text" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px">'
			& '<button type="submit" class="bxsites-button bxsites-button--primary bxsites-button--medium">'
			& '<span class="bxsites-button__label">' & encodeForHTML( submitLabel ) & '</span>'
			& '</button>'
			& '<div class="bxsites-contact-form__status" data-bx-form-status hidden></div>'
			& '</form>'

		return html
	}

	/**
	 * Parses `::: contact-form`'s own `fields="name:type,..."` DSL - one
	 * comma-separated `name:type` pair per field, an optional trailing
	 * `*` directly after the name (before its own `:`) marking that field
	 * required, e.g. `"name:text,email*:email,message:textarea"`.
	 *
	 * @fieldsRaw The raw `fields` attribute value
	 *
	 * @return Array of { name, type ("text"/"email"/"textarea"/"number"), required, label } - one entry per well-formed segment. A malformed segment (no name, no `:type`) is silently skipped rather than failing the whole block - the same forgiving-typo spirit as an unrecognized `type` falling back to `"text"` below rather than erroring the build.
	 */
	private array function parseContactFields( required string fieldsRaw ) {
		var fields = []

		for ( var segment in listToArray( arguments.fieldsRaw, "," ) ) {
			var trimmed = trim( segment )
			// The `*` required-marker sits directly before the field's own
			// `:type` - stripped here (rather than matched as an optional
			// regex group) so contactFieldPattern itself never has to deal
			// with a Java optional-group match that didn't participate
			// (which surfaces as a null, not an empty string).
			var required = trimmed.find( "*:" ) > 0
			if ( required ) {
				trimmed = trimmed.replace( "*:", ":", "one" )
			}

			var matcher = variables.contactFieldPattern.matcher( trimmed )
			if ( !matcher.matches() ) {
				continue
			}

			var name = matcher.group( 1 )
			var type = lCase( matcher.group( 2 ) )
			if ( !listFindNoCase( "text,email,textarea,number", type ) ) {
				type = "text"
			}

			fields.append( { name : name, type : type, required : required, label : humanizeFieldName( name ) } )
		}

		return fields
	}

	/**
	 * @name A `fields` DSL field name, e.g. "full-name" or "email"
	 *
	 * @return A human-friendly label ("Full Name", "Email") - splits `name` on "-"/"_" and title-cases each resulting word
	 */
	private string function humanizeFieldName( required string name ) {
		var words = listToArray( arguments.name, "-_" )
		var labeled = words.map( function( word ) {
			return len( word ) ? uCase( left( word, 1 ) ) & right( word, len( word ) - 1 ) : word
		} )
		return labeled.toList( " " )
	}

}
