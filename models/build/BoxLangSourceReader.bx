/**
 * The shared, semantics-free half of reading BoxLang/CFML source as text:
 * strip comments, split into statements, walk balanced blocks, and pull
 * literal arguments out of a call.
 *
 * ColdBox's routing DSL and WireBox's binder DSL are the same shape - a
 * chained, fluent, multi-line call whose interesting values are string
 * literals - so both parsers want exactly these primitives and neither
 * wants the other's meaning. Keeping them here means one place gets the
 * fiddly parts right: a `//` inside `"https://..."` is not a comment, a
 * comma inside a nested closure does not separate arguments, and a
 * newline only ends a statement when the next line doesn't continue the
 * chain with a leading `.`.
 *
 * Nothing here knows what a route or a mapping is. What it can't do is
 * evaluate: only literals are readable, which is what lets the parsers
 * above it skip a runtime-built declaration rather than guess at it.
 */
class {

	/**
	 * Removes line and block comments, leaving string literals intact.
	 *
	 * @source The source code
	 */
	string function stripComments( required string source ) {
		var output = createObject( "java", "java.lang.StringBuilder" ).init()
		var length = arguments.source.len()
		var index = 1
		var quote = ""

		while ( index <= length ) {
			var current = arguments.source.mid( index, 1 )
			var next = index < length ? arguments.source.mid( index + 1, 1 ) : ""

			if ( len( quote ) ) {
				output.append( current )
				if ( current == quote ) {
					quote = ""
				}
				index++
				continue
			}

			if ( current == """" || current == "'" ) {
				quote = current
				output.append( current )
				index++
				continue
			}

			if ( current == "/" && next == "/" ) {
				while ( index <= length && arguments.source.mid( index, 1 ) != char( 10 ) ) {
					index++
				}
				continue
			}

			if ( current == "/" && next == "*" ) {
				index += 2
				while ( index < length && !( arguments.source.mid( index, 1 ) == "*" && arguments.source.mid( index + 1, 1 ) == "/" ) ) {
					index++
				}
				index += 2
				continue
			}

			output.append( current )
			index++
		}

		return output.toString()
	}

	/**
	 * Splits comment-free source into statements.
	 *
	 * Boundaries are `;`, `{` and `}` at parenthesis depth zero, plus
	 * newlines - with the one rule that makes a fluent DSL parse: a
	 * newline only ends a statement when the next non-blank line doesn't
	 * continue the chain with a leading `.`. Braces inside parentheses (a
	 * closure argument, an inline struct) never split, so such a call
	 * stays the single statement it is.
	 *
	 * @source Comment-free source
	 *
	 * @return Array of trimmed, non-empty statements
	 */
	array function statements( required string source ) {
		var found = []
		var buffer = ""
		var depth = 0
		var quote = ""
		var length = arguments.source.len()

		for ( var index = 1; index <= length; index++ ) {
			var current = arguments.source.mid( index, 1 )

			if ( len( quote ) ) {
				buffer &= current
				if ( current == quote ) {
					quote = ""
				}
				continue
			}

			if ( current == """" || current == "'" ) {
				quote = current
				buffer &= current
				continue
			}

			if ( current == "(" ) {
				depth++
			} else if ( current == ")" ) {
				depth = max( depth - 1, 0 )
			}

			if ( depth == 0 && ( current == ";" || current == "{" || current == "}" ) ) {
				found.append( buffer )
				buffer = ""
				continue
			}

			if ( depth == 0 && current == char( 10 ) ) {
				if ( continuesChain( arguments.source, index ) ) {
					buffer &= current
					continue
				}

				found.append( buffer )
				buffer = ""
				continue
			}

			buffer &= current
		}

		found.append( buffer )

		return found.map( ( statement ) => trim( statement ) ).filter( ( statement ) => len( statement ) )
	}

	/**
	 * The name of the call a statement starts with, or "" when it doesn't
	 * start with one. A leading object reference (`router.`, `binder.`) is
	 * ignored, since a config class can address its own DSL either way.
	 *
	 * @statement A single statement
	 */
	string function initiatorOf( required string statement ) {
		var trimmed = trim( arguments.statement ).reReplace( "^[a-zA-Z_][a-zA-Z0-9_]*\s*\.\s*(?=[a-zA-Z_][a-zA-Z0-9_]*\s*\()", "" )
		var name = trimmed.reReplace( "^([a-zA-Z_][a-zA-Z0-9_]*)\s*\(.*$", "\1" )

		return name == trimmed ? "" : name
	}

	/**
	 * A statement with any leading object reference removed, so chained
	 * call detection sees the same text whichever way it was written.
	 *
	 * @statement A single statement
	 */
	string function withoutReceiver( required string statement ) {
		return trim( arguments.statement ).reReplace( "^[a-zA-Z_][a-zA-Z0-9_]*\s*\.\s*(?=[a-zA-Z_][a-zA-Z0-9_]*\s*\()", "" )
	}

	/**
	 * The argument text of the call a statement starts with.
	 *
	 * @statement The statement
	 *
	 * @return `{ content, closed }` - `closed` is false when the parentheses never balance
	 */
	struct function callArguments( required string statement ) {
		var open = find( "(", arguments.statement )

		if ( !open ) {
			return { "content" : "", "closed" : false }
		}

		return balancedBlock( arguments.statement, open, "(", ")" )
	}

	/**
	 * Whether a statement chains a given call, e.g. `.end()`.
	 *
	 * @statement The statement to search
	 * @call The chained method name
	 */
	boolean function hasCall( required string statement, required string call ) {
		return reFindNoCase( "\.\s*#arguments.call#\s*\(", arguments.statement ) > 0
	}

	/**
	 * The first string-literal argument of a chained call, e.g. the
	 * `"users.index"` in `.to( "users.index" )`. "" when the call isn't
	 * there, or when its argument isn't a literal.
	 *
	 * @statement The statement to search
	 * @call The chained method name
	 */
	string function chainedValue( required string statement, required string call ) {
		var position = reFindNoCase( "\.\s*#arguments.call#\s*\(", arguments.statement )

		if ( !position ) {
			return ""
		}

		var open = find( "(", arguments.statement, position )
		var block = balancedBlock( arguments.statement, open, "(", ")" )

		return literalArgument( parseArguments( block.content ), "", 1 )
	}

	/**
	 * Splits an argument list into positional and named arguments.
	 *
	 * @args The raw argument text
	 *
	 * @return `{ named : { name -> raw }, positional : [ raw, ... ] }`
	 */
	struct function parseArguments( required string args ) {
		var parsed = { "named" : {}, "positional" : [] }

		for ( var part in splitTopLevel( arguments.args, "," ) ) {
			var argument = trim( part )

			if ( !len( argument ) ) {
				continue
			}

			var match = reFind( "^([a-zA-Z_][a-zA-Z0-9_]*)[ #char( 9 )#]*[:=]([^=]|$)", argument, 1, true )

			if ( match.pos[ 1 ] > 0 ) {
				var name = argument.mid( match.pos[ 2 ], match.len[ 2 ] )
				parsed.named[ name ] = trim(
					argument.mid( match.pos[ 2 ] + match.len[ 2 ], argument.len() ).reReplace( "^[ #char( 9 )#]*[:=]", "" )
				)
			} else {
				parsed.positional.append( argument )
			}
		}

		return parsed
	}

	/**
	 * One argument's string-literal value: the named one if present, else
	 * the positional at `position` (1-based; 0 means "named only").
	 * Anything that isn't a quoted literal reads as "".
	 *
	 * @parsed A `parseArguments()` result
	 * @name The argument's name, or "" to look only at the position
	 * @position Its positional index, or 0 when it has none
	 */
	string function literalArgument( required struct parsed, required string name, required numeric position ) {
		if ( len( arguments.name ) && arguments.parsed.named.keyExists( arguments.name ) ) {
			return unquote( arguments.parsed.named[ arguments.name ] )
		}

		if ( arguments.position > 0 && arguments.parsed.positional.len() >= arguments.position ) {
			return unquote( arguments.parsed.positional[ arguments.position ] )
		}

		return ""
	}

	/**
	 * A list-or-array argument as an array of strings.
	 *
	 * @parsed A `parseArguments()` result
	 * @name The argument's name
	 */
	array function listArgument( required struct parsed, required string name ) {
		if ( !arguments.parsed.named.keyExists( arguments.name ) ) {
			return []
		}

		var raw = trim( arguments.parsed.named[ arguments.name ] )

		if ( raw.startsWith( "[" ) ) {
			return splitTopLevel( raw.reReplace( "^\[", "" ).reReplace( "\]$", "" ), "," )
				.map( ( entry ) => unquote( trim( entry ) ) )
				.filter( ( entry ) => len( entry ) )
		}

		return unquote( raw ).listToArray( "," ).map( ( entry ) => trim( entry ) )
	}

	/**
	 * Strips the surrounding quotes from a string literal, returning ""
	 * for anything that isn't one.
	 *
	 * @value The raw argument text
	 */
	string function unquote( required string value ) {
		var trimmed = trim( arguments.value )

		if ( trimmed.len() < 2 ) {
			return ""
		}

		var quote = trimmed.left( 1 )

		if ( ( quote != """" && quote != "'" ) || trimmed.right( 1 ) != quote ) {
			return ""
		}

		return trimmed.mid( 2, trimmed.len() - 2 )
	}

	/**
	 * Splits text on a delimiter that appears at top level only - one
	 * inside nested parens, braces, brackets or strings is left alone.
	 *
	 * @text The text to split
	 * @delimiter The single-character delimiter
	 */
	array function splitTopLevel( required string text, required string delimiter ) {
		var parts = []
		var buffer = ""
		var depth = 0
		var quote = ""
		var length = arguments.text.len()

		for ( var index = 1; index <= length; index++ ) {
			var current = arguments.text.mid( index, 1 )

			if ( len( quote ) ) {
				buffer &= current
				if ( current == quote ) {
					quote = ""
				}
				continue
			}

			if ( current == """" || current == "'" ) {
				quote = current
				buffer &= current
				continue
			}

			if ( current == "(" || current == "{" || current == "[" ) {
				depth++
			} else if ( current == ")" || current == "}" || current == "]" ) {
				depth = max( depth - 1, 0 )
			}

			if ( depth == 0 && current == arguments.delimiter ) {
				parts.append( buffer )
				buffer = ""
				continue
			}

			buffer &= current
		}

		parts.append( buffer )

		return parts
	}

	/**
	 * Every top-level `{ ... }` block in a piece of text, contents only.
	 *
	 * @text The text to scan
	 */
	array function topLevelBlocks( required string text ) {
		var blocks = []
		var index = 1
		var length = arguments.text.len()

		while ( index <= length ) {
			if ( arguments.text.mid( index, 1 ) == "{" ) {
				var block = balancedBlock( arguments.text, index, "{", "}" )
				blocks.append( block.content )
				index = block.endIndex + 1
				continue
			}

			index++
		}

		return blocks
	}

	/**
	 * The contents of the balanced block opening at `openIndex`.
	 *
	 * @text The text to scan
	 * @openIndex Index of the opening character
	 * @openChar The opening character
	 * @closeChar The closing character
	 *
	 * @return `{ content, endIndex, closed }`
	 */
	struct function balancedBlock(
		required string text,
		required numeric openIndex,
		required string openChar,
		required string closeChar
	) {
		var depth = 0
		var quote = ""
		var length = arguments.text.len()

		for ( var index = arguments.openIndex; index <= length; index++ ) {
			var current = arguments.text.mid( index, 1 )

			if ( len( quote ) ) {
				if ( current == quote ) {
					quote = ""
				}
				continue
			}

			if ( current == """" || current == "'" ) {
				quote = current
				continue
			}

			if ( current == arguments.openChar ) {
				depth++
			} else if ( current == arguments.closeChar ) {
				depth--

				if ( depth == 0 ) {
					return {
						"content"  : arguments.text.mid( arguments.openIndex + 1, index - arguments.openIndex - 1 ),
						"endIndex" : index,
						"closed"   : true
					}
				}
			}
		}

		return {
			"content"  : arguments.text.mid( arguments.openIndex + 1, length - arguments.openIndex ),
			"endIndex" : length,
			"closed"   : false
		}
	}

	/**
	 * Whether the first non-whitespace character after a newline chains
	 * onto the statement before it.
	 *
	 * @source The source being split
	 * @index The newline's index
	 */
	private boolean function continuesChain( required string source, required numeric index ) {
		var length = arguments.source.len()

		for ( var lookahead = arguments.index + 1; lookahead <= length; lookahead++ ) {
			var candidate = arguments.source.mid( lookahead, 1 )

			if ( candidate == " " || candidate == char( 9 ) || candidate == char( 13 ) || candidate == char( 10 ) ) {
				continue
			}

			return candidate == "."
		}

		return false
	}

}
