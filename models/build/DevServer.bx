/**
 * Backs the `serve` CLI verb (module spec section 2 - "Build + serve
 * locally with live reload"). Serves a project's `site/` over a plain JDK
 * `com.sun.net.httpserver.SimpleFileServer` (no external server binary or
 * compiled Java needed - just JDK interop, consistent with this module
 * staying BoxLang-first), and supports polling-based live reload: every
 * rebuilt page gets a small injected script that polls a `/__bxsites/version`
 * endpoint and reloads the browser when the served build version changes.
 *
 * `start()`/`stop()`/`checkAndRebuild()` are the real, independently
 * testable surface. The "watch forever" loop itself belongs to the CLI verb
 * (Serve.bx), since blocking there - not here - is what keeps this class
 * testable without hanging a test run.
 *
 * `startWatching()`/`stopWatching()` are Serve.bx's own real watch-mode
 * seam - a BoxLang native `watcherNew()` (module docs: "Directory & File
 * Watchers") on `docs/`, `bxsites.json`/`.yaml`/`.yml` and a project
 * `theme/` override reacts to a change almost immediately instead of
 * Serve.bx's own old 1-second `checkAndRebuild()` poll loop, and
 * BuildPipeline.bx's own per-page content cache (see convertMarkdown()'s
 * docblock) turns a single-page edit's own rebuild into reconverting just
 * that one page rather than every page in every tree. A watcher event only
 * ever marks state dirty; a small native `schedulerNew()` task (its own
 * `withNoOverlaps()`) is what actually calls rebuild() on a short fixed
 * cadence, so a burst of rapid saves - an editor's own atomic-write dance,
 * a find-and-replace across several files - collapses into exactly one
 * rebuild rather than one per file, and a rebuild already in flight is
 * never overlapped by another.
 */
class {

	variables.buildPipeline = new "models.build.BuildPipeline@bxsites"()
	variables.configLoader  = new "models.config.ConfigLoader@bxsites"()
	variables.sourceDirResolver = new "models.config.SourceDirResolver@bxsites"()
	variables.pathRelativizer = new "models.build.PathRelativizer@bxsites"()
	variables.projectRoot   = ""
	variables.fileFingerprint = { count : 0, maxModified : 0 }
	variables.buildVersion  = 0
	variables.started       = false
	variables.watching      = false
	variables.hasWatcher    = false
	variables.dirty         = false
	variables.needsCacheClear = false
	variables.watchedDocsDir = ""
	variables.configPath    = ""
	variables.lastConfigMtime = 0

	/**
	 * Swaps in a fake/test markdown renderer, forwarded straight to the
	 * underlying BuildPipeline - see MarkdownRenderer.bx's docblock for why
	 * this seam exists.
	 *
	 * @renderer Any object exposing `toHtml( markdown, options = {} )`
	 */
	void function setMarkdownRenderer( required any renderer ) {
		variables.buildPipeline.setMarkdownRenderer( arguments.renderer )
	}

	/**
	 * Builds the project, starts the static file server, and injects the
	 * live-reload poller into the freshly built pages.
	 *
	 * @projectRoot Absolute path to the project root
	 * @port TCP port to listen on (0 lets the OS pick a free port)
	 * @host Host/interface to bind to
	 *
	 * @return { url, port }
	 */
	struct function start( required string projectRoot, numeric port = 8080, string host = "127.0.0.1" ) {
		variables.projectRoot = arguments.projectRoot.reReplace( "[\/]+$", "" )

		println( "Building site for serve..." )
		variables.buildPipeline.setProfiling( true )
		rebuild()
		println( "Initial site build complete." )

		var addr = createObject( "java", "java.net.InetSocketAddress" ).init( arguments.host, javaCast( "int", arguments.port ) )
		var rootPath = createObject( "java", "java.nio.file.Paths" ).get( variables.projectRoot & "/site", [] )
		var outputLevel = createObject( "java", "com.sun.net.httpserver.SimpleFileServer$OutputLevel" ).NONE

		variables.httpServer = createObject( "java", "com.sun.net.httpserver.SimpleFileServer" ).createFileServer( addr, rootPath, outputLevel )
		variables.httpServer.createContext( "/__bxsites/version", versionHandler() )
		variables.httpServer.start()
		variables.started = true

		var boundPort = variables.httpServer.getAddress().getPort()

		return {
			url  : "http://#arguments.host#:#boundPort#/",
			port : boundPort
		}
	}

	/**
	 * Stops the file server, and native watching if it was started. Safe to
	 * call even if `start()`/`startWatching()` were never called.
	 */
	void function stop() {
		stopWatching()
		if ( variables.started ) {
			variables.httpServer.stop( javaCast( "int", 0 ) )
			variables.started = false
		}
	}

	/**
	 * Starts native watching of `docs/` (or `src/`), `bxsites.json`/`.yaml`/
	 * `.yml`/`.toml` and a project `theme/` override (whichever exist), reacting to
	 * a real filesystem change instead of Serve.bx's own old 1-second
	 * `checkAndRebuild()` poll loop - see this class's own docblock. Safe to
	 * call more than once; a later call replaces the running watcher/scheduler.
	 */
	void function startWatching() {
		stopWatching()

		var docsDir = variables.sourceDirResolver.resolve( variables.projectRoot )
		var themeDir = variables.projectRoot & "/theme"

		// watcherNew() only ever registers directories, never a single file
		// (bxsites.json/.yaml/.yml) - and site/ itself can never safely be
		// watched, recursively or not, since rebuild() writes there itself
		// (a self-triggering rebuild loop) - so the config file gets a
		// plain, near-free mtime check instead, from the scheduler's own
		// tick below, same as docs/ and theme/ get a real native watch.
		variables.configPath = variables.configLoader.configPathFor( variables.projectRoot )
		variables.lastConfigMtime = fileExists( variables.configPath ) ? createObject( "java", "java.io.File" ).init( variables.configPath ).lastModified() : 0

		var watchPaths = []
		if ( directoryExists( docsDir ) ) {
			watchPaths.append( docsDir )
		}
		if ( directoryExists( themeDir ) ) {
			watchPaths.append( themeDir )
		}

		// Normalized once here so onWatchEvent()'s own startsWith() compares
		// like separators against like - the watcher hands back a native
		// java.nio.file.Path's toString(), backslash-separated on Windows,
		// while docsDir was built with a plain "/" join; left un-normalized
		// on either side, that prefix check never matches on Windows and
		// every edit looks like a non-page change (a correctness downgrade,
		// not a crash - see PathRelativizer.bx for the sibling bug that
		// actually did crash the build).
		variables.watchedDocsDir = variables.pathRelativizer.normalize( docsDir )
		variables.dirty = false
		variables.needsCacheClear = false

		var watcherName = "bxsites-serve-" & hash( variables.projectRoot )
		variables.hasWatcher = watchPaths.len() > 0
		if ( variables.hasWatcher ) {
			variables.watcher = watcherNew(
				name       : watcherName,
				paths      : watchPaths,
				listener   : ( event ) => onWatchEvent( event ),
				recursive  : true,
				debounce   : 250,
				atomicWrites : true
			).start()
		}

		variables.scheduler = schedulerNew( name : watcherName & "-scheduler" )
		variables.scheduler.task( "rebuild-if-dirty" ).call( () => onSchedulerTick() ).every( 300, "milliseconds" ).withNoOverlaps()
		variables.scheduler.startup()

		variables.watching = true
	}

	/**
	 * Stops native watching. Safe to call even if `startWatching()` was
	 * never called, or has already been stopped.
	 */
	void function stopWatching() {
		if ( variables.watching ) {
			if ( variables.hasWatcher ) {
				variables.watcher.stop( javaCast( "boolean", true ) )
				variables.hasWatcher = false
			}
			variables.scheduler.shutdown()
			variables.watching = false
		}
	}

	/**
	 * `startWatching()`'s own watcher listener - never rebuilds directly
	 * (a burst of rapid saves would otherwise trigger one rebuild per
	 * event); only records that *something* changed, and - unless the
	 * change was a single page's own markdown under docs/ (BuildPipeline.bx's
	 * per-page content cache already handles that case correctly on its
	 * own via that file's own changed mtime) - that the dev cache needs a
	 * full clear, since a theme change isn't reflected in any one page's
	 * own source mtime. `onSchedulerTick()` is what actually rebuilds.
	 *
	 * @event { kind, path } - see BoxLang's own watcherNew() docs
	 */
	private void function onWatchEvent( required struct event ) {
		var path = variables.pathRelativizer.normalize( arguments.event.path ?: "" )
		var isPageEdit = len( path ) && path.startsWith( variables.watchedDocsDir ) && path.reFindNoCase( "\.md$" )
		if ( !isPageEdit ) {
			variables.needsCacheClear = true
		}
		variables.dirty = true
	}

	/**
	 * `startWatching()`'s own scheduled task - runs on a short fixed
	 * cadence (rather than once per watcher event) so several rapid
	 * changes collapse into exactly one rebuild; its own `withNoOverlaps()`
	 * skips a tick entirely rather than starting a second rebuild while one
	 * is already in flight. Also carries the config file's own plain mtime
	 * check (see startWatching()'s own docblock for why that file can't
	 * just be handed to watcherNew() directly).
	 */
	private void function onSchedulerTick() {
		if ( len( variables.configPath ) && fileExists( variables.configPath ) ) {
			var configMtime = createObject( "java", "java.io.File" ).init( variables.configPath ).lastModified()
			if ( configMtime != variables.lastConfigMtime ) {
				variables.lastConfigMtime = configMtime
				variables.needsCacheClear = true
				variables.dirty = true
			}
		}

		if ( !variables.dirty ) {
			return
		}
		variables.dirty = false
		var shouldClearCache = variables.needsCacheClear
		variables.needsCacheClear = false
		if ( shouldClearCache ) {
			variables.buildPipeline.clearDevCache()
		}
		println( "Change detected; rebuilding site..." )
		rebuild()
		println( "Site rebuilt; live-reload clients will refresh." )
	}

	/**
	 * Rebuilds the project if `docs/` (or `src/`), `bxsites.json` or a project
	 * `theme/` override changed since the last build, bumping the version the
	 * live-reload poller compares against. Cheap to call repeatedly - the
	 * CLI verb's own watch loop is expected to call this every second or so
	 * while `serve` is running in the foreground.
	 *
	 * @return true if a rebuild actually happened
	 */
	boolean function checkAndRebuild() {
		var current = currentFingerprint()
		if ( current.count == variables.fileFingerprint.count && current.maxModified == variables.fileFingerprint.maxModified ) {
			return false
		}
		rebuild()
		return true
	}

	/**
	 * The live-reload poller's current version number, exposed for tests -
	 * the same value the `/__bxsites/version` endpoint serves.
	 */
	numeric function getBuildVersion() {
		return variables.buildVersion
	}

	/**
	 * Runs a full BuildPipeline.build() - with blog drafts included, so a
	 * post can be previewed locally before its `date` arrives or its
	 * `draft: true` is lifted (BuildPipeline.build()'s own `includeDrafts`,
	 * never on for a real `bxSites build`) - re-injects the live-reload
	 * script, and bumps `buildVersion` so polling clients pick up the change.
	 */
	private void function rebuild() {
		variables.buildPipeline.build( variables.projectRoot, true )
		injectLiveReload()
		variables.fileFingerprint = currentFingerprint()
		variables.buildVersion++
	}

	/**
	 * Appends the live-reload poller script to every built page and writes
	 * the poller script itself to `site/__bxsites-live-reload.js` - both
	 * wiped and rewritten on every rebuild, since BuildPipeline.build()
	 * deletes and recreates `site/` wholesale each time.
	 */
	private void function injectLiveReload() {
		var siteDir = variables.projectRoot & "/site"
		fileWrite( siteDir & "/__bxsites-live-reload.js", liveReloadScript() )

		var scriptTag = '<script src="/__bxsites-live-reload.js"></script></body>'
		for ( var path in directoryList( siteDir, true, "path", "*.html" ) ) {
			var html = fileRead( path )
			if ( html.findNoCase( "</body>" ) ) {
				fileWrite( path, html.reReplaceNoCase( "</body>", scriptTag, "one" ) )
			}
		}
	}

	/**
	 * Snapshots the watched files' count and newest modified time, so
	 * checkAndRebuild() can detect a change without re-reading file
	 * contents.
	 *
	 * @return { count, maxModified } across the site config (bxsites.yaml/.yml/.json, whichever is present), docs/** and a project theme/ override, if present
	 */
	private struct function currentFingerprint() {
		var paths = []
		var configPath = variables.configLoader.configPathFor( variables.projectRoot )
		if ( fileExists( configPath ) ) {
			paths.append( configPath )
		}
		var docsDir = variables.sourceDirResolver.resolve( variables.projectRoot )
		if ( directoryExists( docsDir ) ) {
			paths.addAll( directoryList( docsDir, true, "path" ) )
		}
		if ( directoryExists( variables.projectRoot & "/theme" ) ) {
			paths.addAll( directoryList( variables.projectRoot & "/theme", true, "path" ) )
		}

		var maxModified = 0
		for ( var path in paths ) {
			var lastModified = createObject( "java", "java.io.File" ).init( path ).lastModified()
			if ( lastModified > maxModified ) {
				maxModified = lastModified
			}
		}

		return { count : paths.len(), maxModified : maxModified }
	}

	/**
	 * A closure handed straight to `HttpServer.createContext()` as its
	 * `HttpHandler` - BoxLang closures satisfy single-method Java functional
	 * interfaces directly, no adapter class needed.
	 */
	private any function versionHandler() {
		return function( exchange ) {
			var body = createObject( "java", "java.lang.String" ).init( toString( variables.buildVersion ) ).getBytes()
			exchange.getResponseHeaders().add( "Content-Type", "text/plain" )
			exchange.getResponseHeaders().add( "Cache-Control", "no-store" )
			exchange.sendResponseHeaders( javaCast( "int", 200 ), javaCast( "long", arrayLen( body ) ) )
			var responseBody = exchange.getResponseBody()
			responseBody.write( body )
			responseBody.close()
		}
	}

	/**
	 * Builds the client-side poller script - polls `/__bxsites/version` and
	 * reloads the page the first time the version number changes.
	 */
	private string function liveReloadScript() {
		var lines = [
			"(function () {",
			"	var lastVersion = null;",
			"	setInterval( function () {",
			'		fetch( "/__bxsites/version", { cache : "no-store" } )',
			"			.then( function ( res ) { return res.text(); } )",
			"			.then( function ( version ) {",
			"				if ( lastVersion === null ) {",
			"					lastVersion = version;",
			"					return;",
			"				}",
			"				if ( version !== lastVersion ) {",
			"					location.reload();",
			"				}",
			"			} )",
			'			.catch( function () {} );',
			"	}, 1000 );",
			"})();",
			""
		]
		return lines.toList( char( 10 ) )
	}

}
