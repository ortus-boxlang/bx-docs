/**
 * Reads the literal declarations out of a ColdBox configuration class:
 * a `ModuleConfig`'s `this.*` properties, and the interceptors an app's
 * `config/ColdBox` registers. (`config/WireBox` and `config/Scheduler`
 * have their own parsers, since both are fluent DSLs rather than plain
 * declarations.)
 *
 * Same static-only contract as `ColdBoxAppScanner` and
 * `ColdBoxRouterParser`: nothing is executed, so only literal values are
 * readable. A property assigned from a variable, an environment lookup or
 * a function call is reported as absent rather than guessed at.
 */
class {

	/**
	 * The `this.*` properties a module declares about itself, in the
	 * order they're worth reading on a page. Anything not in this list is
	 * still returned by `thisProperties()`, just not promoted into the
	 * module's own summary.
	 */
	static {
		moduleKeys = [
			"title",
			"author",
			"webURL",
			"description",
			"version",
			"entryPoint",
			"modelNamespace",
			"cfmapping",
			"autoMapModels",
			"dependencies",
			"disabled"
		]
	}

	/**
	 * A module's own declared metadata.
	 *
	 * @configFile Absolute path to a `ModuleConfig.bx`/`.cfc`
	 *
	 * @return A struct of every readable `this.*` property; empty when the file doesn't exist
	 */
	struct function moduleMetadata( required string configFile ) {
		if ( !fileExists( arguments.configFile ) ) {
			return {}
		}

		return thisProperties( fileRead( arguments.configFile ) )
	}

	/**
	 * The interceptors an application registers in its `config/ColdBox`.
	 *
	 * ColdBox takes these as an array of structs - `{ class : "...",
	 * name : "...", properties : {} }` - which is a data literal rather
	 * than a fluent chain, so it's read as one: the `interceptors` array
	 * is located, then each entry's own `class`/`name` literal is read
	 * out of it. An entry whose class is computed has nothing literal to
	 * read and is skipped, as everywhere else here.
	 *
	 * @configFile Absolute path to a `ColdBox.bx`/`.cfc`
	 *
	 * @return Array of `{ class, name }` structs
	 */
	array function interceptorDeclarations( required string configFile ) {
		if ( !fileExists( arguments.configFile ) ) {
			return []
		}

		var reader = new "models.build.BoxLangSourceReader@bxsites"()
		var source = reader.stripComments( fileRead( arguments.configFile ) )
		var position = reFindNoCase( "interceptors[ #char( 9 )#]*=[ #char( 9 )#]*\[", source )

		if ( !position ) {
			return []
		}

		var open = find( "[", source, position )
		var block = reader.balancedBlock( source, open, "[", "]" )

		if ( !block.closed ) {
			return []
		}

		var declarations = []

		for ( var entry in reader.splitTopLevel( block.content, "," ) ) {
			var className = literalKey( entry, "class" )

			if ( !len( className ) ) {
				continue
			}

			declarations.append( { "class" : className, "name" : literalKey( entry, "name" ) } )
		}

		return declarations
	}

	/**
	 * A `key : "value"` literal inside a struct literal's text.
	 *
	 * @text The struct literal's text
	 * @key The key to read
	 */
	private string function literalKey( required string text, required string key ) {
		var match = reFindNoCase(
			"#arguments.key#[ #char( 9 )#]*[:=][ #char( 9 )#]*([""'])([^""']*)\1",
			arguments.text,
			1,
			true
		)

		return match.pos[ 1 ] > 0 ? arguments.text.mid( match.pos[ 3 ], match.len[ 3 ] ) : ""
	}

	/**
	 * Every `this.<name> = <literal>` assignment in a class' source.
	 *
	 * Values are returned in their natural type where that's unambiguous:
	 * a quoted literal as a string, `true`/`false` as a boolean, a bare
	 * number as a number, and a flat `[ ... ]` literal as an array of
	 * strings. Anything else (a struct, an expression, a function call) is
	 * skipped - see this class' docblock.
	 *
	 * @source The class' source code
	 *
	 * @return Struct of property name -> value
	 */
	struct function thisProperties( required string source ) {
		var properties = {}
		var matches = arguments.source.reMatch( "this\.[a-zA-Z_][a-zA-Z0-9_]*[ #char( 9 )#]*=[^=]" )

		for ( var match in matches ) {
			var name = match.reReplace( "^this\.", "" ).reReplace( "[ #char( 9 )#]*=.*$", "" )
			var position = arguments.source.find( match )

			if ( !position ) {
				continue
			}

			var value = readValue( arguments.source, position + match.len() - 1 )

			if ( !isNull( value ) ) {
				properties[ name ] = value
			}
		}

		return properties
	}

	/**
	 * Reads the literal starting at `start`, or returns null when what's
	 * there isn't one.
	 *
	 * @source The class' source
	 * @start Index of the assignment's first value character
	 */
	private any function readValue( required string source, required numeric start ) {
		var index = arguments.start
		var length = arguments.source.len()

		while ( index <= length && isWhitespace( arguments.source.mid( index, 1 ) ) ) {
			index++
		}

		if ( index > length ) {
			return javacast( "null", "" )
		}

		var current = arguments.source.mid( index, 1 )

		if ( current == """" || current == "'" ) {
			return readString( arguments.source, index )
		}

		if ( current == "[" ) {
			return readArray( arguments.source, index )
		}

		var word = arguments.source.mid( index, min( 5, length - index + 1 ) )

		if ( word.left( 4 ) == "true" ) {
			return true
		}

		if ( word.left( 5 ) == "false" ) {
			return false
		}

		var number = arguments.source.mid( index, length - index + 1 ).reReplace( "^([0-9]+(\.[0-9]+)?).*$", "\1", "one" )

		return reFind( "^[0-9]", number ) && !number.find( char( 10 ) ) ? val( number ) : javacast( "null", "" )
	}

	/**
	 * The contents of the string literal opening at `start`.
	 *
	 * @source The class' source
	 * @start Index of the opening quote
	 */
	private string function readString( required string source, required numeric start ) {
		var quote = arguments.source.mid( arguments.start, 1 )
		var length = arguments.source.len()

		for ( var index = arguments.start + 1; index <= length; index++ ) {
			if ( arguments.source.mid( index, 1 ) == quote ) {
				return arguments.source.mid( arguments.start + 1, index - arguments.start - 1 )
			}
		}

		return ""
	}

	/**
	 * A flat array literal's string entries. A nested or computed entry
	 * reads as "" and is dropped.
	 *
	 * @source The class' source
	 * @start Index of the opening bracket
	 */
	private array function readArray( required string source, required numeric start ) {
		var length = arguments.source.len()
		var depth = 0

		for ( var index = arguments.start; index <= length; index++ ) {
			var current = arguments.source.mid( index, 1 )

			if ( current == "[" ) {
				depth++
			} else if ( current == "]" ) {
				depth--

				if ( depth == 0 ) {
					var body = arguments.source.mid( arguments.start + 1, index - arguments.start - 1 )

					return body.listToArray( "," )
						.map( ( entry ) => trim( entry ).reReplace( "^[""']", "" ).reReplace( "[""']$", "" ) )
						.filter( ( entry ) => len( entry ) )
				}
			}
		}

		return []
	}

	/**
	 * Whether a character is whitespace, including the tab and carriage
	 * return a hand-formatted config is full of.
	 *
	 * @character The single character to test
	 */
	private boolean function isWhitespace( required string character ) {
		return [ " ", char( 9 ), char( 10 ), char( 13 ) ].findNoCase( arguments.character ) > 0
	}

}
