/**
 * Orchestrates the full `build` verb end to end (module spec section 5):
 * load config -> load docs -> build nav -> convert markdown -> render
 * through the theme -> write site/ -> build the search index -> copy assets.
 * Also backs the standalone `search-index` verb (buildSearchIndex()).
 */
class {

	variables.configLoader     = new "models.config.ConfigLoader@bxsites"()
	variables.sourceDirResolver = new "models.config.SourceDirResolver@bxsites"()
	variables.stringsResolver  = new "models.config.StringsResolver@bxsites"()
	variables.docsLoader       = new "models.build.DocsLoader@bxsites"()
	variables.navBuilder       = new "models.build.NavBuilder@bxsites"()
	variables.themeRenderer    = new "models.build.ThemeRenderer@bxsites"()
	variables.searchIndexer    = new "models.build.SearchIndexer@bxsites"()
	variables.searchProviderRegistry = new "models.build.SearchProviderRegistry@bxsites"()
	variables.pagefindIndexer  = new "models.build.PagefindIndexer@bxsites"()
	variables.tableOfContents  = new "models.build.TableOfContents@bxsites"()
	variables.baseUrlResolver  = new "models.build.BaseUrlResolver@bxsites"()
	variables.sitemapGenerator = new "models.build.SitemapGenerator@bxsites"()
	variables.robotsTxtGenerator = new "models.build.RobotsTxtGenerator@bxsites"()
	variables.llmsTxtGenerator = new "models.build.LlmsTxtGenerator@bxsites"()
	variables.markdownRenderer = new "models.build.MarkdownRenderer@bxsites"()
	variables.gitRevisionDate  = new "models.build.GitRevisionDate@bxsites"()
	variables.versionsDiscoverer = new "models.build.VersionsDiscoverer@bxsites"()
	variables.localesDiscoverer = new "models.build.LocalesDiscoverer@bxsites"()
	variables.tagsIndexBuilder = new "models.build.TagsIndexBuilder@bxsites"()
	variables.redirectGenerator = new "models.build.RedirectGenerator@bxsites"()
	variables.socialCardGenerator = new "models.build.SocialCardGenerator@bxsites"()
	variables.tabsProcessor = new "models.build.TabsProcessor@bxsites"()
	variables.mathProtector = new "models.build.MathProtector@bxsites"()
	variables.codeAnnotationProcessor = new "models.build.CodeAnnotationProcessor@bxsites"()
	variables.tableWrapProcessor = new "models.build.TableWrapProcessor@bxsites"()
	variables.tryBoxLangProcessor = new "models.build.TryBoxLangProcessor@bxsites"()
	variables.markdownLinkResolver = new "models.build.MarkdownLinkResolver@bxsites"()
	variables.markdownPublisher = new "models.build.MarkdownPublisher@bxsites"()
	variables.includeProcessor = new "models.build.IncludeProcessor@bxsites"()
	variables.directiveBlockProcessor = new "models.build.DirectiveBlockProcessor@bxsites"()
	variables.pageLinkResolver = new "models.build.PageLinkResolver@bxsites"()
	variables.updatesFeedGenerator = new "models.build.UpdatesFeedGenerator@bxsites"()
	variables.pluginLoader = new "models.build.PluginLoader@bxsites"()
	variables.functionsLoader = new "models.build.FunctionsLoader@bxsites"()
	variables.dataLoader = new "models.build.DataLoader@bxsites"()
	variables.courseBuilder = new "models.build.CourseBuilder@bxsites"()
	variables.variablesProcessor = new "models.build.VariablesProcessor@bxsites"()
	variables.iconResolver = new "models.build.IconResolver@bxsites"()
	variables.imageVariantGenerator = new "models.build.ImageVariantGenerator@bxsites"()
	variables.responsiveImageProcessor = new "models.build.ResponsiveImageProcessor@bxsites"()
	variables.assetBundler = new "models.build.AssetBundler@bxsites"()
	variables.fingerprinter = new "models.build.AssetFingerprinter@bxsites"()
	variables.blogDiscoverer = new "models.build.BlogDiscoverer@bxsites"()
	variables.blogAuthorsLoader = new "models.build.BlogAuthorsLoader@bxsites"()
	variables.blogBuilder = new "models.build.BlogBuilder@bxsites"()
	variables.blogFeedGenerator = new "models.build.BlogFeedGenerator@bxsites"()
	variables.pageCache = new "models.build.BuildCache@bxsites"()
	// The first tree's own already-written assets/ directory in the
	// current build() call, once copyAssets() has run for real once -
	// every later tree hardlinks from here instead of re-copying
	// identical bytes. Reset at the top of build() (never carried over
	// from a previous build() call on the same instance); see
	// copyAssets()'s own docblock.
	variables.canonicalAssetsDir = ""
	variables.pluginsOverride = []
	variables.hasPluginsOverride = false
	variables.profiling = false
	variables.profileTimings = []
	variables.profileLastAt = 0

	/**
	 * Enables phase timing for a focused build investigation. Disabled by
	 * default so normal CLI output and build behavior remain unchanged.
	 */
	void function setProfiling( required boolean enabled ) {
		variables.profiling = arguments.enabled
	}

	/**
	 * Swaps in a fake/test markdown renderer. The real one (MarkdownRenderer.bx)
	 * depends on the bx-markdown module being activated, which this
	 * pipeline's own unit tests don't have - see MarkdownRenderer.bx's
	 * docblock for why that dependency is kept behind this seam.
	 *
	 * @renderer Any object exposing `toHtml( markdown, options = {} )`
	 */
	void function setMarkdownRenderer( required any renderer ) {
		variables.markdownRenderer = arguments.renderer
	}

	/**
	 * Swaps in a fake/test pagefind indexer. The real one (PagefindIndexer.bx)
	 * shells out to the external `pagefind` CLI, which this pipeline's own
	 * unit tests can't assume is installed - see PagefindIndexer.bx's own
	 * docblock for why it fails loud rather than degrading silently.
	 *
	 * @indexer Any object exposing `index( siteDir, bin = "pagefind", options = [] )`
	 */
	void function setPagefindIndexer( required any indexer ) {
		variables.pagefindIndexer = arguments.indexer
	}

	/**
	 * Swaps in a fake/test image variant generator. The real one
	 * (ImageVariantGenerator.bx) calls bx-image's own `imageRead()`/
	 * `.scaleToFit()`/`.write()`, which this pipeline's own unit tests
	 * can't assume is installed - same reasoning as setMarkdownRenderer()/
	 * setPagefindIndexer() above.
	 *
	 * @generator Any object exposing `buildManifest( docsAssetsDir, imagesConfig, cacheDir )` and `copyToOutput( manifest, outputAssetsDir )`
	 */
	void function setImageVariantGenerator( required any generator ) {
		variables.imageVariantGenerator = arguments.generator
	}

	/**
	 * Bypasses PluginLoader.discover() (real BoxLang module lookup - no
	 * unit test of its own, see PluginLoader.bx's docblock) with an
	 * already-resolved plugins list, so BuildPipelineSpec.bx can test the
	 * pipeline's own onConfig/onPageMarkdown/onPageHtml/onNav/onBuildComplete
	 * wiring against plain fake plugin objects without a real second
	 * BoxLang module registered.
	 *
	 * @plugins PluginLoader.discover()'s own output shape: array of { name, instance }
	 */
	void function setPlugins( required array plugins ) {
		variables.pluginsOverride = arguments.plugins
		variables.hasPluginsOverride = true
	}

	/**
	 * Runs the full `build` verb end to end: load config -> resolve plugins
	 * -> render the main doc tree, every `docs/versions/<name>/` tree (plus,
	 * by the same by-convention rule one level down, every
	 * `docs/versions/<name>/i18n/<code>/` tree composed onto it), and every
	 * top-level `docs/i18n/<code>/` tree -> copy assets -> write
	 * 404/tags/sitemap.xml/llms.txt -> fire `onBuildComplete`.
	 *
	 * Versions and locales compose one level: a `docs/versions/<name>/`
	 * tree's own default-locale render shows a language switcher too, listing
	 * only the locales that version itself has translations for
	 * (`docs/versions/<name>/i18n/<code>/`, discovered the same
	 * by-convention way as the top-level `docs/i18n/<code>/` - see
	 * LocalesDiscoverer.bx) - a version with no `i18n/` subfolder of its own
	 * renders exactly as before, no switcher shown. Both switchers always
	 * link to a tree's own homepage (never attempt to land on "the same page
	 * in the other tree" - see renderVersionSwitcher()/renderLocaleDropdown()
	 * in a theme's own layout.bxm), and each stays scoped to the axis it
	 * belongs to: the version switcher on a
	 * `versions/2.0/es/` page still lists every version (switching version
	 * always drops back to that version's own default locale, never
	 * assumes the target version has the same translation), while the
	 * locale switcher there only lists locales *that version itself*
	 * translates (switching locale always stays on the current version).
	 *
	 * @projectRoot Absolute path to the project root
	 * @includeDrafts Include blog posts whose frontmatter sets `draft: true` - `false` (the default) for a real build; DevServer.bx's own `bxSites serve` passes `true` so a draft can be previewed locally (BlogBuilder.bx stamps a visible "🚧 Draft" badge on one whenever this is on) without it ever leaking into an actual `bxSites build`
	 *
	 * @return { siteDir, pageCount }
	 */
	struct function build( required string projectRoot, boolean includeDrafts = false ) {
		var root = normalizeRoot( arguments.projectRoot )
		var buildStartedAt = getTickCount()
		variables.profileTimings = []
		variables.profileLastAt = buildStartedAt
		variables.canonicalAssetsDir = ""
		progress( "Loading configuration and content" )
		var config = variables.configLoader.load( root )
		var plugins = resolvePlugins( config )
		config = variables.pluginLoader.applyOnConfig( plugins, config )
		var docsDir = variables.sourceDirResolver.resolve( root )
		// A project's own "magic functions" (module spec section 8) - a
		// single project-wide `docs/functions.bxs`, loaded once here rather
		// than per version/locale tree, so a project doesn't need to
		// duplicate the file into every `docs/versions/<name>/` or
		// `docs/i18n/<code>/` folder to keep the same functions working
		// everywhere - see FunctionsLoader.bx's own docblock.
		var functions = variables.functionsLoader.load( docsDir )
		// A project's own reusable structured data (docs/guides/data-files.md) -
		// docs/data/*.yaml|.yml|.toml|.json, one file per top-level key. Same
		// project-wide, load-once scope as functions above, for the same
		// reason - see DataLoader.bx's own docblock.
		var data = variables.dataLoader.load( docsDir )
		var assetPipeline = applyAssetPipeline( config, root, docsDir )
		config = assetPipeline.config
		var imageManifest = variables.imageVariantGenerator.buildManifest( docsDir & "/assets", config.assets.images, root & "/.cache/images", config.assets.fingerprint )
		var urls = variables.baseUrlResolver.resolve( config.baseURL )
		// The scheme+host portion alone (e.g. "https://example.com", no
		// trailing slash) - `urls.absolute` always equals `origin & urls.basePath`
		// by construction (BaseUrlResolver.bx), but a page's own canonical URL
		// needs *this tree's own* basePath (a locale/version tree's own
		// prefix, not the site's global one) stitched onto that same origin -
		// see canonicalUrlFor()'s own docblock.
		var siteOrigin = len( urls.absolute ) ? left( urls.absolute, len( urls.absolute ) - len( urls.basePath ) ) : ""
		var themeDir = variables.themeRenderer.resolveThemeDir( config.theme.name, root )
		config.theme.styleUrl = resolveThemeStyleUrl( themeDir, config.assets.fingerprint )
		var siteDir = root & "/site"

		if ( directoryExists( siteDir ) ) {
			directoryDelete( siteDir, true )
		}
		directoryCreate( siteDir, true, true )

		var versionNames = variables.versionsDiscoverer.discover( docsDir )
		// `versions.default` (empty, the common case, changes nothing below)
		// names which docs/versions/<name>/ folder should build AT THE SITE
		// ROOT instead of the plain docs/ tree - the plain tree then builds
		// separately at /next/ instead (see the block right after
		// copyAssets() below), previewing whatever's being written toward
		// the next release. See docs/guides/versioning.md.
		var defaultVersionName = trim( config.versions.default ?: "" )
		var hasDefaultVersion = len( defaultVersionName ) > 0
		if ( hasDefaultVersion && !versionNames.contains( defaultVersionName ) ) {
			throw(
				type    = "BxSites.UnknownDefaultVersion",
				message = "versions.default [#defaultVersionName#] does not match any docs/versions/* folder"
			)
		}
		var rootDocsDir = hasDefaultVersion ? ( docsDir & "/versions/" & defaultVersionName ) : docsDir
		var rootVersionLabel = hasDefaultVersion ? defaultVersionName : "Latest"
		var rootDocsRelativePrefix = hasDefaultVersion ? ( "versions/" & defaultVersionName & "/" ) : ""
		var versions = buildVersionsList( versionNames, urls.basePath, defaultVersionName )

		var localeNames = variables.localesDiscoverer.discover( rootDocsDir )
		var locales = buildLocalesList( localeNames, config.i18n, urls.basePath )
		var defaultLocaleCode = config.i18n.defaultLocale.code
		var defaultLocaleDir = config.i18n.defaultLocale.dir ?: "ltr"

		var navConfig = resolveExplicitNav( rootDocsDir, config.nav )
		var mainPages = variables.docsLoader.load( rootDocsDir )
		profile( "setup and main docs load", buildStartedAt )
		// A `404.md` at the root of whichever tree renders at the site root
		// is the custom-404 convention (write404Page()'s own docblock) -
		// pulled out here, before it ever reaches renderDocTree(), so it's
		// never built as a normal page (nav entry, sitemap.xml URL,
		// tags/search index) that nothing else links to. When
		// `versions.default` is set, the physical docs/ tree (rendered
		// separately at /next/, below) stays the single source of truth for
		// this instead - a copy of 404.md a cut version snapshot may carry
		// along is stripped here too, just never treated as the real one.
		var custom404Page = mainPages.filter( p => compareNoCase( p.relativePath, "404.md" ) == 0 )
		if ( custom404Page.len() ) {
			mainPages = mainPages.filter( p => compareNoCase( p.relativePath, "404.md" ) != 0 )
		}
		if ( hasDefaultVersion ) {
			custom404Page = []
		}
		// Loaded (frontmatter parsed, not yet markdown-converted) up front,
		// purely so the main tree's own nav can carry a "Blog" entry from
		// its very first render - see renderDocTree()'s own blogNavUrl
		// docblock. The full post-processing/rendering pass happens after
		// the main tree (and every version/locale tree) is done, alongside
		// the tags page/sitemap/llms.txt/search index, all of which fold
		// blog posts in too.
		var blogPosts = variables.blogDiscoverer.load( docsDir, arguments.includeDrafts )
		var blogNavUrl = blogPosts.len() ? "blog/index.html" : ""
		var mainResult = renderDocTree( mainPages, rootDocsDir, config, themeDir, siteDir, urls.basePath, root, versions, rootVersionLabel, rootDocsRelativePrefix, plugins, urls.absolute, imageManifest, navConfig, locales, defaultLocaleCode, defaultLocaleDir, blogNavUrl, siteOrigin, functions, data )
		profile( "main tree", buildStartedAt )
		progress( "Copying main site assets" )
		var allPages = duplicate( mainResult.pages )
		copyAssets( root, themeDir, siteDir, config.theme.name, searchNeedsLocalIndex( config ), config.mermaid, config.math, config.openapi, config.pageActions, imageManifest, assetPipeline.cssBundle, assetPipeline.jsBundle, config.assets.fingerprint )
		profile( "main assets", buildStartedAt )

		// The plain docs/ tree - "the root" itself when versions.default is
		// unset - instead renders separately at /next/ once a default
		// version has taken over the root, so work-in-progress content
		// toward the next release stays browsable without being what every
		// visitor sees by default. Built the same way any other version
		// tree is (own copyAssets/writeTagsPage/redirects/search-index) -
		// no locale sub-trees of its own in v1 though (docs/i18n/<code>/
		// keeps translating this same physical folder, same as always, but
		// only the default-locale build is published under /next/ for now).
		if ( hasDefaultVersion ) {
			progress( "Building next documentation tree" )
			var nextOutputDir = siteDir & "/next"
			var nextBasePath = urls.basePath & "next/"
			var nextPages = variables.docsLoader.load( docsDir )
			var nextCustom404 = nextPages.filter( p => compareNoCase( p.relativePath, "404.md" ) == 0 )
			if ( nextCustom404.len() ) {
				nextPages = nextPages.filter( p => compareNoCase( p.relativePath, "404.md" ) != 0 )
				custom404Page = nextCustom404
			}
			var nextNavConfig = resolveExplicitNav( docsDir, config.nav )
			var nextLocaleNames = variables.localesDiscoverer.discover( docsDir )
			var nextLocales = buildLocalesList( nextLocaleNames, config.i18n, nextBasePath )
			var nextResult = renderDocTree(
				nextPages, docsDir, config, themeDir, nextOutputDir, nextBasePath, root, versions, "Next", "next/",
				plugins, urls.absolute, imageManifest, nextNavConfig, nextLocales, defaultLocaleCode, defaultLocaleDir, "", siteOrigin, functions, data
			)
			allPages.append( prefixPageUrls( nextResult.pages, "next/" ), true )
			copyAssets( root, themeDir, nextOutputDir, config.theme.name, searchNeedsLocalIndex( config ), config.mermaid, config.math, config.openapi, config.pageActions, imageManifest, assetPipeline.cssBundle, assetPipeline.jsBundle, config.assets.fingerprint )
			writeTagsPage( nextResult.pages, nextResult.nav, config, themeDir, nextOutputDir, nextBasePath, versions, nextLocales, defaultLocaleCode, siteOrigin, functions, "Next", data )
			variables.redirectGenerator.write( nextResult.pages, nextOutputDir, nextBasePath )
			profile( "next tree", buildStartedAt )
		}

		for ( var versionName in versionNames ) {
			// Already rendered at the site root, above - never duplicated
			// at its own /versions/<name>/ URL too.
			if ( versionName == defaultVersionName ) {
				continue
			}
			progress( "Building version: #versionName#" )
			var versionDocsDir = docsDir & "/versions/" & versionName
			var versionOutputDir = siteDir & "/versions/" & versionName
			var versionBasePath = urls.basePath & "versions/" & versionName & "/"
			var versionPages = variables.docsLoader.load( versionDocsDir )

			var versionLocaleNames = variables.localesDiscoverer.discover( versionDocsDir )
			var versionLocales = buildLocalesList( versionLocaleNames, config.i18n, versionBasePath )

			var versionResult = renderDocTree(
				versionPages,
				versionDocsDir,
				config,
				themeDir,
				versionOutputDir,
				versionBasePath,
				root,
				versions,
				versionName,
				"versions/" & versionName & "/",
				plugins,
				urls.absolute,
				imageManifest,
				[],
				versionLocales,
				defaultLocaleCode,
				defaultLocaleDir,
				"",
				siteOrigin,
				functions,
				data
			)
			allPages.append( prefixPageUrls( versionResult.pages, "versions/" & versionName & "/" ), true )
			copyAssets( root, themeDir, versionOutputDir, config.theme.name, searchNeedsLocalIndex( config ), config.mermaid, config.math, config.openapi, config.pageActions, imageManifest, assetPipeline.cssBundle, assetPipeline.jsBundle, config.assets.fingerprint )
			writeTagsPage( versionResult.pages, versionResult.nav, config, themeDir, versionOutputDir, versionBasePath, versions, versionLocales, defaultLocaleCode, siteOrigin, functions, versionName, data )
			variables.redirectGenerator.write( versionResult.pages, versionOutputDir, versionBasePath )

			for ( var versionLocale in versionLocales ) {
				if ( versionLocale.code == defaultLocaleCode ) {
					continue
				}
				var versionLocaleOutputDir = versionOutputDir & "/" & versionLocale.code
				var versionLocalePages = variables.docsLoader.load( versionDocsDir & "/i18n/" & versionLocale.code )
				var mergedVersionLocalePages = mergeLocalePages( versionPages, versionLocalePages, versionLocale.code, "versions/" & versionName & "/" )
				var versionLocaleResult = renderDocTree(
					mergedVersionLocalePages,
					versionDocsDir,
					config,
					themeDir,
					versionLocaleOutputDir,
					versionBasePath & versionLocale.code & "/",
					root,
					versions,
					versionName,
					"",
					plugins,
					urls.absolute,
					imageManifest,
					[],
					versionLocales,
					versionLocale.code,
					versionLocale.dir,
					"",
					siteOrigin,
					functions,
					data
				)
				allPages.append( prefixPageUrls( versionLocaleResult.pages, "versions/" & versionName & "/" & versionLocale.code & "/" ), true )
				copyAssets( root, themeDir, versionLocaleOutputDir, config.theme.name, searchNeedsLocalIndex( config ), config.mermaid, config.math, config.openapi, config.pageActions, imageManifest, assetPipeline.cssBundle, assetPipeline.jsBundle, config.assets.fingerprint )
				writeTagsPage( versionLocaleResult.pages, versionLocaleResult.nav, config, themeDir, versionLocaleOutputDir, versionBasePath & versionLocale.code & "/", versions, versionLocales, versionLocale.code, siteOrigin, functions, versionName, data )
				variables.redirectGenerator.write( versionLocaleResult.pages, versionLocaleOutputDir, versionBasePath & versionLocale.code & "/" )
			}
		}
		profile( "version trees", buildStartedAt )

		for ( var locale in locales ) {
			if ( locale.code == defaultLocaleCode ) {
				continue
			}
			progress( "Building locale: #locale.code#" )
			var localeOutputDir = siteDir & "/" & locale.code
			var localePages = variables.docsLoader.load( rootDocsDir & "/i18n/" & locale.code )
			var mergedPages = mergeLocalePages( mainPages, localePages, locale.code, rootDocsRelativePrefix )
			var localeResult = renderDocTree(
				mergedPages,
				rootDocsDir,
				config,
				themeDir,
				localeOutputDir,
				urls.basePath & locale.code & "/",
				root,
				[],
				rootVersionLabel,
				"",
				plugins,
				urls.absolute,
				imageManifest,
				navConfig,
				locales,
				locale.code,
				locale.dir,
				"",
				siteOrigin,
				functions,
				data
			)
			allPages.append( prefixPageUrls( localeResult.pages, locale.code & "/" ), true )
			copyAssets( root, themeDir, localeOutputDir, config.theme.name, searchNeedsLocalIndex( config ), config.mermaid, config.math, config.openapi, config.pageActions, imageManifest, assetPipeline.cssBundle, assetPipeline.jsBundle, config.assets.fingerprint )
			writeTagsPage( localeResult.pages, localeResult.nav, config, themeDir, localeOutputDir, urls.basePath & locale.code & "/", versions, locales, locale.code, siteOrigin, functions, rootVersionLabel, data )
			variables.redirectGenerator.write( localeResult.pages, localeOutputDir, urls.basePath & locale.code & "/" )
		}
		profile( "locale trees", buildStartedAt )

		var tagsPages = mainResult.pages

		if ( blogPosts.len() ) {
			progress( "Building blog (#blogPosts.len()# post(s))" )
			// A featured image (frontmatter `image`) becomes a post's own
			// `og:image` when it hasn't set an explicit `ogImage` of its
			// own - resolved here, before assignOgImages() below, so a real
			// featured image always wins over an auto-generated text card
			// (assignOgImages() only generates one when `page.ogImage` is
			// still empty at the point it runs).
			for ( var post in blogPosts ) {
				if ( !len( trim( post.ogImage ) ) ) {
					post.ogImage = post.image
				}
			}

			convertMarkdown(
				blogPosts, config, plugins, urls.basePath, docsDir, imageManifest, functions,
				mainResult.nav, versions, rootVersionLabel, locales, defaultLocaleCode, defaultLocaleDir, data
			)
			assignTableOfContents( blogPosts )
			assignEditAndLastUpdated( blogPosts, config, root, "" )
			assignOgImages( blogPosts, config, siteDir )
			assignMarkdownUrl( blogPosts )
			assignIconHtml( blogPosts, docsDir )

			var blogAuthors = variables.blogAuthorsLoader.load( docsDir )
			var blogResult = variables.blogBuilder.build( blogPosts, blogAuthors, config.blog.postsPerPage, urls.basePath, imageManifest )

			for ( var post in blogResult.posts ) {
				writeRenderedPage( post, mainResult.nav, config, themeDir, siteDir, urls.basePath, versions, locales, defaultLocaleCode, defaultLocaleDir, siteOrigin, functions, rootVersionLabel, data )
			}
			for ( var indexPage in blogResult.indexPages ) {
				writeRenderedPage( indexPage, mainResult.nav, config, themeDir, siteDir, urls.basePath, versions, locales, defaultLocaleCode, defaultLocaleDir, siteOrigin, functions, rootVersionLabel, data )
			}

			variables.markdownPublisher.publish( blogResult.posts, siteDir )

			if ( len( urls.absolute ) && config.blog.feed ) {
				directoryCreate( siteDir & "/blog", true, true )
				fileWrite( siteDir & "/blog/feed.xml", variables.blogFeedGenerator.build( blogResult.posts, config.name, urls.absolute, "", config.blog.feedLimit ) )

				for ( var category in blogResult.categories ) {
					var categoryFeedDir = siteDir & "/blog/category/" & category.slug
					directoryCreate( categoryFeedDir, true, true )
					fileWrite( categoryFeedDir & "/feed.xml", variables.blogFeedGenerator.build( blogResult.posts, config.name, urls.absolute, category.name, config.blog.feedLimit ) )
				}
			}

			tagsPages = duplicate( mainResult.pages )
			tagsPages.append( blogResult.posts, true )

			allPages.append( blogResult.posts, true )
			allPages.append( blogResult.indexPages, true )

			if ( searchNeedsLocalIndex( config ) ) {
				writeSearchIndex( tagsPages, siteDir, plugins, config )
			}
		}
		profile( "blog", buildStartedAt )

		write404Page( mainResult.nav, config, themeDir, siteDir, urls.basePath, versions, rootVersionLabel, locales, defaultLocaleCode, functions, docsDir, plugins, imageManifest, custom404Page.len() ? custom404Page[ 1 ] : {}, data )
		progress( "Writing site metadata and search output" )
		writeTagsPage( tagsPages, mainResult.nav, config, themeDir, siteDir, urls.basePath, versions, locales, defaultLocaleCode, siteOrigin, functions, rootVersionLabel, data )
		variables.redirectGenerator.write( mainResult.pages, siteDir, urls.basePath, config.redirects )

		// A plugin's onSitemap() gets one shot at the site-wide accumulated
		// page list, right before both sitemap.xml and llms.txt are built
		// from it - a contributed entry (e.g. a dynamic, non-docs/ page)
		// flows into both, not just the sitemap.
		allPages = variables.pluginLoader.applyOnSitemap( plugins, allPages, config )

		// The /next/ tree (unreleased, work-in-progress toward the next
		// release - only ever present once versions.default is set) is
		// still fully browsable/linkable, just deliberately kept out of
		// sitemap.xml/robots.txt so it doesn't compete with the real,
		// released docs in search results.
		var sitemapPages = hasDefaultVersion
			? allPages.filter( p => !p.urlPath.startsWith( "next/" ) )
			: allPages

		if ( len( urls.absolute ) ) {
			fileWrite( siteDir & "/sitemap.xml", variables.sitemapGenerator.build( sitemapPages, urls.absolute ) )
		}

		fileWrite( siteDir & "/robots.txt", variables.robotsTxtGenerator.resolve( docsDir, urls.absolute, config.robots, hasDefaultVersion ? [ "/next/" ] : [] ) )

		fileWrite( siteDir & "/llms.txt", variables.llmsTxtGenerator.build( allPages, config, urls.absolute, urls.basePath ) )
		profile( "site metadata", buildStartedAt )

		if ( config.search && variables.searchProviderRegistry.usesPagefind( config.searchProvider.provider ) ) {
			variables.pagefindIndexer.index( siteDir, config.searchProvider.pagefind.bin, config.searchProvider.pagefind.options )
			profile( "pagefind", buildStartedAt )
		}

		variables.pluginLoader.applyOnBuildComplete( plugins, siteDir, config )
		profile( "build complete", buildStartedAt )

		return {
			siteDir   : siteDir,
			pageCount : mainResult.pages.len(),
			report    : buildReport( siteDir, allPages.len(), versionNames.len(), locales.len(), buildStartedAt )
		}
	}

	private void function profile( required string label, required numeric startedAt ) {
		if ( variables.profiling ) {
			var now = getTickCount()
			variables.profileTimings.append( {
				label      : arguments.label,
				elapsedMs  : now - variables.profileLastAt,
				totalMs    : now - arguments.startedAt
			} )
			variables.profileLastAt = now
		}
	}

	private void function progress( required string message ) {
		if ( variables.profiling ) {
			systemOutput( "[bx-sites] #arguments.message#...", true )
		}
	}

	private void function profileSegment( required string label, required numeric startedAt ) {
		if ( variables.profiling ) {
			variables.profileTimings.append( {
				label     : arguments.label,
				elapsedMs : getTickCount() - arguments.startedAt
			} )
		}
	}

	private struct function buildReport( required string siteDir, required numeric pageCount, required numeric versionCount, required numeric localeCount, required numeric startedAt ) {
		var outputFiles = directoryList( arguments.siteDir, true, "path" )
			.filter( path => !directoryExists( path ) )
		var outputBytes = 0

		for ( var filePath in outputFiles ) {
			outputBytes += createObject( "java", "java.io.File" ).init( filePath ).length()
		}

		return {
			durationMs  : getTickCount() - arguments.startedAt,
			pageCount   : arguments.pageCount,
			versionCount : arguments.versionCount,
			localeCount  : arguments.localeCount,
			outputFiles : outputFiles.len(),
			outputBytes : outputBytes,
			timings     : variables.profileTimings
		}
	}

	/**
	 * Resolves this build's plugin list - PluginLoader.discover()'s real
	 * BoxLang-module lookup against `config.plugins`, unless setPlugins()
	 * already provided one (test seam - see its own docblock).
	 *
	 * @config The site's bxsites.json config, already defaulted/validated
	 */
	private array function resolvePlugins( required struct config ) {
		if ( variables.hasPluginsOverride ) {
			return variables.pluginsOverride
		}
		return variables.pluginLoader.discover( arguments.config.plugins )
	}

	/**
	 * Bundles `extraCss`/`extraJs` into one fingerprinted file each
	 * (AssetBundler.bx), when `bxsites.json`'s `assets.bundle` is on (the
	 * default) - rewriting `config.extraCss`/`extraJs` in place to a
	 * single-entry array pointing at the bundle, so every theme's own
	 * `layout.bxm` (`renderExtraCss()`/`renderExtraJs()`) needs no changes
	 * at all - it already just loops whatever's in those two arrays.
	 * Runs after plugins' own `onConfig` hook, so a plugin that mutates
	 * `extraCss`/`extraJs` still gets bundled; left completely untouched
	 * when `assets.bundle` is off, or when AssetBundler.bx itself declines
	 * to bundle (an external URL in the list, or a named file that
	 * doesn't exist - see its own docblock).
	 *
	 * @config The site's bxsites.json config, already defaulted/validated and plugin-onConfig'd
	 * @root Absolute path to the project root
	 * @docsDir Absolute path to this project's resolved source content folder (SourceDirResolver.bx - `docs/` or `src/`)
	 *
	 * @return `{ config, cssBundle, jsBundle }` - `cssBundle`/`jsBundle` are AssetBundler.bundle()'s own return shape (empty `cachedPath`/`fileName` when nothing was bundled), threaded through to copyAssets() so the actual bundle file lands in every tree's own output alongside the rewritten `config.extraCss`/`extraJs` URL
	 */
	private struct function applyAssetPipeline( required struct config, required string root, required string docsDir ) {
		var emptyBundle = { bundleUrl : "", urls : [], cachedPath : "", fileName : "" }

		if ( !arguments.config.assets.bundle ) {
			return { config : arguments.config, cssBundle : emptyBundle, jsBundle : emptyBundle }
		}

		var docsDir = arguments.docsDir
		var cacheDir = arguments.root & "/.cache/assets"

		var cssBundle = variables.assetBundler.bundleCss( arguments.config.extraCss, docsDir, cacheDir, arguments.config.assets.fingerprint )
		arguments.config.extraCss = len( cssBundle.bundleUrl ) ? [ cssBundle.bundleUrl ] : cssBundle.urls

		var jsBundle = variables.assetBundler.bundleJs( arguments.config.extraJs, docsDir, cacheDir, arguments.config.assets.fingerprint )
		arguments.config.extraJs = len( jsBundle.bundleUrl ) ? [ jsBundle.bundleUrl ] : jsBundle.urls

		return { config : arguments.config, cssBundle : cssBundle, jsBundle : jsBundle }
	}

	/**
	 * Fingerprints the theme's own `assets/style.css`, so a theme update -
	 * a built-in theme upgraded along with the module, or a project's own
	 * `theme/` override edited by hand - always reaches every visitor on
	 * the next load instead of possibly serving a browser's stale cached
	 * copy under the same unchanging filename forever (unlike `extraCss`/
	 * `extraJs`, which already get this via applyAssetPipeline()'s own
	 * `assetBundler.bundleCss()`/`bundleJs()`). Runs before renderDocTree()
	 * ever writes a page (build()'s own call site), mutating `config.theme.styleUrl`
	 * in place so every theme's own `layout.bxm` already has the final,
	 * correct filename by the time it renders its own `<link>` tag -
	 * copyAssets() calls this same method again when it actually copies
	 * the file into `site/`, deterministic from the same source file, so
	 * no value needs threading through the rest of the render pipeline
	 * for this.
	 *
	 * @themeDir Absolute path to the resolved theme folder (ThemeRenderer.resolveThemeDir()'s own output)
	 * @fingerprintEnabled `config.assets.fingerprint` - `false` leaves the plain, unhashed filename (rewritten, never cache-skipped, on every build)
	 *
	 * @return "assets/theme/style.css" (fingerprinting off, or this theme has no assets/style.css of its own) or "assets/theme/style.<hash>.css"
	 */
	private string function resolveThemeStyleUrl( required string themeDir, required boolean fingerprintEnabled ) {
		var plainUrl = "assets/theme/style.css"
		var styleCssPath = arguments.themeDir & "/assets/style.css"

		if ( !arguments.fingerprintEnabled || !fileExists( styleCssPath ) ) {
			return plainUrl
		}

		var hash8 = variables.fingerprinter.hashOf( fileRead( styleCssPath ) )
		return "assets/theme/" & variables.fingerprinter.fingerprint( "style.css", hash8 )
	}

	/**
	 * Renders and writes one self-contained doc tree from an already-loaded
	 * `pages` array - the project's own `docs/` (the "Latest"/default
	 * build), one `docs/versions/<name>/` folder in its own default locale
	 * (VersionsDiscoverer.bx), one top-level `docs/i18n/<code>/` folder
	 * merged against the default tree, or one `docs/versions/<name>/i18n/<code>/`
	 * folder merged against that version's own tree (LocalesDiscoverer.bx,
	 * mergeLocalePages() either way). All four are rendered the exact same
	 * way, just pre-loaded/rooted/output/base-pathed differently by the caller.
	 *
	 * @pages Already-loaded page structs for this tree - DocsLoader.load()'s own output for the main/version trees, or mergeLocalePages()'s output for a locale (top-level or version-nested) tree
	 * @docsDir Absolute path this tree's `custom:` icons and `::: include` sources resolve against - `<root>/docs` for the main tree and every top-level locale tree (translated pages don't need their own duplicated icon/include assets), `<root>/docs/versions/<name>` for a version tree and every locale tree nested under it
	 * @config The site's bxsites.json config
	 * @themeDir Absolute path to the resolved theme folder
	 * @outputDir Absolute path to write this tree's pages to (`site/`, `site/versions/<name>/`, `site/<localeCode>/`, or `site/versions/<name>/<localeCode>/`)
	 * @basePath Root-relative base path ending with `/`, already namespaced under `versions/<name>/`/`<localeCode>/`/`versions/<name>/<localeCode>/` for a version/locale build
	 * @root Absolute path to the project root - git's working directory for the `lastUpdated` lookup
	 * @versions Version switcher entries as `[ { label, url } ]`, shared by every tree so the switcher is consistent everywhere
	 * @currentVersion Which `versions` entry this tree IS, for the switcher's own "selected" state
	 * @docsRelativePrefix Empty for the main/"Latest" tree or any locale tree (see assignEditAndLastUpdated() - a locale tree's own pages each carry their own `sourceRelativePath` instead, already namespaced under `versions/<name>/` by mergeLocalePages() when nested under a version); `"versions/<name>/"` for a version tree's own default-locale render
	 * @plugins resolvePlugins()'s own output, applied via onNav/onPageMarkdown/onPageHtml
	 * @absoluteUrl The absolute site URL, ending with `/` (BaseUrlResolver's `absolute`), or "" if unknown - gates `::: updates` feed.xml generation, same as sitemap.xml
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output, built once per build() call (docs/assets/** is identical across every tree) - threaded through to convertMarkdown() for the `<img>` -> `<picture>` rewrite
	 * @navConfig An explicit nav tree (NavBuilder.build()'s own `navConfig` shape) for this doc tree - empty (the default) infers nav from folder structure. Non-empty for the main tree and every top-level locale tree (a locale's nav always mirrors its own default tree's structure/navConfig - see mergeLocalePages()); always empty for a version tree and any locale tree nested under it, which infer their own from that version's own folder structure - see resolveExplicitNav()
	 * @locales Language switcher entries as `[ { code, label, url, dir, flag } ]`, the default locale first - only the locales *this specific tree* has translations for (top-level `docs/i18n/<code>/` for the main tree, `docs/versions/<name>/i18n/<code>/` for a version tree and its own nested locale trees), so switching locale always stays within the current version
	 * @currentLocale Which `locales` entry's `code` this tree IS, for the switcher's own "selected" state - the default locale's own code for the main tree and every version tree's own default-locale render (never "")
	 * @currentLocaleDir `"ltr"`/`"rtl"`, this tree's own locale direction - stamped onto `<html dir="...">`
	 * @blogNavUrl A synthetic "Blog" nav entry's own `url` (`"blog/index.html"`), appended to this tree's own nav when non-empty - "" (the default) adds nothing. Only ever passed for the main tree's own render (build()'s docblock) - a version/locale tree's nav stays exactly as its own folder structure infers, same as it already does for tags (no nav entry at all there either, see writeTagsPage()'s docblock)
	 * @siteOrigin The scheme+host portion of the site's absolute URL (no trailing slash, no basePath) - see build()'s own docblock for canonicalUrlFor()
	 * @functions FunctionsLoader.load()'s own output (module spec section 8's "magic functions") - the single project-wide `functions.bxs`, the same for every tree, threaded through to convertMarkdown() (`{{ $name(...) }}` in markdown) and themeRenderer.renderPage() (bare `$name(...)` in a project's own `theme/` `.bxm` overrides)
	 * @data DataLoader.load()'s own output (docs/guides/data-files.md) - the single project-wide docs/data/*, the same for every tree, threaded through the same two places as `functions` above (`{{ data.x }}` in markdown, bare `data` in a `theme/` `.bxm` override)
	 *
	 * @return { pages, nav }
	 */
	private struct function renderDocTree(
		required array pages,
		required string docsDir,
		required struct config,
		required string themeDir,
		required string outputDir,
		required string basePath,
		required string root,
		required array versions,
		required string currentVersion,
		required string docsRelativePrefix,
		required array plugins,
		required string absoluteUrl,
		required struct imageManifest,
		array navConfig = [],
		array locales = [],
		string currentLocale = "",
		string currentLocaleDir = "ltr",
		string blogNavUrl = "",
		string siteOrigin = "",
		struct functions = {},
		struct data = {}
	) {
		// Deep-copied rather than aliased - `pages` gets mutated in place
		// below (contentHtml/toc/editUrl/ogImage/... added per tree), and the
		// same page structs can be handed to more than one renderDocTree()
		// call (mainPages feeds both the main tree's own render AND every
		// locale tree's mergeLocalePages() fallback pages) - aliasing would
		// let one tree's own computed fields (an og:image path written under
		// its own outputDir, a basePath-specific contentHtml) leak into another.
		var pages = duplicate( arguments.pages )
		var nav = variables.navBuilder.build( pages, arguments.navConfig )
		nav = variables.pluginLoader.applyOnNav( arguments.plugins, nav, arguments.config )
		// Captured before the synthetic "Blog" nav node (if any) is appended
		// below, so a regular page's own prev/next chain (assignPrevNext(),
		// against this tree's own `pages` only) never jumps into the blog -
		// blog posts get their own chronological prev/next instead
		// (BlogBuilder.bx).
		var flatSequence = variables.navBuilder.flatten( nav )
		// Skip the synthetic node when the nav (folder-inferred, or a
		// custom nav/docs/nav.json) already carries its own entry
		// pointing at the blog index - the author placed/titled/iconed
		// it deliberately, so respect that instead of adding a duplicate.
		// blogNavUrl captured into a local first - an arrow function's own
		// `arguments` scope is its own (item/index/array, per array
		// .filter()'s own callback signature), not renderDocTree()'s, so
		// `arguments.blogNavUrl` inside the closure below would look up a
		// key that was never there.
		var blogNavUrl = arguments.blogNavUrl
		if ( len( blogNavUrl ) && !flatSequence.filter( n => n.url == blogNavUrl ).len() ) {
			nav.append( { title : "Blog", url : blogNavUrl, order : 999999, icon : "phosphor-duotone:newspaper", children : [] } )
		}
		assignNavIconHtml( nav, arguments.docsDir )

		directoryCreate( arguments.outputDir, true, true )

		var markdownStartedAt = getTickCount()
		convertMarkdown(
			pages, arguments.config, arguments.plugins, arguments.basePath, arguments.docsDir, arguments.imageManifest, arguments.functions,
			nav, arguments.versions, arguments.currentVersion, arguments.locales, arguments.currentLocale, arguments.currentLocaleDir, arguments.data
		)
		profileSegment( "markdown conversion", markdownStartedAt )
		variables.pageLinkResolver.resolve( pages, arguments.basePath )
		// Gracefully skips (never throws for) any course whose lessons
		// don't all exist in THIS tree's own `pages` - `data.courses` is
		// loaded once, project-wide, and reused unchanged across every
		// version/locale tree (DataLoader.bx's own documented scope), but
		// a bare docs/versions/<name>/ snapshot may not contain a
		// course's lesson files at all - see CourseBuilder.bx's own
		// docblock. This is why the same 3 lines below work unmodified at
		// every renderDocTree() call site, with zero new parameter.
		var resolvedCourses = variables.courseBuilder.resolveCourses( arguments.data.courses ?: {}, pages )
		variables.courseBuilder.resolveIndexBlocks( pages, resolvedCourses, arguments.basePath )
		variables.courseBuilder.assignCourseContext( pages, resolvedCourses )
		assignTableOfContents( pages )
		assignPrevNext( pages, flatSequence )
		assignBreadcrumbs( pages, nav )
		assignEditAndLastUpdated( pages, arguments.config, arguments.root, arguments.docsRelativePrefix )
		assignDescriptions( pages )
		assignOgImages( pages, arguments.config, arguments.outputDir )
		assignMarkdownUrl( pages )
		assignIconHtml( pages, arguments.docsDir )

		var renderingStartedAt = getTickCount()
		for ( var page in pages ) {
			page.canonicalUrl = canonicalUrlFor( page.urlPath, arguments.basePath, arguments.siteOrigin )
			var html = variables.themeRenderer.renderPage(
				page, nav, arguments.config, arguments.themeDir, arguments.basePath, arguments.versions, arguments.currentVersion,
				arguments.locales, arguments.currentLocale, arguments.currentLocaleDir, arguments.functions, arguments.data
			)
			var outputPath = arguments.outputDir & "/" & page.urlPath
			directoryCreate( getDirectoryFromPath( outputPath ), true, true )
			fileWrite( outputPath, html )

			if ( len( arguments.absoluteUrl ) && ( page.updatesFeedEntries ?: [] ).len() ) {
				var feedXml = variables.updatesFeedGenerator.build( page.updatesFeedEntries, page, arguments.config.name, arguments.absoluteUrl )
				fileWrite( getDirectoryFromPath( outputPath ) & "/feed.xml", feedXml )
			}
		}
		profileSegment( "page rendering and writes", renderingStartedAt )

		variables.markdownPublisher.publish( pages, arguments.outputDir )

		if ( searchNeedsLocalIndex( arguments.config ) ) {
			writeSearchIndex( pages, arguments.outputDir, arguments.plugins, arguments.config )
		}

		return { pages : pages, nav : nav }
	}

	/**
	 * Resolves the main tree's explicit nav override, if any - `bxsites.json`'s
	 * own `nav` array wins when non-empty (it can get large for a big site,
	 * which is exactly why a project can move it out to its own file
	 * instead); otherwise a `docs/nav.json` file, if present, is used;
	 * otherwise empty, meaning "infer from folder structure" (NavBuilder.bx's
	 * default). Only ever consulted for the main tree - a `docs/versions/<name>/`
	 * tree always uses its own folder structure, even when the main tree has
	 * an explicit nav (see renderDocTree()'s docblock).
	 *
	 * @docsDir Absolute path to the main tree's own `docs/` directory
	 * @configNav The site's bxsites.json `nav` array (already validated to be an array by ConfigLoader.bx)
	 *
	 * @return NavBuilder.build()'s `navConfig` shape - empty when neither source is set
	 */
	private array function resolveExplicitNav( required string docsDir, required array configNav ) {
		if ( arguments.configNav.len() ) {
			return arguments.configNav
		}

		var navJsonPath = arguments.docsDir & "/nav.json"
		if ( !fileExists( navJsonPath ) ) {
			return []
		}

		var parsed = ""
		try {
			parsed = jsonDeserialize( fileRead( navJsonPath ) )
		} catch ( any e ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "docs/nav.json is not valid JSON: #e.message#"
			)
		}

		if ( !isArray( parsed ) ) {
			throw(
				type    = "BxSites.InvalidConfig",
				message = "docs/nav.json must contain a JSON array"
			)
		}

		return parsed
	}

	/**
	 * sitemap.xml/llms.txt are built once, from `allPages`, against the
	 * site-wide `siteUrl`/`basePath` - but a version tree's own pages carry
	 * `urlPath`s relative to their own `docs/versions/<name>/` root (e.g.
	 * `"index.html"`), not the site root. This rebuilds `urlPath` with the
	 * `versions/<name>/` prefix folded in, so those two generators produce
	 * correct locations for version pages without needing to know versioning
	 * exists at all.
	 *
	 * @pages A version tree's own pages (unmutated - copies are returned)
	 * @prefix e.g. `"versions/1.0/"`
	 */
	private array function prefixPageUrls( required array pages, required string prefix ) {
		return arguments.pages.map( function( page ) {
			var copy = duplicate( arguments.page )
			copy.urlPath = prefix & copy.urlPath
			return copy
		} )
	}

	/**
	 * Builds the version switcher's own entries - each one `{ label, url }`,
	 * consumed identically by every built-in theme's own
	 * `renderVersionSwitcher()` regardless of which branch below produced
	 * it, so neither this shape nor any theme needs to change between the
	 * two.
	 *
	 * No `defaultVersionName` (empty, by far the common case): "Latest"
	 * (the project's regular `docs/`) first, then one per discovered
	 * `docs/versions/` folder - today's exact, unchanged behavior.
	 *
	 * `defaultVersionName` set: that version's own name first, pointing at
	 * the site root (it's the one build() actually renders there - see
	 * its own docblock), then `"Next"` (the plain `docs/` tree, now built
	 * separately at `/next/`), then every *other* discovered version -
	 * `defaultVersionName` itself is skipped here since it's already the
	 * first entry, never duplicated at its own `/versions/<name>/` URL too.
	 *
	 * @versionNames VersionsDiscoverer.discover()'s own output, newest first
	 * @basePath The site's own root basePath
	 * @defaultVersionName `config.versions.default`, trimmed - "" (the default) keeps today's "Latest"-at-root behavior
	 */
	private array function buildVersionsList( required array versionNames, required string basePath, string defaultVersionName = "" ) {
		var hasDefault = len( arguments.defaultVersionName ) > 0

		if ( !hasDefault ) {
			var versions = [ { label : "Latest", url : arguments.basePath } ]
			for ( var versionName in arguments.versionNames ) {
				versions.append( { label : versionName, url : arguments.basePath & "versions/" & versionName & "/" } )
			}
			return versions
		}

		var versions = [
			{ label : arguments.defaultVersionName, url : arguments.basePath },
			{ label : "Next", url : arguments.basePath & "next/" }
		]
		for ( var versionName in arguments.versionNames ) {
			if ( versionName == arguments.defaultVersionName ) {
				continue
			}
			versions.append( { label : versionName, url : arguments.basePath & "versions/" & versionName & "/" } )
		}
		return versions
	}

	/**
	 * Rebuilds just the search index standalone (module spec section 2 -
	 * the `search-index` verb). Still loads docs and converts markdown (the
	 * index needs headings/body text), but never touches theme rendering or
	 * assets - it only ever writes `site/search-index.json`.
	 *
	 * @projectRoot Absolute path to the project root
	 *
	 * @return { skipped (true when bxsites.json's `search` is off, or its `searchProvider` doesn't use the local index - see SearchProviderRegistry.bx), indexPath, pageCount }
	 */
	struct function buildSearchIndex( required string projectRoot ) {
		var root = normalizeRoot( arguments.projectRoot )
		var buildStartedAt = getTickCount()
		var config = variables.configLoader.load( root )

		if ( !searchNeedsLocalIndex( config ) ) {
			return { skipped : true, indexPath : "", pageCount : 0 }
		}

		var plugins = resolvePlugins( config )
		config = variables.pluginLoader.applyOnConfig( plugins, config )

		var docsDir = variables.sourceDirResolver.resolve( root )
		var functions = variables.functionsLoader.load( docsDir )
		var data = variables.dataLoader.load( docsDir )
		var pages = variables.docsLoader.load( docsDir )
		profile( "search-index docs load", buildStartedAt )
		convertMarkdown( pages, config, plugins, "/", docsDir, {}, functions, [], [], "Latest", [], "", "ltr", data )
		profile( "search-index markdown", buildStartedAt )

		var siteDir = root & "/site"
		directoryCreate( siteDir, true, true )

		return {
			skipped   : false,
			indexPath : writeSearchIndex( pages, siteDir, plugins, config ),
			pageCount : pages.len()
		}
	}

	/**
	 * Converts every page's raw markdown body to HTML in place (adds a
	 * `contentHtml` key to each page struct), applying bxsites.json's
	 * markdown passthrough options (bx-markdown's own `enableAdmonition`/
	 * `enableFootnotes`/`enableDefinitionLists`/etc. settings included -
	 * see ConfigLoader.bx's own default for `markdown.enableAdmonition`).
	 *
	 * Also runs three bx-sites-only extensions Flexmark itself has no
	 * concept of - content tabs, math spans, and fenced-code
	 * `hl_lines`/`linenums`/`title` annotations - each as a pre-process
	 * pass (protect the body from `Markdown()`'s own inline parsing) and a
	 * post-process pass (restore/apply against the rendered HTML). See
	 * TabsProcessor.bx/MathProtector.bx/CodeAnnotationProcessor.bx's own
	 * docblocks for why this shape is necessary.
	 *
	 * Also rewrites every relative `.md` link (`[Search](search.md)`,
	 * mkdocs' own file-relative-link convention, GitHub-readable and
	 * built-site-readable alike) into its built pretty-URL equivalent -
	 * see MarkdownLinkResolver.bx.
	 *
	 * Also turns every `` ```tryboxlang `` fenced block into a live
	 * try.boxlang.io editor embed (TryBoxLangProcessor.bx), extracted
	 * first - before every other pre-processor below - so its literal
	 * BoxLang source is never misread as tab/math/annotation/directive
	 * syntax of its own.
	 *
	 * Also splices in any `::: include src="..."` reusable content
	 * (IncludeProcessor.bx, run first - the only one of these that has to
	 * become real page markdown rather than an HTML-wrapped block) and
	 * every GitBook-style `:::` container block - expandable, cards,
	 * columns, stepper, updates, file, embed, page-link
	 * (DirectiveBlockProcessor.bx). A page whose `::: updates` block has
	 * entries gets `page.updatesFeedEntries` set too, consumed by
	 * `renderDocTree()` to write that page's own `feed.xml`.
	 *
	 * @pages Array of page structs from DocsLoader.load()
	 * @config The site's bxsites.json config
	 * @basePath Root-relative base path ending with `/` - relative `.md` links are re-rooted under it, same as every other internal link the theme renders
	 * @docsDir Absolute path to this tree's own docs root - `::: include` paths are resolved against it
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - defaults to empty, which makes the `<img>` -> `<picture>` rewrite (ResponsiveImageProcessor.bx) a no-op; buildSearchIndex() relies on exactly that default, since the search index has no use for it
	 * @functions FunctionsLoader.load()'s own output (module spec section 8) - defaults to empty, which makes every `{{ $name(...) }}` call fail with `BxSites.UnknownFunction` (there's nothing to call), same "just doesn't resolve" shape `{{ }}` variable lookups already have against an empty `config.variables`
	 * @nav This tree's own nav tree (NavBuilder.build()'s own output) - one of the "supporting variables" a magic function reads bare, alongside `page`/`siteConfig`/etc. (see below)
	 * @versions Version switcher entries, same shape/meaning as ThemeRenderer.renderPage()'s own `versions` param - another supporting variable
	 * @currentVersion Supporting variable - see ThemeRenderer.renderPage()'s own `currentVersion` param
	 * @locales Supporting variable - see ThemeRenderer.renderPage()'s own `locales` param
	 * @currentLocale Supporting variable - see ThemeRenderer.renderPage()'s own `currentLocale` param
	 * @currentLocaleDir Supporting variable - see ThemeRenderer.renderPage()'s own `currentLocaleDir` param
	 *
	 * Also resolves every `{{ }}` expression (VariablesProcessor.bx) -
	 * `{{ dotted.path }}` against `config.variables` with this page's own
	 * `page` struct merged in under that same name (so `{{ page.title }}`/
	 * `{{ page.frontmatter.<customKey> }}` work too, reusing the exact same
	 * lookup - see this loop's own `pageVars` below), `{{ $name(...) }}`
	 * against `functions` - immediately after the include pass above, so an
	 * included partial's own `{{ }}` expressions resolve too, and before
	 * every other pre-processor below, so the substituted text is ordinary
	 * markdown source by the time tabs/math/code-annotations/directives see it.
	 *
	 * A magic function's own body can also bare-reference a fixed set of
	 * "supporting variables" - `siteConfig` (this tree's `config`), `page`
	 * (this specific page - see below for what's/isn't populated on it yet
	 * at this point), `nav`, `basePath`, `versions`, `currentVersion`,
	 * `locales`, `currentLocale`, `currentLocaleDir` - the same names (and,
	 * `page` aside, the same values) a theme's own `.bxm` override already
	 * has bare in scope (ThemeRenderer.bx), so a magic function reads them
	 * identically regardless of which of the two places calls it. `page`
	 * itself is this loop's own in-progress page struct (DocsLoader.bx's
	 * own shape - `title`/`description`/`tags`/`icon`/`summary`/`ogImage`/
	 * `urlPath`/`relativePath`/`sourcePath`/`body`/etc. are already there),
	 * but not yet enriched with the fields only knowable after every page
	 * in this tree has been converted - `toc`, `prevPage`/`nextPage`,
	 * `breadcrumbs`, `editUrl`/`lastUpdated`, `iconHtml`, `markdownUrl`,
	 * `canonicalUrl` don't exist on it yet here (renderDocTree()'s own
	 * assignXxx() calls add those after this method returns) - by the time
	 * the very same magic function runs again from `page.bxm`, `page` is
	 * the fully-enriched struct instead. See
	 * docs/guides/variables-and-functions.md's "Context variables" section.
	 */
	private void function convertMarkdown( required array pages, required struct config, array plugins = [], string basePath = "/", string docsDir = "", struct imageManifest = {}, struct functions = {}, array nav = [], array versions = [], string currentVersion = "Latest", array locales = [], string currentLocale = "", string currentLocaleDir = "ltr", struct data = {} ) {
		for ( var page in arguments.pages ) {
			// A page's own conversion is a pure function of its source file plus
			// this tree's config/plugins/imageManifest, none of which change
			// without the source file's own mtime changing too (a config/theme/
			// plugin edit clears the whole cache instead - see
			// DevServer.bx's own clearDevCache() call) - so an unchanged
			// mtime means this page's own last conversion is still valid,
			// skipping this whole pipeline entirely. A brand-new
			// BuildPipeline instance (every plain `bxSites build`) starts
			// with an empty cache, so this is a pure no-op for a one-shot
			// build - it only actually saves work across DevServer.bx's own
			// repeated in-process rebuild() calls.
			var sourcePath = page.sourcePath ?: ""
			var mtime = len( sourcePath ) ? createObject( "java", "java.io.File" ).init( sourcePath ).lastModified() : 0
			var cached = len( sourcePath ) ? variables.pageCache.get( sourcePath, mtime ) : {}
			if ( !cached.isEmpty() ) {
				page.contentHtml = cached.contentHtml
				page.updatesFeedEntries = cached.updatesFeedEntries
				continue
			}

			var markdown = variables.pluginLoader.applyOnPageMarkdown( arguments.plugins, page.body, page, arguments.config )
			markdown = variables.includeProcessor.process( markdown, arguments.docsDir, page.relativePath )
			var functionContext = {
				siteConfig       : arguments.config,
				page             : page,
				nav              : arguments.nav,
				basePath         : arguments.basePath,
				versions         : arguments.versions,
				currentVersion   : arguments.currentVersion,
				locales          : arguments.locales,
				currentLocale    : arguments.currentLocale,
				currentLocaleDir : arguments.currentLocaleDir,
				data             : arguments.data
			}
			// `page` merged in under its own key, alongside whatever
			// bxsites.yaml's own `variables` block declares - `{{ page.title }}`,
			// `{{ page.summary }}`, and `{{ page.frontmatter.<customKey> }}`
			// (DocsLoader.bx's own loadFile() docblock) all resolve through
			// the exact same dotted-path lookup `{{ dotted.path }}` already
			// used for site-wide variables, no VariablesProcessor.bx changes
			// needed. `page` is a reserved name here the same way it already
			// is as a magic-function "supporting variable" (functionContext,
			// right above) - a project's own `variables.page`, if it somehow
			// declared one, would be shadowed by this page's own struct.
			// `data` (DataLoader.load()'s own output, docs/guides/data-files.md)
			// is a second reserved name, shadowed the same way, so `{{ data.x }}`
			// resolves through the identical dotted-path lookup with no
			// VariablesProcessor.bx changes either.
			var pageVars = duplicate( arguments.config.variables ?: {} )
			pageVars.page = page
			pageVars.data = arguments.data
			// `::: for`/`::: if` (DirectiveBlockProcessor.bx) bodies aren't
			// extracted yet at this point - protect their own raw content
			// (which may reference a loop variable that doesn't exist until
			// renderFor() binds it, once per iteration, later in this
			// pipeline) from this single top-level `{{ }}` pass, then put it
			// right back once the pass is done - see
			// DirectiveBlockProcessor.protectLoopDirectives()'s own
			// docblock for why.
			var loopProtected = variables.directiveBlockProcessor.protectLoopDirectives( markdown )
			markdown = variables.variablesProcessor.resolve( loopProtected.markdown, pageVars, arguments.functions, page.relativePath, functionContext )
			markdown = variables.directiveBlockProcessor.restoreLoopDirectives( markdown, loopProtected.placeholders )

			var tryBoxLangExtracted = variables.tryBoxLangProcessor.extract( markdown )
			var tabsExtracted = variables.tabsProcessor.extract( tryBoxLangExtracted.markdown )
			var mathProtected = variables.mathProtector.protect( tabsExtracted.markdown )
			var codeExtracted = variables.codeAnnotationProcessor.extractAndStrip( mathProtected.markdown )
			// Wires this page's own {{ }} resolution context into
			// renderFor()/renderIf() - see DirectiveBlockProcessor's own
			// setLoopContext() docblock.
			variables.directiveBlockProcessor.setLoopContext( variables.variablesProcessor, pageVars, arguments.functions, functionContext )
			var directivesExtracted = variables.directiveBlockProcessor.extract( codeExtracted.markdown )

			var html = variables.markdownRenderer.toHtml( directivesExtracted.markdown, arguments.config.markdown )
			html = variables.directiveBlockProcessor.restore( html, directivesExtracted.blocks, variables.markdownRenderer, arguments.config.markdown )
			html = variables.directiveBlockProcessor.resolveFileHrefs( html, arguments.basePath )
			html = variables.directiveBlockProcessor.resolveOpenApiSrcs( html, arguments.basePath )
			html = variables.codeAnnotationProcessor.applyToHtml( html, codeExtracted.annotations )
			html = variables.mathProtector.restore( html, mathProtected.formulas )
			html = variables.tabsProcessor.restore( html, tabsExtracted.groups, variables.markdownRenderer, arguments.config.markdown )
			html = variables.tryBoxLangProcessor.restore( html, tryBoxLangExtracted.embeds )
			html = variables.markdownLinkResolver.resolve( html, page.relativePath, arguments.basePath )
			html = variables.responsiveImageProcessor.resolve( html, page.relativePath, arguments.basePath, arguments.imageManifest )
			html = variables.tableWrapProcessor.wrap( html )

			html = variables.pluginLoader.applyOnPageHtml( arguments.plugins, html, page, arguments.config )

			page.contentHtml = html
			page.updatesFeedEntries = collectUpdatesFeedEntries( directivesExtracted.blocks, arguments.config.markdown )

			if ( len( sourcePath ) ) {
				variables.pageCache.set( sourcePath, mtime, { contentHtml : page.contentHtml, updatesFeedEntries : page.updatesFeedEntries } )
			}
		}
	}

	/**
	 * Discards every cached page conversion (see convertMarkdown()'s own
	 * docblock) - DevServer.bx calls this whenever a watched change isn't a
	 * single page's own markdown (bxsites.json, a theme override, a
	 * plugin), since none of those are reflected in any one page's own
	 * source mtime.
	 */
	void function clearDevCache() {
		variables.pageCache.clear()
		variables.searchIndexer.clearCache()
	}

	/**
	 * Flattens every top-level `::: updates` block's own `::: update`
	 * children into one feed-ready entry array - a page normally has at
	 * most one `::: updates` block, but more than one is merged rather
	 * than only honoring the first.
	 *
	 * @blocks convertMarkdown()'s own `directivesExtracted.blocks` for one page
	 * @markdownOptions Passthrough options forwarded to the renderer for each entry's own content
	 */
	private array function collectUpdatesFeedEntries( required array blocks, required struct markdownOptions ) {
		var entries = []
		for ( var block in arguments.blocks ) {
			if ( lCase( trim( block.type ) ) != "updates" ) {
				continue
			}
			entries.append( variables.directiveBlockProcessor.extractUpdateEntries( block, variables.markdownRenderer, arguments.markdownOptions ), true )
		}
		return entries
	}

	/**
	 * Adds a `toc` key (the "On this page" list, from TableOfContents.bx) to
	 * every page, built from its already-converted `contentHtml` - unless
	 * the page's own frontmatter set `toc: false` (DocsLoader.bx's
	 * `showToc`), in which case it's left empty, same as a page with fewer
	 * than 2 headings already renders. A landing/hero page is the main use
	 * case - it doesn't want a floating "On this page" box competing with
	 * its own hero content.
	 *
	 * @pages Array of page structs with `contentHtml` already set
	 */
	private void function assignTableOfContents( required array pages ) {
		for ( var page in arguments.pages ) {
			page.toc = ( page.showToc ?: true ) ? variables.tableOfContents.build( page.contentHtml ) : []
		}
	}

	/**
	 * Adds `prevPage`/`nextPage` keys (each `{ title, url }`, or `{ title:"", url:"" }`
	 * when there is none) to every page, based on its position in the nav's
	 * own reading order. A page not present in `flatSequence` (i.e. hidden)
	 * gets no prev/next at all - prev/next is a nav concept, and a hidden
	 * page isn't part of the nav.
	 *
	 * @pages Array of page structs
	 * @flatSequence NavBuilder.flatten()'s own output for this build
	 */
	private void function assignPrevNext( required array pages, required array flatSequence ) {
		var none = { title : "", url : "" }

		for ( var page in arguments.pages ) {
			page.prevPage = none
			page.nextPage = none

			for ( var i = 1; i <= arguments.flatSequence.len(); i++ ) {
				if ( arguments.flatSequence[ i ].url == page.urlPath ) {
					page.prevPage = i > 1 ? arguments.flatSequence[ i - 1 ] : none
					page.nextPage = i < arguments.flatSequence.len() ? arguments.flatSequence[ i + 1 ] : none
					break
				}
			}
		}
	}

	/**
	 * Adds a `breadcrumbs` key (root -> ... -> the page itself, from
	 * NavBuilder.breadcrumbs()) to every page. Empty for a hidden page - it
	 * isn't in the nav to begin with, which is exactly what a course lesson
	 * page normally is (CourseBuilder.bx's own docblock - a course is a
	 * flat, manifest-driven sequence, deliberately not a nav.json subtree).
	 * A lesson page falls back to a real two-level trail of its own -
	 * `[courseTitle -> its own title]` - built from `page.course` (already
	 * assigned by CourseBuilder.assignCourseContext(), which always runs
	 * before this), rather than showing no breadcrumb at all. Only applies
	 * when nav.json genuinely has nothing to say (fewer than two crumbs)
	 * and `page.course.indexUrl` actually resolved to something linkable -
	 * a project that explicitly lists its lessons in nav.json keeps
	 * whatever real trail that produces, untouched.
	 *
	 * @pages Array of page structs
	 * @nav The site's nav tree, from NavBuilder.build()
	 */
	private void function assignBreadcrumbs( required array pages, required array nav ) {
		for ( var page in arguments.pages ) {
			var crumbs = variables.navBuilder.breadcrumbs( arguments.nav, page.urlPath )
			if ( crumbs.len() < 2 && len( page.course.id ?: "" ) && len( page.course.indexUrl ?: "" ) ) {
				crumbs = [
					{ title : page.course.courseTitle, url : page.course.indexUrl },
					{ title : page.title, url : page.urlPath }
				]
			}
			page.breadcrumbs = crumbs
		}
	}

	/**
	 * Adds `editUrl` (a GitHub-style "edit this page" link, empty when
	 * `bxsites.json`'s `repo.url`/`repo.editUri` aren't both set) and
	 * `lastUpdated` (an ISO date-time from `git log`, empty unless
	 * `lastUpdated` is turned on) to every page.
	 *
	 * @pages Array of page structs with `relativePath` already set (DocsLoader.load())
	 * @config The site's bxsites.json config
	 * @root Absolute path to the project root - git's working directory for the `lastUpdated` lookup
	 * @docsRelativePrefix `page.relativePath` is relative to whichever docs tree was loaded (`docs/` or `docs/versions/<name>/`) - this is the bit in between, e.g. `"versions/1.0/"`, so the real `docs/`-relative path (for both the edit URL and the git lookup) can be rebuilt as `docsRelativePrefix & page.relativePath`. Empty for the main/"Latest" tree. Ignored for any page that carries its own `sourceRelativePath` instead (mergeLocalePages()'s own output) - a locale tree's pages don't all share one real physical prefix, since a translated page really lives under `docs/i18n/<code>/` while a fallback page really is the default tree's own file under plain `docs/`.
	 */
	private void function assignEditAndLastUpdated( required array pages, required struct config, required string root, string docsRelativePrefix = "" ) {
		var repoUrl = trim( arguments.config.repo.url ?: "" )
		var editUri = trim( arguments.config.repo.editUri ?: "" )
		var canEdit = len( repoUrl ) && len( editUri )

		var sourceDirName = variables.sourceDirResolver.name( arguments.root )

		for ( var page in arguments.pages ) {
			var pathFromDocsRoot = page.keyExists( "sourceRelativePath" ) ? page.sourceRelativePath : ( arguments.docsRelativePrefix & page.relativePath )
			page.editUrl = canEdit ? buildEditUrl( repoUrl, editUri, pathFromDocsRoot ) : ""
			page.lastUpdated = arguments.config.lastUpdated
				? variables.gitRevisionDate.forFile( arguments.root, sourceDirName & "/" & pathFromDocsRoot )
				: ""
		}
	}

	/**
	 * Merges a locale's own translated pages onto the default tree's own
	 * page set, structurally - the output always has exactly the default
	 * tree's own pages, in its own order, matched by `relativePath` (a
	 * translated `docs/i18n/es/guides/setup.md` and the default tree's own
	 * `docs/guides/setup.md` both load with the identical `relativePath`
	 * `"guides/setup.md"`, since DocsLoader.bx computes it relative to
	 * whichever docsDir it was given - no rewriting needed to make them
	 * match). This is what guarantees a locale's nav is always the exact
	 * same shape as the default tree's - see renderDocTree()'s own docblock -
	 * and what lets the language switcher always land on the same page
	 * rather than that locale's homepage.
	 *
	 * A default-tree page with no translated counterpart is carried through
	 * unchanged (its own title/body/icon/order - untranslated, but real
	 * content, never a broken link) and stamped `isFallbackContent = true`
	 * so a theme's `page.bxm` can show a "not yet translated" notice - the
	 * fallback behavior this session settled on over an alternative of
	 * omitting untranslated pages entirely.
	 *
	 * @defaultPages The default tree's own already-loaded pages (DocsLoader.load()'s output for `<root>/docs`, or - composing with a version - `<root>/docs/versions/<name>/`)
	 * @localePages This locale's own already-loaded pages (DocsLoader.load()'s output for `<root>/docs/i18n/<code>`, or `<root>/docs/versions/<name>/i18n/<code>` when composing with a version)
	 * @localeCode This locale's own code, for building each translated page's own `sourceRelativePath`
	 * @docsRelativePrefix Prepended to every `sourceRelativePath`, `docs/`-relative - `""` (default) for the main tree, `"versions/<name>/"` when composing with a version, so edit-URL/last-updated lookups (assignEditAndLastUpdated()) resolve against the right source file either way
	 *
	 * @return Array of page structs, same shape/order as `defaultPages`, each additionally stamped `isFallbackContent` and `sourceRelativePath`
	 */
	private array function mergeLocalePages( required array defaultPages, required array localePages, required string localeCode, string docsRelativePrefix = "" ) {
		var localesByPath = {}
		for ( var localePage in arguments.localePages ) {
			localesByPath[ lCase( localePage.relativePath ) ] = localePage
		}

		var merged = []
		for ( var defaultPage in arguments.defaultPages ) {
			var key = lCase( defaultPage.relativePath )

			if ( localesByPath.keyExists( key ) ) {
				var translated = duplicate( localesByPath[ key ] )
				translated.isFallbackContent = false
				translated.sourceRelativePath = arguments.docsRelativePrefix & "i18n/" & arguments.localeCode & "/" & translated.relativePath
				merged.append( translated )
			} else {
				var fallback = duplicate( defaultPage )
				fallback.isFallbackContent = true
				fallback.sourceRelativePath = arguments.docsRelativePrefix & fallback.relativePath
				merged.append( fallback )
			}
		}

		return merged
	}

	/**
	 * Builds the language switcher's own entries - the default locale first
	 * (`bxsites.json`'s `i18n.defaultLocale`, always the unprefixed `docs/`
	 * tree), then one per discovered `docs/i18n/` folder that's actually
	 * declared in `i18n.locales` (in the order declared there), then any
	 * remaining discovered folder not declared in config at all (using its
	 * bare code as its own label, alphabetically - graceful degradation
	 * rather than silently dropping it from the switcher).
	 *
	 * @localeNames LocalesDiscoverer.discover()'s own output, alphabetical
	 * @i18nConfig The site's bxsites.json `i18n` struct
	 * @basePath The main/default-locale build's own basePath
	 *
	 * @return Array of `{ code, label, url, dir, flag }`, default locale first
	 */
	private array function buildLocalesList( required array localeNames, required struct i18nConfig, required string basePath ) {
		var defaultLocale = arguments.i18nConfig.defaultLocale
		var locales = [ {
			code  : defaultLocale.code,
			label : defaultLocale.label,
			dir   : defaultLocale.dir ?: "ltr",
			flag  : defaultLocale.flag ?: "",
			url   : arguments.basePath
		} ]
		var addedCodes = [ lCase( defaultLocale.code ) ]

		for ( var configured in arguments.i18nConfig.locales ) {
			if ( !arguments.localeNames.contains( configured.code ) ) {
				continue
			}
			locales.append( {
				code  : configured.code,
				label : configured.label,
				dir   : configured.dir ?: "ltr",
				flag  : configured.flag ?: "",
				url   : arguments.basePath & configured.code & "/"
			} )
			addedCodes.append( lCase( configured.code ) )
		}

		for ( var localeName in arguments.localeNames ) {
			if ( addedCodes.contains( lCase( localeName ) ) ) {
				continue
			}
			locales.append( { code : localeName, label : localeName, dir : "ltr", flag : "", url : arguments.basePath & localeName & "/" } )
		}

		return locales
	}

	/**
	 * Fills in each page's own `og:image` when `bxsites.json`'s `generateOgImages`
	 * is on - a page with its own frontmatter `ogImage` keeps that untouched
	 * (it already wins); every other page gets a per-page social card
	 * rendered by SocialCardGenerator.bx (its title + the site name) under
	 * `<outputDir>/assets/og/`. A no-op entirely when `generateOgImages` is
	 * off - `page.ogImage` then stays whatever DocsLoader.bx read from
	 * frontmatter (usually empty), and layout.bxm's own `og:image` falls
	 * back to `bxsites.json`'s site-wide `ogImage` in that case.
	 *
	 * @pages Array of page structs (already markdown-converted, titles final)
	 * @config The site's bxsites.json config
	 * @outputDir Absolute path this tree's pages are being written under (`site/` or `site/versions/<name>/`)
	 */
	private void function assignOgImages( required array pages, required struct config, required string outputDir ) {
		if ( !arguments.config.generateOgImages ) {
			return
		}

		for ( var page in arguments.pages ) {
			if ( len( trim( page.ogImage ?: "" ) ) ) {
				continue
			}

			var relativePath = "assets/og/" & generatedOgImageFileName( page.urlPath )
			var outputPath = arguments.outputDir & "/" & relativePath
			directoryCreate( getDirectoryFromPath( outputPath ), true, true )
			variables.socialCardGenerator.generate( page.title, arguments.config.name, outputPath )
			page.ogImage = relativePath
		}
	}

	/**
	 * Derives a per-page social-card filename from its own `urlPath`, e.g.
	 * `"guides/setup/index.html"` -> `"guides-setup.png"`; the root
	 * `"index.html"` -> `"home.png"` (an empty base would otherwise collide
	 * with the site-wide default's own naming).
	 *
	 * @urlPath The page's own urlPath (DocsLoader.bx's pretty-URL output path)
	 */
	private string function generatedOgImageFileName( required string urlPath ) {
		var base = arguments.urlPath.reReplaceNoCase( "/?index\.html$", "", "one" )
		if ( !len( base ) ) {
			base = "home"
		}
		return base.reReplace( "[\/]", "-", "all" ) & ".png"
	}

	/**
	 * Fills in each page's own `description` (the frontmatter key layout.bxm
	 * actually reads for `og:description`/`<meta name="description">` -
	 * distinct from `summary`, which only ever renders as the on-page
	 * blurb under the title) when a page's own frontmatter didn't set one -
	 * its `summary`, if it has one, else a plain-text excerpt of its own
	 * rendered content. The same fallback chain BlogBuilder.bx's own
	 * computeExcerpt() already gives every blog post, extended to every
	 * regular doc page - previously a page with neither `description` nor
	 * `summary` fell straight through to the site-wide `description` in
	 * layout.bxm, same as every other page with nothing of its own, making
	 * every such page's social-card preview identical regardless of what
	 * it actually covered.
	 *
	 * A page with content that's entirely markup (an embed, an image, a
	 * single content block) with no plain text of its own still ends up
	 * with an empty `description` here - layout.bxm's own further fallback
	 * to the site-wide description still applies in that rare case.
	 *
	 * @pages Array of page structs with contentHtml/summary/description already set
	 */
	private void function assignDescriptions( required array pages ) {
		for ( var page in arguments.pages ) {
			if ( len( trim( page.description ?: "" ) ) ) {
				continue
			}
			if ( len( trim( page.summary ?: "" ) ) ) {
				page.description = trim( page.summary )
				continue
			}
			page.description = truncateText( stripTags( page.contentHtml ?: "" ), 160 )
		}
	}

	/**
	 * A crude HTML-tag stripper for a page's own auto-derived description -
	 * good enough for "plain text summary of this HTML", not a real
	 * sanitizer. Same shape as BlogBuilder.bx's own stripTags() (used for
	 * the same purpose there - a post's own excerpt).
	 *
	 * @html Rendered HTML
	 */
	private string function stripTags( required string html ) {
		return trim( arguments.html.reReplace( "<[^>]+>", " ", "all" ).reReplace( "\s+", " ", "all" ) )
	}

	/**
	 * Truncates plain text to at most `maxLength` characters, backing off to
	 * the previous word boundary rather than cutting mid-word. Same shape
	 * as BlogBuilder.bx's own truncateText().
	 *
	 * @text Plain text (already HTML-tag-stripped)
	 * @maxLength Maximum length before the trailing ellipsis
	 */
	private string function truncateText( required string text, required numeric maxLength ) {
		if ( len( arguments.text ) <= arguments.maxLength ) {
			return arguments.text
		}
		return left( arguments.text, arguments.maxLength ).reReplace( "\s+\S*$", "", "one" ) & "…"
	}

	/**
	 * Fills in each page's own `markdownUrl` - where its raw `.md` source
	 * ends up once MarkdownPublisher.bx copies it alongside the built HTML
	 * (`site/guides/themes.md`, next to `site/guides/themes/index.html`) -
	 * so a theme's `page.bxm` can link to it ("View as Markdown"). Root-relative
	 * but not basePath-prefixed yet - same convention as `page.urlPath`/
	 * `prevPage.url`/`nextPage.url`, prefixed by the theme at render time.
	 *
	 * @pages Array of page structs (relativePath already set by DocsLoader.bx)
	 */
	private void function assignMarkdownUrl( required array pages ) {
		for ( var page in arguments.pages ) {
			page.markdownUrl = page.relativePath
		}
	}

	/**
	 * Resolves each page's own frontmatter `icon` into ready-to-embed HTML
	 * (IconResolver.bx) - a theme's `page.bxm` renders `page.iconHtml`
	 * directly next to the title, never touching `icon`/IconResolver.bx
	 * itself.
	 *
	 * @pages Array of page structs (`icon` already set by DocsLoader.bx)
	 * @docsDir Absolute path to this tree's own docs root - resolves a `custom:` icon against its `assets/icons/`
	 */
	private void function assignIconHtml( required array pages, required string docsDir ) {
		for ( var page in arguments.pages ) {
			page.iconHtml = variables.iconResolver.resolve( page.icon ?: "", arguments.docsDir )
		}
	}

	/**
	 * Resolves every nav node's own `icon` (NavBuilder.bx) into ready-to-embed
	 * HTML, recursively - a theme's `layout.bxm` renders each node's own
	 * `iconHtml` directly next to its title, never touching IconResolver.bx
	 * itself. Mutates `nodes` in place.
	 *
	 * @nodes A nav tree (or subtree) from NavBuilder.build()
	 * @docsDir Absolute path to this tree's own docs root - resolves a `custom:` icon against its `assets/icons/`
	 */
	private void function assignNavIconHtml( required array nodes, required string docsDir ) {
		for ( var node in arguments.nodes ) {
			node.iconHtml = variables.iconResolver.resolve( node.icon ?: "", arguments.docsDir )
			if ( node.children.len() ) {
				assignNavIconHtml( node.children, arguments.docsDir )
			}
		}
	}

	/**
	 * Joins a repo URL, an edit URI (e.g. `edit/main/docs/`) and a docs/-relative
	 * page path into one URL, tolerating either side's leading/trailing slashes.
	 *
	 * @repoUrl bxsites.json's `repo.url`, non-empty
	 * @editUri bxsites.json's `repo.editUri`, non-empty
	 * @relativePath The page's docs/-relative source path, e.g. "guides/setup.md"
	 */
	/**
	 * A page's own absolute canonical URL - `siteOrigin & basePath & urlPath`,
	 * e.g. `"https://example.com" & "/de/" & "guides/setup/index.html"` ->
	 * `"https://example.com/de/guides/setup/index.html"`. `basePath` here is
	 * deliberately *this tree's own* (a locale/version tree's own prefix),
	 * not the site's global `urls.basePath` - `siteOrigin` already excludes
	 * that global prefix (build()'s own docblock), so only the tree-specific
	 * remainder needs adding back on top of it.
	 *
	 * @urlPath A page's own `urlPath` (root-relative to *this tree*, not basePath-prefixed)
	 * @basePath This tree's own root-relative base path ending with `/`
	 * @siteOrigin The scheme+host portion of the site's own absolute URL, or "" if unknown (build()'s own `siteOrigin`) - returns "" right back when empty, same as sitemap.xml/feed.xml are simply skipped rather than emitting an invalid URL
	 */
	private string function canonicalUrlFor( required string urlPath, required string basePath, required string siteOrigin ) {
		return len( arguments.siteOrigin ) ? ( arguments.siteOrigin & arguments.basePath & arguments.urlPath ) : ""
	}

	private string function buildEditUrl( required string repoUrl, required string editUri, required string relativePath ) {
		var base = arguments.repoUrl.reReplace( "[\/]+$", "" )
		var uri = arguments.editUri.reReplace( "^[\/]+|[\/]+$", "", "all" )
		return base & "/" & uri & "/" & arguments.relativePath
	}

	/**
	 * Renders one already-content-ready page - a blog post, or one of its
	 * synthetic list/category/author pages (BlogBuilder.bx's own output) -
	 * through the active theme and writes it to `siteDir` at its own
	 * `urlPath`. The same render-then-write shape renderDocTree()'s own
	 * per-page loop uses for a normal doc tree, pulled out here since the
	 * blog writes its pages outside that loop (build()'s own docblock).
	 *
	 * @page A page struct with `contentHtml`/`urlPath` already set
	 * @nav The main tree's own nav (already carrying its "Blog" entry - renderDocTree()'s own blogNavUrl)
	 * @config The site's config
	 * @themeDir Absolute path to the resolved theme folder
	 * @siteDir Absolute path to the build output directory
	 * @basePath Root-relative base path ending with `/`
	 * @versions Version switcher entries as `[ { label, url } ]`
	 * @locales Language switcher entries as `[ { code, label, url, dir, flag } ]`
	 * @currentLocale The default locale's own code - the blog is main-tree-only in v1, not rendered per-locale
	 * @currentLocaleDir The default locale's own direction
	 * @functions FunctionsLoader.load()'s own output, threaded through to themeRenderer.renderPage()
	 * @currentVersion Which `versions` entry this page's own tree IS, for the switcher's own "selected" state - "Latest" by default, matching the root tree's own render (the blog is main-tree-only in v1, always rendered as part of whichever tree is currently the site root)
	 * @data DataLoader.load()'s own output, threaded through to themeRenderer.renderPage()
	 */
	private void function writeRenderedPage( required struct page, required array nav, required struct config, required string themeDir, required string siteDir, required string basePath, required array versions, required array locales, required string currentLocale, required string currentLocaleDir, string siteOrigin = "", struct functions = {}, string currentVersion = "Latest", struct data = {} ) {
		arguments.page.canonicalUrl = canonicalUrlFor( arguments.page.urlPath, arguments.basePath, arguments.siteOrigin )
		var html = variables.themeRenderer.renderPage(
			arguments.page, arguments.nav, arguments.config, arguments.themeDir, arguments.basePath, arguments.versions, arguments.currentVersion,
			arguments.locales, arguments.currentLocale, arguments.currentLocaleDir, arguments.functions, arguments.data
		)
		var outputPath = arguments.siteDir & "/" & arguments.page.urlPath
		directoryCreate( getDirectoryFromPath( outputPath ), true, true )
		fileWrite( outputPath, html )
	}

	/**
	 * Renders the site's "page not found" page through the active theme and
	 * writes it to `site/404.html` - the filename GitHub Pages (and most
	 * static hosts) automatically serve for any unmatched path.
	 *
	 * By-convention override: a `404.md` at the root of `docs`/`src`
	 * (SourceDirResolver.bx) is never built as a normal page - build()
	 * pulls it out of `mainPages` before renderDocTree() ever sees it (so
	 * it never leaks into nav/sitemap.xml/tags/search as a real, unlinked
	 * URL) and hands it here as `custom404Page` instead. When present, its
	 * own frontmatter `title` and markdown body (run through the same
	 * convertMarkdown() pass every other page gets - includes, `{{ }}`/magic
	 * functions, image variants, plugin onPageMarkdown/onPageHtml hooks)
	 * replace the synthetic English/i18n-strings title+body below; nothing
	 * else about the page (still no toc/prev-next/breadcrumbs - never
	 * meaningful for a page nothing else links to) or how/where it's
	 * written changes. No `404.md` present -> unchanged synthetic-page
	 * behavior.
	 *
	 * @nav The site's nav tree
	 * @config The site's bxsites.json config
	 * @themeDir Absolute path to the resolved theme folder
	 * @siteDir Absolute path to the build output directory
	 * @basePath Root-relative base path ending with `/`
	 * @versions Version switcher entries as `[ { label, url } ]`
	 * @currentVersion The site's own root-tree version label - "Latest", or `versions.default`'s own name once set - the 404 page is only ever written once, for whichever tree renders at the site root
	 * @locales Language switcher entries as `[ { code, label, url, dir, flag } ]` - not built per-locale in v1 (a single 404.html is all a static host serves for any unmatched path, regardless of which locale subtree the reader was in), shown here only so the header renders the same everywhere
	 * @currentLocale The default locale's own code
	 * @functions FunctionsLoader.load()'s own output, threaded through to convertMarkdown()/themeRenderer.renderPage()
	 * @docsDir Absolute path to the main tree's own docs root - only used (`custom:` icons/`::: include` resolution) when `custom404Page` is set
	 * @plugins resolvePlugins()'s own output - only applied (onPageMarkdown/onPageHtml) when `custom404Page` is set
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - only used (the `<img>` -> `<picture>` rewrite) when `custom404Page` is set
	 * @custom404Page The main tree's own `docs/404.md`, already loaded by DocsLoader.bx (title/body/frontmatter parsed, not yet markdown-converted) - `{}` (the default) keeps today's synthetic-page behavior
	 * @data DataLoader.load()'s own output, threaded through to convertMarkdown()/themeRenderer.renderPage()
	 */
	private void function write404Page( required array nav, required struct config, required string themeDir, required string siteDir, required string basePath, required array versions, required string currentVersion, array locales = [], string currentLocale = "", struct functions = {}, string docsDir = "", array plugins = [], struct imageManifest = {}, struct custom404Page = {}, struct data = {} ) {
		var page = {}

		if ( arguments.custom404Page.isEmpty() ) {
			var strings = variables.stringsResolver.resolve( arguments.currentLocale, arguments.config.i18n )
			page = {
				title       : strings.notFoundTitle,
				contentHtml : "<p>" & encodeForHTML( strings.notFoundBody ) & "</p>",
				toc         : [],
				prevPage    : { title : "", url : "" },
				nextPage    : { title : "", url : "" },
				breadcrumbs : []
			}
		} else {
			var pages = [ duplicate( arguments.custom404Page ) ]
			convertMarkdown(
				pages, arguments.config, arguments.plugins, arguments.basePath, arguments.docsDir, arguments.imageManifest, arguments.functions,
				arguments.nav, arguments.versions, arguments.currentVersion, arguments.locales, arguments.currentLocale, "ltr", arguments.data
			)
			page = pages[ 1 ]
			page.toc = []
			page.prevPage = { title : "", url : "" }
			page.nextPage = { title : "", url : "" }
			page.breadcrumbs = []
		}

		var html = variables.themeRenderer.renderPage(
			page, arguments.nav, arguments.config, arguments.themeDir, arguments.basePath, arguments.versions, arguments.currentVersion,
			arguments.locales, arguments.currentLocale, "ltr", arguments.functions, arguments.data
		)
		fileWrite( arguments.siteDir & "/404.html", html )
	}

	/**
	 * Writes `<siteDir>/tags/index.html` - every frontmatter `tags` value
	 * used anywhere in *this one tree*, each with a `##tag-<slug>` anchor
	 * and a list of every page (in this tree) carrying it
	 * (TagsIndexBuilder.bx). Skipped entirely when no page in this tree
	 * uses `tags` - no empty page for a tree not using the feature.
	 *
	 * Called once per tree - main, each version, each locale, each
	 * version×locale - the same shape as `writeSearchIndex()`/`copyAssets()`
	 * already are, since a page's own `page.bxm` tag badge always links to
	 * `<its own basePath>tags/index.html`: without a tags page at that
	 * exact path, every tag badge on every version/locale page would 404
	 * (or, if pointed cross-tree at the main site's own tags page instead,
	 * bounce a locale's reader into an all-English index rather than one
	 * scoped to their own tree's own pages/language).
	 *
	 * @pages This tree's own pages (already markdown-converted, `tags` included)
	 * @nav This tree's own nav
	 * @config The site's bxsites.json config
	 * @themeDir Absolute path to the resolved theme folder
	 * @siteDir Absolute path to this tree's own build output directory
	 * @basePath This tree's own root-relative base path ending with `/`
	 * @versions Version switcher entries as `[ { label, url } ]`
	 * @locales Language switcher entries as `[ { code, label, url, dir, flag } ]` - only the locales *this tree* itself has, same scoping renderDocTree()'s own `locales` param already uses
	 * @currentLocale This tree's own current locale code (the default locale's own code for the main tree and every version's own default-locale render, never "")
	 * @functions FunctionsLoader.load()'s own output, threaded through to themeRenderer.renderPage()
	 * @currentVersion Which `versions` entry this tree IS, for the switcher's own "selected" state - "Latest" by default, matching this tree's own render (renderDocTree()'s own `currentVersion` param)
	 * @data DataLoader.load()'s own output, threaded through to themeRenderer.renderPage()
	 */
	private void function writeTagsPage( required array pages, required array nav, required struct config, required string themeDir, required string siteDir, required string basePath, required array versions, array locales = [], string currentLocale = "", string siteOrigin = "", struct functions = {}, string currentVersion = "Latest", struct data = {} ) {
		var built = variables.tagsIndexBuilder.build( arguments.pages, arguments.basePath )
		if ( !built.hasTags ) {
			return
		}

		var strings = variables.stringsResolver.resolve( arguments.currentLocale, arguments.config.i18n )
		var page = {
			title       : strings.tagsTitle,
			contentHtml : built.contentHtml,
			toc         : [],
			prevPage    : { title : "", url : "" },
			nextPage    : { title : "", url : "" },
			breadcrumbs : [],
			canonicalUrl : canonicalUrlFor( "tags/index.html", arguments.basePath, arguments.siteOrigin )
		}

		var html = variables.themeRenderer.renderPage(
			page, arguments.nav, arguments.config, arguments.themeDir, arguments.basePath, arguments.versions, arguments.currentVersion,
			arguments.locales, arguments.currentLocale, "ltr", arguments.functions, arguments.data
		)
		directoryCreate( arguments.siteDir & "/tags", true, true )
		fileWrite( arguments.siteDir & "/tags/index.html", html )
	}

	/**
	 * Whether this build should produce/copy bx-sites' own static search
	 * index and MiniSearch widget - `config.search` is the master on/off switch
	 * (module spec section 7); `config.searchProvider.provider` then decides
	 * whether the *local* index is actually needed (SearchProviderRegistry.bx) -
	 * `false` only for `algolia`, which is fed from its own hosted index
	 * instead of `search-index.json`.
	 *
	 * @config The site's bxsites.json config, already defaulted/validated
	 */
	private boolean function searchNeedsLocalIndex( required struct config ) {
		return arguments.config.search
			&& variables.searchProviderRegistry.usesLocalIndex( arguments.config.searchProvider.provider )
	}

	/**
	 * Builds the search index from already-converted pages and writes it to
	 * `siteDir`, applying every plugin's `onSearchIndex` hook first.
	 *
	 * @pages Array of page structs with `contentHtml` already set
	 * @siteDir Absolute path to the build output directory (must already exist)
	 * @plugins resolvePlugins()'s own output, applied via onSearchIndex
	 * @config The site's bxsites.json config
	 *
	 * @return Absolute path to the written search-index.json
	 */
	private string function writeSearchIndex( required array pages, required string siteDir, array plugins = [], struct config = {} ) {
		var searchIndex = variables.searchIndexer.build( arguments.pages )
		searchIndex = variables.pluginLoader.applyOnSearchIndex( arguments.plugins, searchIndex, arguments.config )
		var indexPath = arguments.siteDir & "/search-index.json"
		fileWrite( indexPath, jsonSerialize( searchIndex ) )
		return indexPath
	}

	/**
	 * Every argument copyAssets() takes is identical across every tree in a
	 * single build() call - same theme, same feature flags, same project
	 * `docs/assets/**`, same pre-computed imageManifest/cssBundle/jsBundle
	 * (each already noted as "identical across every tree" in their own
	 * docblocks below) - so almost everything it writes is byte-for-byte
	 * identical every time it runs within that build(), only the
	 * destination (siteDir) differs. The one exception is a tree's own
	 * `assets/og/*.png` - assignOgImages()'s own per-page, per-tree social
	 * card output, already written into a version/locale tree's own
	 * `siteDir/assets/` before this ever runs for that tree - see
	 * hardlinkDirectory()'s own docblock for how that's handled. Building
	 * main/next/version/locale/version-locale
	 * trees for a project with N locales and M versions therefore wrote
	 * this same handful of MB (vendor/**, fonts/**, docs/assets/**, the
	 * responsive image variants, the CSS/JS bundle) (1 + N) * (1 + M)
	 * times over - the actual bytes for real projects, not a hypothetical
	 * one: this repository's own build (5 locales, 1 version) wrote its
	 * own vendor/ bundle 10 times for ~63MB of pure duplication, out of
	 * 131MB total site/ output.
	 *
	 * This wrapper runs the real copy (copyAssetsFresh()) exactly once per
	 * build() call - remembered in variables.canonicalAssetsDir, reset at
	 * the top of build() - and hardlinks every subsequent tree's own
	 * assets/ from that first, canonical copy instead: every tree still
	 * gets a fully real, independent-looking assets/ directory at exactly
	 * the same paths as before (a hardlink is indistinguishable from a
	 * regular file to anything that only reads it - the theme templates,
	 * every deploy target, a browser - so no template or URL changes
	 * anywhere else in this codebase), just without writing the same bytes
	 * to disk N extra times. Falls back to a real copy on anything that
	 * stops a hardlink from working (a siteDir on a different filesystem
	 * than the canonical one, most likely) - never lets an optimization
	 * fail a build.
	 *
	 * @root Absolute path to the project root
	 * @themeDir Absolute path to the resolved theme folder
	 * @siteDir Absolute path to the build output directory
	 * @themeName bxsites.json's `theme.name` - selects which vendored theme-specific assets (currently just Bootstrap's own CSS/JS) to copy
	 * @searchEnabled Whether to copy the shared search.js/MiniSearch widget - searchNeedsLocalIndex()'s own result, so this is only true for the `local` search provider (or one bx-sites doesn't otherwise know about), never `algolia`
	 * @mermaidEnabled Whether to copy the shared mermaid-init.js widget and the vendored mermaid.js bundle itself
	 * @mathEnabled Whether to copy the shared math-init.js (KaTeX auto-render) widget
	 * @openapiEnabled Whether to copy the shared openapi-init.js widget and the vendored Swagger UI bundle/CSS - only ever needed by a project actually using a `::: openapi` block (DirectiveBlockProcessor.bx)
	 * @pageActionsEnabled Whether to copy the shared page-actions-init.js widget - only ever needed by a project with `pageActions: true` (the GitBook-style Copy/Export dropdown, page.bxm's own `renderPageActions()`)
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - its already-generated variant files get copied into this tree's own site.../assets/, right alongside the plain docs/assets/** copy below; empty (the default) copies nothing extra
	 * @cssBundle AssetBundler.bundleCss()'s own output (via applyAssetPipeline()) - its cached bundle file gets copied into this tree's own site.../assets/ so the `<link>` config.extraCss now points at actually resolves; empty `cachedPath` (the default) copies nothing
	 * @jsBundle AssetBundler.bundleJs()'s own output - same as cssBundle, for the `<script>` config.extraJs now points at
	 * @fingerprintEnabled `config.assets.fingerprint` - whether the theme's own `assets/style.css` gets renamed to its fingerprinted filename after copying (resolveThemeStyleUrl()'s own docblock); `true` (the default) matches the site-wide default
	 */
	private void function copyAssets( required string root, required string themeDir, required string siteDir, required string themeName, required boolean searchEnabled, required boolean mermaidEnabled, boolean mathEnabled = false, boolean openapiEnabled = false, boolean pageActionsEnabled = false, struct imageManifest = {}, struct cssBundle = {}, struct jsBundle = {}, boolean fingerprintEnabled = true ) {
		var destAssetsDir = arguments.siteDir & "/assets"

		if ( !len( variables.canonicalAssetsDir ) ) {
			copyAssetsFresh( argumentCollection = arguments )
			variables.canonicalAssetsDir = destAssetsDir
			return
		}

		try {
			hardlinkDirectory( variables.canonicalAssetsDir, destAssetsDir )
		} catch ( any e ) {
			copyAssetsFresh( argumentCollection = arguments )
		}
	}

	/**
	 * The real, always-correct copyAssets() implementation - copies theme
	 * assets to `site/assets/theme/`, this module's own shared scripts
	 * (the search widget when search is enabled; the copy-code button, tab
	 * widget, `::: prompt` widget, and code line-number/highlight widget
	 * unconditionally), the vendored third-party CSS/JS every built site
	 * needs with no CDN/internet access (module spec section 8 - highlight.js
	 * and Alpine.js always, Bootstrap's own CSS/JS for the `bootstrap` theme,
	 * MiniSearch alongside search.js, mermaid.js alongside mermaid-init.js when
	 * `mermaid` is on, Swagger UI alongside openapi-init.js when `openapi`
	 * is on), and a project's own `docs/assets/**` to `site/assets/`
	 * (module spec section 5, step 6). copyAssets() above calls this
	 * directly only once per build() (or as its own fallback) - see its
	 * own docblock for why every other tree hardlinks from that first
	 * call's own output instead of calling this again.
	 *
	 * @root Absolute path to the project root
	 * @themeDir Absolute path to the resolved theme folder
	 * @siteDir Absolute path to the build output directory
	 * @themeName bxsites.json's `theme.name` - selects which vendored theme-specific assets (currently just Bootstrap's own CSS/JS) to copy
	 * @searchEnabled Whether to copy the shared search.js/MiniSearch widget - searchNeedsLocalIndex()'s own result, so this is only true for the `local` search provider (or one bx-sites doesn't otherwise know about), never `algolia`
	 * @mermaidEnabled Whether to copy the shared mermaid-init.js widget and the vendored mermaid.js bundle itself
	 * @mathEnabled Whether to copy the shared math-init.js (KaTeX auto-render) widget
	 * @openapiEnabled Whether to copy the shared openapi-init.js widget and the vendored Swagger UI bundle/CSS - only ever needed by a project actually using a `::: openapi` block (DirectiveBlockProcessor.bx)
	 * @pageActionsEnabled Whether to copy the shared page-actions-init.js widget - only ever needed by a project with `pageActions: true` (the GitBook-style Copy/Export dropdown, page.bxm's own `renderPageActions()`)
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - its already-generated variant files get copied into this tree's own site.../assets/, right alongside the plain docs/assets/** copy below; empty (the default) copies nothing extra
	 * @cssBundle AssetBundler.bundleCss()'s own output (via applyAssetPipeline()) - its cached bundle file gets copied into this tree's own site.../assets/ so the `<link>` config.extraCss now points at actually resolves; empty `cachedPath` (the default) copies nothing
	 * @jsBundle AssetBundler.bundleJs()'s own output - same as cssBundle, for the `<script>` config.extraJs now points at
	 * @fingerprintEnabled `config.assets.fingerprint` - whether the theme's own `assets/style.css` gets renamed to its fingerprinted filename after copying (resolveThemeStyleUrl()'s own docblock); `true` (the default) matches the site-wide default
	 */
	private void function copyAssetsFresh( required string root, required string themeDir, required string siteDir, required string themeName, required boolean searchEnabled, required boolean mermaidEnabled, boolean mathEnabled = false, boolean openapiEnabled = false, boolean pageActionsEnabled = false, struct imageManifest = {}, struct cssBundle = {}, struct jsBundle = {}, boolean fingerprintEnabled = true ) {
		var themeAssetsDir = arguments.themeDir & "/assets"
		if ( directoryExists( themeAssetsDir ) ) {
			directoryCopy( themeAssetsDir, arguments.siteDir & "/assets/theme", true )

			// Renames the just-copied plain style.css to its fingerprinted
			// name (resolveThemeStyleUrl() recomputes the identical hash
			// from the same source file build() already used to pick the
			// filename every rendered page's own <link> tag points at) -
			// rather than leaving both the old plain name and the new
			// hashed one sitting in site/, which would just be dead weight
			// nothing ever links to.
			var styleUrl = resolveThemeStyleUrl( arguments.themeDir, arguments.fingerprintEnabled )
			var copiedStylePath = arguments.siteDir & "/assets/theme/style.css"
			if ( styleUrl != "assets/theme/style.css" && fileExists( copiedStylePath ) ) {
				fileMove( copiedStylePath, arguments.siteDir & "/" & styleUrl )
			}
		}

		directoryCreate( arguments.siteDir & "/assets", true, true )
		fileCopy( moduleAssetsDir() & "/copy-code.js", arguments.siteDir & "/assets/copy-code.js" )
		fileCopy( moduleAssetsDir() & "/admonition-collapse.js", arguments.siteDir & "/assets/admonition-collapse.js" )
		fileCopy( moduleAssetsDir() & "/nav-toggle.js", arguments.siteDir & "/assets/nav-toggle.js" )
		fileCopy( moduleAssetsDir() & "/toc-collapse.js", arguments.siteDir & "/assets/toc-collapse.js" )
		fileCopy( moduleAssetsDir() & "/highlight-boxlang.js", arguments.siteDir & "/assets/highlight-boxlang.js" )
		fileCopy( moduleAssetsDir() & "/tabs.js", arguments.siteDir & "/assets/tabs.js" )
		fileCopy( moduleAssetsDir() & "/conditional-content-init.js", arguments.siteDir & "/assets/conditional-content-init.js" )
		fileCopy( moduleAssetsDir() & "/course-progress.js", arguments.siteDir & "/assets/course-progress.js" )
		fileCopy( moduleAssetsDir() & "/prompt-init.js", arguments.siteDir & "/assets/prompt-init.js" )
		fileCopy( moduleAssetsDir() & "/code-lines.js", arguments.siteDir & "/assets/code-lines.js" )
		directoryCopy( moduleAssetsDir() & "/fonts", arguments.siteDir & "/assets/fonts", true )
		directoryCopy( moduleAssetsDir() & "/vendor/highlight", arguments.siteDir & "/assets/vendor/highlight", true )
		directoryCopy( moduleAssetsDir() & "/vendor/alpine", arguments.siteDir & "/assets/vendor/alpine", true )

		if ( arguments.themeName == "bootstrap" ) {
			directoryCopy( moduleAssetsDir() & "/vendor/bootstrap", arguments.siteDir & "/assets/vendor/bootstrap", true )
		}

		if ( arguments.searchEnabled ) {
			fileCopy( moduleAssetsDir() & "/search.js", arguments.siteDir & "/assets/search.js" )
			directoryCopy( moduleAssetsDir() & "/vendor/minisearch", arguments.siteDir & "/assets/vendor/minisearch", true )
		}

		if ( arguments.mermaidEnabled ) {
			fileCopy( moduleAssetsDir() & "/mermaid-init.js", arguments.siteDir & "/assets/mermaid-init.js" )
			directoryCopy( moduleAssetsDir() & "/vendor/mermaid", arguments.siteDir & "/assets/vendor/mermaid", true )
		}

		if ( arguments.mathEnabled ) {
			fileCopy( moduleAssetsDir() & "/math-init.js", arguments.siteDir & "/assets/math-init.js" )
		}

		if ( arguments.openapiEnabled ) {
			fileCopy( moduleAssetsDir() & "/openapi-init.js", arguments.siteDir & "/assets/openapi-init.js" )
			directoryCopy( moduleAssetsDir() & "/vendor/swagger-ui", arguments.siteDir & "/assets/vendor/swagger-ui", true )
		}

		if ( arguments.pageActionsEnabled ) {
			fileCopy( moduleAssetsDir() & "/page-actions-init.js", arguments.siteDir & "/assets/page-actions-init.js" )
		}

		var docsAssetsDir = variables.sourceDirResolver.resolve( arguments.root ) & "/assets"
		if ( directoryExists( docsAssetsDir ) ) {
			directoryCopy( docsAssetsDir, arguments.siteDir & "/assets", true )
		}

		if ( !arguments.imageManifest.isEmpty() ) {
			variables.imageVariantGenerator.copyToOutput( arguments.imageManifest, arguments.siteDir & "/assets" )
		}

		for ( var bundle in [ arguments.cssBundle, arguments.jsBundle ] ) {
			var cachedPath = bundle.cachedPath ?: ""
			if ( len( cachedPath ) ) {
				fileCopy( cachedPath, arguments.siteDir & "/assets/" & bundle.fileName )
			}
		}
	}

	/**
	 * Recreates `source`'s own file tree at `dest`, one hardlink per file
	 * instead of a real copy - `dest`'s own files read exactly the same
	 * content as `source`'s (same inode, same bytes, indistinguishable to
	 * anything that only reads them), just without duplicating that
	 * content on disk. Directories themselves are real directories at
	 * `dest` (a hardlink is a filesystem concept for files, not whole
	 * directory trees) - only the files inside them are links.
	 *
	 * Skips (never overwrites) a `destFile` that already exists - this
	 * tree's own `assets/og/*.png` (assignOgImages()'s own per-page,
	 * per-tree social-card output, generated before copyAssets() runs for
	 * a version/locale tree) already legitimately differ from the
	 * canonical tree's own copy, the one part of `dest`'s eventual
	 * `assets/` that ISN'T actually identical across every tree despite
	 * copyAssets()'s own inputs being - see copyAssets()'s own docblock.
	 * A `directoryList()`-driven copy has no way to know in advance which
	 * paths those are, so it just leaves anything already there alone and
	 * fills in the rest.
	 *
	 * Requires `dest`'s own filesystem to support hardlinks AND be the
	 * same filesystem `source` itself is on (a hardlink can't cross
	 * filesystems) - copyAssets() above is the only caller, and always
	 * wraps this in a try/catch that falls back to a real copy, so a
	 * platform/filesystem that can't do this never fails a build over it.
	 *
	 * @source Absolute path to an existing directory to link from
	 * @dest Absolute path to recreate source's own tree at - created if missing
	 */
	private void function hardlinkDirectory( required string source, required string dest ) {
		if ( !directoryExists( arguments.source ) ) {
			return
		}

		directoryCreate( arguments.dest, true, true )

		var Files = createObject( "java", "java.nio.file.Files" )
		var Paths = createObject( "java", "java.nio.file.Paths" )
		var sourcePrefixLength = len( arguments.source ) + 1 // +1 for the separator between source and the relative path below

		for ( var sourceFile in directoryList( arguments.source, true, "path", "*", "asc", "file" ) ) {
			var relativePath = right( sourceFile, len( sourceFile ) - sourcePrefixLength )
			var destFile = arguments.dest & "/" & relativePath

			if ( fileExists( destFile ) ) {
				continue
			}

			var destFileDir = getDirectoryFromPath( destFile )
			if ( !directoryExists( destFileDir ) ) {
				directoryCreate( destFileDir, true, true )
			}

			Files.createLink( Paths.get( destFile ), Paths.get( sourceFile ) )
		}
	}

	/**
	 * Absolute path to this module's own shared (theme-independent) assets,
	 * found relative to this class's own file - the same approach
	 * ThemeRenderer.bx uses for its built-in themes folder.
	 */
	private string function moduleAssetsDir() {
		return getDirectoryFromPath( getCurrentTemplatePath() ).reReplace( "[\/]models[\/]build[\/]?$", "" ) & "/resources/assets"
	}

	/**
	 * Strips a trailing slash so every path built from `projectRoot`
	 * elsewhere in this class never ends up with a doubled `//`.
	 *
	 * @projectRoot A project root, trailing slash optional
	 */
	private string function normalizeRoot( required string projectRoot ) {
		return arguments.projectRoot.reReplace( "[\/]+$", "" )
	}

}
