/**
 * Rewrites relative `.md` links inside a page's already-rendered HTML into
 * their built pretty-URL equivalents - `[Search](../guides/search.md)`
 * written in Markdown needs to become `href="/base/guides/search/index.html"`
 * once built, the same way `docs/guides/search.md` itself became
 * `guides/search/index.html` (DocsLoader.bx's own `urlPathFor()`).
 *
 * bx-markdown/Flexmark has no concept of a sibling page's eventual output
 * path - it renders a link's href completely verbatim - so left alone,
 * every page-to-page link written the normal (and GitHub-readable)
 * mkdocs way, as a file-relative `.md` path, 404s once built. This is a
 * post-processing pass, same shape as CodeAnnotationProcessor.applyToHtml()
 * - it only ever touches already-rendered HTML, never the source Markdown.
 */
class {

	variables.hrefPattern = createObject( "java", "java.util.regex.Pattern" ).compile( 'href="([^"]*)"' )
	variables.suffixPattern = createObject( "java", "java.util.regex.Pattern" ).compile( "^([^##?]*)([##?].*)?$" )

	/**
	 * Rewrites every relative `.md` link in `html` into its root-relative
	 * built URL. Absolute URLs (`http://`, `mailto:`, ...), links already
	 * starting with `/`, and pure in-page anchors (a leading "##") are left
	 * untouched - only a bare/relative path ending in `.md` (optionally
	 * followed by an anchor or query string) is a candidate.
	 *
	 * @html Already-rendered page HTML (MarkdownRenderer.toHtml()'s own output)
	 * @sourceRelativePath The current page's own docs/-relative source path (DocsLoader.bx's `relativePath`, e.g. "guides/themes.md") - relative links are resolved against its directory, exactly like a `.md` file's own relative links already work when read directly on GitHub
	 * @basePath Root-relative base path ending with `/` (BaseUrlResolver's `basePath`) - every rewritten link is re-rooted under it, matching every other internal link the theme renders
	 * @postUrlsByPath Optional override map, keyed by a docs/-relative `.md` path, of its REAL built `urlPath` - a blog post's `blog/<slug>/index.html` (BlogDiscoverer.bx's own convention) diverges from the generic mirrors-its-source-directory convention urlPathFor() below computes, so a link that resolves to one of these keys uses the given urlPath verbatim instead. Defaults to `{}` (today's plain urlPathFor()-only behavior) for every caller that has no such posts (or doesn't know about them, e.g. a standalone search-index rebuild)
	 *
	 * @return html with every relative `.md` href resolved to its built URL
	 */
	string function resolve( required string html, required string sourceRelativePath, required string basePath, struct postUrlsByPath = {} ) {
		var currentDir = directoryOf( arguments.sourceRelativePath )
		var matcher = variables.hrefPattern.matcher( arguments.html )
		var buffer = createObject( "java", "java.lang.StringBuilder" ).init()

		while ( matcher.find() ) {
			var resolved = resolveHref( matcher.group( 1 ), currentDir, arguments.basePath, arguments.postUrlsByPath )
			matcher.appendReplacement( buffer, quoteReplacement( 'href="' & resolved & '"' ) )
		}
		matcher.appendTail( buffer )

		return buffer.toString()
	}

	/**
	 * @relativePath A docs/-relative path, e.g. "guides/themes.md"
	 *
	 * @return Its directory, e.g. "guides" - "" for a root-level page
	 */
	private string function directoryOf( required string relativePath ) {
		var segments = listToArray( arguments.relativePath, "/", true )
		segments.deleteAt( segments.len() )
		return segments.toList( "/" )
	}

	/**
	 * @href One `href="..."` attribute value, exactly as bx-markdown rendered it
	 * @currentDir The current page's own docs/-relative directory (directoryOf())
	 * @basePath Root-relative base path ending with `/`
	 * @postUrlsByPath resolve()'s own override map, forwarded as-is
	 *
	 * @return href unchanged, or resolved to its built root-relative URL
	 */
	private string function resolveHref( required string href, required string currentDir, required string basePath, struct postUrlsByPath = {} ) {
		if (
			!len( trim( arguments.href ) )
			|| arguments.href.reFindNoCase( "^[a-z][a-z0-9+.\-]*:" )
			|| left( arguments.href, 1 ) == "/"
			|| left( arguments.href, 1 ) == "##"
		) {
			return arguments.href
		}

		var matcher = variables.suffixPattern.matcher( arguments.href )
		if ( !matcher.matches() ) {
			return arguments.href
		}

		var path = matcher.group( 1 )
		var suffix = isNull( matcher.group( 2 ) ) ? "" : matcher.group( 2 )

		if ( !path.reFindNoCase( "\.md$" ) ) {
			return arguments.href
		}

		var resolvedPath = resolvePath( arguments.currentDir, path )
		var urlPath = arguments.postUrlsByPath.keyExists( resolvedPath ) ? arguments.postUrlsByPath[ resolvedPath ] : urlPathFor( resolvedPath )
		return arguments.basePath & urlPath & suffix
	}

	/**
	 * Resolves a `.` / `..` / sibling-relative path against a base
	 * directory - standard filesystem-style segment resolution, e.g.
	 * `resolvePath( "guides", "../configuration.md" )` -> `"configuration.md"`.
	 *
	 * @baseDir A docs/-relative directory (directoryOf()'s own output)
	 * @relativePath The href's path portion (its `.md` target, before any anchor or query string)
	 */
	private string function resolvePath( required string baseDir, required string relativePath ) {
		var stack = []
		for ( var segment in listToArray( arguments.baseDir & "/" & arguments.relativePath, "/", true ) ) {
			if ( segment == "." || !len( segment ) ) {
				continue
			} else if ( segment == ".." ) {
				if ( stack.len() ) {
					stack.deleteAt( stack.len() )
				}
			} else {
				stack.append( segment )
			}
		}
		return stack.toList( "/" )
	}

	/**
	 * Mirrors DocsLoader.bx's own `urlPathFor()` exactly - a resolved
	 * `.md` link needs the identical `index.md` -> same-dir `index.html` /
	 * `name.md` -> `name/index.html` transform that page itself already
	 * got when it was built, or the two would disagree on where it lives.
	 *
	 * @relativePath A docs/-relative `.md` path, already resolved (resolvePath())
	 */
	private string function urlPathFor( required string relativePath ) {
		var segments = listToArray( arguments.relativePath, "/" )
		var baseName = segments[ segments.len() ].reReplaceNoCase( "\.md$", "" )
		segments.deleteAt( segments.len() )

		if ( compareNoCase( baseName, "index" ) == 0 ) {
			segments.append( "index.html" )
		} else {
			segments.append( baseName )
			segments.append( "index.html" )
		}

		return segments.toList( "/" )
	}

	/**
	 * Escapes literal text for use as a `Matcher#appendReplacement` argument.
	 *
	 * @text Literal text to safely pass through java.util.regex.Matcher#appendReplacement, which otherwise treats `$` and `\` as backreference syntax
	 */
	private string function quoteReplacement( required string text ) {
		return createObject( "java", "java.util.regex.Matcher" ).quoteReplacement( arguments.text )
	}

}
