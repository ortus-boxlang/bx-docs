class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.Doctor", function() {

			beforeEach( function() {
				variables.verb = new "models.cli.Doctor@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private string function newProjectRoot( string bxsitesJson = '{"name":"Test Site","theme":{"name":"bootstrap"}}' ) {
				var dir = createTempDirectory( prefix = "bxsites-cli-doctor-" );
				tempDirs.append( dir );
				fileWrite( dir & "/bxsites.json", arguments.bxsitesJson );
				directoryCreate( dir & "/docs", true, true );
				fileWrite( dir & "/docs/index.md", "Home" );
				return dir;
			}

			it( "throws BxSites.MissingProjectRoot when projectRoot is blank", function() {
				expect( function() {
					verb.run( {} );
				} ).toThrow( "BxSites.MissingProjectRoot" );
			} );

			it( "exits 0 with a clean project", function() {
				var projectRoot = newProjectRoot();

				var result = verb.run( { projectRoot : projectRoot } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toInclude( "docs/" );
				expect( result.message ).toInclude( "Config" );
				expect( result.message ).toInclude( "Modules" );
			} );

			it( "exits 1 and reports missing docs/ when there's no docs directory", function() {
				var projectRoot = createTempDirectory( prefix = "bxsites-cli-doctor-" );
				tempDirs.append( projectRoot );
				fileWrite( projectRoot & "/bxsites.json", '{"name":"Test Site","theme":{"name":"bootstrap"}}' );

				var result = verb.run( { projectRoot : projectRoot } );

				expect( result.exitCode ).toBe( 1 );
				expect( result.message ).toInclude( "no docs/ or src/ directory" );
			} );

			it( "exits 1 and reports an invalid bxsites.json", function() {
				var projectRoot = createTempDirectory( prefix = "bxsites-cli-doctor-" );
				tempDirs.append( projectRoot );
				fileWrite( projectRoot & "/bxsites.json", "{not valid json" );

				var result = verb.run( { projectRoot : projectRoot } );

				expect( result.exitCode ).toBe( 1 );
				expect( result.message ).toInclude( "not valid JSON" );
			} );

			it( "exits 1 when a project theme/ override is missing a required file", function() {
				var projectRoot = newProjectRoot();
				directoryCreate( projectRoot & "/theme", true, true );
				fileWrite( projectRoot & "/theme/layout.bxm", "<html></html>" );

				var result = verb.run( { projectRoot : projectRoot } );

				expect( result.exitCode ).toBe( 1 );
				expect( result.message ).toInclude( "missing required page.bxm" );
			} );

			it( "exits 0 when a project theme/ override has both required files", function() {
				var projectRoot = newProjectRoot();
				directoryCreate( projectRoot & "/theme", true, true );
				fileWrite( projectRoot & "/theme/layout.bxm", "<html></html>" );
				fileWrite( projectRoot & "/theme/page.bxm", "<article></article>" );

				var result = verb.run( { projectRoot : projectRoot } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toInclude( "layout.bxm + page.bxm present" );
			} );

			it( "never mentions bx-toml or bx-ftp for a project that uses neither", function() {
				var projectRoot = newProjectRoot();

				var result = verb.run( { projectRoot : projectRoot } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).notToInclude( "bx-toml" );
				expect( result.message ).notToInclude( "bx-ftp" );
			} );

			it( "reports bx-toml when the project has a docs/data/*.toml file - present in this test environment (tests.yml installs it)", function() {
				var projectRoot = newProjectRoot();
				directoryCreate( projectRoot & "/docs/data", true, true );
				fileWrite( projectRoot & "/docs/data/authors.toml", 'name = "Ortus"' );

				var result = verb.run( { projectRoot : projectRoot } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toInclude( "bx-toml" );
				expect( result.message ).toInclude( "present" );
			} );

			it( "reports bx-ftp when a deployments/*.json entry targets ftp or sftp, whether or not it's actually installed here", function() {
				var projectRoot = newProjectRoot();
				directoryCreate( projectRoot & "/deployments", true, true );
				fileWrite( projectRoot & "/deployments/prod.json", '{"target":"sftp","host":"example.com","remotePath":"/var/www","username":"deploy"}' );

				var result = verb.run( { projectRoot : projectRoot } );

				// Whether bx-ftp happens to be installed in whichever
				// environment runs this spec isn't the point being tested
				// here (tests.yml's own module list doesn't include it,
				// unlike bx-toml) - just that the project's real need for
				// it is actually detected and surfaced either way.
				expect( result.message ).toInclude( "bx-ftp" );
				expect( result.message ).toInclude( "prod" );
			} );

		} );
	}

}
