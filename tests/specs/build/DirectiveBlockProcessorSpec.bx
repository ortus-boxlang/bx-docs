class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.DirectiveBlockProcessor", function() {

			beforeEach( function() {
				variables.processor = new "models.build.DirectiveBlockProcessor@bxsites"();
				variables.renderer = new "tests.support.FakeMarkdownRenderer@bxsites"();
				variables.variablesProcessor = new "models.build.VariablesProcessor@bxsites"();
			} );

			private string function render( required string markdown ) {
				var extracted = processor.extract( markdown );
				return htmlDecode( processor.restore( extracted.markdown, extracted.blocks, renderer, {} ) );
			}

			/**
			 * ::: for/::: if need setLoopContext() called first (mirroring
			 * BuildPipeline.convertMarkdown()'s own wiring) - a plain render()
			 * call (no context) is used instead where a test wants to prove
			 * the "no data context available" fallback.
			 */
			private string function renderWithData( required string markdown, struct pageVars = {} ) {
				processor.setLoopContext( variablesProcessor, arguments.pageVars, {}, {} );
				return render( arguments.markdown );
			}

			// encodeForHTML()'s exact escaping range for "safe" ASCII punctuation
			// (e.g. "/") and non-ASCII characters (emoji) is environment-dependent
			// (locale/JVM-charset-driven) - both the escaped numeric-entity form and
			// the raw character are equally valid, equivalent HTML, so assertions
			// below compare against decoded output rather than pinning one form.
			private string function htmlDecode( required string text ) {
				var matcher = createObject( "java", "java.util.regex.Pattern" ).compile( '&##x([0-9a-fA-F]+);' ).matcher( arguments.text )
				var buffer = createObject( "java", "java.lang.StringBuilder" ).init()
				while ( matcher.find() ) {
					var codepoint = createObject( "java", "java.lang.Integer" ).parseInt( matcher.group( 1 ), 16 )
					var chars = createObject( "java", "java.lang.String" ).valueOf( createObject( "java", "java.lang.Character" ).toChars( codepoint ) )
					matcher.appendReplacement( buffer, createObject( "java", "java.util.regex.Matcher" ).quoteReplacement( chars ) )
				}
				matcher.appendTail( buffer )
				return buffer.toString()
			}

			it( "leaves markdown with no directives untouched aside from trimming", function() {
				var md = "Just a paragraph.";
				var extracted = processor.extract( md );

				expect( extracted.blocks.len() ).toBe( 0 );
				expect( extracted.markdown ).toInclude( "Just a paragraph." );
			} );

			it( "renders an expandable as a <details>/<summary>, closed by default", function() {
				var html = render( '::: expandable "FAQ"' & char( 10 ) & "Body text." & char( 10 ) & ":::" );

				expect( html ).toInclude( '<details class="bxsites-expandable">' );
				expect( html ).toInclude( "<summary>FAQ</summary>" );
				expect( html ).toInclude( "Body text." );
				expect( html ).notToInclude( " open>" );
			} );

			it( "opens an expandable by default when open=""true""", function() {
				var html = render( '::: expandable "FAQ" open="true"' & char( 10 ) & "Body." & char( 10 ) & ":::" );

				expect( html ).toInclude( '<details class="bxsites-expandable" open>' );
			} );

			it( "renders a cards group with nested card children, each with title/icon/href/body", function() {
				var md = "::: cards" & char( 10 ) &
					'::: card title="Getting Started" icon="🚀" href="getting-started.md"' & char( 10 ) &
					"Install and scaffold." & char( 10 ) & ":::" & char( 10 ) &
					'::: card title="Themes"' & char( 10 ) &
					"No href here." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-cards">' );
				expect( html ).toInclude( '<a class="bxsites-card" href="getting-started.md">' );
				expect( html ).toInclude( '<div class="bxsites-card__icon">🚀</div>' );
				expect( html ).toInclude( '<div class="bxsites-card__title">Getting Started</div>' );
				expect( html ).toInclude( "Install and scaffold." );
				// A card with no href renders as a plain <div>, not a link.
				expect( html ).toInclude( '<div class="bxsites-card">' );
				expect( html ).toInclude( '<div class="bxsites-card__title">Themes</div>' );
			} );

			it( "unwraps a nested <a> from a linked card's body, instead of nesting it inside the card's own <a>", function() {
				// bx-markdown auto-links a bare email/URL it finds in body text
				// (GFM autolinking) - if the card itself already has an [href],
				// that produces an <a> nested inside the card's own outer <a>,
				// which is invalid HTML. Browsers "fix" that by force-closing the
				// outer <a> the instant they hit the inner one, splitting the
				// card's rendered box in half and stranding the rest of its
				// content outside it entirely.
				var md = "::: cards" & char( 10 ) &
					'::: card title="Get in touch" href="mailto:consulting@ortussolutions.com"' & char( 10 ) &
					'Email <a href="mailto:consulting@ortussolutions.com">consulting@ortussolutions.com</a> to talk.' & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<a class="bxsites-card" href="mailto:consulting@ortussolutions.com">' );
				expect( html ).toInclude( "consulting@ortussolutions.com" );
				// Exactly one <a> for the whole card - none nested inside its body.
				expect( html.reMatchNoCase( "<a[ >]" ).len() ).toBe( 1 );
			} );

			it( "resolves a card's [icon] the same way frontmatter/nav icons are - a named icon renders as inline SVG", function() {
				var md = "::: cards" & char( 10 ) &
					'::: card title="Themes" icon="phosphor-duotone:palette"' & char( 10 ) & "Body." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-card__icon"><svg' );
				expect( html ).toInclude( 'class="bxsites-icon"' );
				expect( html ).notToInclude( "phosphor-duotone:palette" );
			} );

			it( "renders columns honoring a valid CSS width and ignoring an invalid one", function() {
				var md = "::: columns" & char( 10 ) &
					'::: column width="50%"' & char( 10 ) & "Left." & char( 10 ) & ":::" & char( 10 ) &
					'::: column width="javascript:alert(1)"' & char( 10 ) & "Right." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( 'style="--bxsites-column-width:50%"' );
				expect( html ).notToInclude( "javascript:" );
			} );

			it( "renders a numbered stepper from step children, in order", function() {
				var md = "::: stepper" & char( 10 ) &
					'::: step "Install"' & char( 10 ) & "Step one." & char( 10 ) & ":::" & char( 10 ) &
					'::: step "Build"' & char( 10 ) & "Step two." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-step__marker">1</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__title">Install</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__marker">2</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__title">Build</div>' );
			} );

			it( "flags a step with one of the semantic marker colors via its own [color] attribute", function() {
				var md = "::: stepper" & char( 10 ) &
					'::: step "Install" color="success"' & char( 10 ) & "Step one." & char( 10 ) & ":::" & char( 10 ) &
					'::: step "Wipe data" color="danger"' & char( 10 ) & "Step two." & char( 10 ) & ":::" & char( 10 ) &
					'::: step "Optional" color="warning"' & char( 10 ) & "Step three." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-step__marker bxsites-step__marker--success">1</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__marker bxsites-step__marker--danger">2</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__marker bxsites-step__marker--warning">3</div>' );
			} );

			it( "is case-insensitive on a step's [color] attribute", function() {
				var md = "::: stepper" & char( 10 ) &
					'::: step "Install" color="SUCCESS"' & char( 10 ) & "Step one." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-step__marker bxsites-step__marker--success">1</div>' );
			} );

			it( "falls back to the default marker for a step with no/unrecognized [color]", function() {
				var md = "::: stepper" & char( 10 ) &
					'::: step "Install"' & char( 10 ) & "Step one." & char( 10 ) & ":::" & char( 10 ) &
					'::: step "Build" color="purple"' & char( 10 ) & "Step two." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-step__marker">1</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__marker">2</div>' );
				expect( html ).notToInclude( "bxsites-step__marker--purple" );
			} );

			it( "recurses into a directive nested inside another block's content", function() {
				var md = '::: expandable "Outer"' & char( 10 ) &
					"::: cards" & char( 10 ) &
					'::: card title="Inner" href="x.md"' & char( 10 ) & "Inner body." & char( 10 ) & ":::" & char( 10 ) &
					":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( "<summary>Outer</summary>" );
				expect( html ).toInclude( '<div class="bxsites-cards">' );
				expect( html ).toInclude( '<div class="bxsites-card__title">Inner</div>' );
			} );

			it( "renders a file block as a download link, falling back to the filename when no title is given", function() {
				var html = render( '::: file src="assets/spec.pdf"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<a class="bxsites-file" href="assets/spec.pdf" download>' );
				expect( html ).toInclude( "spec.pdf" );
			} );

			it( "a trailing bare ::: on the same line self-closes a directive with no body - no separate closing line needed", function() {
				var html = render( '::: file src="assets/spec.pdf" :::' );

				expect( html ).toInclude( '<a class="bxsites-file" href="assets/spec.pdf" download>' );
				expect( html ).toInclude( "spec.pdf" );
			} );

			it( "the self-closing form and the two-line form render identically", function() {
				var twoLine = render( '::: page-link href="../getting-started.md"' & char( 10 ) & ":::" );
				var oneLine = render( '::: page-link href="../getting-started.md" :::' );

				expect( oneLine ).toBe( twoLine );
			} );

			it( "the self-closing form still works with no attrs at all (a bare directive followed only by a trailing :::)", function() {
				var html = render( "::: pagebreak :::" );

				expect( html ).toInclude( 'data-bxsites-pagebreak' );
			} );

			it( "the self-closing form composes with nesting - a self-closed child inside a container block still renders", function() {
				var md = "::: cards" & char( 10 ) &
					'::: card title="Solo" :::' & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-card__title">Solo</div>' );
			} );

			it( "resolveFileHrefs() prefixes a bare file href with basePath, so a nested page's download link doesn't 404", function() {
				var html = render( '::: file src="assets/spec.pdf"' & char( 10 ) & ":::" );

				var resolved = processor.resolveFileHrefs( html, "/guides/content-blocks/" );

				expect( resolved ).toInclude( '<a class="bxsites-file" href="/guides/content-blocks/assets/spec.pdf" download>' );
			} );

			it( "resolveFileHrefs() leaves an already root-relative or absolute file href untouched", function() {
				var rootRelative = render( '::: file src="/downloads/spec.pdf"' & char( 10 ) & ":::" );
				var absolute = render( '::: file src="https://example.com/spec.pdf"' & char( 10 ) & ":::" );

				expect( processor.resolveFileHrefs( rootRelative, "/guides/content-blocks/" ) ).toInclude( 'href="/downloads/spec.pdf"' );
				expect( processor.resolveFileHrefs( absolute, "/guides/content-blocks/" ) ).toInclude( 'href="https://example.com/spec.pdf"' );
			} );

			it( "renders a pagebreak block as a plain <hr>, no attributes needed", function() {
				var html = render( "::: pagebreak" & char( 10 ) & ":::" );

				expect( html ).toInclude( '<hr class="bxsites-pagebreak" data-bxsites-pagebreak>' );
			} );

			it( "renders a basic button as a link, defaulting to secondary style and medium size", function() {
				var html = render( '::: button "Get Started" href="getting-started.md"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<a class="bxsites-button bxsites-button--secondary bxsites-button--medium" href="getting-started.md">' );
				expect( html ).toInclude( '<span class="bxsites-button__label">Get Started</span>' );
			} );

			it( "renders a button with an explicit primary style and large size", function() {
				var html = render( '::: button "Get Started" href="getting-started.md" style="primary" size="large"' & char( 10 ) & ":::" );

				expect( html ).toInclude( 'bxsites-button bxsites-button--primary bxsites-button--large' );
			} );

			it( "falls back to secondary/medium for an unrecognized [style]/[size] instead of erroring", function() {
				var html = render( '::: button "Get Started" href="x.md" style="bogus" size="huge"' & char( 10 ) & ":::" );

				expect( html ).toInclude( 'bxsites-button--secondary bxsites-button--medium' );
			} );

			it( "resolves a button's [icon] the same way a card's icon is", function() {
				var html = render( '::: button "Get Started" href="x.md" icon="🚀"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<span class="bxsites-button__icon">🚀</span>' );
			} );

			it( "adds target=""_blank""/rel=noopener when [target] is ""_blank"", and omits it otherwise", function() {
				var blank = render( '::: button "Docs" href="https://example.com" target="_blank"' & char( 10 ) & ":::" );
				var sameTab = render( '::: button "Docs" href="https://example.com"' & char( 10 ) & ":::" );

				expect( blank ).toInclude( 'target="_blank" rel="noopener noreferrer"' );
				expect( sameTab ).notToInclude( "target=" );
			} );

			it( "renders a disabled button as an inert <span>, even when an href is also given", function() {
				var html = render( '::: button "Coming soon" href="x.md" disabled="true"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<span class="bxsites-button bxsites-button--secondary bxsites-button--medium bxsites-button--disabled" aria-disabled="true">' );
				expect( html ).toInclude( "Coming soon" );
				expect( html ).notToInclude( "<a " );
			} );

			it( "renders an invalid-block message when a button is missing its required label", function() {
				var html = render( '::: button href="x.md"' & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-button--invalid" );
				expect( html ).toInclude( '::: button - requires a "Label" title' );
			} );

			it( "renders a buttons wrapper with multiple button children laid out in a row", function() {
				var md = "::: buttons" & char( 10 ) &
					'::: button "Get Started" href="a.md" style="primary"' & char( 10 ) & ":::" & char( 10 ) &
					'::: button "Learn More" href="b.md"' & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-buttons">' );
				expect( html ).toInclude( "bxsites-button--primary" );
				expect( html ).toInclude( "Get Started" );
				expect( html ).toInclude( "Learn More" );
			} );

			it( "renders an openapi block as a placeholder div carrying its src and optional title", function() {
				var html = render( '::: openapi src="assets/openapi/example.yaml" title="Example API"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<div class="bxsites-openapi" data-openapi-src="assets/openapi/example.yaml">' );
				expect( html ).toInclude( '<div class="bxsites-openapi__title">Example API</div>' );
			} );

			it( "renders an openapi block with no title as a bare placeholder div", function() {
				var html = render( '::: openapi src="assets/openapi/example.yaml"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<div class="bxsites-openapi" data-openapi-src="assets/openapi/example.yaml"></div>' );
			} );

			it( "renders an invalid-block message when an openapi block is missing its required src", function() {
				var html = render( '::: openapi title="No src"' & char( 10 ) & ":::" );

				expect( html ).toInclude( "missing required src" );
			} );

			it( "resolveOpenApiSrcs() prefixes a bare openapi src with basePath, so the widget fetches the right spec from a nested page", function() {
				var html = render( '::: openapi src="assets/openapi/example.yaml"' & char( 10 ) & ":::" );

				var resolved = processor.resolveOpenApiSrcs( html, "/guides/content-blocks/" );

				expect( resolved ).toInclude( 'data-openapi-src="/guides/content-blocks/assets/openapi/example.yaml"' );
			} );

			it( "resolveOpenApiSrcs() leaves an already root-relative or absolute openapi src untouched", function() {
				var rootRelative = render( '::: openapi src="/specs/example.yaml"' & char( 10 ) & ":::" );
				var absolute = render( '::: openapi src="https://example.com/spec.yaml"' & char( 10 ) & ":::" );

				expect( processor.resolveOpenApiSrcs( rootRelative, "/guides/content-blocks/" ) ).toInclude( 'data-openapi-src="/specs/example.yaml"' );
				expect( processor.resolveOpenApiSrcs( absolute, "/guides/content-blocks/" ) ).toInclude( 'data-openapi-src="https://example.com/spec.yaml"' );
			} );

			it( "resolveOpenApiSrcs() also prefixes an operation-scoped block's own src, despite its extra bxsites-openapi--operation class", function() {
				var html = render( '::: openapi src="assets/openapi/example.yaml" operation="GET /books"' & char( 10 ) & ":::" );

				var resolved = processor.resolveOpenApiSrcs( html, "/guides/content-blocks/" );

				expect( resolved ).toInclude( 'data-openapi-src="/guides/content-blocks/assets/openapi/example.yaml"' );
			} );

			it( "resolves a YouTube embed URL to its iframe embed form", function() {
				var html = render( '::: embed url="https://www.youtube.com/watch?v=dQw4w9WgXcQ" title="Demo"' & char( 10 ) & ":::" );

				expect( html ).toInclude( 'src="https://www.youtube.com/embed/dQw4w9WgXcQ"' );
				expect( html ).toInclude( '<div class="bxsites-embed__caption">Demo</div>' );
			} );

			it( "falls back to a plain link card for an unrecognized embed provider", function() {
				var html = render( '::: embed url="https://example.com/random-page"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<a class="bxsites-embed-fallback" href="https://example.com/random-page"' );
				expect( html ).notToInclude( "<iframe" );
			} );

			it( "renders a page-link as a plain stub anchor - enrichment is PageLinkResolver's job", function() {
				var html = render( '::: page-link href="guides/themes.md"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<a class="bxsites-page-link" href="guides/themes.md" data-bxsites-page-link>' );
			} );

			it( "renders a link-preview card for an external URL with title/description/image/domain", function() {
				var md = '::: link-preview url="https://boxlang.io" title="BoxLang" description="A dynamic JVM language." image="https://boxlang.io/og.png"' & char( 10 ) & ":::";
				var html = render( md );

				expect( html ).toInclude( '<a class="bxsites-link-preview" href="https://boxlang.io" target="_blank" rel="noopener noreferrer">' );
				expect( html ).toInclude( '<img src="https://boxlang.io/og.png" alt="">' );
				expect( html ).toInclude( '<div class="bxsites-link-preview__title">BoxLang</div>' );
				expect( html ).toInclude( '<div class="bxsites-link-preview__description">A dynamic JVM language.</div>' );
				expect( html ).toInclude( '<div class="bxsites-link-preview__domain">boxlang.io</div>' );
			} );

			it( "falls back to the bare url as a link-preview's title when none is given, and omits optional parts", function() {
				var html = render( '::: link-preview url="https://example.com/some/page"' & char( 10 ) & ":::" );

				expect( html ).toInclude( 'href="https://example.com/some/page"' );
				expect( html ).notToInclude( "bxsites-link-preview__image" );
				expect( html ).notToInclude( "bxsites-link-preview__description" );
				expect( html ).toInclude( '<div class="bxsites-link-preview__domain">example.com</div>' );
			} );

			it( "renders an invalid-block message when a link-preview is missing its required url", function() {
				var html = render( "::: link-preview" & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-link-preview--invalid" );
			} );

			it( "renders updates entries with date, tags and body, most-recent-first order left to the caller", function() {
				var md = "::: updates" & char( 10 ) &
					'::: update date="2026-01-15" tags="feature,fix"' & char( 10 ) & "Added dark mode." & char( 10 ) & ":::" & char( 10 ) &
					'::: update date="2026-01-01"' & char( 10 ) & "Initial release." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<time class="bxsites-update__date" datetime="2026-01-15">2026-01-15</time>' );
				expect( html ).toInclude( '<span class="bxsites-update__tag">feature</span>' );
				expect( html ).toInclude( '<span class="bxsites-update__tag">fix</span>' );
				expect( html ).toInclude( "Added dark mode." );
				expect( html ).toInclude( "Initial release." );
			} );

			it( "extractUpdateEntries() returns structured entries from an already-extracted updates block", function() {
				var md = "::: updates" & char( 10 ) &
					'::: update date="2026-01-01" tags="a, b"' & char( 10 ) & "Body." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var extracted = processor.extract( md );
				var updatesBlock = extracted.blocks[ 1 ];

				var entries = processor.extractUpdateEntries( updatesBlock, renderer, {} );

				expect( entries.len() ).toBe( 1 );
				expect( entries[ 1 ].date ).toBe( "2026-01-01" );
				expect( entries[ 1 ].tags ).toBe( [ "a", "b" ] );
				expect( entries[ 1 ].contentHtml ).toInclude( "Body." );
			} );

			it( "flushes an unclosed directive at end of file instead of dropping its content", function() {
				var html = render( '::: expandable "Oops, forgot to close"' & char( 10 ) & "Still here." );

				expect( html ).toInclude( "<summary>Oops, forgot to close</summary>" );
				expect( html ).toInclude( "Still here." );
			} );

			it( "renders a ::: conditional block tagged with its own key/value", function() {
				var html = render( '::: conditional key="plan" value="pro"' & char( 10 ) & "Pro-only body." & char( 10 ) & ":::" );

				expect( html ).toInclude( 'class="bxsites-conditional"' );
				expect( html ).toInclude( 'data-bxsites-key="plan"' );
				expect( html ).toInclude( 'data-bxsites-value="pro"' );
				expect( html ).toInclude( "Pro-only body." );
			} );

			it( "renders a ::: conditional error placeholder when key or value is missing", function() {
				var html = render( '::: conditional key="plan"' & char( 10 ) & "x" & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-conditional--invalid" );
			} );

			it( "renders a ::: audience-switcher with one button per option", function() {
				var html = render( '::: audience-switcher key="plan" options="free:Free,pro:Pro"' & char( 10 ) & ":::" );

				expect( html ).toInclude( 'data-bxsites-key="plan"' );
				expect( html.reMatch( 'data-bxsites-value="free"' ).len() ).toBe( 1 );
				expect( html.reMatch( 'data-bxsites-value="pro"' ).len() ).toBe( 1 );
				expect( html ).toInclude( ">Free<" );
				expect( html ).toInclude( ">Pro<" );
			} );

			it( "renders a ::: audience-switcher error placeholder when key or options is missing", function() {
				var html = render( "::: audience-switcher" & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-audience-switcher--invalid" );
			} );

			it( "renders ::: openapi with an operation attribute scoped to one method+path", function() {
				var html = render( '::: openapi src="assets/openapi/spec.yaml" operation="POST /users"' & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-openapi--operation" );
				expect( html ).toInclude( 'data-openapi-operation="post /users"' );
			} );

			it( "renders an ::: openapi invalid placeholder when operation isn't METHOD /path", function() {
				var html = render( '::: openapi src="assets/openapi/spec.yaml" operation="nope"' & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-openapi--invalid" );
			} );

			it( "still renders plain ::: openapi with no operation attribute unaffected", function() {
				var html = render( '::: openapi src="assets/openapi/spec.yaml"' & char( 10 ) & ":::" );

				expect( html ).toInclude( 'data-openapi-src="assets/openapi/spec.yaml"' );
				expect( html ).notToInclude( "data-openapi-operation" );
				expect( html ).notToInclude( "bxsites-openapi--operation" );
			} );

			it( "renders a ::: prompt with description, a default sparkle icon, a copy button carrying the raw prompt text, and no toggle in its default full state", function() {
				var html = render( '::: prompt description="Summarize a PR"' & char( 10 ) & "Summarize this diff." & char( 10 ) & ":::" );

				expect( html ).toInclude( '<div class="bxsites-prompt bxsites-prompt--full" data-bxsites-prompt-text="Summarize this diff.">' );
				expect( html ).toInclude( '<div class="bxsites-prompt__icon"><svg' );
				expect( html ).toInclude( '<span class="bxsites-prompt__label">Prompt</span>' );
				expect( html ).toInclude( '<span class="bxsites-prompt__description">Summarize a PR</span>' );
				expect( html ).toInclude( '<button type="button" class="bxsites-prompt__copy"' );
				expect( html ).toInclude( "<p>Summarize this diff.</p>" );
				expect( html ).notToInclude( "bxsites-prompt__toggle" );
			} );

			it( "omits a ::: prompt's own description span when none is given", function() {
				var html = render( "::: prompt" & char( 10 ) & "Body." & char( 10 ) & ":::" );

				expect( html ).notToInclude( "bxsites-prompt__description" );
			} );

			it( "resolves a ::: prompt's own [icon] the same way a card's icon is, overriding the default sparkle glyph", function() {
				var html = render( '::: prompt icon="phosphor-duotone:robot"' & char( 10 ) & "Body." & char( 10 ) & ":::" );

				expect( html ).toInclude( '<div class="bxsites-prompt__icon"><svg' );
			} );

			it( "renders a ::: prompt with expanded=""hidden"" behind a Show prompt toggle", function() {
				var html = render( '::: prompt expanded="hidden"' & char( 10 ) & "Secret prompt." & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-prompt--hidden" );
				expect( html ).toInclude( 'data-label-collapsed="Show prompt"' );
				expect( html ).toInclude( 'data-label-expanded="Hide prompt"' );
				expect( html ).toInclude( ">Show prompt</button>" );
			} );

			it( "renders a ::: prompt with expanded=""preview"" behind a Show more toggle, and normalizes the ""partial""/""collapsed"" synonyms", function() {
				var previewHtml = render( '::: prompt expanded="preview"' & char( 10 ) & "Body." & char( 10 ) & ":::" );
				expect( previewHtml ).toInclude( "bxsites-prompt--preview" );
				expect( previewHtml ).toInclude( ">Show more</button>" );

				var partialHtml = render( '::: prompt expanded="partial"' & char( 10 ) & "Body." & char( 10 ) & ":::" );
				expect( partialHtml ).toInclude( "bxsites-prompt--preview" );

				var collapsedHtml = render( '::: prompt expanded="collapsed"' & char( 10 ) & "Body." & char( 10 ) & ":::" );
				expect( collapsedHtml ).toInclude( "bxsites-prompt--hidden" );
			} );

			it( "falls back a ::: prompt's unrecognized [expanded] to full, with no toggle", function() {
				var html = render( '::: prompt expanded="nonsense"' & char( 10 ) & "Body." & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-prompt--full" );
				expect( html ).notToInclude( "bxsites-prompt__toggle" );
			} );

			it( "renders a ::: contact-form with a labeled input per field, required marked, and a working honeypot + submit button", function() {
				var html = render( '::: contact-form id="demo-request" to="sales@acme.com" fields="name:text,email*:email,message:textarea" submitLabel="Send" :::' );

				expect( html ).toInclude( '<form class="bxsites-contact-form" data-bx-form data-form-id="demo-request" data-form-to="sales@acme.com" action="/api/forms/submit" method="POST">' );

				// name: text, not required
				expect( html ).toInclude( '<label class="bxsites-contact-form__label" for="bxsites-contact-form-demo-request-name">Name</label>' );
				expect( html ).toInclude( '<input class="bxsites-contact-form__input" type="text" id="bxsites-contact-form-demo-request-name" name="name">' );

				// email: required
				expect( html ).toInclude( 'for="bxsites-contact-form-demo-request-email">Email <span class="bxsites-contact-form__required" aria-hidden="true">*</span></label>' );
				expect( html ).toInclude( '<input class="bxsites-contact-form__input" type="email" id="bxsites-contact-form-demo-request-email" name="email" required>' );

				// message: textarea
				expect( html ).toInclude( '<textarea class="bxsites-contact-form__input bxsites-contact-form__textarea" id="bxsites-contact-form-demo-request-message" name="message"></textarea>' );

				// honeypot - off-screen, not display:none/hidden
				expect( html ).toInclude( 'type="text" name="_hp" tabindex="-1" autocomplete="off"' );
				expect( html ).toInclude( "position:absolute;left:-9999px" );

				// submit button reuses the shared ::: button styling/markup
				expect( html ).toInclude( '<button type="submit" class="bxsites-button bxsites-button--primary bxsites-button--medium">' );
				expect( html ).toInclude( '<span class="bxsites-button__label">Send</span>' );

				expect( html ).toInclude( '<div class="bxsites-contact-form__status" data-bx-form-status hidden></div>' );
			} );

			it( "defaults a ::: contact-form's [id] to ""contact"" and [submitLabel] to ""Send"" when omitted, and omits data-form-to when [to] is omitted", function() {
				var html = render( '::: contact-form fields="email:email" :::' );

				expect( html ).toInclude( 'data-form-id="contact"' );
				expect( html ).notToInclude( "data-form-to" );
				expect( html ).toInclude( '<span class="bxsites-button__label">Send</span>' );
			} );

			it( "falls back an unrecognized ::: contact-form field type to text rather than erroring", function() {
				var html = render( '::: contact-form fields="phone:tel" :::' );

				expect( html ).toInclude( '<input class="bxsites-contact-form__input" type="text" id="bxsites-contact-form-contact-phone" name="phone">' );
			} );

			it( "renders a ::: contact-form [type=number] field as a real number input, matching bxSites Cloud's own numeric validation for it", function() {
				var html = render( '::: contact-form fields="quantity:number" :::' );

				expect( html ).toInclude( '<input class="bxsites-contact-form__input" type="number" id="bxsites-contact-form-contact-quantity" name="quantity">' );
			} );

			it( "humanizes a ::: contact-form field's dashed/underscored name into its own label", function() {
				var html = render( '::: contact-form fields="full-name:text,company_size:text" :::' );

				expect( html ).toInclude( ">Full Name</label>" );
				expect( html ).toInclude( ">Company Size</label>" );
			} );

			it( "renders a ::: contact-form invalid placeholder when fields is missing", function() {
				var html = render( "::: contact-form" & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-contact-form--invalid" );
				expect( html ).toInclude( "missing required" );
			} );

			it( "renders a ::: contact-form invalid placeholder when fields has no valid name:type entries", function() {
				var html = render( '::: contact-form fields="nonsense"' & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-contact-form--invalid" );
			} );

			it( "parses the ::: contact-form fields DSL - required marker, type fallback, and skipping a malformed segment", function() {
				var html = render( '::: contact-form fields="name:text, email*:email , nonsense , phone:tel" :::' );

				expect( html ).toInclude( 'name="name"' );
				expect( html ).notToInclude( 'name="name" required' );
				expect( html ).toInclude( 'name="email" required' );
				expect( html ).toInclude( 'type="text" id="bxsites-contact-form-contact-phone" name="phone"' );
				expect( html ).notToInclude( 'name="nonsense"' );
			} );

			it( "::: for item, index in <path> iterates an array, binding item+1-based index per iteration", function() {
				var md = "::: for item, idx in data.products" & char( 10 ) &
					"{{ item.name }} at position {{ idx }}" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { products : [ { name : "Widget" }, { name : "Gadget" } ] } } );

				expect( html ).toInclude( "Widget at position 1" );
				expect( html ).toInclude( "Gadget at position 2" );
			} );

			it( "::: for key, value in <path> iterates a struct, binding key+value per iteration", function() {
				var md = "::: for who, role in data.roster" & char( 10 ) &
					"{{ who }} is {{ role }}" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { roster : { "alice" : "Admin" } } } );

				expect( html ).toInclude( "alice is Admin" );
			} );

			it( "::: for over a docs/data/*.bx class instance auto-invokes getData(), same as a plain struct/array data.<key>", function() {
				var md = "::: for plan, info in data.pricing" & char( 10 ) &
					"{{ plan }}: {{ info.price }}" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { pricing : new "tests.support.FakeDataClass@bxsites"() } } );

				expect( html ).toInclude( "free: 0" );
				expect( html ).toInclude( "pro: 29" );
			} );

			it( "::: if resolves a call to an explicit method on a docs/data/*.bx class instance", function() {
				var md = '::: if data.pricing.getDiscountedPrice("pro", 0.5)' & char( 10 ) &
					"Discounted!" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { pricing : new "tests.support.FakeDataClass@bxsites"() } } );

				expect( html ).toInclude( "Discounted!" );
			} );

			it( "resolves {{ }} in a ::: for body against the page's own outer vars too, layered under the loop vars", function() {
				var md = "::: for item, idx in data.products" & char( 10 ) &
					"{{ page.title }}: {{ item.name }}" & char( 10 ) & ":::";
				var html = renderWithData( md, { page : { title : "Catalog" }, data : { products : [ { name : "Widget" } ] } } );

				expect( html ).toInclude( "Catalog: Widget" );
			} );

			it( "a ::: for nested inside ::: cards is still found and resolved, layered on the card's own body", function() {
				var md = "::: cards" & char( 10 ) &
					'::: card title="Team"' & char( 10 ) &
					"::: for member, idx in data.team" & char( 10 ) &
					"{{ member.name }}" & char( 10 ) & ":::" & char( 10 ) &
					":::" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { team : [ { name : "Luis" }, { name : "Jon" } ] } } );

				expect( html ).toInclude( "Luis" );
				expect( html ).toInclude( "Jon" );
			} );

			it( "::: if <path> renders its content only when the resolved value is truthy", function() {
				var md = "::: if data.showBanner" & char( 10 ) & "Banner shown." & char( 10 ) & ":::";

				expect( renderWithData( md, { data : { showBanner : true } } ) ).toInclude( "Banner shown." );
				expect( renderWithData( md, { data : { showBanner : false } } ) ).notToInclude( "Banner shown." );
			} );

			it( "::: if <path> treats an empty array/struct/string as falsy, not just BoxLang's own boolean coercion", function() {
				var md = "::: if data.items" & char( 10 ) & "Has items." & char( 10 ) & ":::";

				expect( renderWithData( md, { data : { items : [] } } ) ).notToInclude( "Has items." );
				expect( renderWithData( md, { data : { items : [ "one" ] } } ) ).toInclude( "Has items." );
			} );

			it( "throws BxSites.UnknownVariable when a ::: for/::: if path doesn't resolve", function() {
				expect( function() {
					renderWithData( "::: for item, idx in data.missing" & char( 10 ) & "x" & char( 10 ) & ":::", { data : {} } );
				} ).toThrow( "BxSites.UnknownVariable" );

				expect( function() {
					renderWithData( "::: if data.missing" & char( 10 ) & "x" & char( 10 ) & ":::", { data : {} } );
				} ).toThrow( "BxSites.UnknownVariable" );
			} );

			it( "throws BxSites.InvalidForTarget when a ::: for path resolves to neither an array nor a struct", function() {
				expect( function() {
					renderWithData( "::: for item, idx in data.name" & char( 10 ) & "x" & char( 10 ) & ":::", { data : { name : "Widget" } } );
				} ).toThrow( "BxSites.InvalidForTarget" );
			} );

			it( "renders a ::: for with malformed grammar (not ""a, b in path"") as an invalid-directive placeholder, not a throw", function() {
				var html = render( "::: for item in data.products" & char( 10 ) & "x" & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-directive-invalid" );
			} );

			it( "renders a ::: for whose loop variable name collides with a reserved name (page/data) as an invalid-directive placeholder", function() {
				var html = renderWithData( "::: for data, idx in data.products" & char( 10 ) & "x" & char( 10 ) & ":::", { data : { products : [] } } );

				expect( html ).toInclude( "bxsites-directive-invalid" );
				expect( html ).toInclude( "reserved" );
			} );

			it( "renders ::: for/::: if as an invalid-directive placeholder when no data context was ever wired (setLoopContext() never called)", function() {
				expect( render( "::: for item, idx in data.products" & char( 10 ) & "x" & char( 10 ) & ":::" ) ).toInclude( "bxsites-directive-invalid" );
				expect( render( "::: if data.showBanner" & char( 10 ) & "x" & char( 10 ) & ":::" ) ).toInclude( "bxsites-directive-invalid" );
			} );

			it( "protectLoopDirectives() shields a ::: for/::: if body from a {{ }} pass, restoreLoopDirectives() puts it back verbatim", function() {
				var md = "::: for item, idx in data.products" & char( 10 ) & "{{ item.name }}" & char( 10 ) & ":::";

				var protectedResult = processor.protectLoopDirectives( md );
				// The loop body is still placeholder-protected - {{ item.name }}
				// (an as-yet-unbound loop variable) must never reach a real
				// {{ }} pass, or it would fail as an unknown variable.
				expect( protectedResult.markdown ).notToInclude( "{{ item.name }}" );
				expect( protectedResult.markdown ).toInclude( "bxsites-raw-block" );

				var restored = processor.restoreLoopDirectives( protectedResult.markdown, protectedResult.placeholders );
				expect( restored ).toInclude( "::: for item, idx in data.products" );
				expect( restored ).toInclude( "{{ item.name }}" );
			} );

			it( "protectLoopDirectives() leaves a non-loop directive's own body completely untouched, reconstructed verbatim", function() {
				var md = '::: expandable "FAQ"' & char( 10 ) & "{{ page.title }}" & char( 10 ) & ":::";

				var protectedResult = processor.protectLoopDirectives( md );

				expect( protectedResult.placeholders.isEmpty() ).toBeTrue();
				expect( protectedResult.markdown ).toInclude( '::: expandable "FAQ"' );
				expect( protectedResult.markdown ).toInclude( "{{ page.title }}" );
			} );

			it( "::: if / ::: elseif / ::: else - renders the ::: if branch when its own condition is truthy, skipping every later branch entirely", function() {
				var md = "::: if data.flags.a" & char( 10 ) & "A" & char( 10 ) & ":::" & char( 10 ) &
					// data.missing would throw if ever actually looked up -
					// proves the elseif/else branches below are never even
					// evaluated once an earlier branch already won.
					"::: elseif data.missing" & char( 10 ) & "B" & char( 10 ) & ":::" & char( 10 ) &
					"::: else" & char( 10 ) & "C" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { flags : { a : true } } } );

				expect( html ).toInclude( "A" );
				expect( html ).notToInclude( "B" );
				expect( html ).notToInclude( "C" );
			} );

			it( "::: if / ::: elseif / ::: else - falls through to the first true ::: elseif when ::: if is falsy", function() {
				var md = "::: if data.flags.a" & char( 10 ) & "A" & char( 10 ) & ":::" & char( 10 ) &
					"::: elseif data.flags.b" & char( 10 ) & "B" & char( 10 ) & ":::" & char( 10 ) &
					"::: else" & char( 10 ) & "C" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { flags : { a : false, b : true } } } );

				expect( html ).notToInclude( "A" );
				expect( html ).toInclude( "B" );
				expect( html ).notToInclude( "C" );
			} );

			it( "::: if / ::: elseif / ::: else - falls all the way through to ::: else when every condition above is falsy", function() {
				var md = "::: if data.flags.a" & char( 10 ) & "A" & char( 10 ) & ":::" & char( 10 ) &
					"::: elseif data.flags.b" & char( 10 ) & "B" & char( 10 ) & ":::" & char( 10 ) &
					"::: else" & char( 10 ) & "C" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { flags : { a : false, b : false } } } );

				expect( html ).notToInclude( "A" );
				expect( html ).notToInclude( "B" );
				expect( html ).toInclude( "C" );
			} );

			it( "::: if / ::: elseif - renders nothing when every condition is falsy and there's no ::: else", function() {
				var md = "::: if data.flags.a" & char( 10 ) & "A" & char( 10 ) & ":::" & char( 10 ) &
					"::: elseif data.flags.b" & char( 10 ) & "B" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { flags : { a : false, b : false } } } );

				expect( html ).notToInclude( "A" );
				expect( html ).notToInclude( "B" );
			} );

			it( "the compact form - one trailing ::: for the whole chain, no ::: before ::: elseif/::: else - parses and evaluates identically", function() {
				var md = "::: if data.flags.a" & char( 10 ) & "A" & char( 10 ) &
					"::: elseif data.flags.b" & char( 10 ) & "B" & char( 10 ) &
					"::: else" & char( 10 ) & "C" & char( 10 ) &
					":::";

				expect( renderWithData( md, { data : { flags : { a : true, b : false } } } ) ).toInclude( "A" );
				expect( renderWithData( md, { data : { flags : { a : false, b : true } } } ) ).toInclude( "B" );
				expect( renderWithData( md, { data : { flags : { a : false, b : false } } } ) ).toInclude( "C" );
			} );

			it( "the compact form still short-circuits - a later ::: elseif's own unresolvable path is never looked up once an earlier branch already won", function() {
				var md = "::: if data.flags.a" & char( 10 ) & "A" & char( 10 ) &
					"::: elseif data.missing" & char( 10 ) & "B" & char( 10 ) &
					":::";

				expect( renderWithData( md, { data : { flags : { a : true } } } ) ).toInclude( "A" );
			} );

			it( "mixing an explicit ::: before one ::: elseif with the compact form elsewhere in the same chain still parses correctly", function() {
				var md = "::: if data.flags.a" & char( 10 ) & "A" & char( 10 ) & ":::" & char( 10 ) &
					"::: elseif data.flags.b" & char( 10 ) & "B" & char( 10 ) &
					"::: else" & char( 10 ) & "C" & char( 10 ) &
					":::";

				expect( renderWithData( md, { data : { flags : { a : false, b : true } } } ) ).toInclude( "B" );
			} );

			it( "the compact form works nested inside another block too (e.g. ::: cards)", function() {
				var md = "::: cards" & char( 10 ) &
					'::: card title="Status"' & char( 10 ) &
					"::: if data.flags.a" & char( 10 ) & "On" & char( 10 ) &
					"::: else" & char( 10 ) & "Off" & char( 10 ) &
					":::" & char( 10 ) &
					":::" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { flags : { a : false } } } );

				expect( html ).toInclude( "Off" );
				expect( html ).notToInclude( "On" );
			} );

			it( "a standalone ::: if (no elseif/else siblings) still works exactly as before", function() {
				var md = "::: if data.flags.a" & char( 10 ) & "A" & char( 10 ) & ":::";

				expect( renderWithData( md, { data : { flags : { a : true } } } ) ).toInclude( "A" );
				expect( renderWithData( md, { data : { flags : { a : false } } } ) ).notToInclude( "A" );
			} );

			it( "resolves {{ }} inside the winning branch's own body against the page's outer vars", function() {
				var md = "::: if data.flags.a" & char( 10 ) & "{{ page.title }}" & char( 10 ) & ":::" & char( 10 ) &
					"::: else" & char( 10 ) & "no" & char( 10 ) & ":::";
				var html = renderWithData( md, { page : { title : "Catalog" }, data : { flags : { a : true } } } );

				expect( html ).toInclude( "Catalog" );
			} );

			it( "an orphaned ::: elseif/::: else (no leading ::: if immediately before it) renders as an invalid-directive placeholder", function() {
				var elseifHtml = render( "Some text." & char( 10 ) & char( 10 ) & "::: elseif data.x" & char( 10 ) & "x" & char( 10 ) & ":::" );
				var elseHtml = render( "::: else" & char( 10 ) & "x" & char( 10 ) & ":::" );

				expect( elseifHtml ).toInclude( "bxsites-directive-invalid" );
				expect( elseHtml ).toInclude( "bxsites-directive-invalid" );
			} );

			it( "renders ::: else with a trailing condition as an invalid-directive placeholder (::: else takes no condition)", function() {
				var md = "::: if data.flags.a" & char( 10 ) & "A" & char( 10 ) & ":::" & char( 10 ) &
					"::: else data.flags.b" & char( 10 ) & "B" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { flags : { a : false, b : true } } } );

				expect( html ).toInclude( "bxsites-directive-invalid" );
			} );

			it( "a ::: for nested inside another ::: for resolves both levels' own {{ }} tokens without the outer loop swallowing the inner one's", function() {
				var md = "::: for group, gIdx in data.groups" & char( 10 ) &
					"{{ group.name }}:" & char( 10 ) &
					"::: for member, mIdx in group.members" & char( 10 ) & "{{ member }}" & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = renderWithData( md, { data : { groups : [ { name : "Core", members : [ "Luis", "Jon" ] } ] } } );

				expect( html ).toInclude( "Core" );
				expect( html ).toInclude( "Luis" );
				expect( html ).toInclude( "Jon" );
			} );

			it( "a ::: for inside a ::: if / ::: else branch still resolves - chains and loops compose", function() {
				var md = "::: if data.flags.a" & char( 10 ) &
					"::: for item, idx in data.team" & char( 10 ) & "{{ item.name }}" & char( 10 ) & ":::" & char( 10 ) &
					":::" & char( 10 ) &
					"::: else" & char( 10 ) & "no team" & char( 10 ) & ":::";
				var html = renderWithData( md, { data : { flags : { a : true }, team : [ { name : "Luis" } ] } } );

				expect( html ).toInclude( "Luis" );
				expect( html ).notToInclude( "no team" );
			} );

			it( "renders a ::: course block as a placeholder div carrying its id - the real index is CourseBuilder.bx's own post-pass, not something DirectiveBlockProcessor can render on its own (it never sees the whole page tree)", function() {
				var html = render( '::: course id="getting-started" :::' );

				expect( html ).toInclude( '<div class="bxsites-course-index" data-bxsites-course-index data-bxsites-course-id="getting-started"></div>' );
			} );

			it( "renders an invalid-block message when a course block is missing its required id", function() {
				var html = render( "::: course" & char( 10 ) & ":::" );

				expect( html ).toInclude( "missing required id" );
			} );

		} );
	}

}
