class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.BuildPipeline", function() {

			beforeEach( function() {
				variables.pipeline = new "models.build.BuildPipeline@bxsites"();
				variables.fakeMarkdown = new "tests.support.FakeMarkdownRenderer@bxsites"();
				pipeline.setMarkdownRenderer( fakeMarkdown );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newProject( string themeName = "bootstrap" ) {
				var dir = createTempDirectory( prefix = "bxsites-buildpipeline-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/docs", true, true );
				fileWrite(
					dir & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"' & themeName & '"}}'
				);
				return dir;
			}

			/**
			 * Locates a build's actual theme CSS file, whether or not
			 * [assets.fingerprint] (on by default) renamed it to a hashed
			 * filename - most tests here only care about the CSS content
			 * or that it exists at all, not its exact URL, so this keeps
			 * them agnostic to that (see BuildPipeline.bx's own
			 * resolveThemeStyleUrl()).
			 *
			 * @siteDir Absolute path to a built site/ directory
			 */
			private string function themeCssPath( required string siteDir ) {
				var plain = arguments.siteDir & "/assets/theme/style.css";
				if ( fileExists( plain ) ) {
					return plain;
				}
				var matches = directoryList( arguments.siteDir & "/assets/theme", false, "path", "style.*.css" );
				return matches.len() ? matches[ 1 ] : plain;
			}

			it( "builds a single page site end to end", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Welcome home" );

				var result = pipeline.build( root );

				expect( result.pageCount ).toBe( 1 );
				expect( result.siteDir ).toBe( root & "/site" );
				expect( fileExists( root & "/site/index.html" ) ).toBeTrue();

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "Test Site" );
				expect( html ).toInclude( "<p>Welcome home</p>" );
			} );

			it( "builds from src/ instead of docs/ when only src/ exists, still writing to site/", function() {
				var root = createTempDirectory( prefix = "bxsites-buildpipeline-src-" );
				tempDirs.append( root );
				directoryCreate( root & "/src", true, true );
				fileWrite( root & "/bxsites.json", '{"name":"Test Site"}' );
				fileWrite( root & "/src/index.md", "Welcome from src" );

				var result = pipeline.build( root );

				expect( result.pageCount ).toBe( 1 );
				expect( result.siteDir ).toBe( root & "/site" );
				expect( fileExists( root & "/site/index.html" ) ).toBeTrue();
				expect( fileRead( root & "/site/index.html" ) ).toInclude( "<p>Welcome from src</p>" );
			} );

			it( "prefers docs/ over src/ when a project somehow has both", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "From docs" );
				directoryCreate( root & "/src", true, true );
				fileWrite( root & "/src/index.md", "From src" );

				pipeline.build( root );

				expect( fileRead( root & "/site/index.html" ) ).toInclude( "<p>From docs</p>" );
			} );

			it( "publishes every page's raw .md source alongside its built HTML, and links to it from the page", function() {
				var root = newProject();
				var markdown = "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Setup body";
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", markdown );

				pipeline.build( root );

				expect( fileExists( root & "/site/index.md" ) ).toBeTrue();
				expect( fileRead( root & "/site/index.md" ) ).toBe( "Home" );

				expect( fileExists( root & "/site/guides/setup.md" ) ).toBeTrue();
				expect( fileRead( root & "/site/guides/setup.md" ) ).toBe( markdown );
				// The raw .md sits alongside setup/index.html, not nested under it.
				expect( fileExists( root & "/site/guides/setup/index.html" ) ).toBeTrue();

				var setupHtml = fileRead( root & "/site/guides/setup/index.html" );
				expect( setupHtml ).toInclude( 'href="/guides/setup.md" download' );
			} );

			it( "builds nested pages at their pretty-URL paths and links them in the nav", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Setup body" );

				var result = pipeline.build( root );

				expect( result.pageCount ).toBe( 2 );
				expect( fileExists( root & "/site/guides/setup/index.html" ) ).toBeTrue();

				var homeHtml = fileRead( root & "/site/index.html" );
				expect( homeHtml ).toInclude( 'href="/guides/setup/index.html"' );
				expect( homeHtml ).toInclude( 'href="/index.html"' );
			} );

			it( "rewrites a page's own relative .md links (mkdocs' file-relative convention) to their built pretty-URLs", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", '<a href="guides/setup.md">Setup</a>' );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", '<a href="../index.md">Home</a> <a href="other.md##anchor">Other</a>' );
				fileWrite( root & "/docs/guides/other.md", "Other page" );

				pipeline.build( root );

				var homeHtml = fileRead( root & "/site/index.html" );
				expect( homeHtml ).toInclude( 'href="/guides/setup/index.html"' );

				var setupHtml = fileRead( root & "/site/guides/setup/index.html" );
				expect( setupHtml ).toInclude( 'href="/index.html"' );
				expect( setupHtml ).toInclude( 'href="/guides/other/index.html##anchor"' );
			} );

			it( "wires includes, directive blocks and page-link enrichment together end to end", function() {
				var root = newProject();
				directoryCreate( root & "/docs/includes", true, true );
				fileWrite( root & "/docs/includes/_shared.md", "Shared note." );
				fileWrite(
					root & "/docs/index.md",
					'::: include src="_shared.md"' & char( 10 ) &
					char( 10 ) &
					'::: expandable "FAQ"' & char( 10 ) &
					"Body." & char( 10 ) &
					":::" & char( 10 ) &
					char( 10 ) &
					'::: page-link href="guides/setup.md"' & char( 10 ) &
					":::"
				);
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Setup body" );

				pipeline.build( root );

				var homeHtml = fileRead( root & "/site/index.html" );
				expect( homeHtml ).toInclude( "Shared note." );
				expect( homeHtml ).toInclude( '<details class="bxsites-expandable">' );
				expect( homeHtml ).toInclude( "<summary>FAQ</summary>" );
				// The page-link stub got enriched with its target's real title.
				expect( homeHtml ).toInclude( '<span class="bxsites-page-link__title">Setup</span>' );
			} );

			it( "prefixes a ::: file block's own href with basePath, so it doesn't 404 under a non-root baseURL", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"baseURL":"my-docs"}'
				);
				fileWrite( root & "/docs/index.md", '::: file src="assets/spec.pdf"' & char( 10 ) & ":::" );

				pipeline.build( root );

				var homeHtml = fileRead( root & "/site/index.html" );
				expect( homeHtml ).toInclude( '<a class="bxsites-file" href="/my-docs/assets/spec.pdf" download>' );
			} );

			it( "resolves a named icon in both a page's own header and its nav entry", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "icon: rocket" & char( 10 ) & "---" & char( 10 ) & "Home" );

				pipeline.build( root );
				var html = fileRead( root & "/site/index.html" );

				expect( html ).toInclude( '<span class="page-icon"><svg class="bxsites-icon"' );
				// Same resolved icon also appears a second time, in the sidebar nav entry for this page.
				expect( reMatch( 'class="bxsites-icon"', html ).len() ).toBeGTE( 2 );
			} );

			it( "writes a feed.xml alongside a page with an ::: updates block, only when baseURL is absolute", function() {
				var root = newProject();
				fileWrite(
					root & "/docs/changelog.md",
					"::: updates" & char( 10 ) &
					'::: update date="2026-01-01" tags="feature"' & char( 10 ) &
					"Initial release." & char( 10 ) &
					":::" & char( 10 ) &
					":::"
				);

				pipeline.build( root );
				expect( fileExists( root & "/site/changelog/feed.xml" ) ).toBeFalse();

				fileWrite( root & "/bxsites.json", '{"name":"Test Site","baseURL":"https://example.com/","theme":{"name":"bootstrap"}}' );
				pipeline.build( root );

				expect( fileExists( root & "/site/changelog/feed.xml" ) ).toBeTrue();
				var feed = fileRead( root & "/site/changelog/feed.xml" );
				expect( feed ).toInclude( "<rss version=" );
				expect( feed ).toInclude( "Initial release." );
			} );

			it( "passes bxsites.json's markdown options through to the markdown renderer", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"markdown":{"anchorLinks":false}}'
				);
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				var calls = fakeMarkdown.getCalls();
				expect( calls.len() ).toBe( 1 );
				expect( calls[ 1 ].options.anchorLinks ).toBeFalse();
			} );

			it( "resolves {{ page.<field> }} against the current page's own frontmatter/fields in its rendered content", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: My Guide" & char( 10 ) & "---" & char( 10 ) & "Hello {{ page.title }}!" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "<p>Hello My Guide!</p>" );
			} );

			it( "resolves {{ page.frontmatter.<customKey> }} against a page's own custom frontmatter field", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: My Guide" & char( 10 ) & "product: BoxLang" & char( 10 ) & "---" & char( 10 ) & "Built with {{ page.frontmatter.product }}." );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "<p>Built with BoxLang.</p>" );
			} );

			it( "resolves {{ page.frontmatter.<customKey> }} in a blog post's own content too", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/blog/posts", true, true );
				fileWrite( root & "/docs/blog/posts/hello.md", "---" & char( 10 ) & "date: 2026-01-01" & char( 10 ) & "series: Getting Started" & char( 10 ) & "---" & char( 10 ) & "Part of {{ page.frontmatter.series }}." );

				pipeline.build( root );

				var html = fileRead( root & "/site/blog/hello/index.html" );
				expect( html ).toInclude( "<p>Part of Getting Started.</p>" );
			} );

			it( "shadows a site-wide variables.page (if declared) with the current page's own struct - page is a reserved {{ }} name", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"variables":{"page":"should not win"}}'
				);
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: My Guide" & char( 10 ) & "---" & char( 10 ) & "{{ page.title }}" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "<p>My Guide</p>" );
			} );

			it( "resolves {{ data.<file>.<key> }} against a docs/data/*.json file", function() {
				var root = newProject();
				directoryCreate( root & "/docs/data", true, true );
				fileWrite( root & "/docs/data/products.json", '{"name":"Widget"}' );
				fileWrite( root & "/docs/index.md", "Our product is {{ data.products.name }}." );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "<p>Our product is Widget.</p>" );
			} );

			it( "shadows a site-wide variables.data (if declared) with docs/data/*'s own struct - data is a reserved {{ }} name", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"variables":{"data":"should not win"}}'
				);
				directoryCreate( root & "/docs/data", true, true );
				fileWrite( root & "/docs/data/products.json", '{"name":"Widget"}' );
				fileWrite( root & "/docs/index.md", "{{ data.products.name }}" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "<p>Widget</p>" );
			} );

			it( "resolves {{ data.<file>.<key> }} identically inside a docs/versions/* tree - data is loaded once, project-wide", function() {
				var root = newProject();
				directoryCreate( root & "/docs/data", true, true );
				fileWrite( root & "/docs/data/products.json", '{"name":"Widget"}' );
				fileWrite( root & "/docs/index.md", "Latest: {{ data.products.name }}" );
				directoryCreate( root & "/docs/versions/1.0", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0: {{ data.products.name }}" );

				pipeline.build( root );

				expect( fileRead( root & "/site/index.html" ) ).toInclude( "<p>Latest: Widget</p>" );
				expect( fileRead( root & "/site/versions/1.0/index.html" ) ).toInclude( "<p>1.0: Widget</p>" );
			} );

			it( "gives a course its own scoped prev/next, independent of the site's global nav-order prev/next - the load-bearing proof CourseBuilder.bx's scoping is real, not a copy of assignPrevNext()", function() {
				var root = newProject();
				directoryCreate( root & "/docs/data", true, true );
				// Deliberately ordered differently from the course's own
				// manifest order below - titles Alpha/Home/Mike/Zulu sort
				// alphabetically into the site's GLOBAL nav (folder-inferred,
				// no nav.json), so Zulu's global prevPage is Mike and its
				// global nextPage is none (last alphabetically) - while the
				// course manifest puts Zulu FIRST, so its course-scoped
				// prevLesson should be none and nextLesson should be Alpha.
				fileWrite(
					root & "/docs/data/courses.json",
					'{"course-1":{"title":"Test Course","lessons":["course/zulu.md","course/alpha.md","course/mike.md"]}}'
				);
				directoryCreate( root & "/docs/course", true, true )
				fileWrite( root & "/docs/index.md", '::: course id="course-1" :::' )
				fileWrite( root & "/docs/course/zulu.md", "---" & char( 10 ) & "title: Zulu" & char( 10 ) & "---" & char( 10 ) & "Zulu content." )
				fileWrite( root & "/docs/course/alpha.md", "---" & char( 10 ) & "title: Alpha" & char( 10 ) & "---" & char( 10 ) & "Alpha content." )
				fileWrite( root & "/docs/course/mike.md", "---" & char( 10 ) & "title: Mike" & char( 10 ) & "---" & char( 10 ) & "Mike content." )

				pipeline.build( root )

				var indexHtml = fileRead( root & "/site/index.html" )
				expect( indexHtml ).toInclude( "bxsites-course-index" )
				expect( indexHtml ).toInclude( "Zulu" )
				expect( indexHtml ).toInclude( "Alpha" )
				expect( indexHtml ).toInclude( "Mike" )

				var zuluHtml = fileRead( root & "/site/course/zulu/index.html" )
				expect( zuluHtml ).toInclude( "Lesson 1 of 3 - Test Course" )

				var courseNav = zuluHtml.reMatchNoCase( '<nav class="page-nav page-nav--course[\s\S]*?</nav>' )
				expect( courseNav.len() ).toBe( 1 )
				expect( courseNav[ 1 ] ).toInclude( "Alpha" )
				expect( courseNav[ 1 ] ).notToInclude( "Mike" )

				var globalNav = zuluHtml.reMatchNoCase( '<nav class="page-nav d-flex[\s\S]*?</nav>' )
				expect( globalNav.len() ).toBe( 1 )
				expect( globalNav[ 1 ] ).toInclude( "Mike" )
				expect( globalNav[ 1 ] ).notToInclude( "Alpha" )
			} );

			it( "falls back to a real [courseTitle -> lesson title] breadcrumb for a lesson page an explicit nav.json never lists - the common shape (course index linked, its lessons left out)", function() {
				var root = newProject();
				directoryCreate( root & "/docs/data", true, true );
				fileWrite(
					root & "/docs/data/courses.json",
					'{"course-1":{"title":"Test Course","lessons":["course/zulu.md"]}}'
				);
				directoryCreate( root & "/docs/course", true, true );
				fileWrite( root & "/docs/index.md", "Home" );
				fileWrite( root & "/docs/course/index.md", '::: course id="course-1" :::' );
				fileWrite( root & "/docs/course/zulu.md", "---" & char( 10 ) & "title: Zulu" & char( 10 ) & "---" & char( 10 ) & "Zulu content." );
				fileWrite( root & "/docs/nav.json", '["index.md","course/index.md"]' );

				pipeline.build( root );

				var zuluHtml = fileRead( root & "/site/course/zulu/index.html" );
				expect( zuluHtml ).toInclude( "breadcrumb-nav" );
				expect( zuluHtml ).toInclude( 'href="/course/index.html"' );
				expect( zuluHtml ).toInclude( ">Test Course<" );
				expect( zuluHtml ).toInclude( ">Zulu<" );
			} );

			it( "builds end to end with the material and tailwind themes too", function() {
				for ( var themeName in [ "material", "tailwind" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", "Welcome home" );

					var result = pipeline.build( root );

					expect( result.pageCount ).toBe( 1 );
					var html = fileRead( root & "/site/index.html" );
					expect( html ).toInclude( "<p>Welcome home</p>" );
					expect( fileExists( themeCssPath( root & "/site" ) ) ).toBeTrue();
				}
			} );

			it( "copies theme assets to site/assets/theme and docs/assets to site/assets", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/assets", true, true );
				fileWrite( root & "/docs/assets/logo.svg", "<svg></svg>" );

				pipeline.build( root );

				expect( fileExists( themeCssPath( root & "/site" ) ) ).toBeTrue();
				expect( fileExists( root & "/site/assets/logo.svg" ) ).toBeTrue();
			} );

			it( "hardlinks a locale tree's own assets/ from the main tree's already-written copy, instead of writing the same bytes twice", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/assets", true, true );
				fileWrite( root & "/docs/assets/logo.svg", "<svg></svg>" );
				directoryCreate( root & "/docs/i18n/es", true, true );
				fileWrite( root & "/docs/i18n/es/index.md", "Inicio" );

				pipeline.build( root );

				var mainCopy = root & "/site/assets/logo.svg";
				var localeCopy = root & "/site/es/assets/logo.svg";
				expect( fileExists( mainCopy ) ).toBeTrue();
				expect( fileExists( localeCopy ) ).toBeTrue();
				expect( fileRead( localeCopy ) ).toBe( fileRead( mainCopy ) );

				// Not just equal content - the same inode. Two independent
				// copies of the same bytes would still pass the assertions
				// above; this is the one that actually proves the second
				// tree was hardlinked rather than freshly copied.
				var Files = createObject( "java", "java.nio.file.Files" );
				var Paths = createObject( "java", "java.nio.file.Paths" );
				var mainInode = Files.getAttribute( Paths.get( mainCopy ), "unix:ino" );
				var localeInode = Files.getAttribute( Paths.get( localeCopy ), "unix:ino" );
				expect( mainInode ).toBe( localeInode );
			} );

			it( "still writes a locale tree's own og:image PNGs rather than hardlinking the main tree's own (per-page content, not identical across trees)", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"generateOgImages":true}'
				);
				fileWrite(
					root & "/docs/index.md",
					"---" & char( 10 ) & "title: Home" & char( 10 ) & "---" & char( 10 ) & "Welcome"
				);
				directoryCreate( root & "/docs/i18n/es", true, true );
				fileWrite(
					root & "/docs/i18n/es/index.md",
					"---" & char( 10 ) & "title: Inicio" & char( 10 ) & "---" & char( 10 ) & "Bienvenido"
				);

				pipeline.build( root );

				// generatedOgImageFileName() derives the filename from urlPath
				// alone (both trees' own root index page -> "home.png"), not
				// from title - the two files share a name but must not share
				// content (or an inode).
				var mainOg = root & "/site/assets/og/home.png";
				var localeOg = root & "/site/es/assets/og/home.png";
				expect( fileExists( mainOg ) ).toBeTrue();
				expect( fileExists( localeOg ) ).toBeTrue();

				// Different pages ("Home" vs "Inicio") generate different
				// auto-generated social cards - hardlinking this one over
				// from the main tree, the way vendor/theme/docs assets
				// correctly are, would silently give the Spanish tree an
				// English og:image.
				var Files = createObject( "java", "java.nio.file.Files" );
				var Paths = createObject( "java", "java.nio.file.Paths" );
				var mainInode = Files.getAttribute( Paths.get( mainOg ), "unix:ino" );
				var localeInode = Files.getAttribute( Paths.get( localeOg ), "unix:ino" );
				expect( mainInode ).notToBe( localeInode );
			} );

			it( "fingerprints the theme's own style.css with a content hash by default, and rewrites the rendered <link> to match", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/theme/style.css" ) ).toBeFalse();
				var hashedPath = themeCssPath( root & "/site" );
				expect( hashedPath ).toMatch( ".*/style\.[0-9a-f]{8}\.css$" );

				var html = fileRead( root & "/site/index.html" );
				var hashedFileName = listLast( hashedPath, "/" );
				expect( html ).toInclude( 'href="/assets/theme/' & hashedFileName & '"' );
			} );

			it( "keeps the theme's style.css unfingerprinted when assets.fingerprint is false", function() {
				var root = newProject();
				fileWrite( root & "/bxsites.json", '{"name":"Test Site","theme":{"name":"bootstrap"},"assets":{"fingerprint":false}}' );
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/theme/style.css" ) ).toBeTrue();

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( 'href="/assets/theme/style.css"' );
			} );

			it( "builds the responsive-image manifest once from docs/assets/ and passes it to buildManifest() with the site's own assets.images config, via the setImageVariantGenerator() test seam", function() {
				var root = newProject();
				fileWrite( root & "/bxsites.json", '{"name":"Test Site","assets":{"images":{"widths":[500,900]}}}' );
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/assets", true, true );

				var fakeImages = new "tests.support.FakeImageVariantGenerator@bxsites"();
				pipeline.setImageVariantGenerator( fakeImages );

				pipeline.build( root );

				var calls = fakeImages.getBuildManifestCalls();
				expect( calls.len() ).toBe( 1 );
				expect( calls[ 1 ].docsAssetsDir ).toBe( root & "/docs/assets" );
				// A project-set widths list survives the one-level-deeper default
				// merge (ConfigLoader.bx's own mergeNestedAssetsImagesDefaults()),
				// alongside the untouched formats/enabled defaults.
				expect( calls[ 1 ].imagesConfig.widths ).toBe( [ 500, 900 ] );
				expect( calls[ 1 ].imagesConfig.enabled ).toBeTrue();
				expect( calls[ 1 ].imagesConfig.formats ).toBe( [ "original", "webp" ] );
			} );

			it( "rewrites a matched <img> into a <picture>, and copies its manifest variant files into site/assets/, via the setImageVariantGenerator() test seam", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", '<img src="assets/screenshot.png" alt="A screenshot">' );
				directoryCreate( root & "/docs/assets", true, true );

				var manifest = {
					"assets/screenshot.png" : {
						width : 1600, height : 900,
						originalVariants : [ { width : 800, format : "png", fileName : "screenshot-800w.abc123.png" } ],
						webpVariants : []
					}
				};
				pipeline.setImageVariantGenerator( new "tests.support.FakeImageVariantGenerator@bxsites"( manifest ) );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "<picture>" );
				expect( html ).toInclude( "screenshot-800w.abc123.png" );
				expect( fileExists( root & "/site/assets/screenshot-800w.abc123.png" ) ).toBeTrue();
			} );

			it( "rewrites a blog post's own featured-image header and its list-card thumbnail into a <picture>, via the same setImageVariantGenerator() test seam", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/blog/posts", true, true );
				directoryCreate( root & "/docs/assets/blog", true, true );
				fileWrite(
					root & "/docs/blog/posts/release.md",
					"---" & char( 10 ) & "date: 2026-02-01" & char( 10 ) & "image: assets/blog/cover.png" & char( 10 ) & "---" & char( 10 ) & "Release post body."
				);

				var manifest = {
					"assets/blog/cover.png" : {
						width : 1600, height : 900,
						originalVariants : [ { width : 800, format : "png", fileName : "cover-800w.abc123.png" } ],
						webpVariants : []
					}
				};
				pipeline.setImageVariantGenerator( new "tests.support.FakeImageVariantGenerator@bxsites"( manifest ) );

				pipeline.build( root );

				var postHtml = fileRead( root & "/site/blog/release/index.html" );
				expect( postHtml ).toInclude( "<picture>" );
				expect( postHtml ).toInclude( "cover-800w.abc123.png" );

				var listHtml = fileRead( root & "/site/blog/index.html" );
				expect( listHtml ).toInclude( "<picture>" );
				expect( listHtml ).toInclude( "cover-800w.abc123.png" );

				expect( fileExists( root & "/site/assets/cover-800w.abc123.png" ) ).toBeTrue();
			} );

			it( "bundles extraCss/extraJs into one fingerprinted file each by default, rendering a single <link>/<script> tag", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","extraCss":["assets/custom.css"],"extraJs":["assets/custom.js"]}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/assets", true, true );
				fileWrite( root & "/docs/assets/custom.css", "body { color: red; }" );
				fileWrite( root & "/docs/assets/custom.js", "console.log( 1 );" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				// The raw per-file references are gone - one bundled <link>/<script> stands in for both.
				expect( html ).notToInclude( "assets/custom.css" & char( 34 ) );
				expect( html ).notToInclude( "assets/custom.js" & char( 34 ) );
				expect( html ).toInclude( "assets/bundle." );

				var bundledCssFiles = directoryList( root & "/site/assets", false, "name", "bundle.*.css" );
				expect( bundledCssFiles.len() ).toBe( 1 );
				var bundledJsFiles = directoryList( root & "/site/assets", false, "name", "bundle.*.js" );
				expect( bundledJsFiles.len() ).toBe( 1 );
			} );

