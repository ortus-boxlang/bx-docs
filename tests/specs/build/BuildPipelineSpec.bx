			it( "self-hosts the theme's webfonts under site/assets/fonts, with no fonts.googleapis.com reference anywhere in the page", function() {
				// Only the themes that actually ship an @font-face - bootstrap/
				// material/tailwind, and gitbook (its serif headings). The other
				// six new themes (docsy/slate/docusaurus/justthedocs/vuepress/
				// notion) are deliberately system-font-only - no @font-face at
				// all - see each one's own assets/style.css docblock.
				for ( var themeName in [ "bootstrap", "material", "tailwind", "gitbook" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", "Home" );

					pipeline.build( root );

					expect( directoryExists( root & "/site/assets/fonts" ) ).toBeTrue();
					expect( directoryList( root & "/site/assets/fonts", false, "name", "*.woff2" ).len() ).toBeGT( 0 );

					var html = fileRead( root & "/site/index.html" );
					expect( html ).notToInclude( "fonts.googleapis.com" );
					expect( html ).notToInclude( "fonts.gstatic.com" );

					var css = fileRead( themeCssPath( root & "/site" ) );
					expect( css ).toInclude( "@font-face" );
					expect( css ).toInclude( "../fonts/" );
				}
			} );

			it( "vendors highlight.js and Alpine.js for every theme, and Bootstrap's own CSS/JS only for the bootstrap theme, with no CDN reference in the built page", function() {
				for ( var themeName in [ "bootstrap", "material", "tailwind", "docsy", "slate", "docusaurus", "justthedocs", "vuepress", "gitbook", "notion" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", "Home" );

					pipeline.build( root );

					expect( fileExists( root & "/site/assets/vendor/highlight/highlight.min.js" ) ).toBeTrue();
					expect( fileExists( root & "/site/assets/vendor/highlight/github.min.css" ) ).toBeTrue();
					expect( fileExists( root & "/site/assets/vendor/alpine/cdn.min.js" ) ).toBeTrue();

					expect( fileExists( root & "/site/assets/vendor/bootstrap/bootstrap.min.css" ) ).toBe( themeName == "bootstrap" );
					expect( fileExists( root & "/site/assets/vendor/bootstrap/bootstrap.bundle.min.js" ) ).toBe( themeName == "bootstrap" );

					var html = fileRead( root & "/site/index.html" );
					expect( html ).notToInclude( "cdn.jsdelivr.net/npm/bootstrap" );
					expect( html ).notToInclude( "cdn.jsdelivr.net/gh/highlightjs" );
					expect( html ).notToInclude( "cdn.jsdelivr.net/npm/alpinejs" );
				}
			} );

			it( "vendors minisearch.js alongside search.js, only when the local search provider needs it", function() {
