					'{"name":"Test Site","theme":{"name":"bootstrap"},"description":"The site-wide fallback"}'
				);
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: Home" & char( 10 ) & "---" & char( 10 ) & "<hr>" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( '<meta name="description" content="The site-wide fallback">' );
			} );

