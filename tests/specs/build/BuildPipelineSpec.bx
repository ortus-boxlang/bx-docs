				var nextHtml = fileRead( root & "/site/next/index.html" );
				expect( nextHtml ).toInclude( "<p>Next home</p>" );

				// Never duplicated at its own /versions/1.0.x/ URL too - it
				// already rendered at the root, above.
				expect( fileExists( root & "/site/versions/1.0.x/index.html" ) ).toBeFalse();
			} );

