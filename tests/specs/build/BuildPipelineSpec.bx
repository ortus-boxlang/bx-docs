			it( "falls back to a page's own [summary] for its description when frontmatter sets no [description]", function() {
				var root = newProject();
				fileWrite(
					root & "/docs/index.md",
					"---" & char( 10 ) & "title: Home" & char( 10 ) & "summary: The on-page blurb" & char( 10 ) & "---" & char( 10 ) & "Body text here."
				);

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( '<meta name="description" content="The on-page blurb">' );
