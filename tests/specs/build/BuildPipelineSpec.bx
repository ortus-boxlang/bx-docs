			it( "does not build mcp-nav.json or mcp-manifest.json when mcp is unset (default)", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Welcome home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/mcp-nav.json" ) ).toBeFalse();
				expect( fileExists( root & "/site/mcp-manifest.json" ) ).toBeFalse();
			} );

			it( "writes mcp-nav.json mirroring this tree's own nav structure when mcp is true", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"mcp":true}'
				);
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: Home" & char( 10 ) & "---" & char( 10 ) & "Welcome home" );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Setup body" );

				pipeline.build( root );

				expect( fileExists( root & "/site/mcp-nav.json" ) ).toBeTrue();
				var nav = jsonDeserialize( fileRead( root & "/site/mcp-nav.json" ) );
				expect( nav ).toBeArray();
				var titles = nav.map( node => node.title );
				expect( titles ).toInclude( "Home" );
				expect( titles ).toInclude( "guides" );
			} );

			it( "writes mcp-manifest.json listing just the main tree, marked default, on a single-tree site", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"mcp":true}'
				);
				fileWrite( root & "/docs/index.md", "Welcome home" );

				pipeline.build( root );

				var manifest = jsonDeserialize( fileRead( root & "/site/mcp-manifest.json" ) );
				expect( manifest.len() ).toBe( 1 );
				expect( manifest[ 1 ].path ).toBe( "" );
				expect( manifest[ 1 ].label ).toBe( "Latest" );
				expect( isNull( manifest[ 1 ].version ) ).toBeTrue();
				expect( manifest[ 1 ].locale ).toBe( "en" );
				expect( manifest[ 1 ].default ).toBeTrue();
			} );

			it( "writes mcp-manifest.json and per-tree mcp-index.json/mcp-nav.json for every version tree, once versions.default is set", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"mcp":true,"versions":{"default":"1.0.x"}}'
				);
				fileWrite( root & "/docs/index.md", "Next home" );
				directoryCreate( root & "/docs/versions/1.0.x", true, true );
				fileWrite( root & "/docs/versions/1.0.x/index.md", "1.0.x home" );
				directoryCreate( root & "/docs/versions/2.0", true, true );
				fileWrite( root & "/docs/versions/2.0/index.md", "2.0 home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/mcp-index.json" ) ).toBeTrue();
				expect( fileExists( root & "/site/next/mcp-index.json" ) ).toBeTrue();
				expect( fileExists( root & "/site/next/mcp-nav.json" ) ).toBeTrue();
				expect( fileExists( root & "/site/versions/2.0/mcp-index.json" ) ).toBeTrue();
				expect( fileExists( root & "/site/versions/2.0/mcp-nav.json" ) ).toBeTrue();

				var manifest = jsonDeserialize( fileRead( root & "/site/mcp-manifest.json" ) );
				var paths = manifest.map( tree => tree.path );
				expect( paths ).toInclude( "" );
				expect( paths ).toInclude( "next" );
				expect( paths ).toInclude( "versions/2.0" );

				var rootTree = manifest.filter( tree => tree.path == "" )[ 1 ];
				expect( rootTree.version ).toBe( "1.0.x" );
				expect( rootTree.default ).toBeTrue();

				var nextTree = manifest.filter( tree => tree.path == "next" )[ 1 ];
				expect( isNull( nextTree.version ) ).toBeTrue();
				expect( nextTree.default ).toBeFalse();

				var v2Tree = manifest.filter( tree => tree.path == "versions/2.0" )[ 1 ];
				expect( v2Tree.version ).toBe( "2.0" );
				expect( v2Tree.default ).toBeFalse();
			} );

			it( "writes mcp-manifest.json and per-tree mcp-index.json/mcp-nav.json for every locale tree", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"mcp":true,"i18n":{"locales":[{"code":"es","label":"Español"}]}}'
				);
				fileWrite( root & "/docs/index.md", "Welcome home" );
				directoryCreate( root & "/docs/i18n/es", true, true );
				fileWrite( root & "/docs/i18n/es/index.md", "Bienvenido" );

				pipeline.build( root );

				expect( fileExists( root & "/site/es/mcp-index.json" ) ).toBeTrue();
				expect( fileExists( root & "/site/es/mcp-nav.json" ) ).toBeTrue();

				var manifest = jsonDeserialize( fileRead( root & "/site/mcp-manifest.json" ) );
				var paths = manifest.map( tree => tree.path );
				expect( paths ).toInclude( "" );
				expect( paths ).toInclude( "es" );

				var esTree = manifest.filter( tree => tree.path == "es" )[ 1 ];
				expect( esTree.label ).toBe( "Español" );
				expect( esTree.locale ).toBe( "es" );
				expect( esTree.default ).toBeFalse();
			} );

			it( "renders an in-page table of contents from the page's own headings", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", '<h2 id="install">Install</h2>' & char( 10 ) & '<h3 id="prereqs">Prereqs</h3>' );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "On this page" );
				expect( html ).toInclude( 'href="##install"' );
				expect( html ).toInclude( ">Install<" );
				expect( html ).toInclude( 'href="##prereqs"' );
			} );

			it( "omits the table of contents when a page's own frontmatter sets [toc] to false", function() {
				var root = newProject();
				fileWrite(
					root & "/docs/index.md",
					"---" & char( 10 ) & "toc: false" & char( 10 ) & "---" & char( 10 ) &
						'<h2 id="install">Install</h2>' & char( 10 ) & '<h3 id="prereqs">Prereqs</h3>'
				);

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).notToInclude( "On this page" );
			} );

			it( "links prev/next pages in nav reading order", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: Home" & char( 10 ) & "order: 1" & char( 10 ) & "---" & char( 10 ) & "Home body" );
				fileWrite( root & "/docs/middle.md", "---" & char( 10 ) & "title: Middle" & char( 10 ) & "order: 2" & char( 10 ) & "---" & char( 10 ) & "Middle body" );
				fileWrite( root & "/docs/last.md", "---" & char( 10 ) & "title: Last" & char( 10 ) & "order: 3" & char( 10 ) & "---" & char( 10 ) & "Last body" );

				pipeline.build( root );

				var homeHtml = fileRead( root & "/site/index.html" );
				expect( homeHtml ).notToInclude( "page-nav__prev" );
				expect( homeHtml ).toInclude( "Middle" );

				var middleHtml = fileRead( root & "/site/middle/index.html" );
				expect( middleHtml ).toInclude( "Home" );
				expect( middleHtml ).toInclude( "Last" );

				var lastHtml = fileRead( root & "/site/last/index.html" );
				expect( lastHtml ).toInclude( "Middle" );
				expect( lastHtml ).notToInclude( "page-nav__next" );
			} );

			it( "writes a themed 404.html", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/404.html" ) ).toBeTrue();
				var html = fileRead( root & "/site/404.html" );
				expect( html ).toInclude( "Page Not Found" );
				expect( html ).toInclude( "Test Site" );
			} );

			it( "renders a project's own docs/404.md as the 404 page when present", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				fileWrite(
					root & "/docs/404.md",
					"---" & char( 10 ) & "title: Lost" & char( 10 ) & "---" & char( 10 ) &
						"That page wandered off. Try the [homepage](index.md)."
				);

				var result = pipeline.build( root );

				expect( fileExists( root & "/site/404.html" ) ).toBeTrue();
				var html = fileRead( root & "/site/404.html" );
				expect( html ).toInclude( "Lost" );
				expect( html ).toInclude( "That page wandered off." );
				expect( html ).notToInclude( "Page Not Found" );

				// Never a regular built page: no /404/ output, and not counted among built pages.
				expect( fileExists( root & "/site/404/index.html" ) ).toBeFalse();
				expect( result.pageCount ).toBe( 1 );
			} );

			it( "writes a redirect stub for a page's own frontmatter redirect_from", function() {
				var root = newProject();
