			it( "builds each docs/i18n/<code>/ folder as its own tree under site/<code>/, using the translated content when it exists", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"i18n":{"locales":[{"code":"es","label":"Español"}]}}'
				);
				fileWrite( root & "/docs/index.md", "Welcome home" );
				directoryCreate( root & "/docs/i18n/es", true, true );
				fileWrite( root & "/docs/i18n/es/index.md", "Bienvenido" );

				pipeline.build( root );

				expect( fileExists( root & "/site/es/index.html" ) ).toBeTrue();
				var esHtml = fileRead( root & "/site/es/index.html" );
				expect( esHtml ).toInclude( "<p>Bienvenido</p>" );
				expect( esHtml ).notToInclude( "fallback-notice" );

				var mainHtml = fileRead( root & "/site/index.html" );
				expect( mainHtml ).toInclude( "<p>Welcome home</p>" );
			} );

			it( "falls back to the default locale's own content, flagged, for a page a locale hasn't translated yet", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"i18n":{"locales":[{"code":"es","label":"Español"}]}}'
				);
				fileWrite( root & "/docs/index.md", "Welcome home" );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Setup body" );
				directoryCreate( root & "/docs/i18n/es", true, true );
				fileWrite( root & "/docs/i18n/es/index.md", "Bienvenido" );
				// docs/i18n/es/guides/setup.md deliberately not created - Spanish
				// hasn't translated this page yet

				pipeline.build( root );

				expect( fileExists( root & "/site/es/guides/setup/index.html" ) ).toBeTrue();
				var esSetupHtml = fileRead( root & "/site/es/guides/setup/index.html" );
				expect( esSetupHtml ).toInclude( "<p>Setup body</p>" );
				expect( esSetupHtml ).toInclude( "fallback-notice" );
				// "es" ships a built-in chrome translation (StringsResolver.bx) -
				// the notice itself renders in Spanish, not the English default.
				// (encodeForHTML() entity-escapes the accented characters, so this
				// checks an accent-free substring of the Spanish text instead.)
				expect( esSetupHtml ).toInclude( "no se ha traducido" );
			} );

			it( "gives every locale the exact same nav shape as the default tree, translated titles included", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"i18n":{"locales":[{"code":"es","label":"Español"}]}}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Body" );
				directoryCreate( root & "/docs/i18n/es/guides", true, true );
				fileWrite( root & "/docs/i18n/es/index.md", "Inicio" );
				fileWrite( root & "/docs/i18n/es/guides/setup.md", "---" & char( 10 ) & "title: Instalación" & char( 10 ) & "---" & char( 10 ) & "Cuerpo" );

				pipeline.build( root );

				var esHtml = fileRead( root & "/site/es/index.html" );
				expect( esHtml ).toInclude( 'href="/es/guides/setup/index.html"' );
				// encodeForHTML() entity-escapes accented characters (own
				// choice, applied uniformly to every page title across every
				// theme, well outside this feature's own scope) - "Instalación"
				// safely renders as this in any browser, just not byte-identical.
				expect( esHtml ).toInclude( ">Instalaci&oacute;n<" );
			} );

			it( "renders a language switcher with the current locale selected when docs/i18n/* exist, and none when there aren't any", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"i18n":{"locales":[{"code":"es","label":"Español"}]}}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/i18n/es", true, true );
				fileWrite( root & "/docs/i18n/es/index.md", "Inicio" );

				pipeline.build( root );

				var mainHtml = fileRead( root & "/site/index.html" );
				expect( mainHtml ).toInclude( "locale-dropdown" );
				expect( mainHtml ).toInclude( "🇺🇸" );
				expect( mainHtml ).toInclude( "English" );
				expect( mainHtml ).toInclude( "🇪🇸" );
				// encodeForHTML() entity-escapes accented characters - see the
				// "gives every locale the exact same nav shape" test above.
				expect( mainHtml ).toInclude( "Espa&ntilde;ol" );

				var esHtml = fileRead( root & "/site/es/index.html" );
				expect( esHtml ).toInclude( "locale-dropdown" );
				expect( esHtml ).toInclude( "🇪🇸" );

				var monolingualRoot = newProject();
				fileWrite( monolingualRoot & "/docs/index.md", "Home" );
				pipeline.build( monolingualRoot );
				expect( fileRead( monolingualRoot & "/site/index.html" ) ).notToInclude( "locale-dropdown" );
			} );

