			it( "falls back to a stripped, truncated excerpt of its own content when a page sets neither [description] nor [summary]", function() {
				var root = newProject();
				fileWrite(
					root & "/docs/index.md",
					"---" & char( 10 ) & "title: Home" & char( 10 ) & "---" & char( 10 ) &
						"<h2>Heading</h2>" & char( 10 ) & "<p>Some real body content for the excerpt.</p>"
				);

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( '<meta name="description" content="Heading Some real body content for the excerpt.">' );
			} );

			it( "truncates a long auto-derived excerpt to 160 characters at a word boundary, with a trailing ellipsis", function() {
				var root = newProject();
				var longText = repeatString( "word ", 40 ); // 200 chars, no frontmatter description/summary
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: Home" & char( 10 ) & "---" & char( 10 ) & longText );

				pipeline.build( root );

				var html = htmlDecode( fileRead( root & "/site/index.html" ) );
				var marker = 'name="description" content="';
				var startPos = html.find( marker ) + len( marker );
				var endPos = html.find( '"', startPos );
				var descValue = html.mid( startPos, endPos - startPos );
				expect( len( descValue ) ).toBeLTE( 161 ); // 160 chars + the trailing ellipsis character
				expect( descValue ).toEndWith( "…" );
			} );

			it( "still falls back to the site-wide [description] when a page's own content has no plain text at all", function() {
				var root = newProject();
				fileWrite(
