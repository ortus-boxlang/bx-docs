			it( "builds mcp-index.json with the full untruncated body when mcp is true and search uses the local provider", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"mcp":true}'
				);
				var longText = "";
				for ( var i = 1; i <= 200; i++ ) {
					longText &= "word "
				}
				fileWrite(
					root & "/docs/index.md",
					"---" & char( 10 ) & "title: Home" & char( 10 ) & "tags: [intro]" & char( 10 ) & "---" & char( 10 ) &
					'<h1>Home</h1>' & char( 10 ) & longText
				);

				pipeline.build( root );

				expect( fileExists( root & "/site/search-index.json" ) ).toBeTrue();
				expect( fileExists( root & "/site/mcp-index.json" ) ).toBeTrue();

				var mcpIndex = jsonDeserialize( fileRead( root & "/site/mcp-index.json" ) );
				expect( mcpIndex.len() ).toBe( 1 );
				expect( mcpIndex[ 1 ].title ).toBe( "Home" );
				expect( mcpIndex[ 1 ].url ).toBe( "index.html" );
				expect( mcpIndex[ 1 ].tags ).toBe( [ "intro" ] );
				expect( mcpIndex[ 1 ].headings ).toBe( [ "Home" ] );
				expect( len( mcpIndex[ 1 ].body ) ).toBeGT( 400 );
				expect( mcpIndex[ 1 ].body ).notToEndWith( "…" );
				expect( mcpIndex[ 1 ].body ).notToInclude( "<" );
			} );

