			it( "writes a redirect stub for a bxsites.json [redirects] entry, resolved against basePath", function() {
				var root = createTempDirectory( prefix = "bxsites-buildpipeline-redirects-" );
				tempDirs.append( root );
				directoryCreate( root & "/docs", true, true );
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","baseURL":"/my-site/","redirects":[{"from":"legacy","to":"guides/setup/"}]}'
				);
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/index.md", "Home" );
				fileWrite( root & "/docs/guides/setup.md", "Setup body" );

				pipeline.build( root );

				expect( fileExists( root & "/site/legacy/index.html" ) ).toBeTrue();
				expect( fileRead( root & "/site/legacy/index.html" ) ).toInclude( "/my-site/guides/setup/" );
			} );

