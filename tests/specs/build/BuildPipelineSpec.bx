			it( "renders mermaid.js and its init script only when [mermaid] is enabled, across every built-in theme, vendored with no CDN reference", function() {
				for ( var themeName in [ "bootstrap", "material", "tailwind", "docsy", "slate", "docusaurus", "justthedocs", "vuepress", "gitbook", "notion" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", "Home" );
					pipeline.build( root );

					var offHtml = fileRead( root & "/site/index.html" );
					expect( offHtml ).notToInclude( "mermaid" );
					expect( fileExists( root & "/site/assets/mermaid-init.js" ) ).toBeFalse();
					expect( fileExists( root & "/site/assets/vendor/mermaid/mermaid.min.js" ) ).toBeFalse();

					var mermaidRoot = newProject( themeName );
					fileWrite(
						mermaidRoot & "/bxsites.json",
						'{"name":"Test Site","theme":{"name":"' & themeName & '"},"mermaid":true}'
					);
					fileWrite( mermaidRoot & "/docs/index.md", "Home" );
					pipeline.build( mermaidRoot );

					var onHtml = fileRead( mermaidRoot & "/site/index.html" );
					expect( onHtml ).toInclude( "mermaid.min.js" );
					expect( onHtml ).toInclude( "assets/mermaid-init.js" );
					expect( onHtml ).notToInclude( "cdn.jsdelivr.net/npm/mermaid" );
					expect( fileExists( mermaidRoot & "/site/assets/mermaid-init.js" ) ).toBeTrue();
					expect( fileExists( mermaidRoot & "/site/assets/vendor/mermaid/mermaid.min.js" ) ).toBeTrue();
				}
			} );

			it( "renders the page-actions dropdown and its init script only when [pageActions] is enabled, across every built-in theme", function() {
				for ( var themeName in [ "bootstrap", "material", "tailwind", "docsy", "slate", "docusaurus", "justthedocs", "vuepress", "gitbook", "notion" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", "Home" );
					pipeline.build( root );

					var offHtml = fileRead( root & "/site/index.html" );
					expect( offHtml ).notToInclude( "bxsites-page-actions" );
					expect( fileExists( root & "/site/assets/page-actions-init.js" ) ).toBeFalse();

					var onRoot = newProject( themeName );
					fileWrite(
						onRoot & "/bxsites.json",
						'{"name":"Test Site","baseURL":"https://example.com/","theme":{"name":"' & themeName & '"},"pageActions":true,"repo":{"url":"https://github.com/acme/docs","editUri":"edit/main/docs/"}}'
					);
					fileWrite( onRoot & "/docs/index.md", "Home" );
					pipeline.build( onRoot );

					var onHtml = fileRead( onRoot & "/site/index.html" );
					expect( onHtml ).toInclude( "bxsites-page-actions" );
					expect( onHtml ).toInclude( 'data-bxsites-action="copy-markdown"' );
					expect( onHtml ).toInclude( 'data-bxsites-action="copy-link"' );
					expect( onHtml ).toInclude( 'data-bxsites-action="print"' );
					expect( onHtml ).toInclude( "https://chatgpt.com/?q=" );
					expect( onHtml ).toInclude( "https://claude.ai/new?q=" );
					expect( onHtml ).toInclude( "github.com/acme/docs/issues/new?title=" );
					expect( onHtml ).toInclude( "x.com/intent/tweet?url=" );
					expect( onHtml ).toInclude( "linkedin.com/sharing/share-offsite/?url=" );
					expect( onHtml ).toInclude( "facebook.com/sharer/sharer.php?u=" );
					expect( onHtml ).toInclude( '<kbd class="bxsites-page-actions__kbd" aria-hidden="true">C</kbd>' );
					expect( onHtml.reMatchNoCase( 'class="bxsites-page-actions__divider"' ).len() ).toBe( 3 );
					expect( onHtml ).toInclude( "assets/page-actions-init.js" );
					expect( fileExists( onRoot & "/site/assets/page-actions-init.js" ) ).toBeTrue();

					// "Copy page" and "Copy link" sit right after each other -
					// "View as Markdown" (also markdownHref-gated) comes after
					// both, not squeezed between them.
					var copyMarkdownPos = onHtml.find( 'data-bxsites-action="copy-markdown"' );
					var copyLinkPos = onHtml.find( 'data-bxsites-action="copy-link"' );
					var viewAsMarkdownPos = onHtml.find( "View as Markdown" );
					expect( copyLinkPos ).toBeGT( copyMarkdownPos );
					expect( viewAsMarkdownPos ).toBeGT( copyLinkPos );
				}
			} );

			it( "omits the [pageActions] dropdown's [repo.url]-dependent Report an issue item when [repo.url] is unset", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","baseURL":"https://example.com/","theme":{"name":"bootstrap"},"pageActions":true}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "bxsites-page-actions" );
				expect( html ).notToInclude( "issues/new?title=" );
			} );

			it( "gives the command-palette backdrop an explicit [hidden] CSS override, across every built-in theme", function() {
				// A plain `.bxsites-command-palette { display: flex }` rule alone
				// loses to the UA stylesheet's `[hidden] { display: none }` - an
				// author rule of *any* specificity always wins over a UA rule
				// regardless (browsers apply origin/importance before
				// specificity) - leaving the backdrop stuck visibly `display:
				// flex` even while `hidden` (search.js's own buildPalette() sets
				// `backdrop.hidden = true` immediately, before ever appending
				// it). Without this override, every page shows a stuck-open,
				// empty command palette on load, in every theme.
				for ( var themeName in [ "bootstrap", "material", "tailwind", "docsy", "slate", "docusaurus", "justthedocs", "vuepress", "gitbook", "notion" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", "Home" );
					pipeline.build( root );

					var css = fileRead( themeCssPath( root & "/site" ) );
					expect( css ).toInclude( ".bxsites-command-palette[hidden]" );
				}
			} );

			it( "gives in-page table-of-contents entries breathing room, so a wrapped heading doesn't read as its own entry", function() {
				// The TOC list items previously had no margin/line-height of
				// their own, relying entirely on the browser's UA default -
				// on a long heading (e.g. "Prerequisite: install BoxLang")
				// that wraps to two lines, the wrapped second line sat flush
				// against the next entry, making it look like its own list
				// item rather than a continuation.
				for ( var themeName in [ "bootstrap", "material", "docsy", "slate", "docusaurus", "justthedocs", "vuepress", "gitbook", "notion" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", '<h2 id="install">Install</h2>' & char( 10 ) & '<h3 id="prereqs">Prereqs</h3>' );

					pipeline.build( root );

					var css = fileRead( themeCssPath( root & "/site" ) );
					expect( css ).toInclude( "margin: 0.35rem 0;" );
					expect( css ).toInclude( "line-height: 1.4;" );
				}

				// tailwind is utility-class-driven, not stylesheet-driven - its
				// own assets/theme/style.css is just a handful of overrides on
				// top of the Tailwind Play CDN, so the same spacing instead
				// shows up as classes in the rendered markup itself.
				var tailwindRoot = newProject( "tailwind" );
				fileWrite( tailwindRoot & "/docs/index.md", '<h2 id="install">Install</h2>' & char( 10 ) & '<h3 id="prereqs">Prereqs</h3>' );

				pipeline.build( tailwindRoot );

				var tailwindHtml = fileRead( tailwindRoot & "/site/index.html" );
				expect( tailwindHtml ).toInclude( 'class="space-y-2"' );
				expect( tailwindHtml ).toInclude( "leading-snug" );
			} );

			it( "copies the shared tabs.js and code-lines.js widgets unconditionally, loading code-lines.js after hljs.highlightAll()", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/tabs.js" ) ).toBeTrue();
				expect( fileExists( root & "/site/assets/code-lines.js" ) ).toBeTrue();

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "assets/tabs.js" );
				var codeLinesPos = html.findNoCase( "assets/code-lines.js" );
				var highlightAllPos = html.findNoCase( "hljs.highlightAll" );
				expect( codeLinesPos ).toBeGT( highlightAllPos );
			} );

			it( "converts a === ""Title"" content tab block into a tab widget, rendering each tab's own markdown", function() {
				var root = newProject();
				fileWrite(
					root & "/docs/index.md",
					'=== "Java"' & char( 10 ) & "    hello java" & char( 10 ) & char( 10 ) &
						'=== "BoxLang"' & char( 10 ) & "    hello bx"
				);

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( 'class="bxsites-tabs" data-bxsites-tabgroup' );
				expect( html ).toInclude( ">Java</button>" );
				expect( html ).toInclude( ">BoxLang</button>" );
				expect( html ).toInclude( "<p>hello java</p>" );
				expect( html ).toInclude( "<p>hello bx</p>" );
				expect( html ).notToInclude( "data-bxsites-token" );
			} );

			it( "converts a ```tryboxlang fenced block into a live try.boxlang.io iframe embed", function() {
				var root = newProject();
				fileWrite(
					root & "/docs/index.md",
					'```tryboxlang title="Say Hi"' & char( 10 ) & 'println( "hi" )' & char( 10 ) & '```'
				);

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( 'class="bxsites-tryboxlang"' );
				expect( html ).toInclude( '<div class="bxsites-tryboxlang__title">Say Hi</div>' );
				expect( html ).toInclude( 'src="https://try.boxlang.io/editor/index.bxm?ro=false&amp;code=' );
				expect( html ).notToInclude( "data-bxsites-token" );
				expect( html ).notToInclude( "println" );
			} );

			it( "loads KaTeX and restores literal math formula text only when [math] is enabled, across every built-in theme", function() {
				var expectedFormula = encodeForHTML( "$e^{i\pi}+1=0$" );

				for ( var themeName in [ "bootstrap", "material", "tailwind", "docsy", "slate", "docusaurus", "justthedocs", "vuepress", "gitbook", "notion" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", 'Euler: $e^{i\pi}+1=0$ here.' );
					pipeline.build( root );

					var offHtml = fileRead( root & "/site/index.html" );
					expect( offHtml ).notToInclude( "katex" );
					expect( fileExists( root & "/site/assets/math-init.js" ) ).toBeFalse();
					expect( offHtml ).toInclude( expectedFormula );

					var mathRoot = newProject( themeName );
					fileWrite(
						mathRoot & "/bxsites.json",
						'{"name":"Test Site","theme":{"name":"' & themeName & '"},"math":true}'
					);
					fileWrite( mathRoot & "/docs/index.md", 'Euler: $e^{i\pi}+1=0$ here.' );
					pipeline.build( mathRoot );

					var onHtml = fileRead( mathRoot & "/site/index.html" );
					expect( onHtml ).toInclude( "katex.min.css" );
					expect( onHtml ).toInclude( "katex.min.js" );
					expect( onHtml ).toInclude( "assets/math-init.js" );
					expect( onHtml ).toInclude( expectedFormula );
					expect( fileExists( mathRoot & "/site/assets/math-init.js" ) ).toBeTrue();
				}
			} );

			it( "runs a plugin's onConfig/onPageMarkdown/onPageHtml/onNav/onBuildComplete hooks in the pipeline, via the setPlugins() test seam", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				var fakePlugin = {
					onConfig : function( required struct config ) {
						arguments.config.pluginTouchedConfig = true;
						return arguments.config;
					},
					onPageMarkdown : function( required string markdown, required struct page, required struct config ) {
						return arguments.markdown & char( 10 ) & "Injected line.";
					},
					onPageHtml : function( required string html, required struct page, required struct config ) {
						return arguments.html & "<!--plugin-html-->";
					},
					onNav : function( required array nav, required struct config ) {
						arguments.nav.append( { title : "Plugin Page", url : "plugin.html", order : 0, children : [] } );
						return arguments.nav;
					},
					onBuildComplete : function( required string siteDir, required struct config ) {
						fileWrite( arguments.siteDir & "/plugin-marker.txt", "built" );
					}
				};
				pipeline.setPlugins( [ { name : "fake", instance : fakePlugin } ] );

				var result = pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "Injected line." );
				expect( html ).toInclude( "<!--plugin-html-->" );
				expect( html ).toInclude( "Plugin Page" );
				expect( fileExists( root & "/site/plugin-marker.txt" ) ).toBeTrue();
			} );

			it( "runs a plugin's onSearchIndex hook, injecting an extra search entry into search-index.json", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				var fakePlugin = {
					onSearchIndex : function( required array entries, required struct config ) {
						arguments.entries.append( { title : "Contact", url : "contact/index.html", headings : [], body : "", tags : [] } );
						return arguments.entries;
					}
				};
				pipeline.setPlugins( [ { name : "fake", instance : fakePlugin } ] );

				pipeline.build( root );

				var index = jsonDeserialize( fileRead( root & "/site/search-index.json" ) );
				expect( index.len() ).toBe( 2 );
				expect( index[ 2 ].title ).toBe( "Contact" );
			} );

			it( "runs a plugin's onSitemap hook, injecting an extra page into both sitemap.xml and llms.txt", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"baseURL":"https://docs.example.com/"}'
				);
				fileWrite( root & "/docs/index.md", "Home" );

				var fakePlugin = {
					onSitemap : function( required array pages, required struct config ) {
						arguments.pages.append( { urlPath : "contact/index.html", title : "Contact", hidden : false } );
						return arguments.pages;
					}
				};
				pipeline.setPlugins( [ { name : "fake", instance : fakePlugin } ] );

				pipeline.build( root );

				var sitemap = fileRead( root & "/site/sitemap.xml" );
				expect( sitemap ).toInclude( "<loc>https://docs.example.com/contact/index.html</loc>" );

				var llmsTxt = fileRead( root & "/site/llms.txt" );
				expect( llmsTxt ).toInclude( "[Contact](https://docs.example.com/contact/index.html)" );
			} );

