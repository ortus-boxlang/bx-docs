			} );

			it( "falls back to the version's own default-locale content, flagged, for a page that version's locale hasn't translated yet", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"i18n":{"locales":[{"code":"es","label":"Español"}]}}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/versions/1.0/guides", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0 home" );
				fileWrite( root & "/docs/versions/1.0/guides/setup.md", "1.0 setup body" );
				directoryCreate( root & "/docs/versions/1.0/i18n/es", true, true );
				fileWrite( root & "/docs/versions/1.0/i18n/es/index.md", "1.0 inicio" );
				// docs/versions/1.0/i18n/es/guides/setup.md deliberately not created

				pipeline.build( root );

				var setupHtml = fileRead( root & "/site/versions/1.0/es/guides/setup/index.html" );
				expect( setupHtml ).toInclude( "<p>1.0 setup body</p>" );
			} );

			it( "shows a language switcher inside a version once that version has its own i18n subfolder, listing only that version's own locales", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"i18n":{"locales":[{"code":"es","label":"Español"},{"code":"fr","label":"Français"}]}}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/versions/1.0", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0 home" );
				// Only "es" is translated for this version - "fr" exists site-wide but not here.
				directoryCreate( root & "/docs/versions/1.0/i18n/es", true, true );
				fileWrite( root & "/docs/versions/1.0/i18n/es/index.md", "1.0 inicio" );

				pipeline.build( root );

				var versionHomeHtml = fileRead( root & "/site/versions/1.0/index.html" );
				expect( versionHomeHtml ).toInclude( "locale-dropdown" );
				expect( versionHomeHtml ).toInclude( 'href="/versions/1.0/es/"' );
				expect( versionHomeHtml ).notToInclude( 'href="/versions/1.0/fr/"' );

				// Switching version from inside a version's own locale tree always
				// lands on the target version's own default locale, never assumes
				// it shares this version's translation.
				var esHomeHtml = fileRead( root & "/site/versions/1.0/es/index.html" );
				expect( esHomeHtml ).toInclude( 'value="/versions/1.0/"' );
			} );

			it( "points a version-nested translated page's editUrl at its own docs/versions/<name>/i18n/<code>/ source, and a fallback page's at that version's own docs/versions/<name>/ source", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"repo":{"url":"https://github.com/acme/docs","editUri":"edit/main/docs/"},"i18n":{"locales":[{"code":"es","label":"Español"}]}}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/versions/1.0/guides", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0 home" );
				fileWrite( root & "/docs/versions/1.0/guides/setup.md", "1.0 setup body" );
				directoryCreate( root & "/docs/versions/1.0/i18n/es", true, true );
				fileWrite( root & "/docs/versions/1.0/i18n/es/index.md", "1.0 inicio" );
				// docs/versions/1.0/i18n/es/guides/setup.md left untranslated on purpose

				pipeline.build( root );

				var esIndexHtml = fileRead( root & "/site/versions/1.0/es/index.html" );
				expect( esIndexHtml ).toInclude( "https://github.com/acme/docs/edit/main/docs/versions/1.0/i18n/es/index.md" );

				var esSetupHtml = fileRead( root & "/site/versions/1.0/es/guides/setup/index.html" );
				expect( esSetupHtml ).toInclude( "https://github.com/acme/docs/edit/main/docs/versions/1.0/guides/setup.md" );
			} );

			it( "includes a version's own locale pages in sitemap.xml and llms.txt alongside everything else", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"baseURL":"https://docs.example.com/","i18n":{"locales":[{"code":"es","label":"Español"}]}}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/versions/1.0", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0 home" );
				directoryCreate( root & "/docs/versions/1.0/i18n/es", true, true );
				fileWrite( root & "/docs/versions/1.0/i18n/es/index.md", "1.0 inicio" );

				pipeline.build( root );

				var sitemap = fileRead( root & "/site/sitemap.xml" );
				expect( sitemap ).toInclude( "<loc>https://docs.example.com/versions/1.0/es/index.html</loc>" );

				var llms = fileRead( root & "/site/llms.txt" );
				expect( llms ).toInclude( "(https://docs.example.com/versions/1.0/es/index.html)" );
			} );

			it( "writes one blog/category/<slug>/feed.xml per category, filtered to just that category's own posts", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"baseURL":"https://docs.example.com/"}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/blog/posts", true, true );
				fileWrite( root & "/docs/blog/posts/release.md", "---" & char( 10 ) & "date: 2026-02-01" & char( 10 ) & "categories: [Releases]" & char( 10 ) & "---" & char( 10 ) & "Release post body." );
				fileWrite( root & "/docs/blog/posts/news.md", "---" & char( 10 ) & "date: 2026-01-01" & char( 10 ) & "categories: [News]" & char( 10 ) & "---" & char( 10 ) & "News post body." );

				pipeline.build( root );

				expect( fileExists( root & "/site/blog/feed.xml" ) ).toBeTrue();
				var mainFeed = fileRead( root & "/site/blog/feed.xml" );
				expect( mainFeed ).toInclude( "Release post body" );
				expect( mainFeed ).toInclude( "News post body" );

				expect( fileExists( root & "/site/blog/category/releases/feed.xml" ) ).toBeTrue();
				var releasesFeed = fileRead( root & "/site/blog/category/releases/feed.xml" );
				expect( releasesFeed ).toInclude( "Release post body" );
				expect( releasesFeed ).notToInclude( "News post body" );

				expect( fileExists( root & "/site/blog/category/news/feed.xml" ) ).toBeTrue();
				var newsFeed = fileRead( root & "/site/blog/category/news/feed.xml" );
				expect( newsFeed ).toInclude( "News post body" );
				expect( newsFeed ).notToInclude( "Release post body" );
			} );

			it( "excludes a draft blog post from a real build by default", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/blog/posts", true, true );
				fileWrite( root & "/docs/blog/posts/draft-post.md", "---" & char( 10 ) & "date: 2026-01-01" & char( 10 ) & "draft: true" & char( 10 ) & "---" & char( 10 ) & "Draft body." );

				pipeline.build( root );

				expect( fileExists( root & "/site/blog/draft-post/index.html" ) ).toBeFalse();
			} );

			it( "includes a draft blog post, with a visible draft badge, when includeDrafts is true", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/blog/posts", true, true );
				fileWrite( root & "/docs/blog/posts/draft-post.md", "---" & char( 10 ) & "date: 2026-01-01" & char( 10 ) & "draft: true" & char( 10 ) & "---" & char( 10 ) & "Draft body." );

				pipeline.build( root, true );

				expect( fileExists( root & "/site/blog/draft-post/index.html" ) ).toBeTrue();
				var html = fileRead( root & "/site/blog/draft-post/index.html" );
				expect( html ).toInclude( "blog-draft-badge" );
			} );

			it( "publishes a blog post's own Markdown source, with a Download Markdown link on its built page", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/blog/posts", true, true );
				fileWrite( root & "/docs/blog/posts/hello-world.md", "---" & char( 10 ) & "date: 2026-01-01" & char( 10 ) & "---" & char( 10 ) & "Hello world body." );

				pipeline.build( root );

				expect( fileExists( root & "/site/blog/posts/hello-world.md" ) ).toBeTrue();
				expect( fileRead( root & "/site/blog/posts/hello-world.md" ) ).toInclude( "Hello world body." );

				var html = fileRead( root & "/site/blog/hello-world/index.html" );
				expect( html ).toInclude( "Download Markdown" );
				expect( html ).toInclude( 'href="/blog/posts/hello-world.md"' );
			} );

			it( "builds /blog/stats/index.html", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/blog/posts", true, true );
				fileWrite( root & "/docs/blog/posts/hello-world.md", "---" & char( 10 ) & "date: 2026-01-01" & char( 10 ) & "---" & char( 10 ) & "Hello world body." );

				pipeline.build( root );

				expect( fileExists( root & "/site/blog/stats/index.html" ) ).toBeTrue();
				expect( fileRead( root & "/site/blog/stats/index.html" ) ).toInclude( "bxsites-cards" );
			} );

			it( "auto-appends a ""Blog"" nav entry last, once there's at least one published post", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				fileWrite( root & "/docs/about.md", "About" );
				directoryCreate( root & "/docs/blog/posts", true, true );
				fileWrite( root & "/docs/blog/posts/hello-world.md", "---" & char( 10 ) & "date: 2026-01-01" & char( 10 ) & "---" & char( 10 ) & "Hello world body." );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				// The auto-appended entry's own icon (phosphor-duotone:newspaper)
				// resolves to inline SVG markup, then a space, before the "Blog"
				// text - assert on "Blog</a>" (the text-to-close-tag boundary)
				// rather than an exact ">Blog<"/href-adjacent substring, so this
				// doesn't re-break the next time a nav icon (or lack of one, or
				// its own markup) changes what sits before the label.
				expect( html ).toInclude( 'href="/blog/index.html"' );
				expect( html.findNoCase( 'href="/blog/index.html"' ) ).toBeLT( html.findNoCase( "Blog</a>" ) );
				expect( html.findNoCase( ">About<" ) ).toBeLT( html.findNoCase( "Blog</a>" ) );
			} );

			it( "skips the auto-appended ""Blog"" nav entry when a custom nav already places one via an explicit url", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","nav":[{"title":"Blog","url":"blog/index.html","icon":"lucide:newspaper"},{"path":"index.md"}]}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/blog/posts", true, true );
				fileWrite( root & "/docs/blog/posts/hello-world.md", "---" & char( 10 ) & "date: 2026-01-01" & char( 10 ) & "---" & char( 10 ) & "Hello world body." );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				// Scoped to the sidebar nav's own <ul> - the page's prev/next
				// page-nav (bottom of page) also legitimately links to
				// blog/index.html here (it's the flattened nav's previous
				// entry), so counting hrefs across the whole page would see 2
				// even when the sidebar itself has exactly one, correctly.
				var sidebarStart = html.findNoCase( '<ul class="nav flex-column">' );
				var sidebarEnd = html.findNoCase( "</ul>", sidebarStart );
				var sidebarHtml = html.mid( sidebarStart, sidebarEnd - sidebarStart + 5 );
				// index.md has no frontmatter title here, so DocsLoader falls
				// back to "Index" (the filename-derived default), not "Home"
				// (the file's own plain-text body content) - only one "Blog"
				// nav link in the sidebar, the author's own, placed before it.
				expect( sidebarHtml.findNoCase( "Blog</a>" ) ).toBeLT( sidebarHtml.findNoCase( ">Index<" ) );
				expect( sidebarHtml.reMatch( 'href="/blog/index\.html"' ).len() ).toBe( 1 );
			} );

			it( "still picks up a page's own edit across repeated build() calls on the same instance (DevServer.bx's own shape), once its source file's mtime changes", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "First body" );

				pipeline.build( root );
				pipeline.build( root ); // same instance, unchanged source - exercises the cache-hit path
				expect( fileRead( root & "/site/index.html" ) ).toInclude( "<p>First body</p>" );

				fileWrite( root & "/docs/index.md", "Second body" );
				var futureMillis = createObject( "java", "java.lang.System" ).currentTimeMillis() + 5000;
				createObject( "java", "java.io.File" ).init( root & "/docs/index.md" ).setLastModified( javaCast( "long", futureMillis ) );

				pipeline.build( root );
				expect( fileRead( root & "/site/index.html" ) ).toInclude( "<p>Second body</p>" );
			} );

			it( "clearDevCache() forces every page to reconvert on the next build(), even with an unchanged mtime", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: Original Title" & char( 10 ) & "---" & char( 10 ) & "Body." );

				pipeline.build( root );
				expect( fileRead( root & "/site/index.html" ) ).toInclude( "Original Title" );

				// bxsites.json's own name changing is exactly the kind of
				// change a single page's own mtime can't reflect on its own -
				// DevServer.bx's own onWatchEvent()/onSchedulerTick() call
				// clearDevCache() for exactly this reason before rebuilding.
				fileWrite( root & "/bxsites.json", '{"name":"Renamed Site","theme":{"name":"bootstrap"}}' );
				pipeline.clearDevCache();
				pipeline.build( root );

				expect( fileRead( root & "/site/index.html" ) ).toInclude( "Renamed Site" );
			} );

			it( 'gives every page a correct <link rel="canonical"> when baseURL is a full URL, scoped to its own tree', function() {
				var root = newTempDirWithConfig( '{"name":"Test Site","baseURL":"https://example.com/docs/","theme":{"name":"bootstrap"},"i18n":{"defaultLocale":{"code":"en","label":"English"},"locales":[{"code":"de","label":"Deutsch"}]}}' );
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/i18n/de", true, true );
				fileWrite( root & "/docs/i18n/de/index.md", "Startseite" );

				pipeline.build( root );

				// encodeForHTML()'s exact escaping range for "safe" characters
				// like ":"/"/" is environment-dependent (locale/JVM-charset-driven) -
				// decoded before comparing, same reasoning
				// DirectiveBlockProcessorSpec.bx's own htmlDecode() uses.
				expect( htmlDecode( fileRead( root & "/site/index.html" ) ) ).toInclude( '<link rel="canonical" href="https://example.com/docs/index.html">' );
				expect( htmlDecode( fileRead( root & "/site/de/index.html" ) ) ).toInclude( '<link rel="canonical" href="https://example.com/docs/de/index.html">' );
			} );

			it( 'omits <link rel="canonical"> entirely when baseURL has no absolute domain', function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileRead( root & "/site/index.html" ) ).notToInclude( 'rel="canonical"' );
			} );

			private string function newTempDirWithConfig( required string configJson ) {
				var dir = createTempDirectory( prefix = "bxsites-buildpipeline-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/docs", true, true );
				fileWrite( dir & "/bxsites.json", arguments.configJson );
				return dir;
			}

			// Same helper DirectiveBlockProcessorSpec.bx already carries -
			// see its own docblock for why this decodes rather than pinning
			// one particular escaped form.
			private string function htmlDecode( required string text ) {
				// encodeForHTML() may also use a named entity instead of a
				// numeric one for punctuation it has one for (e.g. "…" as
				// "&hellip;" rather than "&##x2026;") - decoded first since
				// it's a fixed literal, not a numeric-entity pattern match.
				var decoded = arguments.text.replaceNoCase( "&hellip;", "…", "all" )
				var matcher = createObject( "java", "java.util.regex.Pattern" ).compile( '&##x([0-9a-fA-F]+);' ).matcher( decoded )
				var buffer = createObject( "java", "java.lang.StringBuilder" ).init()
				while ( matcher.find() ) {
					var codepoint = createObject( "java", "java.lang.Integer" ).parseInt( matcher.group( 1 ), 16 )
					var chars = createObject( "java", "java.lang.String" ).valueOf( createObject( "java", "java.lang.Character" ).toChars( codepoint ) )
					matcher.appendReplacement( buffer, createObject( "java", "java.util.regex.Matcher" ).quoteReplacement( chars ) )
				}
				matcher.appendTail( buffer )
				return buffer.toString()
			}

		} );
	}

}
