			it( "wires up Algolia DocSearch instead of the local index/widget when searchProvider.provider is algolia", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"search":true,"searchProvider":{"provider":"algolia","algolia":{"appId":"ABC123","apiKey":"secret","indexName":"my-docs"}}}'
				);
				fileWrite( root & "/docs/index.md", "Welcome home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/search-index.json" ) ).toBeFalse();
				expect( fileExists( root & "/site/assets/search.js" ) ).toBeFalse();

				var html = fileRead( root & "/site/index.html" );
				expect( html ).notToInclude( "bxsites-search-input" );
				expect( html ).notToInclude( "minisearch" );
				expect( html ).toInclude( "bxsites-search-algolia" );
				expect( html ).toInclude( "docsearch(" );
				expect( html ).toInclude( "ABC123" );
				// encodeForJavaScript() hex-escapes non-alphanumerics for safe JS-string
				// embedding - "my-docs" comes out as "my\x2Ddocs" in the rendered
				// <script>, which the browser's own JS parser reads back as "my-docs"
				// at runtime; asserting the raw substring "my-docs" here would be wrong.
				expect( html ).toInclude( "my\x2Ddocs" );
			} );

			it( "buildSearchIndex() reports skipped without writing anything when searchProvider.provider is algolia", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"search":true,"searchProvider":{"provider":"algolia","algolia":{"appId":"ABC123","apiKey":"secret","indexName":"my-docs"}}}'
				);
				fileWrite( root & "/docs/index.md", "Welcome home" );

				var result = pipeline.buildSearchIndex( root );

				expect( result.skipped ).toBeTrue();
				expect( fileExists( root & "/site/search-index.json" ) ).toBeFalse();
			} );

			it( "runs the pagefind indexer against the finished site/ when searchProvider.provider is pagefind, via the setPagefindIndexer() test seam", function() {
				var root = newProject();
				fileWrite(
					root & "/bxsites.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"search":true,"searchProvider":{"provider":"pagefind","pagefind":{"bin":"/opt/pagefind","options":["--exclude-selectors",".no-index"]}}}'
				);
				fileWrite( root & "/docs/index.md", "Welcome home" );

				var fakePagefind = new "tests.support.FakePagefindIndexer@bxsites"();
				pipeline.setPagefindIndexer( fakePagefind );

				pipeline.build( root );

				expect( fileExists( root & "/site/search-index.json" ) ).toBeFalse();
				expect( fileExists( root & "/site/assets/search.js" ) ).toBeFalse();

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "bxsites-search-pagefind" );
				expect( html ).toInclude( "pagefind-ui.js" );

				var calls = fakePagefind.getCalls();
				expect( calls.len() ).toBe( 1 );
				expect( calls[ 1 ].siteDir ).toBe( root & "/site" );
				expect( calls[ 1 ].bin ).toBe( "/opt/pagefind" );
				expect( calls[ 1 ].options ).toBe( [ "--exclude-selectors", ".no-index" ] );
			} );

