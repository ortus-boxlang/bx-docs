class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.MarkdownLinkResolver", function() {

			beforeEach( function() {
				variables.resolver = new "models.build.MarkdownLinkResolver@bxsites"();
			} );

			it( "resolves a root-level page's sibling .md link to its pretty-URL", function() {
				var html = '<a href="getting-started.md">Getting Started</a>';
				var result = variables.resolver.resolve( html, "index.md", "/bx-sites/" );

				expect( result ).toInclude( 'href="/bx-sites/getting-started/index.html"' );
			} );

			it( "resolves a same-folder sibling link, accounting for the linking page's own added URL depth", function() {
				// docs/guides/themes.md links to docs/guides/search.md - both become
				// guides/<name>/index.html, so the correct link is a sibling of
				// guides/themes/index.html, not nested under it.
				var html = '<a href="search.md">Search</a>';
				var result = variables.resolver.resolve( html, "guides/themes.md", "/bx-sites/" );

				expect( result ).toInclude( 'href="/bx-sites/guides/search/index.html"' );
			} );

			it( "resolves a parent-relative ../ link with an anchor preserved", function() {
				var html = '<a href="../configuration.md##repo">Configuration</a>';
				var result = variables.resolver.resolve( html, "guides/themes.md", "/bx-sites/" );

				expect( result ).toInclude( 'href="/bx-sites/configuration/index.html##repo"' );
			} );

			it( "maps a linked index.md to its folder's own index.html, not a nested index/ folder", function() {
				var html = '<a href="../index.md">Home</a>';
				var result = variables.resolver.resolve( html, "guides/themes.md", "/bx-sites/" );

				expect( result ).toInclude( 'href="/bx-sites/index.html"' );
			} );

			it( "leaves absolute URLs, mailto links, root-relative paths and pure anchors untouched", function() {
				var html = '<a href="https://example.com/x.md">A</a>' &
					'<a href="mailto:x@example.com">B</a>' &
					'<a href="/already/rooted/index.html">C</a>' &
					'<a href="##section">D</a>';

				var result = variables.resolver.resolve( html, "guides/themes.md", "/bx-sites/" );

				expect( result ).toBe( html );
			} );

			it( "leaves a non-.md relative href untouched", function() {
				var html = '<a href="../assets/logo.svg">Logo</a>';
				var result = variables.resolver.resolve( html, "guides/themes.md", "/bx-sites/" );

				expect( result ).toInclude( 'href="../assets/logo.svg"' );
			} );

			it( "resolves correctly at the site root (empty basePath directory case)", function() {
				var html = '<a href="cli-reference.md?x=1">CLI</a>';
				var result = variables.resolver.resolve( html, "index.md", "/" );

				expect( result ).toInclude( 'href="/cli-reference/index.html?x=1"' );
			} );

			it( "uses postUrlsByPath's real urlPath for a blog-post-to-blog-post link, instead of mirroring its docs/blog/posts/ source directory", function() {
				// BlogDiscoverer.bx builds a post's own urlPath as
				// blog/<slug>/index.html, dropping the blog/posts/ source
				// prefix - the generic urlPathFor() convention this class
				// otherwise uses would get this specific case wrong
				// (blog/posts/<slug>/index.html, mirroring the source tree
				// like a normal docs page), so BuildPipeline.bx hands over
				// the real answer via this override map.
				var html = '<a href="pick-your-theme.md">Pick Your Theme</a>';
				var postUrlsByPath = { "blog/posts/pick-your-theme.md" : "blog/pick-your-theme/index.html" };

				var result = variables.resolver.resolve( html, "blog/posts/get-your-docs-live.md", "/", postUrlsByPath );

				expect( result ).toInclude( 'href="/blog/pick-your-theme/index.html"' );
			} );

			it( "falls back to the generic urlPathFor() convention for any .md link not in postUrlsByPath", function() {
				// "blog/posts/get-your-docs-live.md" -> directory "blog/posts" - needs to
				// escape two levels ("../../") to reach "guides/search.md", not one.
				var html = '<a href="../../guides/search.md">Search</a>';
				var postUrlsByPath = { "blog/posts/pick-your-theme.md" : "blog/pick-your-theme/index.html" };

				var result = variables.resolver.resolve( html, "blog/posts/get-your-docs-live.md", "/", postUrlsByPath );

				expect( result ).toInclude( 'href="/guides/search/index.html"' );
			} );

			it( "defaults postUrlsByPath to empty, keeping today's plain urlPathFor() behavior for every caller that doesn't pass one", function() {
				var html = '<a href="pick-your-theme.md">Pick Your Theme</a>';

				var result = variables.resolver.resolve( html, "blog/posts/get-your-docs-live.md", "/" );

				expect( result ).toInclude( 'href="/blog/posts/pick-your-theme/index.html"' );
			} );

		} );
	}

}
