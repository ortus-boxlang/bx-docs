				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [docbox.tags] is not an array", function() {
				var dir = newProjectDir( '{"name":"My Docs","docbox":{"tags":"api"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [cloud] is not an object", function() {
				var dir = newProjectDir( '{"name":"My Docs","cloud":"not-an-object"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [cloud.siteId] is not a string", function() {
				var dir = newProjectDir( '{"name":"My Docs","cloud":{"siteId":["not","a","string"]}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [cloud.apiUrl] is not a string", function() {
				var dir = newProjectDir( '{"name":"My Docs","cloud":{"apiUrl":["not","a","string"]}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

		} );
	}

}
