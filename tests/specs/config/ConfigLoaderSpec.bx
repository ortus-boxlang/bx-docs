/**
 * Exercises the bxsites.json loader/validator directly against temp project
 * directories - no CLI dispatch involved (see ModuleConfigCliSpec.bx for that).
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "config.ConfigLoader", function() {

			beforeEach( function() {
				variables.loader = new "models.config.ConfigLoader@bxsites"();
				variables.loader.setTomlRenderer( new "tests.support.FakeTomlRenderer@bxsites"() );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newProjectDir( string configJson = "" ) {
				var dir = createTempDirectory( prefix = "bxsites-configloader-" );
				tempDirs.append( dir );
				if ( len( arguments.configJson ) ) {
					fileWrite( dir & "/bxsites.json", arguments.configJson );
				}
				return dir;
			}

			it( "throws BxSites.ConfigNotFound when bxsites.json is missing", function() {
				var dir = newProjectDir();
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.ConfigNotFound" );
			} );

			it( "loads bxsites.yaml via the injected YAML renderer when there's no bxsites.json", function() {
				// FakeYamlRenderer.bx round-trips through JSON, not real
				// YAML - real bx-yaml BIFs aren't safely callable in a bare
				// unit test (YamlRenderer.bx's own docblock) - so the fixture
				// below is JSON text saved with a .yaml extension, on
				// purpose, matched by the same fake on the reading side.
				var dir = createTempDirectory( prefix = "bxsites-configloader-yaml-" );
				tempDirs.append( dir );
				fileWrite( dir & "/bxsites.yaml", '{"name":"My Docs"}' );
				loader.setYamlRenderer( new "tests.support.FakeYamlRenderer@bxsites"() );

				var config = loader.load( dir );

				expect( config.name ).toBe( "My Docs" );
				expect( config.theme.name ).toBe( "bootstrap" );
			} );

			it( "prefers bxsites.yaml over bxsites.json when both are present", function() {
				var dir = newProjectDir( '{"name":"JSON Site"}' );
				fileWrite( dir & "/bxsites.yaml", '{"name":"YAML Site"}' );
				loader.setYamlRenderer( new "tests.support.FakeYamlRenderer@bxsites"() );

				expect( loader.load( dir ).name ).toBe( "YAML Site" );
			} );

			it( "loads bxsites.toml when YAML and JSON are absent", function() {
				var dir = createTempDirectory( prefix = "bxsites-configloader-toml-" );
				tempDirs.append( dir );
				fileWrite( dir & "/bxsites.toml", '{"name":"TOML Site"}' );

				expect( loader.load( dir ).name ).toBe( "TOML Site" );
			} );

			it( "prefers bxsites.toml over bxsites.json when YAML is absent", function() {
				var dir = newProjectDir( '{"name":"JSON Site"}' );
				fileWrite( dir & "/bxsites.toml", '{"name":"TOML Site"}' );

				expect( loader.load( dir ).name ).toBe( "TOML Site" );
			} );

			it( "throws BxSites.InvalidConfig for malformed TOML", function() {
				var dir = createTempDirectory( prefix = "bxsites-configloader-badtoml-" );
				tempDirs.append( dir );
				fileWrite( dir & "/bxsites.toml", "{ not valid" );

				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig for malformed YAML", function() {
				var dir = createTempDirectory( prefix = "bxsites-configloader-badyaml-" );
				tempDirs.append( dir );
				fileWrite( dir & "/bxsites.yaml", "{ not valid" );
				loader.setYamlRenderer( new "tests.support.FakeYamlRenderer@bxsites"() );

				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig for malformed JSON", function() {
				var dir = newProjectDir( "{ not valid json" );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [name] is missing", function() {
				var dir = newProjectDir( '{"description":"no name here"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "applies defaults for description, baseURL, theme, search, nav, markdown, repo, social, footer and lastUpdated", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				var config = loader.load( dir );

				expect( config.name ).toBe( "My Docs" );
				expect( config.description ).toBe( "" );
				expect( config.baseURL ).toBe( "/" );
				expect( config.theme.name ).toBe( "bootstrap" );
				expect( config.theme.options ).toBeStruct();
				expect( config.search ).toBeTrue();
				expect( config.nav ).toBeArray();
				expect( config.markdown ).toBeStruct();
				expect( config.markdown.enableAdmonition ).toBeTrue();
				expect( config.repo.url ).toBe( "" );
				expect( config.repo.editUri ).toBe( "" );
				expect( config.social ).toBeArray();
				expect( config.social.len() ).toBe( 0 );
				expect( config.footer ).toBeFalse();
				expect( config.lastUpdated ).toBeFalse();
			} );

			it( "deep-merges a partial [theme] override, keeping default options", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"name":"material"}}' );
				var config = loader.load( dir );

				expect( config.theme.name ).toBe( "material" );
				expect( config.theme.options ).toBeStruct();
			} );

			it( "preserves user-supplied values that override defaults", function() {
				var dir = newProjectDir( '{"name":"My Docs","baseURL":"/docs/","search":false}' );
				var config = loader.load( dir );

				expect( config.baseURL ).toBe( "/docs/" );
				expect( config.search ).toBeFalse();
			} );

			it( "deep-merges a partial [markdown] override, keeping the enableAdmonition default", function() {
				var dir = newProjectDir( '{"name":"My Docs","markdown":{"enableFootnotes":true}}' );
				var config = loader.load( dir );

				expect( config.markdown.enableAdmonition ).toBeTrue();
				expect( config.markdown.enableFootnotes ).toBeTrue();
			} );

			it( "allows overriding the enableAdmonition default to false", function() {
				var dir = newProjectDir( '{"name":"My Docs","markdown":{"enableAdmonition":false}}' );
				var config = loader.load( dir );

				expect( config.markdown.enableAdmonition ).toBeFalse();
			} );

			it( "preserves a user-supplied [nav] array", function() {
				var dir = newProjectDir( '{"name":"My Docs","nav":[{"title":"Home","path":"index.md"}]}' );
				var config = loader.load( dir );

				expect( config.nav ).toBeArray();
				expect( config.nav.len() ).toBe( 1 );
				expect( config.nav[ 1 ].title ).toBe( "Home" );
			} );

			it( "throws BxSites.InvalidConfig when [nav] is not an array", function() {
				var dir = newProjectDir( '{"name":"My Docs","nav":{"title":"Home"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [search] is not a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","search":"not-a-boolean-at-all"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "defaults [searchProvider] to the local provider", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				var config = loader.load( dir );

				expect( config.searchProvider.provider ).toBe( "local" );
				expect( config.searchProvider.algolia.appId ).toBe( "" );
				expect( config.searchProvider.algolia.apiKey ).toBe( "" );
				expect( config.searchProvider.algolia.indexName ).toBe( "" );
				expect( config.searchProvider.algolia.insights ).toBeFalse();
				expect( config.searchProvider.pagefind.bin ).toBe( "pagefind" );
				expect( config.searchProvider.pagefind.options ).toBeArray();
				expect( config.searchProvider.pagefind.options.len() ).toBe( 0 );
			} );

			it( "preserves a user-supplied [searchProvider] of algolia with its own settings", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":"algolia","algolia":{"appId":"ABC123","apiKey":"secret","indexName":"my-docs","insights":true}}}' );
				var config = loader.load( dir );

				expect( config.searchProvider.provider ).toBe( "algolia" );
				expect( config.searchProvider.algolia.appId ).toBe( "ABC123" );
				expect( config.searchProvider.algolia.apiKey ).toBe( "secret" );
				expect( config.searchProvider.algolia.indexName ).toBe( "my-docs" );
				expect( config.searchProvider.algolia.insights ).toBeTrue();
			} );

			it( "preserves a custom [searchProvider.provider] name outside the built-in set", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":"meilisearch"}}' );
				var config = loader.load( dir );

				expect( config.searchProvider.provider ).toBe( "meilisearch" );
			} );

			it( "throws BxSites.InvalidConfig when [searchProvider.provider] is blank", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":""}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [searchProvider] is not an object", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":"algolia"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [searchProvider.provider] is algolia but [searchProvider.algolia] is missing required fields", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":"algolia","algolia":{"appId":"ABC123"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [searchProvider.algolia.insights] isn't a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":"algolia","algolia":{"appId":"A","apiKey":"B","indexName":"C","insights":["not","a","boolean"]}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "allows [searchProvider.provider] pagefind with no [pagefind] settings at all", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":"pagefind"}}' );
				var config = loader.load( dir );

				expect( config.searchProvider.provider ).toBe( "pagefind" );
				expect( config.searchProvider.pagefind.bin ).toBe( "pagefind" );
			} );

			it( "preserves a user-supplied [searchProvider.pagefind] bin and options", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":"pagefind","pagefind":{"bin":"/usr/local/bin/pagefind","options":["--exclude-selectors",".no-index"]}}}' );
				var config = loader.load( dir );

				expect( config.searchProvider.pagefind.bin ).toBe( "/usr/local/bin/pagefind" );
				expect( config.searchProvider.pagefind.options ).toBe( [ "--exclude-selectors", ".no-index" ] );
			} );

			it( "throws BxSites.InvalidConfig when [searchProvider.pagefind] is not an object", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":"pagefind","pagefind":"nope"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [searchProvider.pagefind.bin] is blank", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":"pagefind","pagefind":{"bin":""}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [searchProvider.pagefind.options] is not an array", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":"pagefind","pagefind":{"options":"--foo"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when a [searchProvider.pagefind.options] entry is empty", function() {
				var dir = newProjectDir( '{"name":"My Docs","searchProvider":{"provider":"pagefind","pagefind":{"options":[""]}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [theme.name] is explicitly blank", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"name":"","options":{}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "defaults [theme.name] to bootstrap when [theme] is present but has no [name] key at all", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"foo":"bar"}}}' );
				var config = loader.load( dir );

				expect( config.theme.name ).toBe( "bootstrap" );
				expect( config.theme.options.foo ).toBe( "bar" );
			} );

			it( "accepts [theme.options.colorMode] of light, dark or auto, defaulting to auto when absent", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).theme.options.colorMode ?: "auto" ).toBe( "auto" );

				for ( var mode in [ "light", "dark", "auto" ] ) {
					var modeDir = newProjectDir( '{"name":"My Docs","theme":{"options":{"colorMode":"' & mode & '"}}}' );
					expect( loader.load( modeDir ).theme.options.colorMode ).toBe( mode );
				}
			} );

			it( "throws BxSites.InvalidConfig when [theme.options.colorMode] isn't light, dark or auto", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"colorMode":"purple"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "accepts [theme.options.accentColor]/[accentColorDark] as 3- or 6-digit hex colors, undefined when absent", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).theme.options.keyExists( "accentColor" ) ).toBeFalse();
				expect( loader.load( dir ).theme.options.keyExists( "accentColorDark" ) ).toBeFalse();

				for ( var hex in [ "##2563eb", "##fff", "##FFFFFF" ] ) {
					var hexDir = newProjectDir( '{"name":"My Docs","theme":{"options":{"accentColor":"' & hex & '","accentColorDark":"' & hex & '"}}}' );
					var config = loader.load( hexDir );
					expect( config.theme.options.accentColor ).toBe( hex );
					expect( config.theme.options.accentColorDark ).toBe( hex );
				}
			} );

			it( "throws BxSites.InvalidConfig when [theme.options.accentColor] isn't a valid hex color", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"accentColor":"blue"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [theme.options.accentColorDark] isn't a valid hex color", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"accentColorDark":"not-a-color"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "exposes the v1 built-in theme names", function() {
				expect( loader.getBuiltInThemes() ).toBe( [ "bootstrap", "material", "tailwind", "docsy", "slate", "docusaurus", "justthedocs", "vuepress", "gitbook", "notion" ] );
			} );

			it( "deep-merges a partial [repo] override, keeping the default empty editUri", function() {
				var dir = newProjectDir( '{"name":"My Docs","repo":{"url":"https://github.com/acme/docs"}}' );
				var config = loader.load( dir );

				expect( config.repo.url ).toBe( "https://github.com/acme/docs" );
				expect( config.repo.editUri ).toBe( "" );
			} );

			it( "preserves a user-supplied [social] array", function() {
				var dir = newProjectDir( '{"name":"My Docs","social":[{"url":"https://twitter.com/acme","icon":"twitter"}]}' );
				var config = loader.load( dir );

				expect( config.social.len() ).toBe( 1 );
				expect( config.social[ 1 ].url ).toBe( "https://twitter.com/acme" );
			} );

			it( "throws BxSites.InvalidConfig when a [social] entry has no [url]", function() {
				var dir = newProjectDir( '{"name":"My Docs","social":[{"icon":"twitter"}]}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [footer] is not a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","footer":"yes please"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [lastUpdated] is not a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","lastUpdated":"yes please"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "applies defaults for [theme.logo], [theme.favicon], [analytics], [ogImage], [extraCss] and [extraJs]", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				var config = loader.load( dir );

				expect( config.theme.logo ).toBe( "" );
				expect( config.theme.favicon ).toBe( "" );
				expect( config.analytics.provider ).toBe( "" );
				expect( config.analytics.id ).toBe( "" );
				expect( config.ogImage ).toBe( "" );
				expect( config.extraCss ).toBeArray();
				expect( config.extraCss.len() ).toBe( 0 );
				expect( config.extraJs ).toBeArray();
				expect( config.extraJs.len() ).toBe( 0 );
			} );

			it( "preserves user-supplied [theme.logo] and [theme.favicon]", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"logo":"assets/logo.svg","favicon":"assets/favicon.ico"}}' );
				var config = loader.load( dir );

				expect( config.theme.logo ).toBe( "assets/logo.svg" );
				expect( config.theme.favicon ).toBe( "assets/favicon.ico" );
			} );

			it( "throws BxSites.InvalidConfig when [theme.logo] isn't a string", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"logo":["not","a","string"]}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "accepts boolean [theme.options.navCollapsible] and [theme.options.navExpandAll]", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"navCollapsible":true,"navExpandAll":false}}}' );
				var config = loader.load( dir );

				expect( config.theme.options.navCollapsible ).toBeTrue();
				expect( config.theme.options.navExpandAll ).toBeFalse();
			} );

			it( "throws BxSites.InvalidConfig when [theme.options.navCollapsible] isn't a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"navCollapsible":["not","a","boolean"]}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "accepts boolean [theme.options.breadcrumbs], defaulting to unset (themes treat absent as true)", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).theme.options.keyExists( "breadcrumbs" ) ).toBeFalse();

				var offDir = newProjectDir( '{"name":"My Docs","theme":{"options":{"breadcrumbs":false}}}' );
				expect( loader.load( offDir ).theme.options.breadcrumbs ).toBeFalse();
			} );

			it( "throws BxSites.InvalidConfig when [theme.options.breadcrumbs] isn't a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"breadcrumbs":["not","a","boolean"]}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "accepts [theme.options.tocPosition] of top or sticky, defaulting to top when absent", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).theme.options.tocPosition ?: "top" ).toBe( "top" );

				for ( var position in [ "top", "sticky" ] ) {
					var positionDir = newProjectDir( '{"name":"My Docs","theme":{"options":{"tocPosition":"' & position & '"}}}' );
					expect( loader.load( positionDir ).theme.options.tocPosition ).toBe( position );
				}
			} );

			it( "throws BxSites.InvalidConfig when [theme.options.tocPosition] isn't top or sticky", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"tocPosition":"bottom"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "accepts [theme.options.pageMetaPosition] of top or bottom, defaulting to bottom when absent", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).theme.options.pageMetaPosition ?: "bottom" ).toBe( "bottom" );

				for ( var position in [ "top", "bottom" ] ) {
					var positionDir = newProjectDir( '{"name":"My Docs","theme":{"options":{"pageMetaPosition":"' & position & '"}}}' );
					expect( loader.load( positionDir ).theme.options.pageMetaPosition ).toBe( position );
				}
			} );

			it( "throws BxSites.InvalidConfig when [theme.options.pageMetaPosition] isn't top or bottom", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"pageMetaPosition":"middle"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "accepts [theme.options.pageActionsPosition] of top or bottom, defaulting to top when absent", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).theme.options.pageActionsPosition ?: "top" ).toBe( "top" );

				for ( var position in [ "top", "bottom" ] ) {
					var positionDir = newProjectDir( '{"name":"My Docs","theme":{"options":{"pageActionsPosition":"' & position & '"}}}' );
					expect( loader.load( positionDir ).theme.options.pageActionsPosition ).toBe( position );
				}
			} );

			it( "throws BxSites.InvalidConfig when [theme.options.pageActionsPosition] isn't top or bottom", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"pageActionsPosition":"middle"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "preserves a user-supplied Google [analytics] block", function() {
				var dir = newProjectDir( '{"name":"My Docs","analytics":{"provider":"google","id":"G-ABC123"}}' );
				var config = loader.load( dir );

				expect( config.analytics.provider ).toBe( "google" );
				expect( config.analytics.id ).toBe( "G-ABC123" );
			} );

			it( "throws BxSites.InvalidConfig when [analytics.provider] isn't google", function() {
				var dir = newProjectDir( '{"name":"My Docs","analytics":{"provider":"plausible","id":"abc"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [analytics.provider] is set without an [analytics.id]", function() {
				var dir = newProjectDir( '{"name":"My Docs","analytics":{"provider":"google"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

			it( "throws BxSites.InvalidConfig when [analytics.id] contains invalid characters", function() {
				var dir = newProjectDir( '{"name":"My Docs","analytics":{"provider":"google","id":"G-ABC 123!"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidConfig" );
			} );

