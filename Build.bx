class{

	property name="moduleSlug";
	property name="version";
	property name="buildId";
	property name="branch";

	static {
		// Source Excludes Not Added to final binary - matched against each
		// top-level item's bare name (anchored), not the full/relative path.
		excludes = [
	        "^\..*",
	        "^build$",
	        "^Build\.bx$",
			"^Setup\.bx$",
			"^docker-compose\.yml$",
	        "^SetupTemplate\.bx$",
			"^server-.*\.json$",
			"^tests$",
			"^site$",
			"^\.cache$",
			"^examples$",
			"^apidocs$",
			// Java/Gradle/Maven build-tool plugins - net-new, self-contained
			// Java subprojects living alongside the BoxLang module (own
			// build/CI/release pipeline), never part of the module itself.
			"^core$",
			"^gradle-plugin$",
			"^maven-plugin$"
	    ];
	    // Current working directories
	    cwd = server.cli.executionPath & "/";
	    buildDir = static.cwd & "build/module";
	    bundledDir = static.cwd & "build/module-with-deps";
	    artifactsDir = static.cwd & "build/artifacts";
	}

	/**
	 * CI/release entry point (`boxlang Build.bx --version=... --buildId=...`):
	 * copies the module source to `build/module` (excluding dev-only files
	 * per `excludes`), substitutes `@build.version@`/`@build.number@`
	 * placeholders, and writes a build-id marker file.
	 *
	 * @args CLI args, parsed via `cliGetArgs()` (`--version`, `--buildId`, `--branch`)
	 */
	function main( args = [] ){
		// Prep incoming arguments
		var options = cliGetArgs().options;
		variables.moduleSlug = "bx-sites";
		variables.version = options.version ?: "1.0.0"
		variables.buildId = options.buildId ?: createUUID()
		variables.branch = options.branch ?: "development"

		println( "🛠️ Building module..." )
		println( "⚙️ Options:" )
		println( options )

		// Create and build directories
		var buildDirectories = [ static.buildDir, static.bundledDir, static.artifactsDir ]
			.each( dir => {
				if( directoryExists( dir ) ){
					directoryDelete( dir, true )
				}
				directoryCreate( dir, true )
			} )

		// Copy source
        println( "✨ Building source..." )
		copy(
			static.cwd,
			static.buildDir
		)
		// Create build ID
		fileWrite(
			"#static.buildDir#/#variables.moduleSlug#-#version#+#buildID#.md",
			"Built with ❤️ love ❤️ on #dateTimeFormat( now(), "full" )#"
		);

		// Updating Version + ID Placeholders
		println( "📚 Updating version and build ID..." )
		tokenReplace(
			static.buildDir,
			"@build.version@",
			variables.version
		);
		// On main, `--version` is the bare release version (e.g. "1.0.0") -
		// stamp real build metadata onto it. On any other branch, `--version`
		// already carries whatever suffix the caller wants baked in (release.yml
		// passes "1.0.0-snapshot" for a development build) - there's no build
		// number to add on top of that, so the leftover `+@build.number@`
		// token is dropped entirely rather than replaced with another literal
		// "-snapshot" (that used to double up into "1.0.0-snapshot-snapshot"
		// whenever the caller's own version already ended in "-snapshot").
		tokenReplace(
			static.buildDir,
			( variables.branch == "main" ? "@build.number@" : "+@build.number@" ),
			( variables.branch == "main" ? variables.buildID : "" )
		);

		// zip up source
		var destination = "#static.artifactsDir#/#variables.moduleSlug#-#variables.version#.zip";
		println( "📦 Zipping code to [#destination#]..." )
		compress(
			destination : destination,
			format : "zip",
			source : static.buildDir,
			includeBaseFolder : false,
			overwrite : true,
			recurse : true
		)
		fileCopy( static.buildDir & "/box.json", static.artifactsDir & "/box.json" )
		fileCopy( static.buildDir & "/changelog.md", static.artifactsDir & "/changelog.md" )

		// Build checksums: sha-512, md5
		println( "🔑 Building checksums..." )
		buildCheckSum(
			destination,
			"sha-512",
			"sha512"
		)
		buildCheckSum(
			destination,
			"md5",
			"md5"
		)

		// Bundle a second, self-contained artifact via BoxLang module inception
		bundleDependencies()

		println( "🔥 Build complete! 🔥" )
	}

	/**
	 * Packages a second artifact - `#moduleSlug#-#version#-with-deps.zip` -
	 * that bundles every runtime dependency from box.json's `dependencies`
	 * block inside a `modules/` folder alongside the module itself, using
	 * BoxLang's module inception (a module's own `modules/` folder is
	 * discovered and activated before the module itself, recursively - see
	 * https://boxlang.ortusbooks.com/boxlang-framework/module-development/module-inception).
	 * The result needs nothing pre-installed to run standalone. `devDependencies`
	 * (testbox, commandbox-*) are dev-only tooling and are never bundled.
	 *
	 * Built from a copy of the already-built `build/module` (so it stays in
	 * sync with the primary artifact's version/build-id substitutions)
	 * rather than `build/module` itself, so the primary artifact and the
	 * `box forgebox publish` step - which publishes straight from
	 * `build/module` - never pick up the bundled dependencies.
	 */
	function bundleDependencies(){
		var dependencies = jsonDeserialize( fileRead( static.buildDir & "/box.json" ) ).dependencies ?: {}

		if( dependencies.isEmpty() ){
			println( "- No dependencies declared, skipping the with-deps artifact" )
			return
		}

		println( "📦 Bundling module dependencies (module inception)..." )
		directoryCopy( static.buildDir, static.bundledDir, true )
		directoryCreate( static.bundledDir & "/modules", true )

		for( var slug in dependencies ){
			println( "	📥 Installing [#slug#] into [modules/#slug#]..." )
			var result = exec(
				[ "box", "install", slug, "modules", "--!save" ],
				static.bundledDir
			)
			if( result.exitCode != 0 ){
				throw(
					type    = "BxSites.DependencyBundleFailed",
					message = "`box install #slug# modules` failed (exit #result.exitCode#): #result.output#"
				)
			}
		}

		var destination = "#static.artifactsDir#/#variables.moduleSlug#-#variables.version#-with-deps.zip";
		println( "📦 Zipping bundled code to [#destination#]..." )
		compress(
			destination : destination,
			format : "zip",
			source : static.bundledDir,
			includeBaseFolder : false,
			overwrite : true,
			recurse : true
		)

		println( "🔑 Building checksums for the bundled artifact..." )
		buildCheckSum( destination, "sha-512", "sha512" )
		buildCheckSum( destination, "md5", "md5" )
	}

	/**
	 * Runs a command via `java.lang.ProcessBuilder`, capturing its combined
	 * stdout/stderr and exit code - same pattern as
	 * `models/build/PagefindIndexer.bx`/`GitRevisionDate.bx`.
	 *
	 * @cmd Full argv, the binary included as element 1
	 * @cwd Working directory for the process
	 *
	 * @return { exitCode, output }
	 */
	static private function exec( required array cmd, required string cwd ){
		try {
			var pb = createObject( "java", "java.lang.ProcessBuilder" ).init( arguments.cmd )
			pb.directory( createObject( "java", "java.io.File" ).init( arguments.cwd ) )
			pb.redirectErrorStream( true )

			var process = pb.start()
			var output = createObject( "java", "java.lang.String" ).init( process.getInputStream().readAllBytes(), "UTF-8" )
			var exitCode = process.waitFor()

			return { exitCode : exitCode, output : trim( output ) }
		} catch( any e ){
			return {
				exitCode : -1,
				output   : "could not run [#arguments.cmd[ 1 ]#] (#e.message#) - is CommandBox's `box` CLI installed and on PATH?"
			}
		}
	}

	/**
	 * Copy files and directories from source to target with filters
	 *
	 * @src Source directory
	 * @target Target directory
	 * @recurse Recurse into directories
	 */
	static public function copy( src, target, recurse = true ){
        directoryList(
			src,
			false,
			"path",
			function( path ){
				var name = getFileFromPath( path )
				return !static.excludes.some( pattern => name.reFindNoCase( pattern ) )
			}
		).each( ( item ) => {
			// Copy to target
			if ( fileExists( item ) ) {
                println( "	📄 Copying file [#item#]" )
                fileCopy( item, target & "/" & getFileFromPath( item ) )
            } else {
                println( "	📂 Copying directory [#item#]" )
				directoryCopy(
					item,
					target & "/" & item.replace( src, "" ),
					true
				)
            }
        } )
    }

	/**
	 * Replace tokens in files
	 *
	 * @targetDir Target directory
	 * @token Token to replace
	 * @replacement Replacement string
	 * @excludes Excluded files and directories
	 */
	static public function tokenReplace(
		required targetDir,
		required token,
		required replacement,
		excludes = [ "^\.git", "SetupTemplate.bx", "Test.bx" ],
		boolean verbose = false
	){
		directoryList( arguments.targetDir, true, "array", "*.*", "asc", "file" )
			.filter( item => {
				var targetPath = item.replaceNoCase( targetDir, "" )
				return !excludes.some( pattern => targetPath.reFindNoCase( pattern ) )
			} )
			.each( item => {
				var targetPath = item.replaceNoCase( targetDir, "" )
				var content = fileRead( item )

				if( content.findNoCase( token ) ){
					if( verbose )
						println( "✅ Replacing token in [#targetPath#]" );
					var newContent = content.replaceNoCase( token, replacement, "all" );
					fileWrite( item, newContent )
				} else{
					if( verbose )
						println( "- Skipping, token not found on [#targetPath#]" )
				}
			} );
	}

	/**
	 * Builds a checksum for a file and writes it to a file with the specified extension.
	 *
	 * @filePath The path to the file for which the checksum is to be built.
	 * @algorithm The hashing algorithm to use (default is "md5"). Supported algorithms: "md5", "sha1", "sha-256", "sha-512".
	 * @extension The extension for the checksum file (default is "md5").
	 * @throws If the specified algorithm is not supported.
	 */
	static public function buildCheckSum( required filePath, algorithm="md5", extension="md5" ){
		var algorithms = [
			"md5",
			"sha1",
			"sha-256",
			"sha-512"
		]
		if( !algorithms.contains( algorithm ) ){
			throw( "Invalid algorithm [#algorithm#], must be one of [#algorithms.toList()#]" )
		}
		var thisHash = hash( fileReadBinary( filePath ), algorithm );
		fileWrite(
			filePath & "." & extension,
			thisHash
		)
	}

}