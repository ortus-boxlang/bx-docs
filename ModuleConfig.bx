/**
 * BxSites' module descriptor AND its CLI entry point, in one file - the
 * `this.*` properties below are what BoxLang's ModuleService reads to
 * register/activate this as a module (standard BoxLang module contract,
 * nothing bx-sites-specific there), while `main()` further down is what
 * actually runs on every `boxlang bxSites <verb> ...` invocation - see its
 * own docblock for the real verb-dispatch mechanics. `configure()` stays
 * near-empty on purpose: this module registers no interceptors and needs
 * no settings beyond the loadedOn/loadedBy bookkeeping BoxLang itself
 * expects, since almost everything bx-sites does happens synchronously
 * inside a `main()` verb call rather than through the runtime's own
 * event/interceptor system.
 */

class {

	/**
	 * --------------------------------------------------------------------------
	 * Injections
	 * --------------------------------------------------------------------------
	 */
	property name="moduleRecord";
	property name="boxRuntime";
	property name="functionService";
	property name="componentService";
	property name="interceptorService";
	property name="asyncService";
	property name="schedulerService";
	property name="datasourceService";
	property name="cacheService";
	property name="log";

	/**
	 * --------------------------------------------------------------------------
	 * Module Properties
	 * --------------------------------------------------------------------------
	 * Here is where you define the properties of your module that the module service
	 * will use to register and activate your module
	 */

	/**
	 * Your module version. Try to use semantic versioning
	 * @mandatory
	 */
	this.version = "@build.version@+@build.number@";

	/**
	 * The BoxLang mapping for your module.  All BoxLang modules are registered with an internal
	 * mapping prefix of : bxModules.{this.mapping}, /bxmodules/{this.mapping}. Ex: bxModules.test, /bxmodules/test
	 */
	this.mapping = "bxsites";

	/**
	 * Who built the module
	 */
	this.author = "Ortus Solutions";

	/**
	 * The module description
	 */
	this.description = "Static documentation site generator for BoxLang, built on bx-markdown";

	/**
	 * The module web URL
	 */
	this.webURL = "https://www.ortussolutions.com";

	/**
	 * This boolean flag tells the module service to skip the module registration/activation process.
	 */
	this.enabled = true;

    /**
	 * The module dependencies that this module needs to be activated before this module is activated.
	 * A list of module slugs: Example: [ "bxai", "bxoshi" ]
	 */
	this.dependencies = [];

	static {
		// The content-quality verb is registered as "audit", not the
		// plainer "check" its own class name/file suggests, because
		// BoxLang's own CLI reserves the literal argv token "check" (also
		// "compile", "cftranspile", "featureaudit", "generatesecret",
		// "schedule", and "format") as a top-level subcommand - it hijacks
		// ANY invocation containing one of those exact tokens, anywhere in
		// argv, before dispatch ever reaches a module's main() (confirmed
		// on both the current stable release and the 1.18.0-snapshot
		// bleeding edge, so this isn't a version-specific bug to wait out).
		// "audit" isn't one of BoxLang's own reserved tokens (verified the
		// same way), so it's the fix, not a workaround - and it stays
		// unscoped, matching every other top-level verb (build, serve,
		// etc.) instead of a "site:"-namespaced compound like the reserved
		// words would otherwise force.
		verbs = {
			"new"          : "models.cli.New",
			"build"        : "models.cli.Build",
			"serve"        : "models.cli.Serve",
			"search-index" : "models.cli.SearchIndex",
			"clean"        : "models.cli.Clean",
			"gh-deploy"    : "models.cli.GhDeploy",
			"deploy"       : "models.cli.Deploy",
			"publish"      : "models.cli.Publish",
			"package"      : "models.cli.Package",
			"migrate"      : "models.cli.Migrate",
			"audit"        : "models.cli.Check",
			"stats"        : "models.cli.Stats",
			"doctor"       : "models.cli.Doctor",
			"post:new"     : "models.cli.PostNew",
			"version:new"  : "models.cli.VersionNew",
			"i18n:status"  : "models.cli.I18nStatus",
			"i18n:new"     : "models.cli.I18nNew",
			"page:new"     : "models.cli.PageNew",
			"plugin:new"   : "models.cli.PluginNew",
			"theme:new"    : "models.cli.ThemeNew",
			"install:plugin" : "models.cli.InstallPlugin",
			"install:theme"  : "models.cli.InstallTheme",
			"skills:install" : "models.cli.SkillsInstall",
			"theme:import"   : "models.cli.ThemeImport",
			"page:rename"  : "models.cli.PageRename",
			"blog:drafts"  : "models.cli.BlogDrafts",
			"blog:find"    : "models.cli.BlogFind",
			"search:query" : "models.cli.SearchQuery",
			"lint"         : "models.cli.Lint",
			"docbox"       : "models.cli.DocBox",
			"coldbox"      : "models.cli.ColdBox"
		}

		verbDescriptions = {
			"new"          : "Scaffold a docs project                ([--theme], [--name])",
			"build"        : "Render docs/**.md into a static site in site/",
			"serve"        : "Build and serve the site locally with live reload ([--port], [--host])",
			"search-index" : "Rebuild the search index standalone",
			"clean"        : "Remove site/ and any build cache",
			"gh-deploy"    : "Build and force-push site/ to a gh-pages branch ([--branch], [--remote], [--message])",
			"deploy"       : "Build and ship site/ to a real target: s3, azure, gcs, firebase, ftp, sftp, rsync, netlify, vercel, cloudflare-pages, local, github-pages ([--entry=<deployments/*.json entry name>] or [--target] with its own flags; no args deploys every deployments/*.json entry; [--verbose])",
			"publish"      : "Build and publish site/ to bxSites Cloud, using [cloud.siteId]/[cloud.apiUrl] in bxsites.yaml ([--token], overrides the BXSITES_CLOUD_TOKEN env var)",
			"package"      : "Build and zip site/ into a single archive ([--output=<path>], defaults to site.zip)",
			"migrate"      : "Convert a GitBook export, mkdocs project, plain zip of Markdown, or Notion export into a bx-sites project (--source, required; [--from=gitbook|mkdocs|markdown-zip|notion])",
			"audit"        : "CI-grade content check on a built site: broken links/images, missing alt text, orphaned pages",
			"stats"        : "Report page/word counts, versions/locales, blog, tags, search index, and site size for a built site",
			"doctor"       : "Check the project/environment for common problems (modules, config, theme override)",
			"post:new"     : "Scaffold a new blog post (--title, required; [--slug], [--date], [--authors], [--categories], [--tags], [--draft])",
			"version:new"  : "Snapshot docs/ into a new docs/versions/<name>/ (--name, required)",
			"i18n:status"  : "Report per-locale translation coverage against the default tree",
			"i18n:new"     : "Scaffold a new docs/i18n/<code> locale (--code, required)",
			"page:new"     : "Scaffold a single docs page at an arbitrary path (--path, required; [--title], [--description], [--icon], [--tags], [--order])",
			"plugin:new"   : "Scaffold a plugin module skeleton (--name, required; [--dest])",
			"theme:new"    : "Eject a built-in theme into project theme/ for customizing (--theme, required)",
			"install:plugin" : "Download a plugin from ForgeBox into boxlang_modules/ (--name, required; [--version])",
			"install:theme"  : "Download a theme from ForgeBox into themes/<name>/ (--name, required; [--version])",
			"skills:install" : "Install the bx-sites AI agent skills (ortus-boxlang/bx-sites-skills) into every AI coding assistant this project has configured, via `npx skills add` ([--skill=<name>] for just one)",
			"theme:import"   : "Best-effort convert a mkdocs/jekyll/hugo theme into themes/<name>/ (--source, --path, --name, all required)",
			"page:rename"  : "Move a docs page and rewrite every relative link that pointed at it (--from, required; --to, required)",
			"blog:drafts"  : "List every blog post whose frontmatter sets draft: true",
			"blog:find"    : "Filter blog posts ([--author], [--category], [--tag], [--since], [--until], [--drafts])",
			"search:query" : "Query a built search-index.json and rank results (--query, required; [--limit])",
			"lint"         : "Pre-build content checks: heading level skips, blog posts missing a valid date",
			"docbox"       : "Generate a BoxLang/CFML API reference from DocBox into the content dir; needs the bx-docbox module ([--mappings:<name>=<path>], [--projectTitle], [--excludes], [--pagePathPrefix], [--tags], [--jsonDir])",
			"coldbox"      : "Document a ColdBox application from its conventions on disk: routes, handlers, models, modules, interceptors, scheduled tasks ([--appRoot], [--pagePathPrefix], [--tags], [--include])"
		}
	}

	/**
	 * --------------------------------------------------------------------------
	 * Module Methods
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Called by the ModuleService on module registration
	 */
	function configure(){
		/**
		 * Every module has a settings configuration object
		 */
		settings = {
		};

		/**
		 * The module interceptors to register into the runtime
		 */
		interceptors = [];

		/**
		 * A list of custom interception points to register into the runtime
		 */
		customInterceptionPoints = [];
	}

	/**
	 * Called by the ModuleService on module activation
	 */
	function onLoad(){
		// Register the current working directory as the /bxApp mapping in the BoxLang runtime
		var cwd = server.boxlang.cliMode ? server.cli.executionPath : server.java.executionPath
		getBoxRuntime().getConfiguration().registerMapping( "/bxApp", cwd )
		// Register the root of the application as /bxAppRoot in the BoxLang runtime
		var looksLikeWindowsDrive = len( cwd ) >= 2 && cwd.mid( 2, 1 ) == ":"
		var osRoot = looksLikeWindowsDrive ? left( cwd, 2 ) & char( 92 ) : "/"
		getBoxRuntime().getConfiguration().registerMapping( "/bxAppRoot", osRoot )
	}

	/**
	 * Called by the ModuleService on module deactivation
	 */
	function onUnload(){

	}

	/**
	 * --------------------------------------------------------------------------
	 * Module Events
	 * --------------------------------------------------------------------------
	 * You can listen to any runtime events by creating the methods
	 * that match the approved runtime interception points
	 * https://boxlang.ortusbooks.com/boxlang-framework/interceptors/core-interception-points
	 */

	/**
	 * --------------------------------------------------------------------------
	 * CLI Entry Point
	 * --------------------------------------------------------------------------
	 * Every BoxLang module may declare `main( args )`; `boxlang bxSites
	 * <verb> ...` invokes it directly - as does the standalone `bxSites`
	 * script `box install`/`install-bx-module` drops on PATH (`box.json`'s
	 * `boxlang.executable`), which is just a one-line wrapper around the
	 * same `boxlang bxSites "$@"` call. Either way `args` contains
	 * ONLY the arguments after the verb dispatch token - the module name
	 * itself is never included, so args[1] = the verb, args[2..] = the
	 * verb's own flags/positional args.
	 *
	 * Dispatch itself is CLI-agnostic: raw argv is parsed once here into a
	 * plain options struct via `parseCliOptions()`, then handed to one thin
	 * dispatcher class per verb under `models/cli/` - each is unit-tested
	 * directly against that struct shape, without going through argv parsing.
	 *
	 * Argument parsing follows BoxLang's own documented CLI conventions (see
	 * https://boxlang.ortusbooks.com/getting-started/running-boxlang/cli-scripting#parsed-arguments):
	 * `--option` (boolean true), `--option=value` / `--option="quoted value"`,
	 * `-o=value` / `-o` (short form), `-abc` (combined single-char shorthand),
	 * and `--!option` / `--no-option` (negation, sets false). Everything else
	 * becomes a positional. There is deliberately no `--key value`
	 * (space-separated) form - BoxLang's own convention doesn't have one.
	 *
	 * `--version`/`-v` and `--help`/`-h` (or no verb, or the `help` verb) are
	 * handled before verb dispatch and never reach a verb class - though in
	 * practice only `-v` and `help`/no-args ever get this far intact:
	 * BoxLang's own CLI reserves `-h`, `--help`, and the long `--version`
	 * form as ITS OWN global flags and intercepts them before any module,
	 * this one included, ever runs - `-h`/`--help` show BoxLang's generic
	 * runtime help instead of this method's own printUsage(), and
	 * `--version` gets silently stripped from argv, so firstToken below
	 * ends up empty rather than "--version". Not a bug in this dispatch
	 * logic to fix - there's no argv this class ever sees to fix it with -
	 * see docs/cli-reference.md's "Global options" section for the
	 * user-facing form of this same caveat.
	 *
	 * @args The raw CLI argv, module name and dispatch token excluded
	 *
	 * @return The process exit code (0 success, 1 failure)
	 */
	function main( args = [] ) {
		// Relative to this file's OWN location (the module root) - BoxLang
		// resolves a bare dotted path like "models.cli.New" relative to the
		// module root only from the file the runtime directly invokes as the
		// module's main() (this one). Nested classes must use the "Class@bxsites"
		// suffix form instead when referencing each other.
		var firstToken = arguments.args[ 1 ] ?: ""

		if ( firstToken == "--version" || firstToken == "-v" ) {
			println( "✨ bxSites v#this.version#" )
			return 0
		}

		if ( firstToken == "--help" || firstToken == "-h" || firstToken == "help" ) {
			mergeProviderVerbs( static.verbs, static.verbDescriptions, arguments.args )
			printUsage( static.verbs, static.verbDescriptions )
			return 0
		}

		if ( !len( firstToken ) ) {
			printUsage( static.verbs, static.verbDescriptions )
			return 1
		}

		mergeProviderVerbs( static.verbs, static.verbDescriptions, arguments.args )

		// A provider-contributed verb may register under a colon-joined
		// compound name (e.g. "cloud:publish", following the same
		// convention core's own "post:new"/"i18n:status" already use) -
		// "cloud publish" (two space-separated argv tokens) is UX sugar
		// over that same registration, not a second dispatch mechanism.
		// Checked only after provider verbs are merged in, so a provider's
		// own compound verb is eligible here exactly like a core one.
		var verbName = firstToken
		var verbTokens = 1

		if ( arrayLen( arguments.args ) >= 2 ) {
			var compoundVerbName = firstToken & ":" & arguments.args[ 2 ]
			if ( static.verbs.keyExists( compoundVerbName ) ) {
				verbName = compoundVerbName
				verbTokens = 2
			}
		}

		if ( !static.verbs.keyExists( verbName ) ) {
			println( "Unknown verb [#verbName#]." )
			println( "" )
			printUsage( static.verbs, static.verbDescriptions )
			return 1
		}

		var rawVerbArgs = []
		for ( var i = verbTokens + 1; i <= arrayLen( arguments.args ); i++ ) {
			rawVerbArgs.append( arguments.args[ i ] )
		}

		var options = parseCliOptions( rawVerbArgs )
		options.projectRoot = resolveProjectRoot( options )

		try {
			var verbClass = new "#static.verbs[ verbName ]#"()
			var result = verbClass.run( options )
			if ( len( result.message ?: "" ) ) {
				println( result.message )
			}
			return result.exitCode ?: 0
		} catch ( any e ) {
			println( "Error: #e.message#" )
			return 1
		}
	}

	/**
	 * Merges CLI verbs contributed by installed+activated addon modules
	 * into the core verb tables, IN PLACE - the mechanism that lets an
	 * addon like a commercial bxSites companion module register its own
	 * verbs (`bxSites deploy`, `bxSites cloud:publish`, ...) without any
	 * further core changes. See `models/cli/CliProviderLoader.bx` for the
	 * `models/BxSitesCliProvider.bx` contract a module implements, and
	 * `docs/guides/cli-providers.md` for the end-to-end guide.
	 *
	 * Core's own literal verb table always wins on a name collision (a
	 * verb already present in `arguments.verbs` is left untouched).
	 *
	 * Hardened end-to-end: a missing/malformed `bxsites.yaml`, a project
	 * that doesn't exist yet (e.g. `--help` run outside any project), a
	 * module listed in `plugins` with no `BxSitesCliProvider.bx` of its
	 * own, or a provider whose `verbs()` throws, all silently leave the
	 * core verb table untouched rather than breaking dispatch - this must
	 * never be the reason `bxSites --help`/`new`/any core verb stops working.
	 *
	 * @verbs Core's own verb-name -> dispatch-class-path struct, mutated in place
	 * @verbDescriptions Core's own verb-name -> description struct, mutated in place
	 * @rawArgs The full, untouched argv passed to main()
	 */
	private void function mergeProviderVerbs( required struct verbs, required struct verbDescriptions, required array rawArgs ) {
		try {
			var projectRoot = guessProjectRootForDiscovery( arguments.rawArgs )
			var config = new "models.config.ConfigLoader@bxsites"().load( projectRoot )
			var loader = new "models.cli.CliProviderLoader@bxsites"()
			var providers = loader.discoverProviders( config.plugins ?: [] )
			var contributed = loader.collectVerbs( providers )

			for ( var verbName in contributed.verbs ) {
				if ( !arguments.verbs.keyExists( verbName ) ) {
					arguments.verbs[ verbName ] = contributed.verbs[ verbName ]
					arguments.verbDescriptions[ verbName ] = contributed.descriptions[ verbName ] ?: ""
				}
			}
		} catch ( any e ) {
			// No project, no config, invalid config, or discovery failure -
			// core verbs remain fully usable on their own either way.
		}
	}

	/**
	 * A best-effort project root for provider-verb DISCOVERY ONLY - never
	 * used for actual verb dispatch, which stays `resolveProjectRoot()`'s
	 * job further down `main()`. Deliberately narrower than
	 * `resolveProjectRoot()`'s own precedence: at the point this runs, the
	 * verb (and, for a compound "cloud publish"-style verb, its own second
	 * token) hasn't been identified yet, so a bare positional argument
	 * can't be trusted to be a project path rather than another verb
	 * token - only an explicit `--projectRoot=` flag is honored here,
	 * else the current working directory.
	 *
	 * @rawArgs The full, untouched argv passed to main()
	 */
	private string function guessProjectRootForDiscovery( required array rawArgs ) {
		for ( var token in arguments.rawArgs ) {
			if ( token.startsWith( "--projectRoot=" ) ) {
				return stripQuotes( token.right( len( token ) - len( "--projectRoot=" ) ) )
			}
		}
		return resolveProjectRoot( {} )
	}

	/**
	 * Prints the `--help`/no-verb/unknown-verb usage text: module identity,
	 * one line per verb (sorted alphabetically) with its description, and the
	 * two global flags handled before verb dispatch.
	 *
	 * @verbs Struct mapping verb name -> dispatch class path
	 * @verbDescriptions Struct mapping verb name -> one-line help text
	 */
	private void function printUsage( required struct verbs, required struct verbDescriptions ) {
		println( "✨ bxSites v#this.version# - #this.description#" )
		println( "" )
		println( "📖 Usage: bxSites <verb> [options]" )
		println( "   or: boxlang bxSites <verb> [options]" )
		println( "" )

		var verbNames = arguments.verbs.keyArray().sort( "textnocase" )
		var verbWidth = 0
		for ( var verbName in verbNames ) {
			verbWidth = max( verbWidth, len( verbName ) )
		}

		println( "🛠 Commands:" )
		for ( var verbName in verbNames ) {
			var description = arguments.verbDescriptions[ verbName ] ?: ""
			var descriptionLines = wrapUsageText( description, 96 - verbWidth - 4 )
			var prefix = "  " & verbName.lJustify( verbWidth ) & "  "
			println( prefix & ( descriptionLines[ 1 ] ?: "" ) )
			for ( var lineIndex = 2; lineIndex <= descriptionLines.len(); lineIndex++ ) {
				println( repeatString( " ", len( prefix ) ) & descriptionLines[ lineIndex ] )
			}
		}

		println( "" )
		println( "⚙ Global options:" )
		println( "  -h, --help     Show this help message and exit" )
		println( "  -v, --version  Show the module version and exit" )
		println( "" )
		println( "📍 Project root:" )
		println( "Every verb also accepts --projectRoot=<path> (or a bare positional path) to" )
		println( "target a project other than the current directory." )
	}

	/**
	 * Wraps help text at word boundaries while preserving a usable minimum width
	 * for unusually long command names.
	 */
	private array function wrapUsageText( required string text, required numeric width ) {
		var words = len( trim( arguments.text ) ) ? listToArray( trim( arguments.text ), " " ) : [ "" ]
		var lines = []
		var currentLine = ""
		var wrapWidth = max( 20, arguments.width )

		for ( var word in words ) {
			if ( len( currentLine ) && len( currentLine ) + len( word ) + 1 > wrapWidth ) {
				lines.append( currentLine )
				currentLine = word
			} else {
				currentLine = len( currentLine ) ? currentLine & " " & word : word
			}
		}

		if ( len( currentLine ) || lines.isEmpty() ) {
			lines.append( currentLine )
		}
		return lines
	}

	/**
	 * Parses a verb's own argv (module name + verb already stripped) into a
	 * plain options struct, following BoxLang's own documented CLI argument
	 * conventions (see `main()`'s docblock for why this exists instead of
	 * just calling `CLIGetArgs()`, which is tied to the runtime's real
	 * process-launch argv and has no equivalent that parses an arbitrary array):
	 *
	 * - `--option`          -> `true`
	 * - `--option=value`    -> `value` (surrounding `"..."` / `'...'` stripped)
	 * - `-o=value`          -> short form with a value
	 * - `-o`                -> short form, `true`
	 * - `-abc`              -> combined single-char shorthand: a/b/c all `true`
	 * - `--!option`         -> negation, `false`
	 * - `--no-option`       -> negation, `false`
	 * - anything else       -> a positional; the first one becomes
	 *                          `_positional` (a fallback project path for
	 *                          `resolveProjectRoot()`)
	 *
	 * Repeated options override earlier ones, matching the documented "last
	 * one wins" rule.
	 *
	 * @rawArgs A verb's own argv, with the module name and verb token already stripped
	 *
	 * @return A plain options struct (flag names -> value/true/false), plus an optional `_positional` key for the first bare positional argument
	 */
	private struct function parseCliOptions( required array rawArgs ) {
		var options = {}

		for ( var token in arguments.rawArgs ) {
			if ( token.startsWith( "--!" ) ) {
				options[ token.right( len( token ) - 3 ) ] = false
			} else if ( token.startsWith( "--no-" ) ) {
				options[ token.right( len( token ) - 5 ) ] = false
			} else if ( token.startsWith( "--" ) ) {
				var body = token.right( len( token ) - 2 )
				var eqPos = body.find( "=" )
				if ( eqPos ) {
					options[ body.left( eqPos - 1 ) ] = stripQuotes( body.right( len( body ) - eqPos ) )
				} else {
					options[ body ] = true
				}
			} else if ( token.startsWith( "-" ) && len( token ) > 1 ) {
				var body = token.right( len( token ) - 1 )
				var eqPos = body.find( "=" )
				if ( eqPos ) {
					options[ body.left( eqPos - 1 ) ] = stripQuotes( body.right( len( body ) - eqPos ) )
				} else if ( len( body ) > 1 ) {
					for ( var charIndex = 1; charIndex <= len( body ); charIndex++ ) {
						options[ body.mid( charIndex, 1 ) ] = true
					}
				} else {
					options[ body ] = true
				}
			} else if ( !options.keyExists( "_positional" ) ) {
				options[ "_positional" ] = token
			}
		}

		return options
	}

	/**
	 * Strips one layer of matching surrounding `"..."` / `'...'` quotes from
	 * a `--option="value"` / `--option='value'` assignment, per BoxLang's own
	 * documented convention.
	 *
	 * @value The raw assigned value, quotes included if present
	 *
	 * @return The value with one layer of matching surrounding quotes removed, or unchanged if none/mismatched
	 */
	private string function stripQuotes( required string value ) {
		if ( len( arguments.value ) < 2 ) {
			return arguments.value
		}
		var first = arguments.value.left( 1 )
		var last  = arguments.value.right( 1 )
		if ( ( first == '"' && last == '"' ) || ( first == "'" && last == "'" ) ) {
			return arguments.value.right( len( arguments.value ) - 1 ).left( len( arguments.value ) - 2 )
		}
		return arguments.value
	}

	/**
	 * Precedence: --projectRoot flag > first positional arg > the shell's
	 * current working directory. A relative value is resolved against the
	 * CWD, never against this module's own file location.
	 *
	 * @options The parsed options struct from parseCliOptions()
	 *
	 * @return An absolute, trailing-slash-free path to the target project root
	 */
	private string function resolveProjectRoot( required struct options ) {
		var cwd = getSystemSetting( "user.dir", "" )
		var candidate = len( arguments.options.projectRoot ?: "" )
			? arguments.options.projectRoot
			: ( len( arguments.options._positional ?: "" ) ? arguments.options._positional : "." )

		if ( candidate == "." ) {
			return cwd.reReplace( "[\/]+$", "" )
		}

		var isAbsolute = candidate.startsWith( "/" ) || reFind( "^[A-Za-z]:", candidate ) > 0
		var resolved = isAbsolute ? candidate : ( cwd & "/" & candidate )
		return resolved.reReplace( "[\/]+$", "" )
	}

}
